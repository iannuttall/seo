---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import DottedCard from '@/components/DottedCard.astro'
import FeatureCta from '@/components/FeatureCta.astro'
import NavCard from '@/components/NavCard.astro'
import PageHeader from '@/components/PageHeader.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Features', href: '/features' },
  { label: 'SEO audit tool' },
]

const steps = [
  ['1. Run the audit', 'Start with seo report. It checks the evidence available for the project and shows what needs a closer look.'],
  ['2. Inspect the pages', 'Open the affected URLs, source details, dates, limits, and caveats behind each finding.'],
  ['3. Fix the cause', 'Let your coding agent trace the issue to the code or content and prepare a reviewable change.'],
  ['4. Check the result', 'Run the focused report again and compare later search data before you call the work a win.'],
] as const
---

<BaseLayout
  title="SEO audit tool for AI agents"
  description="Run a local website SEO audit with your AI agent. Find technical, content, indexing, internal-link, and search-performance issues with affected URLs and clear evidence."
  canonicalPath="/features/seo-audit"
  {breadcrumbs}
>
  <main data-agent-content>
    <Breadcrumbs {breadcrumbs} />
    <PageHeader
      title="SEO audit tool for AI agents"
      description="Find the SEO problems that matter, see every affected page, and give your coding agent enough evidence to fix the cause."
      align="left"
    />

    <div class="grid gap-6 sm:grid-cols-2">
      {steps.map(([title, description], index) => (
        <DottedCard patternId={`audit-step-${index}`}>
          <div class="p-5 pb-10">
            <h2 class="text-sm font-normal leading-5">{title}</h2>
            <p class="mt-3 font-sans text-sm leading-6 text-foreground-muted">{description}</p>
          </div>
          <span slot="label">Audit workflow</span>
        </DottedCard>
      ))}
    </div>

    <section class="docs-prose mt-14" aria-labelledby="more-than-score">
      <h2 id="more-than-score">Get affected URLs, not one vague score</h2>
      <p>
        A score cannot tell your agent where the defect lives. This website SEO audit tool keeps the observed evidence next to the finding, so you can review the pages, confirm the pattern, and fix the right thing.
      </p>
      <p>
        The main report combines what is available from the crawl, Search Console, and Google Analytics. It explains skipped sections and suggests a small number of focused reports for the next step.
      </p>

      <h2>Cover technical SEO and search performance</h2>
      <ul>
        <li>Find crawl errors, redirect chains, duplicate signals, weak internal links, and broken technical files.</li>
        <li>Review titles, descriptions, headings, canonicals, robots rules, structured data, and page content.</li>
        <li>Find weak CTR, page-two queries, declining pages, cannibalisation, and indexing candidates.</li>
        <li>Check AI crawler access, content extractability, citations, and fixed prompt observations without calling them universal visibility scores.</li>
      </ul>

      <h2>Run it on your machine</h2>
      <p>
        The audit is open source and local first. It does not require an account, hosted dashboard, or telemetry service. You can run it from the terminal, through the <a href="/features/mcp">SEO MCP server</a>, in CI, or from TypeScript.
      </p>
      <p>
        Start with a live URL or save a project profile. Connect Google only when your search and analytics evidence will improve the decision.
      </p>
    </section>

    <div class="mt-14 grid gap-6 sm:grid-cols-2">
      <NavCard
        title="SEO report catalog"
        heading="See every audit and research report"
        description="Choose a focused report after the main audit shows the first investigation queue."
        href="/docs/reports"
      />
      <NavCard
        title="Free SEO tools"
        heading="Check one file or decision in your browser"
        description="Use a focused browser tool when you do not need a full crawl or project profile."
        href="/tools"
      />
    </div>

    <FeatureCta
      title="Run your first SEO audit"
      description="Install the command, complete the guided setup, and run seo report."
    />
  </main>
</BaseLayout>
