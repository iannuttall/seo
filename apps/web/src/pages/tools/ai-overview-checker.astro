---
import {
  AiSearchIcon,
  ChartBarLineIcon,
  RankingIcon,
  SearchList01Icon,
} from '@hugeicons/core-free-icons'
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import HomeCard from '@/components/HomeCard.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SetupPrompts from '@/components/SetupPrompts.astro'
import SplitList from '@/components/SplitList.astro'
import AiOverviewChecker from '@/components/tools/AiOverviewChecker.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: 'AI Overview checker' },
]

const answers = [
  { title: 'Shown', text: 'Google put an AI Overview on the page.' },
  { title: 'Not shown', text: 'The page came back without one.' },
  { title: 'Unknown, check failed', text: 'The search failed, so the checker cannot say either way (and it never counts those as a no).' },
  { title: 'Unknown, no results', text: 'The search returned no results, so the checker cannot say either way.' },
  {
    title: 'Check a not shown keyword again',
    text: 'Not shown is weaker evidence than shown. The checker waits for the overviews Google builds after the page loads, but Google does not show one for every search every time, so a keyword that shows nothing today is worth checking again before you write it off.',
  },
]

const compare = [
  { title: 'Most sources in the top five', text: 'The overview mostly repeats the results page.' },
  {
    title: 'Several sources outside the top 20',
    text: 'Google is drawing on pages that do not rank for this exact wording, so read what those pages say.',
  },
  {
    title: 'Your page ranks but is not cited',
    text: 'Add your domain to see both sides for your own site. A page that ranks on the first page but is not cited is a good place to start reading the overview text against your content.',
  },
  { title: 'Subdomains count as yours', text: 'blog.example.com is highlighted when you enter example.com.' },
]

const method = [
  {
    title: 'One live search per keyword',
    text: 'Each keyword is one live Google search through DataForSEO at the moment you press the button, in the country and on the device you choose.',
  },
  {
    title: 'Everything from the same page',
    text: 'The overview, its sources and the organic results all come from that same page, read 20 results deep, and the results show when they were checked.',
  },
  {
    title: 'Treat each run as one snapshot',
    text: 'AI Overviews change from one search to the next, by location and by device.',
  },
  {
    title: 'Sources linked through a Google redirect',
    text: 'When Google links a source through its own redirect, the page is unknown, so the source keeps its title and has no position.',
  },
  {
    title: 'Full organic results for one keyword',
    text: 'Use the SERP checker.',
    href: '/tools/serp-checker',
  },
]

const tools = [
  { title: 'SERP checker', text: 'The full organic results for one keyword, with who ranks and each site\u2019s Domain Rating.', href: '/tools/serp-checker', icon: SearchList01Icon, link: 'Check a SERP' },
  { title: 'AI visibility checker', text: 'Ask ChatGPT search, Gemini, Google AI Mode and AI Overviews your own questions and see whether each answer cites or names your brand.', href: '/tools/ai-visibility-checker', icon: AiSearchIcon, link: 'Check AI visibility' },
  { title: 'Query fan-out tool', text: 'The searches ChatGPT actually ran to answer a prompt, and the sites it cited from them.', href: '/tools/query-fan-out-tool', icon: RankingIcon, link: 'See fan-out searches' },
  { title: 'seo research', text: 'Run the same check from your agent with your own DataForSEO key.', href: '/docs/research', icon: ChartBarLineIcon, link: 'Research docs' },
]

const faq = [
  {
    question: 'What is an AI Overview?',
    answer:
      'The AI written summary Google shows above the results for some searches. It answers the search in a few paragraphs and links the pages it drew on as sources.',
  },
  {
    question: 'How does the AI Overview checker work?',
    answer:
      'When you press the button it searches Google live for each keyword through DataForSEO, in the country and on the device you pick. It reads the AI Overview, its sources in order and the first 20 organic results from that same page, then matches each source to its organic position.',
  },
  {
    question: 'Is this AI Overview checker free?',
    answer:
      'Yes. You get 3 free checks a day, each with up to five keywords, and you need no email or signup. For more, your agent can run the same check with your own DataForSEO key, which bills you directly.',
  },
  {
    question: 'Why does a keyword show no AI Overview when I see one?',
    answer:
      'Google does not show the same page to everyone. Overviews differ by location, device, signed in state and the moment you search, so one check can miss an overview that shows up on the next search. Run the check again before you treat a missing overview as a no.',
  },
  {
    question: 'Why does a source say the page is unknown?',
    answer:
      'Google sometimes links a source through its own redirect address instead of the page itself. The checker shows the title Google gave it and says the page is unknown, rather than guessing the address or dropping the source.',
  },
  {
    question: 'Does my site count if a subdomain is cited?',
    answer:
      'Yes. If you enter example.com, a source or result on blog.example.com or shop.example.com counts as yours and is highlighted.',
  },
  {
    question: 'Will ranking higher get my page cited?',
    answer:
      'Not on its own. The position column shows where each cited page ranks on the same results page, which tells you whether Google drew on top results or reached further down for this search. It is one observation, not a rule for how sources are picked.',
  },
]
---

<BaseLayout
  title="Free AI Overview checker with cited sources"
  description="Check whether Google shows an AI Overview for up to five keywords, read it, and see each cited source matched to its organic rank, free with no signup."
  canonicalPath="/tools/ai-overview-checker"
  {breadcrumbs}
  framed={false}
>
  <main data-agent-content>
    <section class="pt-4">
      <div class="site-frame flex flex-col items-center pt-14 text-center sm:pt-20">
        <h1 class="mt-4 max-w-3xl text-pretty text-4xl/tight font-medium -tracking-[0.8px] xl:text-5xl/tight xl:-tracking-[1px]">
          AI Overview checker
        </h1>
        <p class="mt-4 max-w-2xl text-pretty text-xl/8 font-medium -tracking-[0.2px] text-foreground-muted">
          See whether Google shows an AI Overview for your keywords, what it
          says, which pages it cites and where those pages rank.
        </p>
      </div>
      <div class="site-frame mt-10 sm:mt-12">
        <AiOverviewChecker />
      </div>
    </section>

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      <section class="site-frame" aria-labelledby="results-heading">
        <SectionHeading
          id="results-heading"
          title="What do the AI Overview results show?"
          text="One line per keyword: whether Google showed an AI Overview, how many sources it cited and, if you added your domain, whether your site is cited and where it ranks. Under it, each keyword has the overview's own text and its sources in the order Google listed them."
        />
        <div class="docs-prose max-w-4xl">
          <table>
            <thead>
              <tr>
                <th>Column</th>
                <th>What it tells you</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>#</td>
                <td>The source's place in the overview's list, first to last.</td>
              </tr>
              <tr>
                <td>Cited source</td>
                <td>The page title and address Google linked.</td>
              </tr>
              <tr>
                <td>Page position</td>
                <td>Where that exact page ranks in the first 20 organic results on the same search.</td>
              </tr>
              <tr>
                <td>Best on the site</td>
                <td>The highest organic position of any page on the source's site, which shows when Google cites a different page from the one that ranks.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <SplitList
        id="answers-heading"
        title="What do shown, not shown and unknown mean?"
        text="Each keyword gets one of four answers, and only shown and not shown say anything about the overview. An unknown search is never counted as a no."
        items={answers}
      />

      <SplitList
        id="compare-heading"
        title="Does Google cite the pages that already rank?"
        text="Matching each source to its organic rank answers that for each search: is Google citing the pages it already ranks, or reaching past them?"
        items={compare}
      />

      <SplitList
        id="method-heading"
        title="How does the AI Overview check run?"
        text="As one live Google search per keyword through DataForSEO, at the moment you press the button. Treat each run as one snapshot."
        items={method}
      />

      <SplitList
        id="agent-heading"
        title="How do you track AI Overviews with your AI agent?"
        text="Ask it, once SEO Skill is connected. Your agent runs the same check with seo research and your own DataForSEO key, for the queries your site already gets impressions for in Search Console."
        items={[
          { title: 'The same check through seo research', text: 'Your agent uses your own DataForSEO key, which bills you directly.', href: '/docs/research' },
          { title: 'Queries from your Search Console', text: 'That way you check the keywords that already matter to your site, instead of a list you guessed.' },
        ]}
      >
        <div class="mt-6">
          <CodeBlock
            label="Ask your agent"
            prompt
            value="Check which of my top 20 Search Console queries for example.com show a Google AI Overview, list the sources each one cites with their organic positions, and tell me where my pages rank but are not cited"
            wrap
          />
        </div>
      </SplitList>

      <section class="site-frame" aria-labelledby="tools-heading">
        <SectionHeading
          id="tools-heading"
          title="Which tools go with an AI Overview check?"
          text="These, which cover the full results page, AI answers from other engines and the same check from your agent."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {tools.map((item) => <HomeCard {...item} />)}
        </div>
      </section>

      <section class="site-frame" aria-labelledby="faq-heading">
        <div class="max-w-2xl">
          <h2 id="faq-heading" class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            AI Overview checker questions
          </h2>
        </div>
        <div class="mt-10">
          <FaqAccordion items={faq} id="ai-overview-faq" />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="start-heading">
        <SectionHeading
          id="start-heading"
          title="Check AI Overviews for your own queries with your agent"
          text="Add SEO Skill to your agent, sign in with the Google account that can read your Search Console, and ask which of your queries show an AI Overview that cites someone else."
        />
        <SetupPrompts id="ai-overview-setup" />
      </section>
    </div>
  </main>
</BaseLayout>
