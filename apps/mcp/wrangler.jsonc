{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The hosted MCP. D1 keeps only linked Google and Bing sign-ins and
  // research keys, sealed with SEAL_KEY, and how each person signed up.
  // No report data and no logs, except the weekly-audit beta's crawl
  // results for the sites a granted account adds (src/audit).
  "name": "seo-mcp",
  "main": "./src/index.ts",
  "account_id": "ab5ec097e2579c5f3639612c755e6f15",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "seoskill.dev/mcp", "zone_name": "seoskill.dev" },
    { "pattern": "seoskill.dev/mcp/*", "zone_name": "seoskill.dev" },
    { "pattern": "seoskill.dev/oauth/*", "zone_name": "seoskill.dev" },
    // /account* also covers /account?query and the site's /account-shell,
    // which only this Worker reads, through the SITE binding.
    { "pattern": "seoskill.dev/account*", "zone_name": "seoskill.dev" },
    {
      "pattern": "seoskill.dev/.well-known/oauth-*",
      "zone_name": "seoskill.dev"
    },
    // The static server card for MCP directories.
    { "pattern": "seoskill.dev/.well-known/mcp/*", "zone_name": "seoskill.dev" }
  ],
  "limits": { "cpu_ms": 60000 },
  // Bundles skills/seo/SKILL.md as text for the skill resource.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "vars": { "PUBLIC_URL": "https://seoskill.dev" },
  // The site Worker, for the account page design (/account-shell).
  "services": [{ "binding": "SITE", "service": "seo-skill" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seo-mcp",
      "database_id": "f75c6bad-c11a-49c0-bcdb-f1a4de1be3bf",
      "migrations_dir": "migrations"
    },
    {
      // The site's anonymous usage events, read (SELECT only) for the
      // weekly failure count. Its migrations belong to apps/web.
      "binding": "TELEMETRY_DB",
      "database_name": "seo-telemetry",
      "database_id": "4b8c5f37-983d-4229-a712-77dbcd853efe"
    }
  ],
  // The weekly-audit beta: one SQLite Durable Object per person and
  // Search Console property (src/audit).
  "durable_objects": {
    "bindings": [{ "name": "SITE_AUDIT", "class_name": "SiteAudit" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SiteAudit"] }],
  // No Workers Logs: the server keeps no logs of requests or user data.
  "observability": { "enabled": false },
  // Mondays 08:00 UTC: the week's sign-up and failure counts to Telegram.
  // Hourly at :17: start the weekly audits that are due.
  "triggers": { "crons": ["0 8 * * 1", "17 * * * *"] }
  // Secrets: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, SEAL_KEY, AHREFS_DR_KEY,
  // BING_CLIENT_ID, BING_CLIENT_SECRET, and optionally TELEGRAM_BOT_TOKEN and
  // TELEGRAM_CHAT_ID for the weekly sign-up and failure counts.
}
