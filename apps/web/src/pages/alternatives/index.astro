---
// Every alternative, grouped by kind, as a landing page: why SEO Skill, then
// one card per alternative that opens its comparison.
import FaqAccordion from '@/components/FaqAccordion.astro'
import HomeCard from '@/components/HomeCard.astro'
import LandingHero from '@/components/LandingHero.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SetupPrompts from '@/components/SetupPrompts.astro'
import SplitList from '@/components/SplitList.astro'
import { AiChat02Icon, QuillWrite01Icon } from '@hugeicons/core-free-icons'
import { competitors, groups } from '@/content/alternatives'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [{ label: 'Home', href: '/' }, { label: 'Alternatives' }]

const why = [
  { title: 'Free SEO tools, no account', text: 'Backlinks, Domain Rating, competitor keywords, SERPs, traffic estimates and site checks in your browser.', href: '/tools' },
  { title: 'Free in your AI agent, with no usage cap', text: 'Every tool your agent calls on demand costs nothing, with no trial and no daily limit.' },
  { title: 'A Google Search Console MCP with one sign-in', text: 'Search Console, Google Analytics and URL Inspection with read-only access. No Google Cloud project, no API key.', href: '/features/search-console' },
  { title: 'Works in every client', text: 'Claude, ChatGPT and Le Chat on the web, plus Claude Code, Codex, Cursor, VS Code and Gemini CLI.' },
  { title: 'Your data is not stored', text: 'Rows are fetched when your agent asks and returned, never stored, except what the paid weekly audit keeps for its sites. Your sign-ins, saved keys and the issues lists your agent saves are kept.' },
  { title: 'Keyword research with your own key', text: 'DataForSEO or Ahrefs results next to your own numbers, kept clearly apart from them.' },
]

const suites = competitors.filter((item) => item.kind === 'seo suite')
const names = (list: typeof competitors) => list.map((item) => item.short).join(', ')
const webChat = competitors.filter((item) => item.webChat === 'Yes')
const openSource = competitors.filter((item) => item.kind === 'self-hosted')
const faqs = [
  { question: 'What is the best free alternative to Ahrefs or Semrush?', answer: 'For the everyday lookups, SEO Skill\'s free web tools check backlinks, Domain Rating, competitor keywords, SERPs and traffic estimates with no account. For your own site, its free MCP server gives your AI agent your real Search Console and Google Analytics data, which no index estimate can match.' },
  { question: 'Which SEO tools are compared here?', answer: `${names(suites)}, plus ${competitors.length - suites.length} MCP servers, skills and connectors that give an AI agent SEO data.` },
  { question: 'What is the best free Google Search Console MCP server?', answer: `SEO Skill is free for every on-demand tool with no usage cap, and it runs hosted, so there is nothing to install. The free open source servers (${names(openSource)}) run on your own machine with your own Google Cloud project.` },
  { question: 'Which Search Console MCP servers work in claude.ai and ChatGPT?', answer: `SEO Skill does, and so do ${names(webChat)}, according to their own pages.` },
  { question: 'Do I need a Google Cloud project?', answer: 'Not for SEO Skill. You add one URL and sign in with Google. Most open source servers ask you to create a Google Cloud project and an OAuth client first.' },
  { question: 'Where do the facts on these pages come from?', answer: 'From each tool\'s own product, docs, pricing and GitHub pages. GitHub numbers are refreshed by script, and a person re-reads prices and plans.' },
]
---

<BaseLayout
  title="Free alternatives to Ahrefs, Semrush and SEO tools"
  description={`Free alternatives to Ahrefs, Semrush, Moz, Similarweb, SpyFu and ${competitors.length - 5} more SEO tools and MCP servers, compared with SEO Skill on features, price and data.`}
  canonicalPath="/alternatives"
  schemaType="CollectionPage"
  {breadcrumbs}
  framed={false}
>
  <main data-agent-content>
    <LandingHero
      title="SEO tool alternatives compared"
      lead="Free alternatives to Ahrefs, Semrush, Moz, Similarweb and the rest of the SEO stack, plus every other way to give an AI agent your search data. What each one does, what it costs and what it keeps, next to SEO Skill."
      setupId="alternatives-setup"
    />

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      <SplitList
        id="why-heading"
        title="Why do teams pick SEO Skill over other SEO tools?"
        text="Because it is free: SEO tools in your browser, and your own search data in your AI agent. Add the URL, sign in with Google and ask."
        items={why}
      />

      {
        groups.map((group) => {
          const items = competitors.filter((item) => item.kind === group.kind)
          if (!items.length) return null
          return (
            <section class="site-frame" aria-labelledby={`group-${group.kind.replace(' ', '-')}`}>
              <SectionHeading id={`group-${group.kind.replace(' ', '-')}`} title={group.title} text={group.text} />
              <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                {items.map((item) => (
                  <HomeCard
                    title={item.short}
                    text={`${item.summary} Paid plans start at ${item.priceFrom}.`}
                    icon={group.icon}
                    href={`/alternatives/${item.slug}`}
                    link={item.kind === 'seo suite' ? `Free ${item.short} alternative` : `SEO Skill vs ${item.short}`}
                  />
                ))}
                {group.kind === 'seo suite' && items.length % 2 ? (
                  <HomeCard
                    title="All free SEO tools"
                    text="Every free tool on SEO Skill in one place, with no account and no key."
                    icon={group.icon}
                    href="/tools"
                    link="Browse the free tools"
                  />
                ) : null}
              </div>
            </section>
          )
        })
      }

      <section class="site-frame" aria-labelledby="group-ai-visibility">
        <SectionHeading
          id="group-ai-visibility"
          title="AI visibility trackers"
          text="Tools that track how often ChatGPT, Gemini and Google's AI answers name or cite you, compared on what they measure and who does the work."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          <HomeCard title="Peec AI" text="A daily tracker for marketing teams, with an MCP server and Looker Studio." icon={AiChat02Icon} href="/alternatives/peec-ai" link="Peec AI alternatives" />
          <HomeCard title="Profound" text="Ten engines, bot logs and agents that draft the content, for large teams." icon={AiChat02Icon} href="/alternatives/profound" link="Profound alternatives" />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="group-ai-writers">
        <SectionHeading
          id="group-ai-writers"
          title="AI article writers"
          text="Tools that write and publish blog articles for you, compared with writing in your own agent from your Search Console data."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          <HomeCard title="BlogSEO" text="An AI article a day and a backlink exchange, from $59 a month for 15 articles." icon={QuillWrite01Icon} href="/alternatives/blogseo" link="BlogSEO alternatives" />
          <HomeCard title="SEObot" text="Autopilot blog articles from $49 a month for 9, published to your CMS every week." icon={QuillWrite01Icon} href="/alternatives/seobot" link="SEObot alternatives" />
          <HomeCard title="Outrank" text="An AI article a day on autopilot, from $99 a month for 30 articles." icon={QuillWrite01Icon} href="/alternatives/outrank" link="Outrank alternatives" />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="alternatives-faq">
        <div class="max-w-2xl">
          <h2 id="alternatives-faq" class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            Questions about the alternatives
          </h2>
        </div>
        <div class="mt-10">
          <FaqAccordion items={faqs} id="alternatives-faq-list" />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="start-heading">
        <SectionHeading
          id="start-heading"
          title="Try SEO Skill on your own site"
          text="Add SEO Skill to your agent, sign in with Google and ask for your site's quick wins. It reads your Search Console live, so you can keep your other tools while you decide."
        />
        <SetupPrompts id="alternatives-setup-end" />
      </section>
    </div>
  </main>
</BaseLayout>
