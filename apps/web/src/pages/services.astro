---
import {
  AiChat02Icon,
  Analytics01Icon,
  ChartLineData01Icon,
  Rocket01Icon,
  Route01Icon,
} from '@hugeicons/core-free-icons'
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import HomeCard from '@/components/HomeCard.astro'
import LandingHero from '@/components/LandingHero.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SetupPrompts from '@/components/SetupPrompts.astro'
import SplitList from '@/components/SplitList.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'AI SEO services' },
]

const services = [
  { title: 'SEO audit service', text: 'What a technical audit should check, what you should get from it, and how to run one with your own agent.', href: '/services/seo-audit', icon: Route01Icon, link: 'See the SEO audit service' },
  { title: 'AEO and GEO agency', text: 'The weekly work an AEO or GEO agency does to get you cited in AI answers, and how to judge it.', href: '/services/aeo-agency', icon: AiChat02Icon, link: 'See the AEO agency page' },
  { title: 'SEO for startups', text: 'The few SEO jobs to do at launch, in the order they pay off, each checked with your own data.', href: '/seo-for-startups', icon: Rocket01Icon, link: 'See SEO for startups' },
]

const related = [
  { title: 'AI visibility checker', text: 'Ask ChatGPT, Gemini, AI Mode and AI Overviews your buyer questions and see who they cite.', href: '/features/ai-visibility-checker', icon: AiChat02Icon, link: 'See the checker' },
  { title: 'SEO audit', text: 'Crawl the site for the technical problems that keep pages out of Google and AI answers.', href: '/features/seo-audit', icon: Route01Icon, link: 'See the audit' },
  { title: 'SEO agent', text: 'Turn the coding agent you already use into the one that does the work.', href: '/features/seo-agent', icon: Analytics01Icon, link: 'See the agent' },
  { title: 'SEO reporting', text: 'A weekly report on what moved, from your own Search Console and analytics.', href: '/features/seo-reporting', icon: ChartLineData01Icon, link: 'See reporting' },
]

const faq = [
  {
    question: 'What is the difference between AI SEO and normal SEO?',
    answer:
      'Most of the work is the same. AI Overviews and AI Mode use pages Google has indexed, and ChatGPT and Perplexity search the web before they answer, so a page that is not crawlable or indexed cannot be cited either. AI SEO adds one thing: checking what AI answers say about your category and who they cite, so you can see whether the work reaches them.',
  },
  {
    question: 'Are AEO, GEO and AI search optimization different services?',
    answer:
      'No. Answer engine optimization (AEO), generative engine optimization (GEO) and AI search optimization are names for the same work: getting a business named and cited in AI answers. Judge a service by the work it does each week.',
  },
  {
    question: 'How do you measure whether AI answers name you?',
    answer:
      'Ask the same buyer questions on each AI engine, more than once, and count how often the answer names or cites you. One answer is one sample, and the same question can name you in one run and skip you in the next. SEO Skill can ask each question up to five times and report the rate.',
  },
  {
    question: 'Can I run AI SEO myself?',
    answer:
      'Yes. SEO Skill gives your agent your Search Console, Google Analytics, crawl and AI answer data, and the agent works in your site’s code. You review each change before it ships. The tools your agent calls on demand are free.',
  },
]
// The five jobs, in the order each one depends on the one before.
const jobs = [
  { title: 'Get crawled and indexed', text: 'Let search and AI crawlers read every page, and get the pages that matter into Google’s index. seo index checks Google’s index status for your pages.', href: '/docs/indexing' },
  { title: 'Find the buyer questions', text: 'Find what buyers search and ask AI, and which pages show up for it today. AI search tracking pulls those questions from your own Search Console.', href: '/features/ai-search' },
  { title: 'Write and fix pages', text: 'Comparison, alternatives and use-case pages, and sharper titles and copy. Your agent writes the change in your site’s code, and you review it before it ships.', href: '/features/seo-agent' },
  { title: 'Track AI answers', text: 'Ask ChatGPT, Gemini and Google’s AI answers your buyer questions. The AI visibility checker lists the sites each answer cites, yours and your competitors’.', href: '/features/ai-visibility-checker' },
  { title: 'Report what moved', text: 'Clicks, rankings, index status and AI answers, each week compared with the one before, from your own data.', href: '/features/seo-reporting' },
]

const loop = [
  { title: 'Read what changed', text: 'Search Console and AI answers since last week, from your own data.' },
  { title: 'Pick one change', text: 'The change most likely to help, with the evidence for it.' },
  { title: 'Make it', text: 'Your agent makes the change in your codebase. Nothing ships without your say.' },
  { title: 'Check it next week', text: 'The next run shows whether the change moved the numbers.' },
]

const checks = [
  { title: 'Which questions do you track, and where did they come from?', text: 'Questions from your own Search Console are ones people already ask. A list someone guessed may be questions nobody types.' },
  { title: 'How many times do you ask each one?', text: 'A rate across several runs means something. A single answer does not.' },
  { title: 'Whose data is the report built on?', text: 'Your own Search Console and analytics show real clicks. Third-party estimates are useful for competitors, but they are estimates.' },
  { title: 'Can you see every change and when it shipped?', text: 'If a number moves, you should be able to line it up with the change that came before it.' },
  { title: 'Do they separate cause from timing?', text: 'A rise in the same week as a new page shows the timing matched. It does not prove the page caused it.' },
]

---

<BaseLayout
  title="AI SEO services for Google and AI answers"
  description="What AI SEO services cover: indexing, pages for buyer questions, tracking who AI answers cite and weekly reports, run with your own agent and data."
  canonicalPath="/services"
  {breadcrumbs}
  framed={false}
>
  <main data-agent-content>
    <LandingHero
      title="AI SEO services"
      lead="AI SEO is the work of getting found in Google and named in ChatGPT, Gemini, Perplexity and Google's AI answers. This is what that work covers, how to check it is working, and how to run it with your own agent and data."
      setupId="services-setup"
      author
    />

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      <SplitList
        id="jobs-heading"
        title="What do AI SEO services cover?"
        text="Five jobs, whatever a provider calls it (AI SEO, AEO, GEO or AI search optimization). Each depends on the one before it, because a page Google has not indexed cannot rank, and a page that does not rank is rarely the one an AI answer cites."
        items={jobs}
      />

      <SplitList
        id="loop-heading"
        title="How does the work run each week?"
        text="As a weekly loop. SEO Skill runs it through the agent you already use, picking the next step from your own data."
        items={loop}
      />

      <SplitList
        id="check-heading"
        title="How do you check an AI SEO service before you pay for it?"
        text="Ask these five questions of any provider, or of your own setup. AI answers vary from run to run, so a screenshot of one good answer proves very little."
        items={checks}
      />

      <section class="site-frame" aria-labelledby="services-list">
        <SectionHeading
          id="services-list"
          title="Which AI SEO service do you need?"
          text="The one that matches your job. Each page covers what the work should include and how to judge it."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {services.map((item) => <HomeCard {...item} />)}
        </div>
      </section>

      <section class="site-frame" aria-labelledby="agent-heading">
        <SectionHeading
          id="agent-heading"
          title="Can you run AI SEO with your own agent?"
          text="Yes. SEO Skill gives Claude Code, Codex, Cursor or ChatGPT your Search Console, crawl and AI answer data, and these tools do each job."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {related.map((item) => <HomeCard {...item} />)}
        </div>
        <div class="docs-prose mt-10 max-w-3xl">
          <p>Once it is connected, ask:</p>
          <CodeBlock prompt value="What should I fix first to get found in Google and named in AI answers?" wrap />
          <p>
            Your agent reads your Search Console, checks your pages and AI
            answers, and comes back with the first step and the evidence for it.
          </p>
        </div>
      </section>

      <section class="site-frame" aria-labelledby="services-faq-heading">
        <SectionHeading
          id="services-faq-heading"
          title="Questions about AI SEO services"
          text="These are the follow-ups people ask before they hire someone or start themselves."
        />
        <FaqAccordion id="services-faq" items={faq} />
      </section>

      <section class="site-frame" aria-labelledby="start-heading">
        <SectionHeading
          id="start-heading"
          title="Start AI SEO with your own agent"
          text="Add SEO Skill to your agent, sign in with Google and ask what to fix first to get found in Google and named in AI answers."
        />
        <SetupPrompts id="services-setup-end" />
      </section>
    </div>
  </main>
</BaseLayout>
