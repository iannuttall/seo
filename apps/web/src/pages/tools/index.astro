---
import HomeCard from '@/components/HomeCard.astro'
import { getButtonClasses } from '@/components/ui/button'
import { toolIcon } from '@/content/tool-icons'
import { tools } from '@/content/tools/manifest.mjs'
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout
  title="Free SEO tools"
  description="Use free SEO tools to check websites, technical files, search traffic, structured data and keyword lists in your browser without signing in."
  canonicalPath="/tools"
  schemaType="CollectionPage"
>
  <main data-agent-content>
    <section class="flex flex-col items-center pt-8 text-center sm:pt-12">
      <h1 class="max-w-3xl text-pretty text-4xl/tight font-medium -tracking-[0.8px] xl:text-5xl/tight xl:-tracking-[1px]">
        Free SEO tools
      </h1>
      <p class="mt-4 max-w-2xl text-pretty text-xl/8 font-medium -tracking-[0.2px] text-foreground-muted">
        Check a website, a technical file or a keyword list in your browser.
        No account, no sign-in.
      </p>
    </section>

    <div class="mt-14 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
      {
        tools.map((tool) => (
          <HomeCard title={tool.title} text={tool.description} icon={toolIcon(tool.id)} href={tool.path} />
        ))
      }
    </div>

    <section class="mt-16 flex items-start gap-4 rounded-lg bg-muted p-6 sm:p-8" aria-labelledby="larger-jobs">
      <div class="max-w-2xl">
        <h2 id="larger-jobs" class="text-xl/7 font-medium text-foreground">
          Ask your agent about your own site
        </h2>
        <p class="mt-2 text-base/7 text-foreground-muted">
          These tools check one file or one site at a time. For your own
          Search Console and analytics data, connect the free hosted MCP or
          install the CLI and ask your agent.
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          <a class={getButtonClasses('default', 'lg')} href="/docs/getting-started">Get started</a>{' '}
          <a class={getButtonClasses('outline', 'lg')} href="/docs#docs-commands">See the commands</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
