---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHeader from '@/components/PageHeader.astro'
import SetupCommands from '@/components/SetupCommands.astro'
import { docsSections } from '@/content/docs-nav.mjs'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Docs' },
]
---

<BaseLayout
  title="Docs"
  description="Connect the free hosted MCP or install the seo CLI, then learn the eight commands that give your agent facts from your search data."
  canonicalPath="/docs"
  {breadcrumbs}
  schemaType="CollectionPage"
>
  <main data-agent-content>
    <Breadcrumbs {breadcrumbs} />

    <PageHeader
      title="Docs"
      description="Connect the hosted MCP or install the CLI. Both run the same reports and give your agent the same facts."
    />

    <section aria-labelledby="docs-setup">
      <h2 id="docs-setup" class="sr-only">Connect or install</h2>
      <SetupCommands id="docs-setup-commands" />
    </section>

    <div class="mt-16 space-y-14">
      {
        docsSections.map((section) => (
          <section aria-labelledby={`docs-${section.title.toLowerCase()}`}>
            <h2
              id={`docs-${section.title.toLowerCase()}`}
              class="text-2xl/8 font-medium tracking-normal"
            >
              {section.title}
            </h2>
            <div class="mt-6 grid gap-3 sm:grid-cols-2">
              {section.items.map((doc) => (
                <a
                  class="rounded-lg bg-muted p-5 no-underline transition-colors hover:bg-secondary-hover focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/20"
                  href={doc.path}
                >
                  <h3 class:list={['text-base font-medium text-foreground', doc.label.startsWith('seo ') && 'font-mono text-[0.9375rem]']}>
                    {doc.label}
                  </h3>
                  <p class="mt-2 text-sm leading-6 text-foreground-muted">
                    {doc.description}
                  </p>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </main>
</BaseLayout>
