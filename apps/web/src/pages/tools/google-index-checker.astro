---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import PageHeader from '@/components/PageHeader.astro'
import SetupPrompts from '@/components/SetupPrompts.astro'
import GoogleIndexChecker from '@/components/tools/GoogleIndexChecker.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: 'Google index checker' },
]

const faq = [
  {
    question: 'How do I check if a page is indexed by Google?',
    answer:
      'Enter the URL above. The checker searches Google for site: plus the URL and for exact phrases from the page, on desktop and mobile, and says whether Google returned the page itself. If the site is yours, URL Inspection in Search Console gives the definitive answer for one page at a time.',
  },
  {
    question: 'Is this Google index checker free?',
    answer:
      'Yes. You get 3 free checks a day, up to 5 URLs each, with no account and no email. For more, your agent can run the same check with your own DataForSEO key, which bills you directly.',
  },
  {
    question: 'Does "not found" mean my page is not indexed?',
    answer:
      'Not for certain. Google can hold a page in its index and still leave it out of a site: or exact phrase search. Found is strong evidence, because Google returned the page itself. Not found is weaker: the page may be missing, or indexed and not shown for those searches.',
  },
  {
    question: 'Why does a result say not known?',
    answer:
      'A search failed, or Google returned results from the site behind redirect links that could not be matched to a page. The checker never turns a failed search into "not indexed". Run it again later.',
  },
  {
    question: 'Why is the site: search showing other websites?',
    answer:
      'When nothing matches a site: search, Google sometimes drops the filter and shows unrelated sites instead. The checker counts those as no match, not as rankings.',
  },
  {
    question: 'My page is not indexed. What should I do?',
    answer:
      'Fix anything the checker flags first: a noindex, a robots.txt block, an error status or a canonical pointing elsewhere. Then use Request indexing in URL Inspection, make sure the page is in your sitemap, and link to it from pages Google already knows.',
  },
  {
    question: 'How long does Google take to index a new page?',
    answer:
      'Anywhere from a few hours to several weeks. Google does not promise to index every page it crawls, and pages with no internal links or thin content often wait longer or are left out.',
  },
]
---

<BaseLayout
  title="Free Google index checker for up to 5 URLs"
  description="Check whether Google has indexed up to 5 pages. See every search as evidence, on desktop and mobile, and what could stop each page being indexed."
  canonicalPath="/tools/google-index-checker"
  {breadcrumbs}
>
  <main data-agent-content>
    <Breadcrumbs {breadcrumbs} />
    <PageHeader
      title="Google index checker"
      description="Find out whether Google has a page in its index, with the searches that show it and anything on the page that keeps it out."
    />

    <GoogleIndexChecker />

    <div class="docs-prose mt-16">
      <h2>How the index check works</h2>
      <p>
        For each URL, the checker runs live Google searches through
        DataForSEO in the country you pick, on desktop and on mobile. It
        searches <code>site:</code> plus the page address, then an exact
        phrase from the page's H1 or title and one from its meta
        description. If any search returns the page itself, the page is
        found. Each run is one snapshot of Google, so the answer can change
        from one run to the next.
      </p>
      <p>
        At the same time it fetches the page the way a crawler would and
        reads what it tells Google: the status code, every redirect, the
        robots meta tags, the X-Robots-Tag header, the canonical and
        robots.txt. A page that is not found next to a noindex has a likely
        reason. A page that is not found with nothing blocking it is
        probably waiting on Google.
      </p>

      <h2>Read found, not found and not known</h2>
      <table>
        <thead>
          <tr>
            <th>Result</th>
            <th>What it means</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Found in Google</td>
            <td>At least one search returned the page itself. Strong evidence that it is indexed.</td>
          </tr>
          <tr>
            <td>Not found</td>
            <td>Every search ran and none returned the page. The page may be missing, or indexed and not shown for these searches.</td>
          </tr>
          <tr>
            <td>Not known</td>
            <td>A search failed, or Google's results could not be matched to a page. Run it again later.</td>
          </tr>
        </tbody>
      </table>
      <p>
        Not found is weaker evidence than found. Google can index a page and
        still leave it out of a <code>site:</code> search (it does this more
        than you would expect for big sites). If the site is yours, URL
        Inspection in Search Console gives the definitive answer, because it
        reads Google's own record of the URL.
      </p>

      <h2>Check what blocks indexing</h2>
      <p>
        The second half of each result lists what the page tells Google. A
        noindex in a meta tag or header asks Google to leave the page out. A
        robots.txt rule stops Google crawling it. A canonical that points to
        another URL asks Google to index that one instead. These can all be
        deliberate, so check the intent before you change them.
      </p>
      <p>
        For one page in detail, with the exact rule and how to fix it on
        WordPress, Webflow, Shopify and other platforms, use the{' '}
        <a href="/tools/noindex-checker">noindex checker</a>.
      </p>

      <h2>Check indexing with your AI agent</h2>
      <p>
        With SEO Skill your agent runs the same check with{' '}
        <a href="/docs/research">seo research</a> and your own DataForSEO
        key, on as many pages as you like. For your own site it goes further:{' '}
        <a href="/docs/indexing">seo index</a> reads URL Inspection from
        Search Console for each page and says why Google does or does not
        index it. Ask:
      </p>
      <CodeBlock value="Check whether Google has indexed my five newest blog posts on example.com, and tell me what is keeping out any that are missing" wrap />
      <p>To set it up, give your agent this prompt:</p>
    </div>

    <SetupPrompts id="index-checker-setup" class="mt-6" />

    <div class="docs-prose mt-16">
      <h2>Google index checker questions</h2>
    </div>
    <div class="mt-6">
      <FaqAccordion id="index-checker-faq" items={faq} />
    </div>
  </main>
</BaseLayout>
