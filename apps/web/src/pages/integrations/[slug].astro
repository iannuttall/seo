---
// One landing page per data source (/integrations/google-search-console) and
// one per AI client (/integrations/claude-code).
import ClientSteps from '@/components/ClientSteps.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import HomeCard from '@/components/HomeCard.astro'
import LandingHero from '@/components/LandingHero.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SetupPrompts from '@/components/SetupPrompts.astro'
import SplitList from '@/components/SplitList.astro'
import { getButtonClasses } from '@/components/ui/button'
import { integrationIcon } from '@/content/integration-icons'
import { type Client, type Source, clients, hostedSources, sources } from '@/content/integrations'
import { setupPromptFor, sourceSetupSteps } from '@/content/setup-prompts'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

export function getStaticPaths() {
  return [
    ...sources.map((source) => ({ params: { slug: source.id }, props: { source } })),
    ...clients.map((client) => ({ params: { slug: client.id }, props: { client } })),
  ]
}

type Props = { source?: Source; client?: Client }
const { source, client } = Astro.props

const id = source?.id ?? client?.id ?? ''
const name = source?.name ?? client?.name ?? ''
const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Integrations', href: '/integrations' },
  { label: name },
]
const title = source ? source.title : `SEO MCP server for ${name}`
const metaTitle = source?.metaTitle ?? `SEO MCP server for ${name}`
const description = source
  ? source.description
  : `Add the free SEO Skill MCP server to ${name} and ask about your Search Console, Google Analytics, Clicky and keyword data. Setup takes a minute.`
const lead = source
  ? source.lead
  : `Give ${name}, ${client?.where}, your real Search Console, Google Analytics and keyword data. Add one server, sign in with Google, and ask.`
const hosted = source ? source.connect !== 'cli' : true

// How the source's data reaches your agent, step by step.
const connectSteps = source
  ? [
      { title: 'What you need', text: source.needs },
      ...(source.connect === 'google'
        ? [{ title: 'Connect', text: 'Give your agent the setup prompt on this page. It adds the server, and you sign in with Google when it asks. Access is read only. Add more Google accounts, such as a client\'s, on your account page.' }]
        : []),
      ...(source.connect === 'key'
        ? [{ title: `Add your ${name} key`, text: `The setup prompt has your agent ask you to save your ${source.id === 'dataforseo' ? 'login and password' : 'API key'} under Keys on your account page, so the key never goes into a chat. Clients that send headers can pass it with each request instead.` }]
        : []),
      ...(source.connect === 'clicky'
        ? [{ title: 'Add your Clicky sites', text: 'The setup prompt has your agent ask you to add your whole Clicky account, or one site at a time, under Keys on your account page.' }]
        : []),
      ...(source.connect === 'cli'
        ? [{ title: 'Connect Bing', text: 'The setup prompt installs the CLI, links it to your account and asks you to choose Connect Bing on your account page. To keep Bing on one machine instead, use a Bing Webmaster API key with seo providers bing connect.' }]
        : []),
      { title: 'Read it with its limits', text: source.limit },
      ...(source.id === 'google-search-console'
        ? [{ title: 'Free, with a paid weekly audit', text: 'Every tool is free with no usage cap. The weekly site audit is $50 a month per site: a weekly crawl, daily Google index checks, stored history, drop and return alerts, and a Monday email and webhook. Cancel any time.' }]
        : []),
    ]
  : []

// A link to the feature page that covers this source or client in depth.
const featureLinks: Record<string, { before: string; anchor: string; href: string; after: string }> = {
  'google-search-console': { before: 'This page shows how to connect it. For everything it can do, with prompts and a worked example, see the ', anchor: 'Google Search Console MCP', href: '/features/search-console', after: ' page.' },
  'google-analytics': { before: 'This page shows how to connect it. For everything it can do, with prompts and a worked example, see the ', anchor: 'Google Analytics MCP server', href: '/features/google-analytics', after: ' page.' },
  'claude-code': { before: 'Add the ', anchor: 'Claude SEO skill', href: '/features/claude-seo', after: ' too, so Claude Code knows which tool answers which question.' },
  claude: { before: 'The ', anchor: 'Claude SEO skill', href: '/features/claude-seo', after: ' page covers claude.ai, Claude Desktop and Claude Code.' },
  codex: { before: 'The ', anchor: 'Codex SEO skill', href: '/features/codex-seo', after: ' page adds the skill and the seo CLI to Codex.' },
  chatgpt: { before: 'The ', anchor: 'ChatGPT SEO', href: '/features/chatgpt-seo', after: ' page shows what to ask ChatGPT once it has your own clicks, queries and pages.' },
  dataforseo: { before: 'For what your agent can do with the key, see the ', anchor: 'AI keyword research tool', href: '/features/keyword-research', after: ' page.' },
  ahrefs: { before: 'For what your agent can do with the key, see the ', anchor: 'AI keyword research tool', href: '/features/keyword-research', after: ' page.' },
}
const featureLink = featureLinks[id]

const clientFaq = client
  ? [
      { question: `Is SEO Skill free in ${name}?`, answer: 'Yes. Every tool your agent calls on demand is free with no usage cap. The only paid part is the weekly site audit, which runs on our servers in the background for $50 a month per site.' },
      { question: `Can ${name} change anything in my Search Console?`, answer: 'No. The Google sign-in asks for read-only access to Search Console and Google Analytics.' },
      { question: 'Does the server keep my search data?', answer: 'It keeps your linked Google accounts and any keys you save, encrypted. Search Console and analytics rows are fetched when your agent asks and not kept, except for sites in the paid weekly audit, where it keeps the crawls, index checks with each page\'s clicks and impressions, and the issues list.' },
      ...(client.note ? [{ question: `Which ${name} plans can add it?`, answer: client.note }] : []),
      { question: 'What about site crawls and Bing?', answer: setupPromptFor(client.id) ? `Those run on your own machine with the seo CLI. The setup prompt installs it and links it to your account, and ${name} runs it when a request needs it.` : 'Those run on your own machine with the seo CLI. The hosted server tells your agent when a request needs the CLI.' },
    ]
  : []
---

<BaseLayout title={metaTitle} {description} canonicalPath={`/integrations/${id}`} {breadcrumbs} framed={false}>
  <main data-agent-content>
    {
      source ? (
        hosted ? (
          <LandingHero {title} {lead} setupId="integration-setup" setupSteps={sourceSetupSteps(source)} author>
            {featureLink ? (
              <p slot="note" class="mt-4 max-w-2xl text-pretty text-base leading-7 text-foreground-muted">
                {featureLink.before}
                <a class="underline underline-offset-4" href={featureLink.href}>{featureLink.anchor}</a>
                {featureLink.after}
              </p>
            ) : null}
          </LandingHero>
        ) : (
          <LandingHero {title} {lead} setupId="integration-setup" setupSteps={sourceSetupSteps(source)} author />
        )
      ) : (
        client && setupPromptFor(client.id) ? (
          <LandingHero {title} {lead} setupId="integration-setup" setupClient={client.id} author />
        ) : (
          <LandingHero {title} {lead} setupId="integration-setup" author>
            <p slot="note" class="mt-4 max-w-2xl text-pretty text-base leading-7 text-foreground-muted">
            {name} adds connectors in its own settings, not from a prompt. Give this prompt to a coding agent, or follow the steps below in {name}.
          </p>
          </LandingHero>
        )
      )
    }

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      {
        client && !setupPromptFor(client.id) ? (
          <section class="site-frame" aria-labelledby="clicks-heading">
            <SectionHeading
              id="clicks-heading"
              title={`How do you add SEO Skill in ${name}?`}
              text={`By hand in ${name}'s settings, because a chat cannot add a connector to itself. You sign in with Google at the end.`}
            />
            <ClientSteps steps={client.steps} note={client.signIn} />
          </section>
        ) : null
      }

      {
        source ? (
          <>
            <SplitList
              id="asks-heading"
              title={`What can you ask about your ${name} data?`}
              text={`Anything you would ask a colleague, in the same words. Your agent picks the tool and reads your ${name} data before it answers.`}
              items={source.asks.map((ask) => ({ title: ask.question, text: ask.answer }))}
            >
            </SplitList>
            {source.tools.length ? (
              <SplitList
                id="tools-heading"
                title="Which tools does your agent get?"
                text={`These SEO Skill tools read ${name}, and your agent calls them for you.`}
                items={source.tools.map((tool) => ({ title: tool.text, code: tool.tool }))}
              />
            ) : null}
            <SplitList id="connect-heading" title={`How do you connect ${name}?`} text="With the setup prompt on this page. You need the account below, and each answer comes with the limits listed here." items={connectSteps}>
              <a class:list={[getButtonClasses('secondary', 'lg'), 'mt-6']} href={source.docs.href}>{source.docs.label}</a>
            </SplitList>
          </>
        ) : (
          <SplitList
            id="prompts-heading"
            title={`What can you ask in ${name}?`}
            text="Questions about your own search data, such as these. Each one reads a different source, so open one for its setup in this client."
            items={hostedSources.map((item) => ({
              title: item.asks[0]?.question ?? item.name,
              text: `Reads ${item.name}.`,
              href: `/integrations/${item.id}/${id}`,
            }))}
          >
            {featureLink ? (
              <p class="mt-4 text-base leading-7 text-foreground-muted">
                {featureLink.before}
                <a class="underline underline-offset-4" href={featureLink.href}>{featureLink.anchor}</a>
                {featureLink.after}
              </p>
            ) : null}
            <a class:list={[getButtonClasses('secondary', 'lg'), 'mt-6']} href={client?.docsUrl} target="_blank" rel="noreferrer">
              {name} MCP docs
            </a>
          </SplitList>
        )
      }

      <section class="site-frame" aria-labelledby="links-heading">
        <SectionHeading
          id="links-heading"
          title={source ? (hosted ? `Which AI clients can read ${name}?` : 'What other data can your agent read?') : `What data can ${name} read?`}
          text={source && hosted ? `All of these, with the same server and sign-in. Open one for its setup.` : 'Search Console and Google Analytics, which come with your Google sign-in, and research with your own key.'}
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {
            source && hosted
              ? clients.map((item) => (
                  <HomeCard title={item.name} text={item.card} icon={integrationIcon(item.id)} href={`/integrations/${source.id}/${item.id}`} link={`${name} in ${item.name}`} />
                ))
              : hostedSources.map((item) => (
                  <HomeCard
                    title={item.name}
                    text={item.card}
                    icon={integrationIcon(item.id)}
                    href={client ? `/integrations/${item.id}/${id}` : `/integrations/${item.id}`}
                    link={client ? `${item.name} in ${name}` : `${item.name} MCP`}
                  />
                ))
          }
        </div>
      </section>

      <section class="site-frame" aria-labelledby="faq-heading">
        <div class="max-w-2xl">
          <h2 id="faq-heading" class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            Questions about {source ? `the ${name} MCP` : `SEO Skill in ${name}`}
          </h2>
        </div>
        <div class="mt-10">
          <FaqAccordion items={source?.faq ?? clientFaq} id="integration-faq" />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="start-heading">
        <SectionHeading
          id="start-heading"
          title={client ? `Add SEO Skill to ${name}` : `Connect ${name} to your agent`}
          text={client && !setupPromptFor(client.id) ? `Give the setup prompt to a coding agent, or add the connector in ${name} with the steps above. Then sign in with Google and ask about your site.` : 'Give your agent the setup prompt, sign in with Google when it asks, and ask about your site.'}
        />
        <SetupPrompts id="integration-setup-end" client={client?.id} extraSteps={source ? sourceSetupSteps(source) : undefined} />
      </section>
    </div>
  </main>
</BaseLayout>
