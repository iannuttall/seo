---
import Card from '@/components/Card.astro'
import PageHeader from '@/components/PageHeader.astro'
import {
  reportCommands,
  reportDestination,
  reportIds,
} from '@/content/telemetry/report-ids.mjs'

// Each report id a client can send, with the command it now belongs to and
// the docs page that covers it. Removed reports count under "Removed".
const commandLabels: Record<string, string> = {
  setup: 'seo start',
  removed: 'Removed reports',
}
const reportMapJson = JSON.stringify(
  Object.fromEntries(
    reportIds.map((id) => {
      const command = reportCommands[id] ?? 'removed'
      return [
        id,
        {
          command: commandLabels[command] ?? `seo ${command}`,
          path: reportDestination(id),
        },
      ]
    }),
  ),
)

const metrics = [
  ['installs', 'Recorded installs'],
  ['setupCompletions', 'Setup completions'],
  ['firstAuditCompletions', 'First audits completed'],
  ['auditsStarted', 'Audits started'],
  ['auditsCompleted', 'Successful audits'],
  ['auditsThisMonth', 'Audits run this month'],
  ['firstAuditConversionPercent', 'Installs completing first audit'],
  ['auditsFailed', 'Failed audits'],
  ['commandsFailed', 'Failed commands'],
] as const
---

<div data-stats-root data-report-map={reportMapJson} aria-busy="true">
  <PageHeader
    title="Anonymous usage stats"
    description="Aggregate event counts from installs that leave anonymous telemetry enabled. No user, machine, site, URL, report content, Google data, or location is attached to any event."
  >
    <p slot="actions" class="animate-pulse text-sm text-foreground-muted" data-stats-status data-stats-loading data-agent-markdown="exclude" aria-live="polite">
      Fetching current totals.
    </p>
    <p slot="actions" hidden data-agent-markdown="only">
      Agents can fetch current values as JSON with a GET request to
      https://seoskill.dev/api/stats.
    </p>
  </PageHeader>

  <section class="mb-14" aria-label="Usage totals" data-agent-markdown="exclude">
    <div class="grid items-stretch gap-2 sm:auto-rows-fr sm:grid-cols-2 lg:grid-cols-3">
      {
        metrics.map(([key, label]) => (
          <Card inverted>
            <article class="flex h-full min-h-32 flex-col justify-between gap-5 p-6">
              <p class="text-sm text-foreground-muted">{label}</p>
              <p class="animate-pulse text-2xl font-medium tabular-nums sm:text-3xl" data-stat={key} data-stats-loading>
                {key === 'firstAuditConversionPercent' ? '0%' : '0'}
              </p>
            </article>
          </Card>
        ))
      }
    </div>
  </section>

  <div class="mb-14 grid items-start gap-5 lg:grid-cols-2" data-agent-breakdowns data-agent-markdown="exclude">
    <section class="min-w-0 space-y-5" aria-labelledby="agent-installs-heading">
      <h2 id="agent-installs-heading" class="text-xl font-medium leading-tight">
        Install agent breakdown
      </h2>
      <div class="docs-prose">
        <div class="table-frame">
          <table class="min-w-0">
            <thead><tr><th>Agent</th><th class="text-right">Installs</th><th class="text-right">Share</th></tr></thead>
            <tbody class="animate-pulse" data-agent-table="installs" data-stats-loading><tr><td colspan="3">No recorded events</td></tr></tbody>
          </table>
        </div>
      </div>
    </section>
    <section class="min-w-0 space-y-5" aria-labelledby="agent-audits-heading">
      <h2 id="agent-audits-heading" class="text-xl font-medium leading-tight">
        Audit agent breakdown
      </h2>
      <div class="docs-prose">
        <div class="table-frame">
          <table class="min-w-0">
            <thead><tr><th>Agent</th><th class="text-right">Audits</th><th class="text-right">Share</th></tr></thead>
            <tbody class="animate-pulse" data-agent-table="audits" data-stats-loading><tr><td colspan="3">No recorded events</td></tr></tbody>
          </table>
        </div>
      </div>
    </section>
  </div>

  <section class="mb-14 space-y-5" aria-labelledby="retention-heading" data-agent-markdown="exclude">
    <div class="space-y-2">
      <h2 id="retention-heading" class="text-xl font-medium leading-tight">
        Day 7 retention by install week
      </h2>
      <p class="text-[0.9375rem] leading-7">
        A returning install ran the tool at least seven days after its first run.
        Only complete weekly cohorts are shown.
      </p>
    </div>
    <div class="docs-prose">
      <div class="table-frame">
        <table>
          <thead><tr><th>Cohort</th><th class="text-right">Installs</th><th class="text-right">Active at day 7</th><th class="text-right">Retention</th></tr></thead>
          <tbody class="animate-pulse" data-retention-table data-stats-loading><tr><td colspan="4">No recorded events</td></tr></tbody>
        </table>
      </div>
    </div>
  </section>

  <div class="mb-14 grid items-start gap-5 lg:grid-cols-2" data-agent-markdown="exclude">
    <section class="min-w-0 space-y-5" aria-labelledby="failure-categories-heading">
      <div class="space-y-2">
        <h2 id="failure-categories-heading" class="text-xl font-medium leading-tight">
          Why runs failed
        </h2>
        <p class="text-[0.9375rem] leading-7">
          Broad categories from every recorded failure.
        </p>
      </div>
      <div class="docs-prose">
        <div class="table-frame">
          <table class="min-w-0">
            <thead><tr><th>Category</th><th class="text-right">Runs</th></tr></thead>
            <tbody class="animate-pulse" data-failure-category-table data-stats-loading><tr><td colspan="2">No recorded failures</td></tr></tbody>
          </table>
        </div>
      </div>
    </section>
    <section class="min-w-0 space-y-5 lg:col-span-2" aria-labelledby="failure-details-heading">
      <div class="space-y-2">
        <h2 id="failure-details-heading" class="text-xl font-medium leading-tight">
          Detailed failure signals
        </h2>
        <p class="text-[0.9375rem] leading-7">
          Fixed classifications from compatible versions. Raw errors and user data are never sent.
        </p>
      </div>
      <div class="docs-prose">
        <div class="table-frame">
          <table class="min-w-0">
            <thead><tr><th>Run</th><th>Reason</th><th>Context</th><th>Version</th><th class="text-right">Count</th></tr></thead>
            <tbody class="animate-pulse" data-failure-detail-table data-stats-loading><tr><td colspan="5">No detailed failure signals</td></tr></tbody>
          </table>
        </div>
      </div>
    </section>
  </div>

  <div class="mb-14 grid items-start gap-5 lg:grid-cols-2" data-agent-markdown="exclude">
    <section class="min-w-0 space-y-5" aria-labelledby="command-runs-heading">
      <div class="space-y-2">
        <h2 id="command-runs-heading" class="text-xl font-medium leading-tight">
          Runs by command
        </h2>
        <p class="text-base leading-7 text-foreground-muted">
          Older versions sent a report id. Each one is counted under the command that covers it now.
        </p>
      </div>
      <div class="docs-prose">
        <div class="table-frame">
          <table class="min-w-0">
            <thead><tr><th>Command</th><th class="text-right">Runs</th></tr></thead>
            <tbody class="animate-pulse" data-command-table data-stats-loading><tr><td colspan="2">No recorded events</td></tr></tbody>
          </table>
        </div>
      </div>
    </section>
    <section class="min-w-0 space-y-5" aria-labelledby="popular-reports-heading">
      <div class="space-y-2">
        <h2 id="popular-reports-heading" class="text-xl font-medium leading-tight">
          Most run reports
        </h2>
        <p class="text-base leading-7 text-foreground-muted">
          The ten report ids with the most runs.
        </p>
      </div>
      <Card inverted>
        <ol class="animate-pulse divide-y divide-border text-sm" data-report-list="popular" data-stats-loading><li class="px-5 py-4">No recorded events</li></ol>
      </Card>
    </section>
  </div>

  <section aria-labelledby="reading-stats">
    <Card inverted>
      <div class="space-y-4 p-6">
        <h2 id="reading-stats" class="text-xl font-medium leading-tight">
          How to read these numbers
        </h2>
        <div class="space-y-4 text-sm leading-6 text-foreground-muted">
          <p>
            These are event totals, not people. One person can use several machines,
            clearing local state creates a new install, and disabled or CI runs do not
            appear. The first audit ratio divides first completed audit events by
            all recorded first run events. It is not an identity-linked funnel. Runs through the hosted MCP count as audits with no install behind them.
          </p>
          <p>
            The totals cover events recorded since anonymous collection began. Read
            the <a class="text-primary underline underline-offset-4 hover:text-primary-hover" href="/telemetry">full telemetry specification</a>
            {' '}or inspect the{' '}
            <a class="text-primary underline underline-offset-4 hover:text-primary-hover" href="/api/stats">aggregate JSON</a>.
          </p>
        </div>
      </div>
    </Card>
  </section>
</div>

<script>
  const numberFormat = new Intl.NumberFormat('en-GB', {
    maximumFractionDigits: 0,
  })

  const text = (element: Element | null, value: string) => {
    if (element) element.textContent = value
  }

  const count = (value: unknown) =>
    typeof value === 'number' && Number.isFinite(value)
      ? numberFormat.format(value)
      : '0'

  const percent = (value: unknown) =>
    typeof value === 'number' && Number.isFinite(value)
      ? `${value.toFixed(1).replace('.0', '')}%`
      : '0%'

  const cell = (value: string, align = 'left') => {
    const element = document.createElement('td')
    element.className = align === 'right' ? 'text-right' : 'text-left'
    element.textContent = value
    return element
  }

  const emptyRow = (columns: number, label = 'No recorded events') => {
    const row = document.createElement('tr')
    const value = cell(label)
    value.colSpan = columns
    row.append(value)
    return row
  }

  const renderAgents = (
    table: Element | null,
    rows: Array<{ agent: string; count: number; percent: number }>,
  ) => {
    if (!(table instanceof HTMLElement)) return
    table.replaceChildren()
    if (rows.length === 0) {
      table.append(emptyRow(3))
      return
    }
    for (const item of rows) {
      const row = document.createElement('tr')
      row.append(
        cell(item.agent),
        cell(count(item.count), 'right'),
        cell(percent(item.percent), 'right'),
      )
      table.append(row)
    }
  }

  const renderRetention = (
    table: Element | null,
    rows: Array<{
      cohort: string
      installs: number
      retained: number
      percent: number | null
      complete: boolean
    }>,
  ) => {
    if (!(table instanceof HTMLElement)) return
    table.replaceChildren()
    const completeRows = rows.filter((row) => row.complete).slice(0, 12)
    if (completeRows.length === 0) {
      table.append(emptyRow(4))
      return
    }
    for (const item of completeRows) {
      const row = document.createElement('tr')
      row.append(
        cell(item.cohort),
        cell(count(item.installs), 'right'),
        cell(count(item.retained), 'right'),
        cell(percent(item.percent), 'right'),
      )
      table.append(row)
    }
  }

  type ReportInfo = { command: string; path: string }
  const reportMap = (() => {
    const value = document
      .querySelector('[data-stats-root]')
      ?.getAttribute('data-report-map')
    if (!value) return {} as Record<string, ReportInfo>
    try {
      return JSON.parse(value) as Record<string, ReportInfo>
    } catch {
      return {} as Record<string, ReportInfo>
    }
  })()

  const reportPath = (report: string) => reportMap[report]?.path ?? '/docs'
  const reportCommand = (report: string) =>
    reportMap[report]?.command ?? 'Removed reports'
  const reportLabel = (report: string) => report

  const failureLabel = (value: string) =>
    value
      .split('_')
      .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
      .join(' ')

  const failureContextLabel = (value: string | null) => {
    if (value === 'crawl_pages_run_id_url') return 'crawl_pages (run_id, url)'
    return value ? failureLabel(value) : 'None'
  }

  const renderFailureCategories = (
    table: Element | null,
    rows: Array<{ category: string; count: number }>,
  ) => {
    if (!(table instanceof HTMLElement)) return
    table.replaceChildren()
    if (rows.length === 0) {
      table.append(emptyRow(2, 'No recorded failures'))
      return
    }
    for (const item of rows) {
      const row = document.createElement('tr')
      row.append(
        cell(failureLabel(item.category)),
        cell(count(item.count), 'right'),
      )
      table.append(row)
    }
  }

  const renderFailureDetails = (
    table: Element | null,
    rows: Array<{
      event: 'audit_failed' | 'command_failed'
      report: string | null
      operation: string | null
      reason: string
      context: string | null
      version: string
      count: number
    }>,
  ) => {
    if (!(table instanceof HTMLElement)) return
    table.replaceChildren()
    if (rows.length === 0) {
      table.append(emptyRow(5, 'No detailed failure signals'))
      return
    }
    for (const item of rows) {
      const row = document.createElement('tr')
      const run = item.report
        ? reportLabel(item.report)
        : item.operation
          ? `seo ${item.operation}`
          : 'Unknown'
      row.append(
        cell(run),
        cell(failureLabel(item.reason)),
        cell(failureContextLabel(item.context)),
        cell(item.version),
        cell(count(item.count), 'right'),
      )
      table.append(row)
    }
  }

  const renderReports = (
    list: Element | null,
    rows: Array<{ report: string; count: number }>,
  ) => {
    if (!(list instanceof HTMLElement)) return
    list.replaceChildren()
    if (rows.length === 0) {
      const row = document.createElement('li')
      row.className = 'px-5 py-4'
      row.textContent = 'No recorded events'
      list.append(row)
      return
    }
    for (const item of rows) {
      const row = document.createElement('li')
      row.className = 'flex items-center justify-between gap-4 px-5 py-3'
      const name = document.createElement('span')
      name.className = 'flex min-w-0 flex-col'
      const link = document.createElement('a')
      link.className = 'truncate font-mono text-primary underline underline-offset-4 hover:text-primary-hover'
      link.href = reportPath(item.report)
      link.textContent = reportLabel(item.report)
      const command = document.createElement('span')
      command.className = 'text-xs text-foreground-muted'
      command.textContent = reportCommand(item.report)
      name.append(link, command)
      const value = document.createElement('span')
      value.className = 'tabular-nums'
      value.textContent = count(item.count)
      row.append(name, value)
      list.append(row)
    }
  }

  const renderCommands = (
    table: Element | null,
    rows: Array<{ report: string; count: number }>,
  ) => {
    if (!(table instanceof HTMLElement)) return
    table.replaceChildren()
    const totals = new Map<string, number>()
    for (const item of rows) {
      if (!(item.count > 0)) continue
      const command = reportCommand(item.report)
      totals.set(command, (totals.get(command) ?? 0) + item.count)
    }
    const sorted = [...totals.entries()].sort(
      (a, b) => b[1] - a[1] || a[0].localeCompare(b[0]),
    )
    if (sorted.length === 0) {
      table.append(emptyRow(2))
      return
    }
    for (const [command, total] of sorted) {
      const row = document.createElement('tr')
      row.append(cell(command), cell(count(total), 'right'))
      table.append(row)
    }
  }

  const loadStats = async () => {
    const status = document.querySelector('[data-stats-status]')
    try {
      const response = await fetch('/api/stats', {
        headers: { accept: 'application/json' },
      })
      if (!response.ok) throw new Error('Stats request failed')
      const stats = await response.json()
      const totals = stats.totals ?? {}
      for (const key of [
        'installs',
        'setupCompletions',
        'firstAuditCompletions',
        'auditsStarted',
        'auditsCompleted',
        'auditsThisMonth',
        'auditsFailed',
        'commandsFailed',
      ]) {
        text(document.querySelector(`[data-stat="${key}"]`), count(totals[key]))
      }
      text(
        document.querySelector('[data-stat="firstAuditConversionPercent"]'),
        percent(totals.firstAuditConversionPercent),
      )
      renderAgents(
        document.querySelector('[data-agent-table="installs"]'),
        stats.agents?.installs ?? [],
      )
      renderAgents(
        document.querySelector('[data-agent-table="audits"]'),
        stats.agents?.audits ?? [],
      )
      renderRetention(
        document.querySelector('[data-retention-table]'),
        stats.retentionD7 ?? [],
      )
      renderFailureCategories(
        document.querySelector('[data-failure-category-table]'),
        stats.failures?.categories ?? [],
      )
      renderFailureDetails(
        document.querySelector('[data-failure-detail-table]'),
        stats.failures?.details ?? [],
      )
      const reports = Array.isArray(stats.reports) ? stats.reports : []
      renderReports(
        document.querySelector('[data-report-list="popular"]'),
        reports
          .filter((item: { count: number }) => item.count > 0)
          .slice(0, 10),
      )
      renderCommands(
        document.querySelector('[data-command-table]'),
        reports,
      )
      const generated = new Date(stats.generatedAt)
      text(
        status,
        Number.isNaN(generated.getTime())
          ? 'Aggregate counts loaded.'
          : `Updated ${generated.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' })} UTC.`,
      )
    } catch {
      text(status, 'Live aggregate counts are temporarily unavailable.')
    } finally {
      document.querySelector('[data-stats-root]')?.setAttribute('aria-busy', 'false')
      document.querySelectorAll('[data-stats-loading]').forEach((item) => {
        item.classList.remove('animate-pulse')
        item.removeAttribute('data-stats-loading')
      })
    }
  }

  void loadStats()
</script>
