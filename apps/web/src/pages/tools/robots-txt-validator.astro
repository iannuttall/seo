---
import {
  AiBrain01Icon,
  Alert02Icon,
  FileSearchIcon,
  Link01Icon,
  Search01Icon,
  UserIcon,
} from '@hugeicons/core-free-icons'
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import HomeCard from '@/components/HomeCard.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SetupPrompts from '@/components/SetupPrompts.astro'
import SplitList from '@/components/SplitList.astro'
import RobotsTxtValidator from '@/components/tools/RobotsTxtValidator.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: 'robots.txt checker and tester' },
]

const modes = [
  { title: 'Live mode', text: "Requests the robots.txt file at the site's root." },
  { title: 'Custom mode', text: 'Checks pasted rules inside your browser, which is useful before a change reaches production.' },
  { title: 'One parser for both', text: 'Both modes use the same parser and URL matching rules.' },
  { title: 'Bad lines do not sink the file', text: 'The result keeps parseable rules even when another line is ignored, because crawlers do not normally discard a whole file over one bad line.' },
]

const matching = [
  { title: 'The most specific user-agent group', text: 'Repeated groups for the same specific crawler are combined. A specific group is not combined with the global User-agent: * group.' },
  { title: 'Case-sensitive paths', text: 'With support for * and a terminal $.', code: '/Admin ≠ /admin' },
  { title: 'The longest match wins', text: 'The rule that matches the most URL octets decides.' },
  { title: 'Allow wins a tie', text: 'When equally specific Allow and Disallow rules conflict.' },
  { title: 'The Robots Exclusion Protocol', text: 'The tester follows RFC 9309.', href: 'https://www.rfc-editor.org/rfc/rfc9309.html' },
  { title: "Google's robots.txt parser documentation", text: 'Shows the same grouping and matching behaviour.', href: 'https://developers.google.com/crawling/docs/robots-txt/robots-txt-spec' },
]

const limits = [
  { title: 'Allowed is only about robots.txt', text: 'A firewall, login, bot challenge, network failure or page response can still stop a request. The tool does not impersonate a crawler or verify its source IP address.' },
  { title: 'A crawl control, not access control', text: 'Google may show a blocked URL without a snippet when it discovers that address elsewhere. Use authentication for private content.' },
  { title: 'Noindex keeps a page out of Search', text: 'Use a crawlable noindex directive when the goal is to keep a public page out of Google Search.' },
  { title: 'A missing file means no restrictions', text: 'Google generally treats a missing robots.txt and most other 4xx responses as no crawl restrictions.' },
  { title: 'Server errors are uncertain', text: 'A 429, a server error, a DNS failure or a timeout is different, because a cached copy may continue to apply. The checker reports that state as uncertain rather than guessing which rules a crawler holds.' },
]

const crawlers = [
  {
    title: 'Search and AI answers',
    icon: Search01Icon,
    text: 'Googlebot, Bingbot, OAI-SearchBot, Claude-SearchBot, PerplexityBot and Applebot find the pages these engines show and cite. Let them all in. Blocking Googlebot takes the page out of Google Search, which includes AI Overviews and AI Mode. OpenAI says sites that block OAI-SearchBot will not be shown in ChatGPT search answers.',
  },
  {
    title: 'Opens a page when a person asks',
    icon: UserIcon,
    text: 'ChatGPT-User, Claude-User and Perplexity-User fetch a page because someone asked about it. OpenAI says robots.txt rules may not apply to ChatGPT-User, and Perplexity says Perplexity-User generally ignores them, so a block there is a request rather than a guarantee.',
  },
  {
    title: 'Model training',
    icon: AiBrain01Icon,
    text: 'GPTBot, ClaudeBot, Applebot-Extended, CCBot and Bytespider are your call. OpenAI, Anthropic and Apple run search and training on separate tokens, so blocking GPTBot, ClaudeBot or Applebot-Extended keeps you in their search answers. Google-Extended does not affect Google Search, but it decides whether Gemini can use your pages for training and to ground its answers.',
  },
]

const guidance = [
  { title: 'OpenAI', href: 'https://developers.openai.com/api/docs/bots' },
  { title: 'Anthropic', href: 'https://support.anthropic.com/en/articles/8896518-does-anthropic-crawl-data-from-the-web-and-how-can-site-owners-block-the-crawler' },
  { title: 'Perplexity', href: 'https://docs.perplexity.ai/docs/resources/perplexity-crawlers' },
  { title: 'Apple', href: 'https://support.apple.com/en-us/119829' },
  { title: 'Google', href: 'https://developers.google.com/crawling/docs/crawlers-fetchers/google-common-crawlers' },
]

const mistakes = [
  { title: 'A leftover Disallow: /', text: 'A staging file copied to production blocks the whole site. Test the home page for Googlebot after every launch.' },
  { title: 'Blocked CSS and JavaScript', text: 'Google renders pages like a browser. If it cannot fetch the files a page needs, it may see a broken page.' },
  { title: 'Noindex in robots.txt', text: 'Google ignores it. Put the noindex on the page and leave the page crawlable.' },
  { title: 'Blocking a page you want removed', text: 'The block hides the noindex tag, so the URL can stay in results. Allow the crawl until the page drops out.' },
  { title: 'Wrong case or a missing slash', text: 'Paths are case sensitive, so /Admin does not block /admin. Test the exact URLs.' },
]

const tools = [
  { title: 'seo crawl', text: 'Reads your robots.txt while it crawls your site on your own machine, and reports the pages your rules stop it from fetching.', href: '/docs/crawl', icon: FileSearchIcon, link: 'seo crawl docs' },
  { title: 'Sitemap extractor', text: 'List every URL in a sitemap, then test the ones that matter against your rules.', href: '/tools/sitemap-extractor', icon: Link01Icon, link: 'Extract a sitemap' },
  { title: 'Redirect checker', text: 'Follow each hop and see whether the final page can be indexed.', href: '/tools/redirect-checker', icon: Alert02Icon, link: 'Check a redirect' },
  { title: 'SEO checker', text: 'Check one page for the problems that stop it ranking, including its robots rules.', href: '/tools/seo-checker', icon: Search01Icon, link: 'Check a page' },
]

const faq = [
  {
    question: 'How do I test my robots.txt file?',
    answer:
      'Enter your domain above to fetch the live file, or paste a draft. Add the URLs you care about and pick a crawler. Each URL comes back allowed or blocked, with the group and the exact line that decided it.',
  },
  {
    question: 'Does noindex work in robots.txt?',
    answer:
      'No. Google stopped supporting noindex lines in robots.txt in 2019 and ignores them. To keep a page out of search, let Google crawl it and put a noindex meta tag or X-Robots-Tag header on the page itself.',
  },
  {
    question: 'Does blocking a page in robots.txt remove it from Google?',
    answer:
      'No. It stops Google crawling the page, not indexing it. A blocked URL that other pages link to can still show in results, usually without a description. It also means Google can never see a noindex tag on that page.',
  },
  {
    question: 'Where does the robots.txt file go?',
    answer:
      'At the root of each host, such as https://example.com/robots.txt. A file in a folder is ignored, and each subdomain and each protocol needs its own file.',
  },
  {
    question: 'Should I add my sitemap to robots.txt?',
    answer:
      'Yes, it is a cheap way to tell every crawler where the sitemap is. Add a line such as Sitemap: https://example.com/sitemap.xml with the full URL. It can go anywhere in the file and does not belong to a user-agent group.',
  },
  {
    question: 'How do I block AI crawlers but stay in AI search?',
    answer:
      'Block the training crawlers by name and leave the search crawlers allowed. For OpenAI that means a group for GPTBot with Disallow: / and no block for OAI-SearchBot. Use the presets above to test both tokens against the same file.',
  },
  {
    question: 'Does Google still have a robots.txt tester?',
    answer:
      'Not one you can paste rules into. Google retired the old tester in 2023. The robots.txt report in Search Console shows the files Google found for your site and when it last read them, and URL Inspection checks one URL at a time. Paste a draft here to test it before it goes live.',
  },
  {
    question: 'Does robots.txt cover my subdomains?',
    answer:
      'No. A robots.txt file applies only to the protocol, host and port it is served from. blog.example.com needs its own file at blog.example.com/robots.txt, even when example.com has one.',
  },
  {
    question: 'How long does Google take to see a robots.txt change?',
    answer:
      'Google usually caches robots.txt for up to 24 hours, sometimes longer if the file cannot be fetched. Search Console has a robots.txt report where you can ask Google to fetch it again.',
  },
]
---

<BaseLayout
  title="Free robots.txt checker for Google and AI crawlers"
  description="Free robots.txt checker. Load a site's file or paste a draft, and see which search, AI and training crawlers can read each URL, and the line that decides."
  canonicalPath="/tools/robots-txt-validator"
  {breadcrumbs}
  framed={false}
>
  <main data-agent-content>
    <section class="pt-4">
      <div class="site-frame flex flex-col items-center pt-14 text-center sm:pt-20">
        <h1 class="mt-4 max-w-3xl text-pretty text-4xl/tight font-medium -tracking-[0.8px] xl:text-5xl/tight xl:-tracking-[1px]">
          robots.txt checker and tester
        </h1>
        <p class="mt-4 max-w-2xl text-pretty text-xl/8 font-medium -tracking-[0.2px] text-foreground-muted">
          Load a site's robots.txt or test a draft. See which search, AI and
          training crawlers can read each URL, and the line that allows or
          blocks them.
        </p>
      </div>
      <div class="site-frame mt-10 sm:mt-12">
        <RobotsTxtValidator />
      </div>
    </section>

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      <SplitList
        id="modes-heading"
        title="Can you test a robots.txt draft before it goes live?"
        text="Yes. Paste it into custom mode and it is checked in your browser, with the same rules as the live file."
        items={modes}
      />

      <SplitList
        id="matching-heading"
        title="How does the checker pick the rule that wins?"
        text="It follows the Robots Exclusion Protocol, the same way Google's parser does."
        items={matching}
      />

      <SplitList
        id="limits-heading"
        title="Does allowed mean a crawler can fetch the page?"
        text="No. Allowed means no matching robots.txt rule blocks the URL. Other things can still stop a request, and a missing file is not the same as a broken one."
        items={limits}
      />

      <section class="site-frame" aria-labelledby="crawlers-heading">
        <SectionHeading
          id="crawlers-heading"
          title="Which crawlers should you let in?"
          text="Every search and AI answer crawler. Training crawlers are your call. The crawler access table splits them into three groups, because blocking each group does something different."
        />
        <div class="grid grid-cols-1 gap-2 lg:grid-cols-3">
          {crawlers.map((item) => <HomeCard title={item.title} text={item.text} icon={item.icon} />)}
        </div>
      </section>

      <SplitList
        id="guidance-heading"
        title="Where is the current guidance for each crawler?"
        text="With each company, because crawler names and uses change, so read it before you change your policy. Applebot has one quirk: Apple says that when no group names Applebot but one names Googlebot, Applebot follows the Googlebot rules. The checker does the same and says so in the result."
        items={guidance}
      />

      <SplitList
        id="mistakes-heading"
        title="What are the most common robots.txt mistakes?"
        text="These five, and each one can keep pages out of Google or keep them in when you wanted them gone."
        items={mistakes}
      />

      <SplitList
        id="agent-heading"
        title="How do you check robots.txt across your site with your agent?"
        text="With seo crawl, which reads your robots.txt while it crawls your site on your own machine."
        items={[
          { title: 'AI search and training crawlers', text: 'It lists which AI search crawlers and which AI training crawlers your file allows, apart from each other.', href: '/docs/crawl' },
          { title: 'Pages your rules block', text: 'It reports the pages your rules stop its own crawler from fetching.' },
          { title: 'Fix and retest', text: 'Your agent can then change the file in your codebase and test the new rules here before you ship.' },
        ]}
      >
        <div class="mt-6">
          <CodeBlock
            label="Ask your agent"
            prompt
            value="Crawl example.com and tell me which AI search and training crawlers my robots.txt blocks, and which linked pages robots.txt stops the crawl from fetching"
            wrap
          />
        </div>
      </SplitList>

      <section class="site-frame" aria-labelledby="tools-heading">
        <SectionHeading
          id="tools-heading"
          title="Which tools go with a robots.txt check?"
          text="These, which cover the URLs your rules apply to and whether each page can be indexed."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {tools.map((item) => <HomeCard {...item} />)}
        </div>
      </section>

      <section class="site-frame" aria-labelledby="faq-heading">
        <div class="max-w-2xl">
          <h2 id="faq-heading" class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            robots.txt questions
          </h2>
        </div>
        <div class="mt-10">
          <FaqAccordion id="robots-faq" items={faq} />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="start-heading">
        <SectionHeading
          id="start-heading"
          title="Check robots.txt across your whole site"
          text="The crawl runs from the CLI on your machine. Give your agent this prompt and it installs the CLI and adds the hosted MCP server."
        />
        <SetupPrompts id="robots-setup" />
      </section>
    </div>
  </main>
</BaseLayout>
