{
  "name": "@seo/core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server-logs/browser": {
      "types": "./src/server-logs/browser.ts",
      "browser": "./src/server-logs/browser.ts",
      "import": "./dist/server-logs/browser.js"
    },
    "./hosted": {
      "types": "./src/hosted.ts",
      "workerd": "./src/hosted.ts",
      "import": "./dist/hosted.js"
    },
    "./commands": {
      "types": "./src/commands/index.ts",
      "workerd": "./src/commands/index.ts",
      "import": "./dist/commands/index.js"
    },
    "./cannibal/browser": {
      "types": "./src/analyze/site-diagnostics/cannibal-browser.ts",
      "browser": "./src/analyze/site-diagnostics/cannibal-browser.ts",
      "import": "./dist/analyze/site-diagnostics/cannibal-browser.js"
    },
    "./lint/browser": {
      "types": "./src/lint/index.ts",
      "browser": "./src/lint/index.ts",
      "import": "./dist/lint/index.js"
    },
    "./updates/browser": {
      "types": "./src/updates/browser.ts",
      "browser": "./src/updates/browser.ts",
      "import": "./dist/updates/browser.js"
    },
    "./serp/browser": {
      "types": "./src/serp/browser.ts",
      "browser": "./src/serp/browser.ts",
      "import": "./dist/serp/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { force: true, recursive: true })\"",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/keyring": "^1.3.0",
    "cheerio": "^1.2.0",
    "defuddle": "^0.19.6",
    "htmlparser2": "10.1.0",
    "libsql": "^0.5.29",
    "lighthouse": "13.6.0",
    "linkedom": "^0.18.14",
    "open": "^11.0.4",
    "p-queue": "^9.3.5",
    "p-retry": "^8.0.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "playwright-core": "1.65.0",
    "proper-lockfile": "^4.1.2",
    "robots-parser": "^3.0.1",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  }
}
