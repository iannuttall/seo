---
import {
  Alert02Icon,
  Clock01Icon,
  CodeIcon,
  FilterIcon,
  LockIcon,
  Search01Icon,
  ServerStack01Icon,
  TaskDone01Icon,
} from '@hugeicons/core-free-icons'
import BeforeAfter from '@/components/blog/BeforeAfter.astro'
import UrlMap from '@/components/blog/UrlMap.astro'
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import HomeCard from '@/components/HomeCard.astro'
import LandingHero from '@/components/LandingHero.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SetupPrompts from '@/components/SetupPrompts.astro'
import StatusGuides from '@/components/StatusGuides.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Guides', href: '/guides' },
  { label: "Excluded by 'noindex' tag" },
]

// seoskill.dev's own pages: /privacy and /terms send noindex in both the
// meta tag and the X-Robots-Tag header, checked live on 27 November 2026.
const urls = [
  { url: '/privacy', action: 'noindex', tone: 'change' as const, note: 'Excluded on purpose. Nobody searches for our privacy policy.' },
  { url: '/terms', action: 'noindex', tone: 'change' as const, note: 'Kept out of search on purpose, for the same reason.' },
  { url: '/guides', action: 'Indexable', tone: 'keep' as const, note: 'No noindex anywhere, so Google may index it.' },
]

const tags = {
  before: {
    label: 'Meta tag',
    code: `<meta name="robots" content="noindex, follow">`,
    note: 'In the page’s HTML head. Anyone can see it with view source.',
  },
  after: {
    label: 'HTTP header',
    code: `HTTP/2 200\nx-robots-tag: noindex, follow`,
    note: 'Sent by the server or CDN. It does the same job and is easy to miss, because it is not in the HTML.',
  },
}

const leave = [
  { title: 'Sign-in and account pages', text: 'Pages that only make sense to someone signed in.', icon: LockIcon },
  { title: 'Policies and legal pages', text: 'Privacy, terms and cookie pages nobody searches for.', icon: TaskDone01Icon },
  { title: 'Filters and internal search', text: 'Result pages that repeat what your real pages already say.', icon: FilterIcon },
  { title: 'Thank-you and confirmation pages', text: 'Pages a visitor reaches only after doing something.', icon: Clock01Icon },
]

const act = [
  { title: 'A template adds noindex everywhere', text: 'A theme setting, a plugin or a staging flag left on after launch.', icon: CodeIcon },
  { title: 'The server or CDN sends it', text: 'An X-Robots-Tag header set for previews or old deploys, now on production.', icon: ServerStack01Icon },
  { title: 'Your sitemap lists the page', text: 'You ask Google to index a page that tells it not to. One of the two is wrong.', icon: Alert02Icon },
  { title: 'The page should rank', text: 'A product, pricing or guide page that buyers search for.', icon: Search01Icon },
]

const faq = [
  {
    question: "Is \"excluded by 'noindex' tag\" an error?",
    answer:
      'Only if you want the page in Google. The reason says Google found a noindex rule and obeyed it. For an account, policy or filter page, that is the outcome you asked for.',
  },
  {
    question: "How do I fix excluded by 'noindex' tag?",
    answer:
      'Remove noindex from the robots meta tag and from any X-Robots-Tag header the server sends, then make sure robots.txt lets Google crawl the page. Google drops the reason the next time it crawls the page and finds no rule.',
  },
  {
    question: 'I removed noindex. Why does Search Console still show it?',
    answer:
      'Search Console shows what Google saw at its last crawl. Compare the last crawl date with the day you made the change. To ask for a fresh crawl, use Request indexing in the URL Inspection tool.',
  },
  {
    question: 'Should I block the page in robots.txt as well?',
    answer:
      'No. Google’s help says a robots.txt block stops Google from crawling the page, so it never sees the noindex. Use noindex alone to keep a page out of search.',
  },
  {
    question: 'Where can noindex come from if it is not in my HTML?',
    answer:
      'From an X-Robots-Tag header set by your server, CDN, hosting platform or framework. Some hosts add one to preview deployments. The free noindex checker shows both the tag and the header for any URL.',
    links: [{ text: 'noindex checker', href: '/tools/noindex-checker' }],
  },
]
---

<BaseLayout
  title="Excluded by noindex tag in Search Console: check every URL"
  description="What excluded by noindex tag means in Search Console, which pages should keep it, and how to find every page where noindex is there by mistake."
  canonicalPath="/guides/excluded-by-noindex-tag"
  {breadcrumbs}
  framed={false}
>
  <main data-agent-content>
    <LandingHero
      title="Excluded by 'noindex' tag"
      lead="This Search Console reason means the page, or the server that sent it, told Google not to index it. On the right pages that is the point. Find the pages where it got there by mistake."
      setupId="noindex-setup"
      author
    />

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      <section class="site-frame" aria-labelledby="meaning-heading">
        <SectionHeading
          id="meaning-heading"
          title="What does excluded by noindex tag mean?"
          text="It means Google obeyed a noindex rule. It crawled the page, found the rule in a robots meta tag or an X-Robots-Tag header, and left the page out."
        />
        <div class="max-w-3xl">
          <UrlMap
            rows={urls}
            title="seoskill.dev, as Google sees it"
            caption="Our privacy and terms pages carry noindex in both places."
          />
          <BeforeAfter
            before={tags.before}
            after={tags.after}
            title="The two places noindex lives"
            caption="Either one is enough. seoskill.dev's /privacy sends both."
          />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="leave-heading">
        <SectionHeading
          id="leave-heading"
          title="When should you leave it alone?"
          text="When the page belongs out of search, because Google’s help calls noindex the right way to keep it out. These are the usual cases."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {leave.map((item) => <HomeCard {...item} />)}
        </div>
      </section>

      <section class="site-frame" aria-labelledby="act-heading">
        <SectionHeading
          id="act-heading"
          title="When does it need fixing?"
          text="When noindex lands on a page you want found. It usually arrives through a template, a setting or a header nobody looks at."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {act.map((item) => <HomeCard {...item} />)}
        </div>
      </section>

      <section class="site-frame" aria-labelledby="check-heading">
        <SectionHeading
          id="check-heading"
          title="How do you check every noindex page on your site?"
          text="With SEO Skill, which asks URL Inspection about each page it knows, then loads each one live and reads both the robots meta tag and the X-Robots-Tag header."
        />
        <div class="docs-prose max-w-3xl">
          <p>Connect SEO Skill to your agent, then ask:</p>
          <CodeBlock prompt value="Which pages on example.com are excluded by a noindex tag? Tell me where the noindex comes from on each one, and which of them are in our sitemap or look like pages we want in Google." wrap />
          <p>Or run it in a terminal:</p>
          <CodeBlock value="seo index --site example.com" />
          <p>
            A page your sitemap lists is labelled fix, because the sitemap and
            the page disagree. A page where Google saw noindex but the live
            page has none is labelled check: Google's reason is from an older
            crawl and should clear the next time Google visits. A page that
            still has noindex and is not in your sitemap is labelled check,
            because only you know whether it belongs in search.
          </p>
          <p>
            On seoskill.dev, <code>/privacy</code> and <code>/terms</code>{' '}
            come back that way. Both are meant to stay out, so we leave them.
          </p>
          <p>
            For one URL, the free <a href="/tools/noindex-checker">noindex
            checker</a> shows the meta tag, the header and robots.txt side by
            side.
          </p>
        </div>
      </section>

      <section class="site-frame" aria-labelledby="noindex-faq">
        <SectionHeading
          id="noindex-faq"
          title="Questions about excluded by noindex tag"
          text="These are the follow-ups people ask after they see it in Search Console."
        />
        <FaqAccordion items={faq} id="noindex-faq-list" />
      </section>

      <StatusGuides current="/guides/excluded-by-noindex-tag" />

      <section class="site-frame" aria-labelledby="start-heading">
        <SectionHeading
          id="start-heading"
          title="Check your noindex pages with your agent"
          text="Add SEO Skill to your agent, sign in with Google and ask which noindex pages should be in search."
        />
        <SetupPrompts id="noindex-setup-end" />
      </section>
    </div>
  </main>
</BaseLayout>
