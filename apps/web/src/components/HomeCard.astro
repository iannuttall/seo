---
// A card from the ilo home page: an icon in the corner, the title and text
// below. Linked cards add an arrow, lift the icon, and change colour on
// hover. Each card spans three rows of its parent grid (icon, title, text) as
// a subgrid, so titles and text line up across a row whatever their length.
import { ArrowUpRight01Icon } from '@hugeicons/core-free-icons'
import HugeIcon from './HugeIcon.astro'

type Props = {
  title: string
  text: string
  icon: Parameters<typeof HugeIcon>[0]['icon']
  href?: string
  code?: string
}

const { title, text, icon, href, code } = Astro.props
const Tag = href ? 'a' : 'div'
---

<Tag
  href={href}
  class:list={[
    'row-span-3 grid grid-rows-subgrid gap-y-0 rounded-lg bg-muted p-6',
    href &&
      'group no-underline transition-colors hover:bg-secondary-hover focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/20',
  ]}
>
  <div class="flex items-start justify-between gap-4 text-foreground-muted">
    <HugeIcon
      icon={icon}
      class:list={[
        'size-6',
        href &&
          'transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:text-primary',
      ]}
    />
    {href ? (
      <HugeIcon
        icon={ArrowUpRight01Icon}
        class="size-5 text-foreground-soft transition-colors group-hover:text-foreground"
      />
    ) : null}
  </div>
  <h3 class="mt-8 text-base font-medium text-foreground">
    {code ? <code class="font-mono text-[0.9375rem]">{code}</code> : title}
  </h3>
  <p class="mt-2 text-sm leading-6 text-foreground-muted">{text}</p>
</Tag>
