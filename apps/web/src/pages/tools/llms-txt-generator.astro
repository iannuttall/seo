---
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import SetupCommands from '@/components/SetupCommands.astro'
import PageHeader from '@/components/PageHeader.astro'
import LlmsTxtGenerator from '@/components/tools/LlmsTxtGenerator.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: 'llms.txt generator' },
]

const faq = [
  {
    question: "What is llms.txt?",
    answer:
      "A proposed Markdown file at the root of a site, /llms.txt, that gives AI agents a short summary and a curated list of the site’s most useful pages.",
  },
  {
    question: "Does Google use llms.txt?",
    answer:
      "No. Google says Search ignores llms.txt for visibility and rankings. Some AI tools and agents read it when they visit a site.",
  },
  {
    question: "Do I need an llms.txt file?",
    answer:
      "It is optional. It costs little to publish and can help agents that read it. It will not help you rank.",
  },
  {
    question: "What format does llms.txt use?",
    answer:
      "Markdown: one H1 with the site name, an optional blockquote summary, then H2 sections that list links, each with a short note.",
  },
  {
    question: "Is llms.txt the same as robots.txt?",
    answer:
      "No. robots.txt controls which crawlers may fetch pages. llms.txt only suggests which pages are worth reading.",
  },
]
---

<BaseLayout
  title="llms.txt generator"
  description="Generate an llms.txt file from your own links or sitemap. Get the right Markdown structure for AI agents, and learn what the file can and cannot do."
  canonicalPath="/tools/llms-txt-generator"
  {breadcrumbs}
>
  <main data-agent-content>
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-foreground-muted">
      <ol class="flex flex-wrap items-center gap-1.5">
        {breadcrumbs.map((crumb, index) => (
          <li class="flex items-center gap-1.5">
            {crumb.href ? (
              <a class="underline decoration-border underline-offset-4 hover:decoration-foreground" href={crumb.href}>
                {crumb.label}
              </a>
            ) : (
              <span class="text-foreground">{crumb.label}</span>
            )}
            {index < breadcrumbs.length - 1 ? <span aria-hidden="true" class="text-border">/</span> : null}
          </li>
        ))}
      </ol>
    </nav>

    <PageHeader
      title="llms.txt generator"
      description="Start with a sitemap or add links yourself, choose the pages an agent should read first, then copy or download an llms.txt file."
    />

    <LlmsTxtGenerator />

    <div class="docs-prose mt-16">
      <h2>What this generator creates</h2>
      <p>
        The llms.txt proposal uses Markdown. A file starts with one H1 title and
        can add a short blockquote summary, notes, and H2 sections containing
        links. A section named Optional identifies secondary pages that can be
        skipped when a consumer needs a shorter context.
      </p>
      <p>
        Read the current{' '}
        <a href="https://llmstxt.org/" target="_blank" rel="noreferrer">llms.txt proposal and format</a>
        {' '}before publishing the file. This generator checks its own fields and
        creates that basic structure. It does not fetch the linked pages or prove
        that another service reads them.
      </p>

      <h2>llms.txt does not improve Google rankings</h2>
      <p>
        Google Search says it ignores llms.txt files for visibility and rankings.
        Publish one only when an agent or service you care about explicitly uses
        it. Keep normal crawling, indexing, internal links, and useful page content
        as separate work.
      </p>
      <p>
        See Google's current{' '}
        <a href="https://developers.google.com/search/docs/fundamentals/ai-optimization-guide#mythbusting" target="_blank" rel="noreferrer">generative AI search guidance</a>
        {' '}for that distinction.
      </p>

      <h2>Choose the pages yourself</h2>
      <p>
        This web tool reads URLs from the sitemap files you submit. It does not
        crawl the pages or decide which ones matter, so review the selected URLs
        before you publish the file.
      </p>

      <h2>Check the published file</h2>
      <p>
        Check the Markdown shape with the{' '}
        <a href="/tools/llms-txt-validator">llms.txt validator</a> before and
        after you publish it.
      </p>

      <h2>What to put in llms.txt</h2>
      <p>
        Think of the file as a reading list for an agent that has a few
        seconds to understand your site. Start with what the site is in one
        sentence. Then link the pages that answer the questions people ask
        most: documentation, pricing, setup, policies. Leave out blog
        archives, tag pages and anything a reader would skip.
      </p>
      <p>
        Put the pages that matter less under an <strong>Optional</strong>{' '}
        heading. An agent short on space can drop that section and still
        get the main picture.
      </p>

      <h2>Where to publish the file</h2>
      <p>
        Save it as <code>/llms.txt</code> at the root of the site, served as
        plain text or Markdown. It does not replace robots.txt or the
        sitemap, and it does not control which crawlers can read the site.
      </p>

      <h2>Check your llms.txt with your agent</h2>
      <p>
        The <a href="/docs/crawl">seo crawl</a> command checks whether{' '}
        <code>/llms.txt</code> exists and whether its links load, along with
        Markdown copies of your pages and the robots.txt rules for AI search
        and AI training crawlers. Your agent can update the file in your
        codebase when pages move. Ask:
      </p>
      <CodeBlock value="Check whether example.com has an llms.txt with working links, and list the pages that are missing from it" wrap />
      <p>The crawl runs from the CLI on your machine. Install it and run setup:</p>
      <CodeBlock value="npm i -g seo && seo start" wrap />
      <p>Or add the hosted MCP server to your agent and sign in with Google:</p>
    </div>

    <SetupCommands id="llms-txt-generator-setup" class="mt-6" />

    <div class="docs-prose mt-16">
      <h2>llms.txt generator questions</h2>
    </div>
    <div class="mt-6">
      <FaqAccordion id="llms-txt-generator-faq" items={faq} />
    </div>
  </main>
</BaseLayout>
