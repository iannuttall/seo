---
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import SetupCommands from '@/components/SetupCommands.astro'
import PageHeader from '@/components/PageHeader.astro'
import SitemapExtractor from '@/components/tools/SitemapExtractor.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: 'Sitemap URL extractor' },
]

const faq = [
  {
    question: "How do I find the sitemap of a website?",
    answer:
      "Enter the domain above. The extractor reads robots.txt for Sitemap lines, then tries common addresses such as /sitemap.xml. You can also open the site’s robots.txt in a browser and look for the line yourself.",
  },
  {
    question: "How do I extract all URLs from a sitemap?",
    answer:
      "Enter the sitemap address or the domain. The extractor follows a sitemap index into each child sitemap and lists every URL, which you can download as CSV or JSON.",
  },
  {
    question: "Can it read gzip sitemaps?",
    answer:
      "Yes. It reads .xml.gz files as well as plain XML sitemaps, sitemap indexes and text sitemaps.",
  },
  {
    question: "Why did the extractor not find a sitemap?",
    answer:
      "The site may have none, use an unusual address, or block automated requests. Try the exact sitemap URL if you know it.",
  },
  {
    question: "Does the sitemap list every page on the site?",
    answer:
      "Not always. A sitemap lists what the site chose to list. Pages can exist without being in it, and some listed pages may no longer work.",
  },
]
---

<BaseLayout
  title="Free sitemap URL extractor with CSV export"
  description="Find a website’s sitemap and extract every URL from XML sitemaps, sitemap indexes, gzip and text sitemaps. Download the list as CSV or JSON with dates and sources."
  canonicalPath="/tools/sitemap-extractor"
  {breadcrumbs}
>
  <main data-agent-content>
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-foreground-muted">
      <ol class="flex flex-wrap items-center gap-1.5">
        {breadcrumbs.map((crumb, index) => (
          <li class="flex items-center gap-1.5">
            {crumb.href ? (
              <a class="underline decoration-border underline-offset-4 hover:decoration-foreground" href={crumb.href}>
                {crumb.label}
              </a>
            ) : (
              <span class="text-foreground">{crumb.label}</span>
            )}
            {index < breadcrumbs.length - 1 ? <span aria-hidden="true" class="text-border">/</span> : null}
          </li>
        ))}
      </ol>
    </nav>

    <PageHeader
      title="Sitemap URL extractor"
      description="Enter a sitemap URL or domain, follow nested sitemap indexes, then filter and download the extracted URLs with their sitemap metadata."
    />

    <SitemapExtractor />

    <div class="docs-prose mt-16">
      <h2>How to find a website’s sitemap</h2>
      <p>
        Most sites list their sitemap in robots.txt with a{' '}
        <code>Sitemap:</code> line, so that is the first place the extractor
        looks. If there is none, it tries the usual addresses, such as{' '}
        <code>/sitemap.xml</code> and <code>/sitemap_index.xml</code>. Some
        sites use other names, and some have no sitemap at all. When you
        know the address, enter it directly.
      </p>

      <h2>Extract URLs from sitemap files</h2>
      <p>
        The extractor reads XML sitemaps, sitemap indexes, gzip files, and text
        sitemaps. When you enter a domain, it checks robots.txt first and then
        common sitemap locations. It follows linked child sitemaps and shows any
        files it could not read.
      </p>
      <p>
        CSV and JSON downloads retain each URL's source sitemap, nesting depth,
        last modified value, change frequency, priority, hreflang count, and
        image, video, or news entry counts. These are declarations in the
        sitemap. The tool does not request the page or confirm that its metadata
        is accurate.
      </p>

      <h2>Split large sitemap files around 10,000 URLs</h2>
      <p>
        Google accepts up to 50,000 URLs or 50 MB uncompressed in one sitemap.
        This tool flags individual files above 10,000 URL entries because many
        technical SEO teams use that as a practical working size. Smaller files
        can make failures, retries, and Search Console coverage groups easier to
        isolate. The 10,000 URL threshold is a convention, not a Google
        requirement or ranking factor.
      </p>
      <p>
        Read Google's current{' '}
        <a href="https://developers.google.com/search/docs/crawling-indexing/sitemaps/build-sitemap" target="_blank" rel="noreferrer">sitemap size and format documentation</a>
        {' '}for the protocol limits. Barry Adams also explains the 10,000 URL
        working size in his{' '}
        <a href="https://www.polemicdigital.com/perfecting-xml-sitemaps/" target="_blank" rel="noreferrer">technical sitemap guidance</a>.
      </p>

      <h2>Partial results stay visible</h2>
      <p>
        A blocked child sitemap, timeout, invalid XML file, or processing limit
        does not erase the URLs already extracted. The result is marked as
        partial and lists the affected sitemap. Do not treat a partial export as
        the complete URL inventory for the site.
      </p>
      <p>
        Some sites block automated requests even when their sitemap works in a
        normal browser. Entering the exact sitemap URL may help when discovery
        fails, but it cannot bypass the target site's access controls.
      </p>

      <h2>The tool does not crawl extracted pages</h2>
      <p>
        HTTP status codes, canonicals, robots directives, and indexability need
        page requests. Run a{' '}
        <a href="/docs/crawl">technical SEO site crawl</a>
        {' '}with the CLI when you need that evidence.
      </p>
      <CodeBlock value="npm i -g seo && seo start" wrap />

      <h2>What you can do with the URL list</h2>
      <ul>
        <li>Count the pages a site says it has, by section, before an audit or a migration.</li>
        <li>Build a redirect map from the old URL list before you move a site.</li>
        <li>Compare a competitor’s sitemap month to month to see what they publish.</li>
        <li>Find sections that are missing from your own sitemap, or listed twice.</li>
      </ul>
      <p>
        The last modified dates show what a site says it changed and when.
        They are only as honest as the site that writes them.
      </p>

      <h2>Check the extracted URLs with your agent</h2>
      <p>
        A sitemap is a list of what a site claims. To see which of those
        pages work, ask your agent to check them with{' '}
        <a href="/docs/crawl">seo crawl</a>, which can read the sitemap and
        check each URL’s status and redirects without reading every page.
        Ask:
      </p>
      <CodeBlock value="Check every URL in https://example.com/sitemap.xml and list the ones that redirect or return an error" wrap />
      <p>Or add the hosted MCP server to your agent and sign in with Google:</p>
    </div>

    <SetupCommands id="sitemap-extractor-setup" class="mt-6" />

    <div class="docs-prose mt-16">
      <h2>Sitemap extractor questions</h2>
    </div>
    <div class="mt-6">
      <FaqAccordion id="sitemap-extractor-faq" items={faq} />
    </div>
  </main>
</BaseLayout>
