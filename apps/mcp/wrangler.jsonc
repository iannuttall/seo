{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The hosted MCP. D1 keeps only linked Google and Bing sign-ins and
  // research keys, sealed with SEAL_KEY, and how each person signed up.
  // No report data and no logs.
  "name": "seo-mcp",
  "main": "./src/index.ts",
  "account_id": "ab5ec097e2579c5f3639612c755e6f15",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "seoskill.dev/mcp", "zone_name": "seoskill.dev" },
    { "pattern": "seoskill.dev/mcp/*", "zone_name": "seoskill.dev" },
    { "pattern": "seoskill.dev/oauth/*", "zone_name": "seoskill.dev" },
    // /account* also covers /account?query and the site's /account-shell,
    // which only this Worker reads, through the SITE binding.
    { "pattern": "seoskill.dev/account*", "zone_name": "seoskill.dev" },
    {
      "pattern": "seoskill.dev/.well-known/oauth-*",
      "zone_name": "seoskill.dev"
    },
    // The static server card for MCP directories.
    { "pattern": "seoskill.dev/.well-known/mcp/*", "zone_name": "seoskill.dev" }
  ],
  "limits": { "cpu_ms": 60000 },
  // Bundles skills/seo/SKILL.md as text for the skill resource.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "vars": { "PUBLIC_URL": "https://seoskill.dev" },
  // The site Worker, for the account page design (/account-shell).
  "services": [{ "binding": "SITE", "service": "seo-skill" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seo-mcp",
      "database_id": "f75c6bad-c11a-49c0-bcdb-f1a4de1be3bf",
      "migrations_dir": "migrations"
    }
  ],
  // No Workers Logs: the server keeps no logs of requests or user data.
  "observability": { "enabled": false }
  // Secrets: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, SEAL_KEY, AHREFS_DR_KEY,
  // BING_CLIENT_ID, BING_CLIENT_SECRET.
}
