{
  "name": "@seo/hosted-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "beta": "node scripts/beta.mjs",
    "dev": "wrangler dev",
    "signups": "node scripts/signups.mjs",
    "test": "node --test src/*.test.ts",
    "typecheck": "wrangler types src/worker-configuration.d.ts --include-runtime false --env-file .dev.vars.example --check && tsc -p tsconfig.json",
    "types": "wrangler types src/worker-configuration.d.ts --include-runtime false --env-file .dev.vars.example"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@seo/core": "workspace:*",
    "htmlparser2": "10.1.0",
    "robots-parser": "^3.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.152.0"
  }
}
