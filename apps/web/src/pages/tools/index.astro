---
import NavCard from '@/components/NavCard.astro'
import PageHeader from '@/components/PageHeader.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'
import { tools } from '@/content/tools/manifest.mjs'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools' },
]
---

<BaseLayout
  title="Free SEO tools"
  description="Use free SEO tools to check websites, technical files, search traffic, and keyword lists."
  canonicalPath="/tools"
  {breadcrumbs}
  schemaType="CollectionPage"
>
  <main data-agent-content>
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-foreground-muted">
      <ol class="flex flex-wrap items-center gap-1.5">
        {breadcrumbs.map((crumb, index) => (
          <li class="flex items-center gap-1.5">
            {crumb.href ? (
              <a class="underline decoration-border underline-offset-4 hover:decoration-foreground" href={crumb.href}>
                {crumb.label}
              </a>
            ) : (
              <span class="text-foreground">{crumb.label}</span>
            )}
            {index < breadcrumbs.length - 1 ? <span aria-hidden="true" class="text-border">/</span> : null}
          </li>
        ))}
      </ol>
    </nav>

    <PageHeader
      title="Free SEO tools"
      description="Check a website, technical file, or keyword list without creating an account."
      align="left"
    />

    <div class="grid gap-6 sm:grid-cols-2">
      {tools.map((tool) => (
        <NavCard title={tool.action} heading={tool.title} description={tool.description} href={tool.path} />
      ))}
    </div>

    <section class="docs-prose mt-14" aria-labelledby="larger-audits">
      <h2 id="larger-audits">Run larger audits on your machine</h2>
      <p>
        Browser tools are useful for one file or one decision. Use the{' '}
        <a href="/docs/reports">SEO report catalog</a> when the job needs a crawl,
        Search Console, Google Analytics, or outside keyword and result estimates.
        Reports and credentials stay on your machine.
      </p>
    </section>
  </main>
</BaseLayout>
