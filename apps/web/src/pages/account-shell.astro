---
// The account and connect pages of the hosted MCP, in the site design. The
// MCP Worker (apps/mcp) serves this page at /account and /oauth/authorize
// and adds a JSON state block; the script below shows the matching view.
// Opened directly, it sends the visitor to /account.
import FormInput from '@/components/FormInput.astro'
import PageHeader from '@/components/PageHeader.astro'
import { getButtonClasses } from '@/components/ui/button'
import BaseLayout from '@/layouts/BaseLayout.astro'

const primary = getButtonClasses('default')
const outline = getButtonClasses('outline')
const danger = getButtonClasses('destructive')
const quiet = getButtonClasses('link-muted', 'xs')
const panel = 'rounded-lg bg-muted p-6'
const heading = 'text-base font-medium text-foreground'
const note = 'mt-1 text-sm/6 text-foreground-muted'
const description =
  'The Google accounts and API keys your agents use through the hosted MCP server.'
const keys: { name: string; label: string; type: 'text' | 'password' }[] = [
  { name: 'x-dataforseo-login', label: 'DataForSEO API login', type: 'text' },
  {
    name: 'x-dataforseo-password',
    label: 'DataForSEO API password',
    type: 'password',
  },
  { name: 'x-ahrefs-key', label: 'Ahrefs API key', type: 'password' },
]
---

<BaseLayout
  title="Your account"
  description="Manage the Google accounts and API keys your agents use through the hosted SEO Skill MCP server."
  canonicalPath="/account"
  noindex
  analytics={false}
>
  <main class="max-w-2xl" data-account-app>
    <div data-header>
      <PageHeader title="Your account" description={description} />
    </div>
    <p data-message class="mb-6 rounded-lg bg-muted px-4 py-3 text-sm/6 text-foreground" hidden></p>

    <section data-view="loading">
      <p class="text-sm text-foreground-muted">Loading.</p>
    </section>

    <section data-view="connect" hidden>
      <div class={panel}>
        <p class="text-sm/6 text-foreground">
          <strong class="font-medium" data-client></strong> wants to read your
          Search Console and Google Analytics data through SEO Skill. After you
          sign in, Google sends you back to <strong class="font-medium" data-host></strong>.
        </p>
        <p class={note}>
          SEO Skill keeps your Google sign-in, encrypted, so every agent you
          connect can use it. It never keeps your data or reports. You can add
          more Google accounts and API keys on your account page, and
          delete everything there.
        </p>
        <form method="post" data-action="/oauth/google" class="mt-6">
          <input type="hidden" name="flow" data-flow />
          <button type="submit" class={primary}>Continue with Google</button>
        </form>
        <p class="mt-4 text-xs text-foreground-muted">
          Only continue if you started this from your own agent.
        </p>
      </div>
    </section>

    <section data-view="signin" hidden>
      <div class={panel}>
        <p class="text-sm/6 text-foreground">
          Sign in with any Google account you connected to SEO Skill.
        </p>
        <p class={note}>
          A Google account that is not connected yet gets its own new account.
        </p>
        <form method="post" data-action="/account/signin" class="mt-6">
          <button type="submit" class={primary}>Sign in with Google</button>
        </form>
      </div>
    </section>

    <section data-view="notice" hidden>
      <div class={panel}>
        <p class="text-sm/6 text-foreground" data-notice-text></p>
        <a href="/account" data-href="/account" class:list={[outline, 'mt-6']}>Go to your account</a>
      </div>
    </section>

    <section data-view="account" hidden>
      <div class="flex flex-col gap-4">
        <div class={panel}>
          <h2 class={heading}>Google accounts</h2>
          <p class={note}>Each report uses the account that can read the site.</p>
          <ul class="mt-4 divide-y divide-border text-sm" data-google-list></ul>
          <form method="post" data-action="/account/google" class="mt-4">
            <input type="hidden" name="form" />
            <button type="submit" class={outline}>Add a Google account</button>
          </form>
        </div>

        <div class={panel} data-bing-panel>
          <h2 class={heading}>Bing Webmaster Tools</h2>
          <p class={note}>
            Adds Bing clicks, impressions, queries and pages beside Search
            Console. Each report uses the Bing account that has the site.
          </p>
          <ul class="mt-4 divide-y divide-border text-sm" data-bing-list></ul>
          <form method="post" data-action="/account/bing" class="mt-4" data-bing-add>
            <input type="hidden" name="form" />
            <button type="submit" class={outline} data-bing-button>Connect Bing</button>
          </form>
        </div>

        <div class={panel}>
          <h2 class={heading}>API keys</h2>
          <p class={note}>
            For keyword, SERP, competitor and backlink data from your own
            DataForSEO or Ahrefs account. Each request uses your credits there.
            Saved keys are encrypted and never shown again.
          </p>
          <form method="post" data-action="/account/keys" class="mt-4 flex flex-col gap-4">
            <input type="hidden" name="form" />
            {
              keys.map((key) => (
                <label class="flex flex-col gap-1.5 text-sm font-medium text-foreground">
                  <span>
                    {key.label}{' '}
                    <span class="font-normal text-primary" data-saved={key.name} hidden>
                      saved
                    </span>
                  </span>
                  <FormInput
                    name={key.name}
                    type={key.type}
                    autocomplete="off"
                    spellcheck="false"
                    data-key-input={key.name}
                  />
                </label>
              ))
            }
            <div class="flex flex-wrap gap-3">
              <button type="submit" class={primary}>Save keys</button>
            </div>
          </form>
          <form method="post" data-action="/account/keys/remove" class="mt-3" data-keys-remove hidden>
            <input type="hidden" name="form" />
            <button type="submit" class={quiet}>Remove all keys</button>
          </form>
        </div>

        <div class={panel}>
          <h2 class={heading}>Delete everything</h2>
          <p class={note}>
            Removes your Google and Bing sign-ins and keys from SEO Skill and
            revokes the Google sign-ins. Your agents will ask you to sign in
            again.
          </p>
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <form method="post" data-action="/account/delete">
              <input type="hidden" name="form" />
              <button type="submit" class={danger}>Delete everything</button>
            </form>
            <form method="post" data-action="/account/signout">
              <input type="hidden" name="form" />
              <button type="submit" class={outline}>Sign out</button>
            </form>
          </div>
        </div>
      </div>
    </section>

    <template data-account-row>
      <li class="flex items-center justify-between gap-4 py-2.5">
        <span class="min-w-0 break-all text-foreground" data-email></span>
        <form method="post" data-action="/account/remove" data-remove>
          <input type="hidden" name="form" />
          <input type="hidden" name="provider" data-provider />
          <input type="hidden" name="subject" data-subject />
          <button type="submit" class={quiet}>Remove</button>
        </form>
      </li>
    </template>
  </main>
</BaseLayout>

<script>
  type State = {
    view: 'connect' | 'signin' | 'account' | 'notice'
    base?: string
    message?: string
    connect?: { client: string; host: string; flow: string }
    notice?: { title: string; text: string }
    account?: {
      form: string
      google: { email: string; subject: string }[]
      bing: { label: string; subject: string }[]
      bingReady: boolean
      keys: string[]
    }
  }

  const root = document.querySelector<HTMLElement>('[data-account-app]')
  const raw = document.getElementById('seo-state')?.textContent
  if (!raw) {
    window.location.replace('/account')
  } else if (root) {
    const state = JSON.parse(raw) as State
    const base = state.base ?? ''
    const all = <T extends Element>(selector: string) =>
      Array.from(root.querySelectorAll<T>(selector))
    const show = (element: Element | null, visible = true) =>
      element?.toggleAttribute('hidden', !visible)

    // The account rows come first so their forms get actions below.
    const account = state.account
    if (account) {
      const row = root.querySelector<HTMLTemplateElement>('[data-account-row]')
      const fill = (
        list: Element | null,
        provider: 'google' | 'bing',
        items: { label: string; subject: string }[],
        removable: boolean,
      ) => {
        for (const item of items) {
          const copy = row?.content.cloneNode(true) as DocumentFragment
          const label = copy.querySelector('[data-email]')
          if (label) label.textContent = item.label
          const kind = copy.querySelector<HTMLInputElement>('[data-provider]')
          if (kind) kind.value = provider
          const subject = copy.querySelector<HTMLInputElement>('[data-subject]')
          if (subject) subject.value = item.subject
          if (!removable) copy.querySelector('[data-remove]')?.remove()
          list?.append(copy)
        }
      }
      fill(
        root.querySelector('[data-google-list]'),
        'google',
        account.google.map((item) => ({ label: item.email, subject: item.subject })),
        account.google.length > 1,
      )
      fill(root.querySelector('[data-bing-list]'), 'bing', account.bing, true)
      const bingButton = root.querySelector('[data-bing-button]')
      if (bingButton && account.bing.length) bingButton.textContent = 'Add a Bing account'
      show(root.querySelector('[data-bing-add]'), account.bingReady)
      // Hidden while the hosted server has no Bing.
      show(
        root.querySelector('[data-bing-panel]'),
        account.bingReady || account.bing.length > 0,
      )
      for (const name of account.keys) {
        show(root.querySelector(`[data-saved="${name}"]`))
        const input = root.querySelector<HTMLInputElement>(`[data-key-input="${name}"]`)
        if (input) input.placeholder = 'Leave empty to keep the saved key'
      }
      show(root.querySelector('[data-keys-remove]'), account.keys.length > 0)
      for (const input of all<HTMLInputElement>('input[name="form"]')) {
        input.value = account.form
      }
    }

    const connect = state.connect
    if (connect) {
      const client = root.querySelector('[data-client]')
      if (client) client.textContent = connect.client
      const host = root.querySelector('[data-host]')
      if (host) host.textContent = connect.host
      const flow = root.querySelector<HTMLInputElement>('[data-flow]')
      if (flow) flow.value = connect.flow
    }

    // One page header: its title and description follow the view.
    const title = root.querySelector('[data-header] h1')
    const lead = root.querySelector('[data-header] p')
    if (state.view === 'connect' && title) title.textContent = 'Connect SEO Skill'
    if (state.notice) {
      if (title) title.textContent = state.notice.title
      const text = root.querySelector('[data-notice-text]')
      if (text) text.textContent = state.notice.text
    }
    show(lead, state.view === 'signin' || state.view === 'account')

    for (const form of all<HTMLFormElement>('form[data-action]')) {
      form.action = `${base}${form.dataset.action}`
    }
    for (const link of all<HTMLAnchorElement>('a[data-href]')) {
      link.href = `${base}${link.dataset.href}`
    }

    const message = root.querySelector('[data-message]')
    if (message && state.message) {
      message.textContent = state.message
      show(message)
    }
    for (const view of all('[data-view]')) {
      show(view, view.getAttribute('data-view') === state.view)
    }
  }
</script>
