---
import { GitCompareIcon, Robot02Icon, Route01Icon, ViewOffIcon } from '@hugeicons/core-free-icons'
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import FounderBadge from '@/components/FounderBadge.astro'
import HomeCard from '@/components/HomeCard.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SetupPrompts from '@/components/SetupPrompts.astro'
import SplitList from '@/components/SplitList.astro'
import MigrationChecklist, { type ChecklistPhase } from '@/components/tools/MigrationChecklist.astro'
import RedirectMapChecker from '@/components/tools/RedirectMapChecker.astro'
import { getButtonClasses } from '@/components/ui/button'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: 'SEO migration checklist' },
]

const phases: ChecklistPhase[] = [
  {
    id: 'before-launch',
    title: 'Before launch',
    when: 'Start four to eight weeks out. Most migrations that lose traffic lose it here.',
    items: [
      { id: 'one-change', title: 'Change one thing at a time', detail: 'Move the domain, then redesign, not both on the same day. Google asks for this, and when traffic drops you will know which change caused it.' },
      { id: 'list-urls', title: 'List every old URL that matters', detail: 'Start with the pages that get clicks in Search Console, then add the sitemap, pages with backlinks and URLs from server logs. Include PDFs and images that rank or get linked.' },
      { id: 'baseline', title: 'Save a baseline', detail: 'Export Search Console clicks and impressions by page and query for the last 16 months, and crawl the old site. After launch, every comparison starts from this.' },
      { id: 'map', title: 'Map each old URL to its closest new page', detail: 'One old URL to one new URL with the same content. Content you are dropping should return 404 or 410, not redirect to the homepage.' },
      { id: 'check-map', title: 'Check the map for chains, loops and homepage redirects', detail: 'Paste it into the <a href="#redirect-map-checker-heading">redirect map checker</a> below. It finds problems in the map itself before anything is live.' },
      { id: 'keep-content', title: 'Keep titles, headings and content on moved pages', detail: 'Unless changing them is the point of the project. Every difference gives Google one more thing to reassess.' },
      { id: 'staging', title: 'Crawl the staging site', detail: 'Check for broken internal links, missing titles and canonicals that point at the old domain. Keep staging out of Google with a password, not just robots.txt.' },
      { id: 'ttl', title: 'Lower the DNS TTL a week before a hosting move', detail: 'Google suggests a few hours, so the switch reaches everyone quickly on launch day.' },
    ],
  },
  {
    id: 'launch-day',
    title: 'Launch day',
    when: 'Allow a full working day, with someone who can change server rules on hand.',
    items: [
      { id: 'remove-blocks', title: 'Remove the staging noindex and robots.txt block', detail: 'This is the most common launch mistake, and it can take a whole site out of Google. Run the homepage and a few templates through the <a href="/tools/noindex-checker">noindex checker</a>.' },
      { id: 'redirects-live', title: 'Put the redirects live as 301 or 308', detail: 'Server-side and permanent. A 302 or 307 tells Google the move is temporary, so it may keep the old URL indexed.' },
      { id: 'run-checker', title: 'Run the redirect map checker against the live site', detail: 'Every row should take one hop to the right page, and that page should return 200 and be indexable.' },
      { id: 'canonicals', title: 'Point canonicals, hreflang and internal links at the new URLs', detail: 'Each new page needs a self-referencing canonical. Internal links that go through a redirect waste a hop on every crawl.' },
      { id: 'robots', title: 'Check robots.txt on the new site', detail: 'Use the <a href="/tools/robots-txt-validator">robots.txt validator</a> on the new domain. Leave the old domain\'s robots.txt open so Google can follow its redirects.' },
      { id: 'sitemaps', title: 'Submit the new sitemap and keep the old one for a while', detail: 'The old sitemap helps Google find the redirects sooner. Search Console warnings about redirecting URLs in it are expected.' },
      { id: 'change-address', title: 'Use the Change of Address tool for a domain move', detail: 'In the old domain\'s Search Console property. It is only for moving domains. It does not cover http to https or a path change.' },
    ],
  },
  {
    id: 'after-launch',
    title: 'After launch',
    when: 'Watch daily for the first week, then weekly for three months.',
    items: [
      { id: 'compare', title: 'Compare clicks before and after the launch date', detail: 'By page and by query, in equal periods, so a drop points at the pages that lost it. <code>seo compare --date</code> does this from Search Console.' },
      { id: 'errors', title: 'Fix new 404s and soft 404s', detail: 'Check the Pages report in Search Console and crawl the new site. Old URLs you missed in the map show up here first.' },
      { id: 'backlinks', title: 'Update your best backlinks', detail: 'Ask the sites that send the most links or traffic to point at the new URL. The redirect works without it, but a direct link is one hop less.' },
      { id: 'keep-redirects', title: 'Keep the redirects for at least a year', detail: 'Google says at least one year and suggests keeping them for good. Keep paying for the old domain too.' },
      { id: 'weekly', title: 'Set a weekly check until traffic settles', detail: 'The same comparison and the same redirect check each week, so a regression after a later deploy gets caught.' },
    ],
  },
]

const recovery = [
  { title: '22.8% recovered within 90 days', text: 'Of the 1,052 domain migrations SALT.agency tracked, 22.8% had recovered their traffic after 90 days.' },
  { title: '59.5% recovered within a year', text: 'After a year, 59.5% had recovered.' },
  { title: 'The median took 304 days', text: 'That is how long the median domain migration took to recover.' },
  { title: 'A redesign that keeps its URLs usually does better', text: 'Those numbers come from third-party traffic estimates of domain moves.' },
]

const mapFlags = [
  { title: 'Old URLs listed twice' },
  { title: 'Rows that point at another old URL' },
  { title: 'Three or more pages sent to one place' },
  { title: 'Pages sent to the homepage' },
]

const googleRules = [
  { title: 'Permanent redirects keep link value', text: '\u201c301 and other permanent redirects don\u2019t cause a loss in PageRank.\u201d' },
  { title: 'Redirect straight to the final URL', text: '\u201cWhile Googlebot can follow up to 10 hops ... we advise redirecting to the final destination directly. If this is not possible, keep the number of redirects in the chain low, ideally no more than 3 and fewer than 5.\u201d' },
  { title: 'Don\u2019t send old URLs to the homepage', text: '\u201cDon\u2019t redirect many old URLs to one irrelevant single URL destination, such as the home page of the new site. This can confuse users and might be treated as a soft 404 error.\u201d' },
  { title: 'Keep redirects for at least a year', text: '\u201cKeep the redirects for as long as possible, generally at least 1 year.\u201d' },
  { title: 'Check that the new URLs exist', text: 'The most common mistake, in Google\u2019s words: \u201cWe frequently see people redirecting to the wrong (non-existent) URLs on the new site.\u201d' },
]

const baseline = [
  { title: 'Pull every page with clicks', text: 'With SEO Skill your agent pulls every page with clicks from Search Console for the last 16 months, before you touch anything.' },
  { title: 'Save the list as your baseline', text: 'The top of it is the part of the redirect map you cannot afford to get wrong.' },
  { title: 'Trace the whole map after launch', text: 'From your own machine, up to 1,000 rows at a time. Each line is an old URL and the new URL it should land on, the same file you paste into the checker above.' },
]

const drops = [
  { title: 'A drop spread evenly across the site in week one', text: 'Google is moving URLs.' },
  { title: 'A drop concentrated on one folder or template', text: 'A redirect, noindex or canonical problem on those pages, and it will not fix itself.' },
]

const weekly = [
  { title: 'Compare against the launch date', text: 'Your agent runs the same comparison each week for the first three months.' },
  { title: 'Trace the top old URLs again', text: 'The same redirect check each week, against the same map.' },
  { title: 'Hear only what changed', text: 'A later deploy that breaks a redirect rule gets caught in days instead of at the next quarterly review.' },
]

const tools = [
  { title: 'Redirect checker', text: 'See every hop for a single URL, with its status codes and the page it ends on.', href: '/tools/redirect-checker', icon: Route01Icon, link: 'Trace a redirect' },
  { title: 'Noindex checker', text: 'Make sure the staging noindex is gone from the homepage and each template.', href: '/tools/noindex-checker', icon: ViewOffIcon, link: 'Check noindex' },
  { title: 'robots.txt validator', text: 'Test robots.txt on the new domain, and check the old one still lets Google follow its redirects.', href: '/tools/robots-txt-validator', icon: Robot02Icon, link: 'Check robots.txt' },
  { title: 'Compare report', text: 'Search Console before and after the launch date, with the pages and queries that moved most.', href: '/docs/compare', icon: GitCompareIcon, link: 'Compare report docs' },
]

const faq = [
  {
    question: 'How long does an SEO migration take to recover?',
    answer:
      'For a domain move, longer than most guides say. SALT.agency tracked 1,052 domain migrations in June 2026: 22.8% recovered traffic within 90 days, 59.5% within a year, and the median took 304 days. Those are third-party traffic estimates for domain moves, so a redesign on the same domain usually settles faster.',
  },
  {
    question: 'Should I use 301 or 302 redirects for a site migration?',
    answer:
      'Use 301 or 308. Google treats them as a strong signal that the new URL is the one to index. A 302 or 307 is a weak signal, so Google may keep showing the old URL.',
  },
  {
    question: 'Can I redirect old pages to the homepage?',
    answer:
      'Only if the homepage really replaces them. Google says redirecting many old URLs to one irrelevant page such as the homepage might be treated as a soft 404. Redirect each page to its closest match, and let pages with no replacement return 404 or 410.',
  },
  {
    question: 'How many redirects in a chain is too many?',
    answer:
      'Googlebot follows up to 10 hops, but Google advises redirecting straight to the final URL, and if you cannot, keeping chains to no more than 3 and fewer than 5. One hop is the target.',
  },
  {
    question: 'How long should I keep redirects after a migration?',
    answer:
      'At least a year, and for good if you can. Google needs to recrawl every old URL to move it, and backlinks to the old URLs keep working only while the redirects do.',
  },
  {
    question: 'Is a drop in traffic after a migration normal?',
    answer:
      "Some movement is. Google says visibility may fluctuate during a move and that a small to medium site can take a few weeks for most pages to move. A drop concentrated on certain pages or templates is not normal: check those pages' redirects, status and noindex first.",
  },
  {
    question: 'Does the redirect map checker follow redirects like Google?',
    answer:
      'It follows server redirects hop by hop from this site, up to 10, the same limit Google documents. It does not run JavaScript redirects. A server that blocks unknown bots may answer it differently from Googlebot, and the result says so when that happens.',
  },
]
---

<BaseLayout
  title="SEO migration checklist with a redirect checker"
  description="A site migration checklist for before, during and after launch, with a free redirect checker that flags chains, loops, 404s and homepage redirects."
  canonicalPath="/tools/seo-migration-checklist"
  {breadcrumbs}
  framed={false}
>
  <main data-agent-content>
    <section class="pt-4">
      <div class="site-frame flex flex-col items-center pt-14 text-center sm:pt-20">
        <FounderBadge prefix="Written by AI and" ai />
        <h1 class="mt-4 max-w-3xl text-pretty text-4xl/tight font-medium -tracking-[0.8px] xl:text-5xl/tight xl:-tracking-[1px]">
          SEO migration checklist
        </h1>
        <p class="mt-4 max-w-2xl text-pretty text-xl/8 font-medium -tracking-[0.2px] text-foreground-muted">
          Twenty checks for moving a site without losing search traffic, in
          the order you do them, with a redirect map checker that tests every
          old URL against the live site.
        </p>
      </div>
      <div class="site-frame mt-10 sm:mt-12">
        <h2 class="sr-only">Work through the migration before, on and after launch day</h2>
        <MigrationChecklist {phases} storageKey="seo:migration-checklist" />
      </div>
    </section>

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      <SplitList
        id="recovery-heading"
        title="How long does traffic take to recover after a site migration?"
        text="Longer than the people running it expect. SALT.agency tracked 1,052 domain migrations and published the results in June 2026. The slow ones share a pattern: old URLs that redirect to the wrong place, through a chain, to the homepage or to nothing. So this checklist has a redirect checker built in. Tick the steps as you go (ticks stay in this browser), and run your redirect map through the checker before and after launch."
        items={recovery}
      />

      <section class="site-frame" aria-labelledby="redirect-map-checker-heading">
        <SectionHeading
          id="redirect-map-checker-heading"
          title="How do you check a redirect map before and after launch?"
          text="Paste old and new URL pairs, or upload the CSV from your mapping spreadsheet. The checker reads the map itself first, then traces each old URL on the live site, hop by hop, and checks where it lands."
        />
        <RedirectMapChecker />
      </section>

      <SplitList
        id="map-flags-heading"
        title="Which problems does the checker find in the map itself?"
        text="Four, and it flags them before it traces anything, so you can fix the map before anything is live."
        items={mapFlags}
      />

      <section class="site-frame" aria-labelledby="results-heading">
        <SectionHeading
          id="results-heading"
          title="What does each redirect result mean?"
          text="Each row of the map gets one of six results, and each has its own fix. Only one hop to the right page needs nothing."
        />
        <div class="docs-prose max-w-4xl">
          <table>
            <thead>
              <tr>
                <th>Result</th>
                <th>What happened</th>
                <th>Fix</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>One hop, right page</td>
                <td>A single permanent redirect to the URL in your map, which returns 200 and can be indexed.</td>
                <td>Nothing.</td>
              </tr>
              <tr>
                <td>Chain</td>
                <td>Two or more hops, often http to https, then a trailing slash, then the new page.</td>
                <td>Point the old URL straight at the final URL. Map to the exact final form, slash and all.</td>
              </tr>
              <tr>
                <td>Wrong page</td>
                <td>It lands somewhere other than your map says. Often a catch-all rule that runs before the specific one.</td>
                <td>Check the order of the server rules. Specific rules go first.</td>
              </tr>
              <tr>
                <td>No redirect</td>
                <td>The old URL still loads, or returns 404.</td>
                <td>Add the rule. A 404 on an old URL with links or traffic is lost value.</td>
              </tr>
              <tr>
                <td>Loop or too many hops</td>
                <td>The redirects never reach a page, or take more than 10 hops.</td>
                <td>Find the two rules that point at each other and replace both with one.</td>
              </tr>
              <tr>
                <td>Lands on a 404, noindex or another canonical</td>
                <td>The redirect works but the new page cannot rank.</td>
                <td>Fix the new page. A redirect only passes signals to a page Google can index.</td>
              </tr>
            </tbody>
          </table>
          <p>
            To see every hop for a single URL, with its status codes, use the{' '}
            <a href="/tools/redirect-checker">redirect checker</a>.
          </p>
        </div>
      </section>

      <SplitList
        id="google-rules-heading"
        title="What does Google say about redirects in a site move?"
        text="That permanent redirects keep their link value and should go straight to the final page. Every number in the checker comes from Google's site move guide and its redirects guide, quoted here in Google's own words."
        items={googleRules}
      >
        <div class="mt-6 flex flex-wrap gap-2">
          <a
            class={getButtonClasses('secondary', 'lg')}
            href="https://developers.google.com/search/docs/crawling-indexing/site-move-with-url-changes"
            target="_blank"
            rel="noreferrer">Read Google's site move guide</a
          >{' '}
          <a
            class={getButtonClasses('secondary', 'lg')}
            href="https://developers.google.com/search/docs/crawling-indexing/301-redirects"
            target="_blank"
            rel="noreferrer">Read Google's redirects guide</a
          >
        </div>
      </SplitList>

      <SplitList
        id="baseline-heading"
        title="How do you find the old URLs that matter?"
        text="Start from the pages Google sends visitors to, in Search Console. A redirect map built from the new site's sitemap misses the old URLs that earn traffic, so build it the other way round."
        items={baseline}
      >
        <div class="mt-6">
          <CodeBlock
            label="Ask your agent"
            prompt
            value="Pull every page on example.com with Search Console clicks in the last 16 months and save the list as my migration baseline"
            wrap
          />
          <CodeBlock
            label="After launch, trace the map"
            prompt
            value="Trace every row of redirects.csv with seo redirect-trace and list each chain, loop, error and temporary redirect"
            wrap
          />
        </div>
      </SplitList>

      <SplitList
        id="compare-heading"
        title="Which pages lost clicks after the launch?"
        text="The compare report shows them. It takes the launch date and splits Search Console into equal periods before and after it, with the pages and queries that moved most. Where the drop sits tells you what kind it is."
        items={drops}
      >
        <div class="mt-6">
          <CodeBlock
            label="Ask your agent"
            prompt
            value="Compare example.com before and after 2026-11-02 and show the pages and queries that lost the most clicks"
            wrap
          />
        </div>
      </SplitList>

      <SplitList
        id="weekly-heading"
        title="Should you run the migration checks every week?"
        text="Yes, for the first three months. This is one of the few SEO jobs where a scheduled task pays for the setup."
        items={weekly}
      >
        <div class="mt-6">
          <CodeBlock
            label="Ask your agent"
            prompt
            value="Every Monday until February, compare example.com before and after 2026-11-02, run seo redirect-trace --map redirects.csv, and tell me only what got worse"
            wrap
          />
        </div>
      </SplitList>

      <section class="site-frame" aria-labelledby="tools-heading">
        <SectionHeading
          id="tools-heading"
          title="Which tools go with a migration check?"
          text="These, which cover one URL's redirects, the robots rules on the new site and what Search Console shows after launch."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {tools.map((item) => <HomeCard {...item} />)}
        </div>
      </section>

      <section class="site-frame" aria-labelledby="faq-heading">
        <div class="max-w-2xl">
          <h2 id="faq-heading" class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            SEO migration questions
          </h2>
        </div>
        <div class="mt-10">
          <FaqAccordion items={faq} id="migration-faq" />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="start-heading">
        <SectionHeading
          id="start-heading"
          title="Watch a migration week by week with your agent"
          text="Add SEO Skill to your agent and sign in with the Google account that can read your Search Console. Setup installs the CLI and adds the hosted MCP server, so your agent can compare the launch date and trace the map."
        />
        <SetupPrompts id="migration-setup" />
      </section>
    </div>
  </main>
</BaseLayout>
