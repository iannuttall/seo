---
import {
  BookOpen01Icon,
  CheckListIcon,
  QuillWrite01Icon,
  TextCheckIcon,
} from '@hugeicons/core-free-icons'
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import FounderBadge from '@/components/FounderBadge.astro'
import HomeCard from '@/components/HomeCard.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SetupPrompts from '@/components/SetupPrompts.astro'
import SplitList from '@/components/SplitList.astro'
import AiHumanizer from '@/components/tools/AiHumanizer.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: 'AI humanizer' },
]

const facts = [
  {
    title: 'A plain rewrite prompt adds claims',
    text: 'Ask a model to make a draft sound human and it adds what a human would have written: a story, a customer name, a reason, a number. In the same test, a plain “make it sound like a person wrote it” prompt added 54 claims the drafts never made.',
  },
  { title: 'The fixes never ask for something new', text: 'Each one works with what the draft already says.' },
  { title: 'Sales words', text: 'A sales word gets a plainer swap or a cut.' },
  { title: 'Inflated significance', text: 'It gets cut, or replaced with a fact the text already states.' },
  {
    title: 'A fix that needs a fact you do not have',
    text: 'Delete the phrase. The draft is usually better for it.',
  },
]

const rewrite = [
  { title: 'Start with the lines marked as a fix', text: 'Most drafts need a handful of edits, and doing them by hand takes a few minutes.' },
  { title: 'Then read each line marked as your call', text: 'Change it only if it fails the question.' },
  {
    title: 'Hand the job to a chat assistant',
    text: 'Use Copy rewrite prompt. It asks the model to make each marked line clearer and more direct, to leave other lines alone, and to add no new names, numbers, dates or quotes.',
  },
  { title: 'Paste the result back here', text: 'Check it again.' },
]

const tools = [
  { title: 'SEO content checker', text: 'Check a post’s headings and copy, with a fix for each problem.', href: '/tools/seo-content-checker', icon: TextCheckIcon, link: 'Check your content' },
  { title: 'Title and meta description checker', text: 'Check a title and meta description in pixels, with the Google preview.', href: '/tools/title-and-meta-description-checker', icon: QuillWrite01Icon, link: 'Check a title' },
  { title: 'seo lint', text: 'The same AI pattern rules for files in your project, with presets for posts, landing pages and meta descriptions.', href: '/docs/lint', icon: CheckListIcon, link: 'seo lint docs' },
  { title: 'Build your own humanizer skill', text: 'Each of the 8 patterns turned into a check and a rewrite rule for your agent.', href: '/blog/humanizer-skill', icon: BookOpen01Icon, link: 'Read the post' },
]

const faq = [
  {
    question: 'What does an AI humanizer do?',
    answer:
      "This one makes AI-assisted writing clear and direct for the person reading it. It finds the sentence patterns that get in the reader's way, such as padded lists of three, drama nobody needs and closing lines that repeat the point, and shows how to fix each one with the facts already in your text.",
  },
  {
    question: 'Will this get my text past an AI detector?',
    answer:
      'That is not what it is for, and it makes no promise about detector scores. It is for the reader. Every fix makes a sentence plainer or shorter, so the point arrives sooner.',
  },
  {
    question: 'Is my text sent anywhere?',
    answer:
      'No. The check runs in your browser with the same rules as seo lint. Nothing you paste leaves the tab, and there is no account or daily limit.',
  },
  {
    question: 'Why does it not rewrite the text for me?',
    answer:
      'A rewrite that only asks for a human voice tends to invent one: an experience, a name, a reason or a number the draft never had. The tool lists each line and its fix instead. Copy the rewrite prompt to give the same list to ChatGPT, Claude or Gemini, asking for clearer, more direct sentences that keep to facts already in your text.',
  },
  {
    question: 'What is the difference between a fix and your call?',
    answer:
      'A fix is a pattern that almost always reads as AI, such as "It isn\'t X, it\'s Y". Your call is a line a pattern can find but only a reader can judge, such as three short sentences in a row. Change it only when it fails the question beside it.',
  },
  {
    question: 'Does it work on writing that is not from ChatGPT?',
    answer:
      "Yes. The rules look for sentence patterns, not one model's fingerprint, and Wikipedia's editors list the same patterns in their guide to signs of AI writing. Five texts written before ChatGPT came out got no AI pattern errors from these rules.",
  },
  {
    question: 'Can I run the same checks on files in my project?',
    answer:
      'Yes. Ask your agent to run seo lint on any Markdown, MDX, HTML or Astro file and fix every line until the check comes back clean. The setup prompt installs the CLI it uses.',
  },
]
---

<BaseLayout
  title="Free AI humanizer that keeps your facts"
  description="Paste a draft to find the AI writing patterns that get in the reader's way, each with a clearer fix that uses only your facts. Free, in your browser."
  canonicalPath="/tools/ai-humanizer"
  {breadcrumbs}
  framed={false}
>
  <main data-agent-content>
    <section class="pt-4">
      <div class="site-frame flex flex-col items-center pt-14 text-center sm:pt-20">
        <FounderBadge prefix="Written by AI and" ai />
        <h1 class="mt-4 max-w-3xl text-pretty text-4xl/tight font-medium -tracking-[0.8px] xl:text-5xl/tight xl:-tracking-[1px]">
          AI humanizer
        </h1>
        <p class="mt-4 max-w-2xl text-pretty text-xl/8 font-medium -tracking-[0.2px] text-foreground-muted">
          Make AI-assisted writing clear and direct for your reader. Paste a
          draft to find the patterns that get in the way, each marked in your
          text with a fix that keeps to the facts you already wrote.
        </p>
      </div>
      <div class="site-frame mt-10 sm:mt-12">
        <AiHumanizer />
      </div>
    </section>

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      <section class="site-frame" aria-labelledby="patterns-heading">
        <SectionHeading
          id="patterns-heading"
          title="Which sentence patterns give AI drafts away?"
          text="Eight of them account for most. A blind judge read 24 drafts written by Claude and counted 212 AI writing tells, and 187 of them came from these 8 patterns."
        />
        <div class="docs-prose max-w-4xl">
          <table>
            <thead>
              <tr>
                <th>Tell</th>
                <th>An example from the drafts</th>
                <th>Tells counted</th>
              </tr>
            </thead>
            <tbody>
              <!-- seo-lint-ignore -->
              <tr><td>Forced triads</td><td>It is cheap, it is reversible, and it produces evidence rather than opinions.</td><td>63</td></tr>
              <!-- seo-lint-ignore -->
              <tr><td>Not X but Y</td><td>Four Days Is Not a Perk. It's a Strategy.</td><td>27</td></tr>
              <!-- seo-lint-ignore -->
              <tr><td>Bold labels on list items</td><td><strong>Better forecasts.</strong> We're investing in improved wave and tide modeling.</td><td>27</td></tr>
              <!-- seo-lint-ignore -->
              <tr><td>One-line closers and fragments</td><td>$299 per month. That's it.</td><td>26</td></tr>
              <!-- seo-lint-ignore -->
              <tr><td>Comment tails ending in -ing</td><td>Chair utilization improved dramatically, allowing the practice to serve 15% more patients without extending hours.</td><td>14</td></tr>
              <!-- seo-lint-ignore -->
              <tr><td>Inflated significance</td><td>I haven't experienced any hot spots or blisters across all those miles, a testament to the thoughtful design.</td><td>12</td></tr>
              <!-- seo-lint-ignore -->
              <tr><td>Sales words</td><td>Fiddle-leaf figs are stunning houseplants that require periodic repotting.</td><td>9</td></tr>
              <!-- seo-lint-ignore -->
              <tr><td>Arguing with no one</td><td>It isn't perfect. The tongue is slightly thin and can shift if you don't lace carefully.</td><td>9</td></tr>
            </tbody>
          </table>
          <p>
            Overused words such as "delve" and "testament" made up only 4, so a
            word list on its own misses most of what readers notice.{' '}
            <a href="/blog/humanizer-skill">How to build your own humanizer skill</a>
            {' '}turns each pattern into a check and a rewrite rule for your
            agent.
          </p>
          <p>
            The humanizer files each line it marks under one of these, and puts
            the rest (dashes, emoji, stock openers, chatbot leftovers) under
            other AI patterns. Counts are the mean of three judge runs, rounded.
          </p>
        </div>
      </section>

      <SplitList
        id="facts-heading"
        title="Does every fix keep to the facts in your text?"
        text="Yes. Every fix works from what your draft already says, because a model asked to sound human tends to invent the details a human would have added."
        items={facts}
      />

      <SplitList
        id="rewrite-heading"
        title="How do you rewrite the marked lines?"
        text="By hand or with your AI. Start with the fixes, then judge the lines marked as your call."
        items={rewrite}
      />

      <SplitList
        id="agent-heading"
        title="How do you run the same checks in your agent?"
        text="Ask it to run seo lint, once SEO Skill is set up. This page runs the AI pattern rules from seo lint, the writing check in the SEO Skill CLI, so your agent can run it on a draft, fix each finding and check again until nothing is left."
        items={[
          {
            title: 'Presets for posts, landing pages and meta descriptions',
            text: 'The seo lint docs cover them, and how to keep a flagged line on purpose.',
            href: '/docs/lint',
          },
          {
            title: 'The research behind the patterns',
            text: 'What AI slop is and how to remove it explains it.',
            href: '/blog/ai-slop',
          },
        ]}
      >
        <div class="mt-6">
          <CodeBlock
            label="Ask your agent"
            prompt
            value="Check drafts/launch-post.md with seo lint and fix every error and warning. Use only facts already in the text. Run seo lint again until it reports 0 errors and 0 warnings."
            wrap
          />
        </div>
      </SplitList>

      <section class="site-frame" aria-labelledby="tools-heading">
        <SectionHeading
          id="tools-heading"
          title="Which tools go with an AI writing check?"
          text="These, which check the rest of a page's copy, its title and the files in your project."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {tools.map((item) => <HomeCard {...item} />)}
        </div>
      </section>

      <section class="site-frame" aria-labelledby="faq-heading">
        <div class="max-w-2xl">
          <h2 id="faq-heading" class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            AI humanizer questions
          </h2>
        </div>
        <div class="mt-10">
          <FaqAccordion items={faq} id="ai-humanizer-faq" />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="start-heading">
        <SectionHeading
          id="start-heading"
          title="Check every draft with your agent"
          text="Add SEO Skill to your agent. The prompt installs the CLI that runs seo lint, so your agent can fix a draft and check it again until it comes back clean."
        />
        <SetupPrompts id="ai-humanizer-setup" />
      </section>
    </div>
  </main>
</BaseLayout>
