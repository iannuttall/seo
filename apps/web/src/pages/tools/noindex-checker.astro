---
import { Alert02Icon, Robot02Icon, Route01Icon, WebValidationIcon } from '@hugeicons/core-free-icons'
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import FounderBadge from '@/components/FounderBadge.astro'
import HomeCard from '@/components/HomeCard.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SetupPrompts from '@/components/SetupPrompts.astro'
import SplitList from '@/components/SplitList.astro'
import NoindexChecker from '@/components/tools/NoindexChecker.astro'
import { getButtonClasses } from '@/components/ui/button'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: 'Noindex checker' },
]

const blocked = [
  { title: 'Google never sees the noindex', text: 'Google\u2019s noindex documentation says the page \u201cmust not be blocked by a robots.txt file\u201d, because a crawler that cannot fetch the page \u201cwill never see the noindex rule, and the page can still appear in search results\u201d.' },
  { title: 'Search Console calls it Indexed, though blocked by robots.txt', text: 'This is the mistake that keeps pages in Google after someone tries to remove them.' },
  { title: 'Allow crawling first', text: 'The fix runs in an order that feels backwards. Let Google crawl the page and see the noindex.' },
  { title: 'Block it only once it has dropped', text: 'After Google drops the page, block it in robots.txt if you still want to save crawling.' },
]

const sources = [
  { title: 'WordPress', text: 'Settings, then Reading, then \u201cDiscourage search engines from indexing this site\u201d. It prints noindex, nofollow on every page, and it travels with a staging database copied to production.' },
  { title: 'SEO plugins', text: 'Yoast and Rank Math noindex whole content types and archives from one setting, and drop them from the sitemap at the same time.' },
  { title: 'Shopify', text: 'A conditional noindex in theme.liquid, the seo.hidden metafield, or an Unlisted product.' },
  { title: 'Webflow', text: 'The Sitemap indexing toggle in page settings adds the meta tag.' },
  { title: 'Next.js', text: 'A page that calls notFound() after streaming starts keeps a 200 status and gets a noindex tag.' },
  { title: 'Servers and CDNs', text: 'A header rule in nginx, Apache, .htaccess, Netlify\u2019s _headers or a CDN. Only the header shows it.' },
]

const canonical = [
  { title: 'A noindex says leave this page out', text: 'Use it for a page that should not be in Google at all, and let the canonical point at the page itself.' },
  { title: 'A canonical to another URL says this is a copy', text: 'It asks Google to index that other URL instead. For a duplicate, use the canonical alone.' },
  { title: 'Don\u2019t pick a canonical with noindex', text: 'Google\u2019s duplicate URL guide advises against it, \u201cbecause it will completely block the page from Search\u201d.' },
]

const javascript = [
  { title: 'The checker reads the server HTML', text: 'It reads the HTML your server sends, before any script runs.' },
  { title: 'A script can add a robots tag', text: 'Google\u2019s JavaScript guide says so.' },
  { title: 'A script that removes one may never run', text: 'When the first HTML already says noindex, Google \u201cmay skip rendering\u201d. Put the right value in the server HTML.' },
]

const recover = [
  { title: 'Remove the rule the checker names', text: 'Check again here until it says no noindex found.' },
  { title: 'Put the URL in your sitemap and link to it', text: 'Make sure the URL is in your XML sitemap and linked from a page Google already visits.' },
  { title: 'Test the live URL in Search Console', text: 'Open URL Inspection, run Test live URL, and check \u201cIndexing allowed?\u201d says yes.' },
  { title: 'Press Request indexing', text: 'A page Google crawls often can come back within days. One it rarely visits can take weeks.' },
]

const tools = [
  { title: 'Redirect checker', text: 'See where a redirect lands, and whether the page it ends on can be indexed.', href: '/tools/redirect-checker', icon: Route01Icon, link: 'Trace redirects' },
  { title: 'robots.txt validator', text: 'Find the robots.txt line that blocks a URL, so Google can read the noindex again.', href: '/tools/robots-txt-validator', icon: Robot02Icon, link: 'Check robots.txt' },
  { title: 'Canonical tag checker', text: 'See where a page\u2019s canonical points, for a duplicate that needs a canonical instead of a noindex.', href: '/tools/canonical-checker', icon: WebValidationIcon, link: 'Check canonicals' },
  { title: 'Excluded by noindex tag', text: 'What the Search Console status means and how to check every URL it covers.', href: '/guides/excluded-by-noindex-tag', icon: Alert02Icon, link: 'Read the guide' },
]

const faq = [
  {
    question: 'What does a noindex tag do?',
    answer:
      'It tells search engines not to show the page in their results. Google drops the page the next time it crawls it and reads the tag, even if other sites link to it.',
  },
  {
    question: 'How do I check if a page is noindex?',
    answer:
      'Enter the URL above. The checker reads the robots and googlebot meta tags in the HTML, the X-Robots-Tag header the server sends, and robots.txt, then says whether Google may index the page. In Search Console, URL Inspection shows the same thing as Google saw it.',
  },
  {
    question: 'Can I block a page with robots.txt instead of noindex?',
    answer:
      'Not if you want it out of Google. robots.txt controls crawling. It does not keep a URL out of the index: Google can still list a blocked URL from links to it, and it never sees a noindex on a page it is not allowed to crawl.',
  },
  {
    question: 'How long does Google take to drop a noindex page?',
    answer:
      'As long as it takes Googlebot to recrawl the page. Google says that can be months for a page it rarely visits. Request indexing in URL Inspection to ask for a recrawl. The Removals tool hides a URL faster, but only for about six months.',
  },
  {
    question: 'Is noindex, follow still useful?',
    answer:
      'For a while. John Mueller said in 2017 that Google stops following the links on a page that has been noindex for a long time, so over time noindex, follow behaves like noindex, nofollow.',
  },
  {
    question: 'Does Bing read the noindex tag?',
    answer:
      'Yes. Bing reads the robots meta tag, a bingbot meta tag and the X-Robots-Tag header. The checker shows Bing separately, because a bingbot tag does not apply to Google and a googlebot tag does not apply to Bing.',
  },
  {
    question: 'What does "URL marked noindex" mean in Search Console?',
    answer:
      'Google tried to index the page and found a noindex rule, so it left the page out. Older reports called it "Excluded by noindex tag" or "Submitted URL marked noindex". If you want the page indexed, remove the rule, then use Test live URL and Request indexing in URL Inspection.',
  },
]
---

<BaseLayout
  title="Free noindex checker for meta tags and headers"
  description="Check any URL for noindex in meta tags, the X-Robots-Tag header and robots.txt. See which rule Google follows and how to fix it."
  canonicalPath="/tools/noindex-checker"
  {breadcrumbs}
  framed={false}
>
  <main data-agent-content>
    <section class="pt-4">
      <div class="site-frame flex flex-col items-center pt-14 text-center sm:pt-20">
        <FounderBadge prefix="Written by AI and" ai />
        <h1 class="mt-4 max-w-3xl text-pretty text-4xl/tight font-medium -tracking-[0.8px] xl:text-5xl/tight xl:-tracking-[1px]">
          Noindex checker
        </h1>
        <p class="mt-4 max-w-2xl text-pretty text-xl/8 font-medium -tracking-[0.2px] text-foreground-muted">
          Enter a URL to see whether Google is allowed to index it, which rule
          says so and how to change it. It checks the robots meta tag,
          googlebot tags, the X-Robots-Tag header, robots.txt, redirects, the
          status code and the canonical.
        </p>
      </div>
      <div class="site-frame mt-10 max-w-3xl sm:mt-12">
        <NoindexChecker />
      </div>
    </section>

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      <section class="site-frame" aria-labelledby="places-heading">
        <SectionHeading
          id="places-heading"
          title="Where can a noindex hide?"
          text="In five places, and a page is out of the index if any one of them says so. Most noindex checkers read one meta tag. Google reads all five before it decides, and the most restrictive rule wins."
        />
        <div class="docs-prose max-w-4xl">
          <table>
            <thead>
              <tr>
                <th>Where</th>
                <th>What it looks like</th>
                <th>Who sets it</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Robots meta tag</td>
                <td><code>&lt;meta name="robots" content="noindex"&gt;</code></td>
                <td>The template, CMS or SEO plugin</td>
              </tr>
              <tr>
                <td>Googlebot meta tag</td>
                <td><code>&lt;meta name="googlebot" content="noindex"&gt;</code></td>
                <td>The same, aimed at Google only</td>
              </tr>
              <tr>
                <td>X-Robots-Tag header</td>
                <td><code>X-Robots-Tag: noindex</code></td>
                <td>The server, CDN or hosting platform</td>
              </tr>
              <tr>
                <td>unavailable_after</td>
                <td><code>unavailable_after: 2026-12-31</code></td>
                <td>Anyone who set an expiry and forgot it</td>
              </tr>
              <tr>
                <td>robots.txt</td>
                <td><code>Disallow: /blog/</code></td>
                <td>Not a noindex, but it hides one from Google</td>
              </tr>
            </tbody>
          </table>
          <p>
            The header is the one people miss. It never shows in view source, so
            a page can look clean and still be out of Google. Vercel, for
            example, adds <code>X-Robots-Tag: noindex</code> to every preview
            deployment.
          </p>
        </div>
      </section>

      <SplitList
        id="blocked-heading"
        title="Why does robots.txt hide a noindex from Google?"
        text="Because Google has to crawl a page to read its noindex, and robots.txt stops the crawl. The URL can stay in Google from links to it."
        items={blocked}
      >
        <a
          class:list={[getButtonClasses('secondary', 'lg'), 'mt-6']}
          href="https://developers.google.com/search/docs/crawling-indexing/block-indexing"
          target="_blank"
          rel="noreferrer">Read Google's noindex guide</a
        >
      </SplitList>

      <section class="site-frame" aria-labelledby="results-heading">
        <SectionHeading
          id="results-heading"
          title="What does each noindex result mean?"
          text="Each result says whether Google may index the page and what to do next. Allowed is not the same as indexed, so a page with no noindex can still be missing from Google."
        />
        <div class="docs-prose max-w-4xl">
          <table>
            <thead>
              <tr>
                <th>Result</th>
                <th>What it means</th>
                <th>What to do</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>No noindex found</td>
                <td>Google is allowed to index the page.</td>
                <td>If it is still missing from Google, check URL Inspection. Allowed is not the same as indexed.</td>
              </tr>
              <tr>
                <td>Noindex found</td>
                <td>Google will drop the page when it next crawls it.</td>
                <td>Keep it if the page should stay out. Otherwise remove the rule the checker names.</td>
              </tr>
              <tr>
                <td>Blocked by robots.txt</td>
                <td>Google cannot crawl the page, but can still list the URL from links.</td>
                <td>Remove the rule if the page should rank. Use noindex if it should not.</td>
              </tr>
              <tr>
                <td>Noindex found, but Google cannot see it</td>
                <td>The noindex never takes effect.</td>
                <td>Remove the robots.txt rule first, so Google can read the noindex.</td>
              </tr>
              <tr>
                <td>The page returns 404, 410 or 5xx</td>
                <td>Google drops it for the status, noindex or not.</td>
                <td>Restore the page or redirect it if it should exist. The <a href="/tools/redirect-checker">redirect checker</a> shows where a redirect lands.</td>
              </tr>
            </tbody>
          </table>
          <p>
            A noindex is not a fault on its own. Login pages, internal search
            results, thank you pages and filtered lists often should be out of
            Google. The question is whether you meant it.
          </p>
        </div>
      </section>

      <SplitList
        id="sources-heading"
        title="Where does an accidental noindex come from?"
        text="Usually one setting in the platform that built the page. The value tells you which layer wrote it, and when the checker can tell the platform from the page, it names the setting to change."
        items={sources}
      />

      <SplitList
        id="canonical-heading"
        title="Should you use noindex or a canonical for a duplicate page?"
        text="A canonical. Noindex and canonical ask for different things, and only the canonical tells Google which copy to keep."
        items={canonical}
      >
        <a
          class:list={[getButtonClasses('secondary', 'lg'), 'mt-6']}
          href="https://developers.google.com/search/docs/crawling-indexing/consolidate-duplicate-urls"
          target="_blank"
          rel="noreferrer">Read Google's duplicate URL guide</a
        >
      </SplitList>

      <SplitList
        id="javascript-heading"
        title="Can JavaScript remove a noindex?"
        text="Not reliably. JavaScript can add a noindex, but Google may stop before the script that removes one runs."
        items={javascript}
      >
        <a
          class:list={[getButtonClasses('secondary', 'lg'), 'mt-6']}
          href="https://developers.google.com/search/docs/crawling-indexing/javascript/javascript-seo-basics"
          target="_blank"
          rel="noreferrer">Read Google's JavaScript guide</a
        >
      </SplitList>

      <SplitList
        id="recover-heading"
        title="How do you get a noindexed page back into Google?"
        text="Remove the rule, then ask Google to crawl the page again. These four steps, in this order."
        items={recover}
      />

      <SplitList
        id="agent-heading"
        title="How do you check every page for noindex with your agent?"
        text="With seo crawl and seo page, which answer the two questions this page cannot: which other pages carry a noindex, and whether Google has actually dropped them. This page checks one URL from the outside."
        items={[
          { title: 'Every noindex on the site', text: 'seo crawl lists every noindex, robots.txt block and canonical on a site from your own machine.', href: '/docs/crawl' },
          { title: 'Google\u2019s own view of a page', text: 'seo page adds Google\u2019s URL Inspection result for a page, through your Search Console.', href: '/docs/page' },
        ]}
      >
        <div class="mt-6">
          <CodeBlock
            label="Ask your agent"
            prompt
            value="Crawl example.com and list every page that has noindex or is blocked by robots.txt, then check which of them still get impressions in Search Console"
            wrap
          />
        </div>
        <p class="mt-6 text-base leading-7 text-foreground-muted">
          Once a page is indexable again,{' '}
          <a class="text-foreground underline underline-offset-4" href="https://indexmysite.app" target="_blank" rel="noreferrer">Index My Site</a>{' '}
          can submit it to Google for you. We build it too.
        </p>
      </SplitList>

      <section class="site-frame" aria-labelledby="tools-heading">
        <SectionHeading
          id="tools-heading"
          title="Which tools go with a noindex check?"
          text="These, which cover where a redirect lands, the robots.txt rule that hides a noindex and what Search Console says about it."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {tools.map((item) => <HomeCard {...item} />)}
        </div>
      </section>

      <section class="site-frame" aria-labelledby="faq-heading">
        <div class="max-w-2xl">
          <h2 id="faq-heading" class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            Noindex checker questions
          </h2>
        </div>
        <div class="mt-10">
          <FaqAccordion items={faq} id="noindex-checker-faq" />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="start-heading">
        <SectionHeading
          id="start-heading"
          title="Find every noindex on your site with your agent"
          text="Give your agent this prompt and it installs the CLI and adds the hosted MCP server. Sign in with the Google account that can read your Search Console."
        />
        <SetupPrompts id="noindex-checker-setup" />
      </section>
    </div>
  </main>
</BaseLayout>
