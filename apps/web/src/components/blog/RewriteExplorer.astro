---
// Every draft in a rewrite test, and every rewrite of it, one at a time. A
// reader picks a draft and a rewrite, and sees its text with the flagged
// lines marked and its scores above it. The texts load from `src` (a JSON
// file in public/) when the exhibit comes near the screen, so they never
// weigh down the page. Without scripts the exhibit shows a link to the file.
//
// The file holds { conditions: [{ key, label }], metrics: [{ key, label,
// format }], drafts: [{ id, label, versions: { <condition>: { text,
// marks: string[], scores: { <metric>: number | null } } } }] }.
// Each mark is a quote from the text to highlight.
import Select from '../ui/select.astro'
import Exhibit from './Exhibit.astro'

type Props = {
  src: string
  title?: string
  caption?: string
}

const { src, title, caption } = Astro.props
---

<Exhibit title={title} caption={caption}>
  <div data-rewrite-explorer data-src={src} data-agent-markdown="exclude">
    <p class="text-sm text-foreground-muted" data-fallback>
      The drafts and every rewrite are in <a class="text-primary underline underline-offset-4" href={src}>the test data</a>.
    </p>
    <div class="hidden" data-ui>
      <label class="block text-sm font-medium text-foreground" for={`${src}-draft`}>Draft</label>
      <div class="mt-1.5">
        <Select id={`${src}-draft`} data-draft />
      </div>
      <div class="mt-4 flex flex-wrap gap-1 rounded-lg bg-background p-1" role="tablist" aria-label="Version" data-tabs></div>
      <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-3 sm:grid-cols-3" data-scores></dl>
      <div
        class="mt-4 max-h-[28rem] overflow-auto whitespace-pre-wrap rounded-lg bg-background p-4 text-[0.9375rem]/6 text-foreground"
        tabindex="0"
        aria-live="polite"
        data-text
      ></div>
      <p class="mt-3 text-sm text-foreground-muted" data-legend></p>
    </div>
  </div>
</Exhibit>

<style>
  [data-rewrite-explorer] :global(.re-tab[aria-selected='true']) {
    background: var(--muted);
    color: var(--foreground);
    font-weight: 500;
  }

  [data-rewrite-explorer] :global(mark) {
    background: var(--destructive-soft);
    color: inherit;
    border-radius: 0.2rem;
    padding: 0 0.1rem;
  }
</style>

<script>
  type Version = { text: string; marks: string[]; scores: Record<string, number | null> }
  type Data = {
    conditions: { key: string; label: string }[]
    metrics: { key: string; label: string; format?: 'number' | 'decimal' | 'percent' }[]
    legend?: string
    drafts: { id: string; label: string; versions: Record<string, Version> }[]
  }

  const escape = (text: string) =>
    text.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] ?? c)

  // Marks each quote's first match, longest quotes first so a short quote
  // never splits a longer one.
  function marked(text: string, quotes: string[]) {
    const spans: [number, number][] = []
    for (const quote of [...new Set(quotes)].sort((a, b) => b.length - a.length)) {
      if (quote.length < 3) continue
      const at = text.indexOf(quote)
      if (at < 0) continue
      const end = at + quote.length
      if (spans.some(([s, e]) => at < e && s < end)) continue
      spans.push([at, end])
    }
    spans.sort((a, b) => a[0] - b[0])
    let html = ''
    let last = 0
    for (const [s, e] of spans) {
      html += `${escape(text.slice(last, s))}<mark>${escape(text.slice(s, e))}</mark>`
      last = e
    }
    return html + escape(text.slice(last))
  }

  const format = (value: number | null, kind?: string) => {
    if (value === null || value === undefined) return 'none'
    if (kind === 'percent') return `${Math.round(value * 100)}%`
    if (kind === 'decimal') return value.toLocaleString('en-US', { maximumFractionDigits: 1 })
    return value.toLocaleString('en-US')
  }

  function mount(root: HTMLElement, data: Data) {
    const ui = root.querySelector<HTMLElement>('[data-ui]')!
    const select = root.querySelector<HTMLSelectElement>('[data-draft]')!
    const tabs = root.querySelector<HTMLElement>('[data-tabs]')!
    const scores = root.querySelector<HTMLElement>('[data-scores]')!
    const body = root.querySelector<HTMLElement>('[data-text]')!
    root.querySelector('[data-legend]')!.textContent = data.legend ?? ''
    let draft = 0
    let condition = data.conditions[0]?.key ?? ''

    for (const [index, item] of data.drafts.entries()) select.add(new Option(item.label, String(index)))
    for (const item of data.conditions) {
      const tab = document.createElement('button')
      tab.type = 'button'
      tab.role = 'tab'
      tab.className =
        're-tab rounded-md px-3 py-1.5 text-sm/5 text-foreground-muted transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/20'
      tab.textContent = item.label
      tab.dataset.key = item.key
      tab.addEventListener('click', () => {
        condition = item.key
        draw()
      })
      tabs.append(tab)
    }
    tabs.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return
      const keys = data.conditions.map((item) => item.key)
      const step = event.key === 'ArrowRight' ? 1 : -1
      condition = keys[(keys.indexOf(condition) + step + keys.length) % keys.length] ?? condition
      draw()
      tabs.querySelector<HTMLElement>(`[data-key="${condition}"]`)?.focus()
    })
    select.addEventListener('change', () => {
      draft = Number(select.value)
      draw()
    })

    function draw() {
      const version = data.drafts[draft]?.versions[condition]
      for (const tab of tabs.querySelectorAll<HTMLButtonElement>('button')) {
        const on = tab.dataset.key === condition
        tab.setAttribute('aria-selected', String(on))
        tab.tabIndex = on ? 0 : -1
      }
      if (!version) return
      scores.innerHTML = data.metrics
        .map(
          (metric) =>
            `<div><dt class="text-xs/4 text-foreground-muted">${escape(metric.label)}</dt><dd class="mt-0.5 text-lg font-medium tabular-nums text-foreground">${format(version.scores[metric.key] ?? null, metric.format)}</dd></div>`,
        )
        .join('')
      body.innerHTML = marked(version.text, version.marks)
    }

    draw()
    ui.classList.remove('hidden')
    root.querySelector('[data-fallback]')?.remove()
  }

  const roots = document.querySelectorAll<HTMLElement>('[data-rewrite-explorer]')
  const load = (root: HTMLElement) =>
    fetch(root.dataset.src ?? '')
      .then((response) => (response.ok ? response.json() : Promise.reject(response.status)))
      .then((data: Data) => mount(root, data))
      .catch(() => {})
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue
        observer.unobserve(entry.target)
        load(entry.target as HTMLElement)
      }
    },
    { rootMargin: '600px 0px' },
  )
  for (const root of roots) observer.observe(root)
</script>
