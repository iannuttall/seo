---
import { FileSearchIcon, Route01Icon, ViewOffIcon, WebValidationIcon } from '@hugeicons/core-free-icons'
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import FounderBadge from '@/components/FounderBadge.astro'
import HomeCard from '@/components/HomeCard.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SetupPrompts from '@/components/SetupPrompts.astro'
import SplitList from '@/components/SplitList.astro'
import HreflangGenerator from '@/components/tools/HreflangGenerator.astro'
import { getButtonClasses } from '@/components/ui/button'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: 'Hreflang generator' },
]

const set = [
  { title: 'Each version lists itself and every other version', text: 'Each language version must reference itself and every other version.' },
  { title: 'The output is the same set for every page', text: 'The generated HTML and HTTP header output is the same complete set for every page in the group.' },
  { title: 'Use complete URLs', text: 'Google\u2019s localized page documentation requires complete URLs and reciprocal links.' },
  { title: 'Missing return links can be ignored', text: 'One page pointing to another without a return link can be ignored.' },
]

const methods = [
  { title: 'All three are equivalent for Google', text: 'HTML tags, HTTP headers and XML sitemaps are equivalent methods for Google Search.' },
  { title: 'Pick the one your team can keep accurate', text: 'Maintaining the same annotations in three places creates more chances for them to drift.' },
]

const codes = [
  { title: 'A two-letter language code', code: 'en', text: 'Start with a language code such as en or fr.' },
  { title: 'A region only when the page targets it', code: 'en-GB', text: 'Add a region only when the page genuinely targets it.' },
  { title: 'A script value', code: 'zh-Hant', text: 'Script values are also accepted.' },
  { title: 'A fallback for everyone else', code: 'x-default', text: 'It can point users who match no listed language to a language selector or fallback page.' },
]

const canonicals = [
  { title: 'Each localized page needs its own canonical', text: 'It normally represents that same localized version.' },
  { title: 'Inspect the HTML before you publish', text: 'The canonical tag checker can check the page before you publish the hreflang set.', href: '/tools/canonical-checker' },
]

const privacy = [
  { title: 'Validated and formatted in this tab', text: 'The generator checks and formats the entries in your browser.' },
  { title: 'Nothing is fetched or uploaded', text: 'It does not fetch the URLs or upload the list.' },
]

const search = [
  { title: 'It links versions of the same content', text: 'Hreflang tells Google that several pages are versions of the same content for different languages or regions.' },
  { title: 'Google swaps in the right version', text: 'When one of them ranks, Google can show the version that suits the searcher, so a reader in France sees the French page instead of the English one.' },
  { title: 'It does not make any page rank higher', text: 'It only decides which version shows.' },
  { title: 'Unlinked regional pages can still be duplicates', text: 'It does not stop Google treating near-identical regional pages as duplicates when they are left unlinked.' },
]

const errors = [
  { title: 'No return links', text: 'Page A lists page B but B does not list A, so Google can ignore the pair.' },
  { title: 'Missing self reference', text: 'Each page must list itself as well as the others.' },
  { title: 'Wrong codes', text: 'The region for the United Kingdom is GB, so en-UK is invalid. A region alone, such as gb, is invalid too.' },
  { title: 'URLs that redirect, are noindexed or point their canonical elsewhere', text: 'List only the final, indexable URL of each version.' },
  { title: 'Relative URLs', text: 'Use full URLs with the protocol and host.' },
]

const tools = [
  { title: 'Canonical tag checker', text: 'Check that each localized page has a canonical that points to itself.', href: '/tools/canonical-checker', icon: WebValidationIcon, link: 'Check canonicals' },
  { title: 'Redirect checker', text: 'Find the final URL of a version that redirects, so the set lists only that one.', href: '/tools/redirect-checker', icon: Route01Icon, link: 'Trace redirects' },
  { title: 'Noindex checker', text: 'Make sure every version in the set can be indexed.', href: '/tools/noindex-checker', icon: ViewOffIcon, link: 'Check noindex' },
  { title: 'Site crawl', text: 'seo crawl reads hreflang on every page it reaches and reports the errors.', href: '/docs/crawl', icon: FileSearchIcon, link: 'Crawl docs' },
]

const faq = [
  {
    question: "What is hreflang?",
    answer:
      "An annotation that links the language and region versions of a page, so search engines can show each searcher the right one. It can be HTML link tags, HTTP headers or entries in an XML sitemap.",
  },
  {
    question: "Does hreflang improve rankings?",
    answer:
      "No. It decides which version of a page Google shows, not whether the page ranks.",
  },
  {
    question: "What is x-default?",
    answer:
      "The version to show when no other language or region matches the searcher, often a language picker or the main international page.",
  },
  {
    question: "Do I need a canonical and hreflang together?",
    answer:
      "Yes. Each version should have a canonical pointing to itself, and hreflang linking it to the others. A canonical pointing to another language version cancels the hreflang.",
  },
  {
    question: "Should I use HTML tags or a sitemap for hreflang?",
    answer:
      "Either works for Google. Tags are easier to see and test. A sitemap is easier for large sites. Use one method, not both.",
  },
  {
    question: "Is it en-GB or en-UK?",
    answer:
      "en-GB. Region codes follow ISO 3166-1, and the code for the United Kingdom is GB.",
  },
]
---

<BaseLayout
  title="Free hreflang tag generator for HTML and sitemaps"
  description="Generate hreflang tags for every language and region version of a page, as HTML, HTTP headers or sitemap entries, and fix return link and code errors."
  canonicalPath="/tools/hreflang-generator"
  {breadcrumbs}
  framed={false}
>
  <main data-agent-content>
    <section class="pt-4">
      <div class="site-frame flex flex-col items-center pt-14 text-center sm:pt-20">
        <FounderBadge prefix="Written by AI and" ai />
        <h1 class="mt-4 max-w-3xl text-pretty text-4xl/tight font-medium -tracking-[0.8px] xl:text-5xl/tight xl:-tracking-[1px]">
          Hreflang generator
        </h1>
        <p class="mt-4 max-w-2xl text-pretty text-xl/8 font-medium -tracking-[0.2px] text-foreground-muted">
          Add each language or regional version once. Get the complete
          reciprocal set as HTML, an HTTP header, or XML sitemap entries.
        </p>
      </div>
      <div class="site-frame mt-10 max-w-3xl sm:mt-12">
        <HreflangGenerator />
      </div>
    </section>

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      <SplitList
        id="set-heading"
        title="Does every localized page need the complete hreflang set?"
        text="Yes. Every version lists itself and all the others, with a return link from each one, or Google can ignore the pair."
        items={set}
      >
        <a
          class:list={[getButtonClasses('secondary', 'lg'), 'mt-6']}
          href="https://developers.google.com/search/docs/specialty/international/localized-versions"
          target="_blank"
          rel="noreferrer">Read Google's localized page guide</a
        >
      </SplitList>

      <SplitList
        id="methods-heading"
        title="Should you use HTML tags, HTTP headers or a sitemap?"
        text="Any one of them, because Google treats them the same. Choose one implementation method and keep it accurate."
        items={methods}
      />

      <SplitList
        id="codes-heading"
        title="Which language and region codes should you use?"
        text="A language code first, then a region only when the page targets one. Use the codes carefully, because a wrong one is invalid."
        items={codes}
      />

      <SplitList
        id="canonical-heading"
        title="Should a localized page's canonical point to itself?"
        text="Yes, normally. Keep canonicals aligned with the localized URLs, since a canonical that points to another language version cancels the hreflang."
        items={canonicals}
      />

      <SplitList
        id="privacy-heading"
        title="Does the hreflang generator upload your URLs?"
        text="No. Your URLs stay in the browser."
        items={privacy}
      />

      <SplitList
        id="search-heading"
        title="What does hreflang do in search?"
        text="It lets Google show each searcher the version of a page in their language or region. It has no effect on how high the page ranks."
        items={search}
      />

      <SplitList
        id="errors-heading"
        title="How do you fix common hreflang errors?"
        text="Most come from a set that is incomplete or lists the wrong URLs. These five are the ones to check first."
        items={errors}
      />

      <SplitList
        id="agent-heading"
        title="How do you check hreflang across your site with your agent?"
        text="With seo crawl, which reads hreflang on every page it reaches on your machine. One set is easy to check by eye. A whole site is not."
        items={[
          { title: 'Malformed and repeated values', text: 'The crawl reports both, page by page.', href: '/docs/crawl' },
          { title: 'Pages missing from their own set', text: 'It lists pages that leave themselves out.' },
          { title: 'Fix the template, then check here', text: 'Your agent can fix the template and paste the corrected set here to check it.' },
        ]}
      >
        <div class="mt-6">
          <CodeBlock
            label="Ask your agent"
            prompt
            value="Crawl example.com and list the pages with hreflang errors, then check whether each language version links back"
            wrap
          />
        </div>
      </SplitList>

      <section class="site-frame" aria-labelledby="tools-heading">
        <SectionHeading
          id="tools-heading"
          title="Which tools go with a hreflang check?"
          text="These, which check that every URL in the set is final, indexable and canonical to itself."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {tools.map((item) => <HomeCard {...item} />)}
        </div>
      </section>

      <section class="site-frame" aria-labelledby="faq-heading">
        <div class="max-w-2xl">
          <h2 id="faq-heading" class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            Hreflang questions
          </h2>
        </div>
        <div class="mt-10">
          <FaqAccordion items={faq} id="hreflang-generator-faq" />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="start-heading">
        <SectionHeading
          id="start-heading"
          title="Check hreflang on every page with your agent"
          text="The crawl runs from the CLI on your machine. Give your agent this prompt and it installs the CLI and adds the hosted MCP server."
        />
        <SetupPrompts id="hreflang-generator-setup" />
      </section>
    </div>
  </main>
</BaseLayout>
