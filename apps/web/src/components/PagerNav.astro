---
type PagerLink = {
  label: string
  href: string
}

type Props = {
  ariaLabel: string
  previous?: PagerLink
  next?: PagerLink
}

const { ariaLabel, previous, next } = Astro.props
const linkClass =
  'font-medium text-foreground underline decoration-border underline-offset-4 transition-colors group-hover:decoration-foreground'
---

<nav aria-label={ariaLabel} class="mt-16 flex items-stretch justify-between gap-4 pt-6">
  {
    previous ? (
      <a href={previous.href} class="group flex flex-col gap-1 no-underline">
        <span class="text-sm text-foreground-muted">Previous</span>
        <span class={linkClass}>{previous.label}</span>
      </a>
    ) : (
      <span />
    )
  }
  {
    next ? (
      <a href={next.href} class="group flex flex-col items-end gap-1 text-right no-underline">
        <span class="text-sm text-foreground-muted">Next</span>
        <span class={linkClass}>{next.label}</span>
      </a>
    ) : (
      <span />
    )
  }
</nav>
