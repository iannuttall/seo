---
import {
  Idea01Icon,
  Megaphone01Icon,
  MapsLocation01Icon,
  SearchList01Icon,
  ShoppingBag01Icon,
  TextIcon,
  GridViewIcon,
  AiSearchIcon,
} from '@hugeicons/core-free-icons'
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import HomeCard from '@/components/HomeCard.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SetupPrompts from '@/components/SetupPrompts.astro'
import SplitList from '@/components/SplitList.astro'
import WordCombiner from '@/components/tools/WordCombiner.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: 'Word combiner' },
]

const order = [
  {
    title: 'Each list works like a column',
    text: 'Add "best" and "local" to list A, "SEO tools" and "rank tracker" to list B, and the tool creates four combinations.',
  },
  {
    title: 'Add a list for each qualifier',
    text: 'Add another list when every output needs a location, audience, product attribute, or other qualifier.',
  },
  {
    title: 'Choose how the lists combine',
    text: 'You can combine every populated list, build progressively from list A, or generate adjacent pairs alongside the full combination. Individual list items can be included too.',
  },
  {
    title: 'Fixed order reads better',
    text: 'Fixed order usually produces cleaner phrases than generating every possible word order.',
  },
]

const filters = [
  {
    title: 'Filters run during generation',
    text: 'Include and exclude filters are applied while the list is generated. Use one phrase per line.',
  },
  {
    title: 'Include keeps, exclude removes',
    text: 'An include filter keeps a combination when any phrase matches, while an exclude filter removes it when any phrase matches.',
  },
  {
    title: 'The count shows before you run it',
    text: 'The projected count appears before you run the tool.',
  },
  {
    title: 'A capped result is marked partial',
    code: '100,000',
    text: 'Generation stops after the first 100,000 candidate combinations, and a capped result is labelled as partial. Narrow the source lists when you need the complete set.',
  },
]

const research = [
  {
    title: 'A combination is only a candidate',
    text: 'It does not prove that people search for it. Check relevance, intent, and demand before using a phrase in a page plan or paid search campaign.',
  },
  {
    title: 'Start from the queries you already get',
    text: 'For an existing site, seo data returns the queries people already use to find you in Search Console.',
    href: '/docs/data',
  },
  {
    title: 'Keep landing pages for distinct answers',
    text: 'Do not turn every row into a landing page. The useful rows are the ones that match a real product, service, audience, or location and deserve a distinct answer.',
  },
]

const privacy = [
  {
    title: 'Lists stay in this tab',
    text: 'Your lists stay in this browser tab while you combine, filter, copy, and export them. Closing or refreshing the tab clears the current result.',
  },
  {
    title: 'Copy and TXT use your separator',
    text: 'Copy and TXT use your chosen output separator, which can be a new line, comma, space, pipe, dash, or custom value.',
  },
  {
    title: 'CSV for spreadsheets',
    text: 'CSV keeps one combination per row and adds a heading for spreadsheet imports.',
  },
  {
    title: 'Export only what you searched for',
    text: 'All three actions use the active result search, so you can export a smaller subset without generating it again.',
  },
]

const uses = [
  {
    title: 'Keyword lists',
    icon: MapsLocation01Icon,
    text: 'Combine services with locations, such as “plumber” and “emergency plumber” with a list of towns.',
  },
  { title: 'Product names', icon: ShoppingBag01Icon, text: 'Pair attributes with products: sizes, colours and materials.' },
  { title: 'Ad groups', icon: Megaphone01Icon, text: 'Build exact phrase lists for a paid search campaign.' },
  { title: 'Names and ideas', icon: Idea01Icon, text: 'Join two lists of words to find a domain or brand name.' },
]

const demand = [
  { title: 'Expect most phrases to get no searches', text: 'Most generated phrases get no searches at all, so check the demand before you plan pages around them.' },
  { title: 'Pick the ones a person would type', text: 'Pick the combinations that read like something a person would type.' },
  { title: 'Look up their search volume', text: 'Then look up their search volume and keep the ones with demand.' },
  { title: 'Fold close variants into one page', text: 'Fold close variants into one page rather than one page each.' },
]

const tools = [
  {
    title: 'Keyword clustering tool',
    text: 'Group up to 50 keywords by the pages Google ranks for each, and see which keywords one page can target.',
    href: '/tools/keyword-clustering-tool',
    icon: GridViewIcon,
    link: 'Cluster keywords',
  },
  {
    title: 'Competitor keyword research',
    text: 'The keywords a competitor ranks for in Google, with positions, monthly searches and the ranking page.',
    href: '/tools/competitor-keyword-research',
    icon: SearchList01Icon,
    link: 'Research a competitor',
  },
  {
    title: 'People Also Ask tool',
    text: 'The questions Google shows for any keyword, and the page that answers each one.',
    href: '/tools/people-also-ask-tool',
    icon: AiSearchIcon,
    link: 'Find questions',
  },
  {
    title: 'Title tag word frequency',
    text: 'Count the words and phrases in the titles that rank in Google for any keyword.',
    href: '/tools/title-tag-word-frequency',
    icon: TextIcon,
    link: 'Count title words',
  },
]

const faq = [
  {
    question: 'What is a word combiner?',
    answer:
      'A tool that joins words from two or more lists into every combination, in order. Two lists of three words each make nine phrases.',
  },
  {
    question: 'How do I combine two lists of words?',
    answer:
      'Put one word or phrase per line in list A and list B, choose how to join them, and generate. Add more lists for more parts.',
  },
  {
    question: 'Is the word combiner free?',
    answer: 'Yes, with no account. It runs in your browser and nothing is uploaded.',
  },
  {
    question: 'Can I combine words in every order?',
    answer:
      'This tool keeps the list order, which gives cleaner phrases. To get the reverse order, swap the lists and generate again.',
  },
  {
    question: 'How many combinations can it make?',
    answer:
      'Up to 100,000 at a time. A larger result is marked as partial, so narrow the lists to get the full set.',
  },
]
---

<BaseLayout
  title="Free word combiner for keyword lists"
  description="Combine words from several lists into every phrase, in order, with filters and CSV export. Use it for keyword lists, product names, ad groups and name ideas."
  canonicalPath="/tools/word-combiner"
  {breadcrumbs}
  framed={false}
>
  <main data-agent-content>
    <section class="pt-4">
      <div class="site-frame flex flex-col items-center pt-14 text-center sm:pt-20">
        <h1 class="mt-4 max-w-3xl text-pretty text-4xl/tight font-medium -tracking-[0.8px] xl:text-5xl/tight xl:-tracking-[1px]">
          Word combiner
        </h1>
        <p class="mt-4 max-w-2xl text-pretty text-xl/8 font-medium -tracking-[0.2px] text-foreground-muted">
          Mix up to five lists into ordered word and keyword combinations, then
          filter, copy, or download the result.
        </p>
      </div>
      <div class="site-frame mt-10 sm:mt-12">
        <WordCombiner />
      </div>
    </section>

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      <SplitList
        id="order-heading"
        title="How does the word combiner join keyword lists?"
        text="In a fixed order, one item from each list in turn, so every phrase reads list A, then list B, then the next."
        items={order}
      />

      <SplitList
        id="filters-heading"
        title="How do you keep large combinations manageable?"
        text="With include and exclude filters, which run while the list is generated, and a count you see before you start."
        items={filters}
      />

      <SplitList
        id="research-heading"
        title="Do generated phrases still need keyword research?"
        text="Yes. A generated phrase is a candidate until you have checked its relevance, intent and demand."
        items={research}
      />

      <SplitList
        id="privacy-heading"
        title="Do your word lists stay private?"
        text="Yes. Your lists stay in this browser tab, and you choose how the result is copied or exported."
        items={privacy}
      />

      <section class="site-frame" aria-labelledby="uses-heading">
        <SectionHeading
          id="uses-heading"
          title="What can you use a word combiner for?"
          text="Anything built from parts that combine: keyword lists, product names, ad groups and name ideas."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {uses.map((item) => <HomeCard title={item.title} text={item.text} icon={item.icon} />)}
        </div>
      </section>

      <SplitList
        id="demand-heading"
        title="How do you check which combinations people search for?"
        text="Look up the search volume of the phrases that read naturally, and keep the ones with demand."
        items={demand}
      />

      <SplitList
        id="agent-heading"
        title="How do you check search volume with your agent?"
        text="Give it the list straight from here. With SEO Skill, your agent looks up the numbers and checks your own Search Console."
        items={[
          {
            title: 'Search volume, difficulty and cost per click',
            text: 'seo research looks up search volume, keyword difficulty and cost per click for up to 100 keywords at a time with your own DataForSEO or Ahrefs key.',
            href: '/docs/research',
          },
          {
            title: 'Phrases you already get impressions for',
            text: 'Your agent can check which ones you already get impressions for with seo data.',
            href: '/docs/data',
          },
        ]}
      >
        <div class="mt-6">
          <CodeBlock
            label="Ask your agent"
            prompt
            value="Get the search volume for these phrases in the US, drop the ones with none, and group the rest by intent"
            wrap
          />
        </div>
      </SplitList>

      <section class="site-frame" aria-labelledby="tools-heading">
        <SectionHeading
          id="tools-heading"
          title="Which tools go with a word combiner?"
          text="These, which group your phrases, show what competitors rank for and find the questions people ask."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {tools.map((item) => <HomeCard {...item} />)}
        </div>
      </section>

      <section class="site-frame" aria-labelledby="faq-heading">
        <div class="max-w-2xl">
          <h2 id="faq-heading" class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            Word combiner questions
          </h2>
        </div>
        <div class="mt-10">
          <FaqAccordion id="word-combiner-faq" items={faq} />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="start-heading">
        <SectionHeading
          id="start-heading"
          title="Check search volume for your phrases with your agent"
          text="Add SEO Skill to your agent, add your DataForSEO or Ahrefs key, and give it the list from this page."
        />
        <SetupPrompts id="word-combiner-setup" />
      </section>
    </div>
  </main>
</BaseLayout>
