---
import Button from '@/components/Button.astro'
import Card from '@/components/Card.astro'
import FormInput from '@/components/FormInput.astro'
---

<section data-seo-checker class="space-y-6">
  <Card>
    <form data-seo-form class="space-y-5 p-5 sm:p-6" novalidate>
      <div class="space-y-1">
        <h2 class="text-lg font-medium">Check a page</h2>
        <p class="text-sm leading-6 text-foreground-muted">
          The checker loads the page the way a crawler does, follows its redirects, tests robots.txt and reads the HTML for the signals search engines use.
        </p>
      </div>
      <label class="block space-y-2 text-sm font-medium">
        <span>Page URL</span>
        <FormInput
          data-seo-url
          type="text"
          inputmode="url"
          autocomplete="url"
          autocapitalize="off"
          spellcheck="false"
          maxlength="2048"
          placeholder="https://example.com/pricing"
        />
      </label>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-xs leading-5 text-foreground-muted">Free, 10 checks a day, no account. The page must be public.</p>
        <Button data-check type="submit" class="min-h-10 shrink-0 px-5 text-xs">Check SEO</Button>
      </div>
      <p data-error hidden class="text-sm leading-6 text-red-700 dark:text-red-400" role="alert"></p>
    </form>
  </Card>

  <div data-results hidden class="space-y-6">
    <Card inverted>
      <div class="space-y-5 p-5 sm:p-6">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
          <div class="min-w-0">
            <p data-headline class="text-2xl font-medium text-primary"></p>
            <p data-summary class="mt-1 text-sm leading-6 text-foreground"></p>
            <p data-subline class="mt-1 break-words text-xs leading-5 text-foreground-muted"></p>
          </div>
          <div class="grid shrink-0 gap-2 sm:grid-cols-2">
            <Button data-copy type="button" class="min-h-10 px-4 text-xs">Copy findings</Button>
            <Button data-download type="button" class="min-h-10 px-4 text-xs">Download JSON</Button>
          </div>
        </div>
        <p data-action-status class="text-xs text-foreground-muted" aria-live="polite"></p>
      </div>
    </Card>

    <Card>
      <div class="space-y-4 p-5 sm:p-6">
        <h3 class="text-sm font-medium">What the page says</h3>
        <dl data-facts class="grid grid-cols-[minmax(0,8rem)_minmax(0,1fr)] gap-x-4 gap-y-3 text-sm sm:grid-cols-[minmax(0,12rem)_minmax(0,1fr)] sm:gap-x-6"></dl>
      </div>
    </Card>

    <div data-groups class="space-y-6"></div>
  </div>
</section>

<script>
  type Check = { group: 'access' | 'content' | 'markup'; id: string; level: 'pass' | 'warn' | 'fail' | 'info'; message: string; fix?: string }
  type Result = {
    checkedAt: string
    finalUrl: string
    status: number | null
    verdict: string
    headline: string
    summary: string
    redirects: number
    page: {
      title: string | null
      description: string | null
      h1: string | null
      canonical: string | null
      lang?: string | null
      words?: number
      h1Count?: number
      h2Count?: number
      images?: number
      imagesWithoutAlt?: number
      links?: { internal: number; external: number; nofollow: number }
      structuredData?: { types: string[]; invalid: number }
    }
    counts: Record<Check['level'], number>
    checks: Check[]
  }

  const LEVELS: Record<Check['level'], { label: string; className: string }> = {
    fail: { label: 'Fix', className: 'bg-destructive-soft text-destructive' },
    warn: { label: 'Check', className: 'bg-warning-soft text-foreground' },
    info: { label: 'Note', className: 'bg-muted text-foreground-muted' },
    pass: { label: 'OK', className: 'bg-primary-soft text-foreground' },
  }
  const GROUPS: Array<[Check['group'], string]> = [
    ['access', 'Can Google reach and index it'],
    ['content', 'Title, description and content'],
    ['markup', 'Canonical, structured data and sharing'],
  ]
  const ORDER: Record<Check['level'], number> = { fail: 0, warn: 1, info: 2, pass: 3 }

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className = '', text = ''): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag)
    if (className) node.className = className
    if (text) node.textContent = text
    return node
  }

  function initialise(root: HTMLElement): void {
    if (root.dataset.initialised === 'true') return
    root.dataset.initialised = 'true'
    const $ = <T extends Element>(selector: string) => root.querySelector<T>(selector) as T
    const form = $<HTMLFormElement>('[data-seo-form]')
    const input = $<HTMLInputElement>('[data-seo-url]')
    const button = $<HTMLButtonElement>('[data-check]')
    const error = $<HTMLElement>('[data-error]')
    const status = $<HTMLElement>('[data-action-status]')
    let result: Result | undefined

    function render(): void {
      if (!result) return
      const r = result
      $<HTMLElement>('[data-headline]').textContent = r.headline
      $<HTMLElement>('[data-summary]').textContent = r.summary
      $<HTMLElement>('[data-subline]').textContent = `${r.finalUrl}${r.redirects ? `, reached after ${r.redirects} ${r.redirects === 1 ? 'redirect' : 'redirects'}` : ''}. Checked ${new Date(r.checkedAt).toLocaleString()}.`

      const p = r.page
      const read = p.words !== undefined
      const shown = (value: string | null | undefined) => (value === null || value === undefined ? (read ? 'None' : 'Not read') : value || 'Empty')
      const rows: Array<[string, string]> = [
        ['Status', r.status === null ? 'No response' : String(r.status)],
        ['Title', shown(p.title)],
        ['Meta description', shown(p.description)],
        ['H1', shown(p.h1)],
        ['Canonical', shown(p.canonical)],
      ]
      if (read) {
        rows.push(
          ['Headings', `${p.h1Count} H1, ${p.h2Count} H2`],
          ['Words in the HTML', String(p.words)],
          ['Images without alt', `${p.imagesWithoutAlt} of ${p.images}`],
          ['Links', `${p.links?.internal} internal, ${p.links?.external} external`],
          ['Structured data', p.structuredData?.types.length ? p.structuredData.types.join(', ') : 'None'],
          ['Language', p.lang || 'Not set'],
        )
      }
      $<HTMLElement>('[data-facts]').replaceChildren(
        ...rows.flatMap(([term, value]) => [
          el('dt', 'text-foreground-muted', term),
          el('dd', 'min-w-0 break-words text-foreground [overflow-wrap:anywhere]', value),
        ]),
      )

      $<HTMLElement>('[data-groups]').replaceChildren(
        ...GROUPS.flatMap(([group, heading]) => {
          const items = r.checks.filter((check) => check.group === group).sort((a, b) => ORDER[a.level] - ORDER[b.level])
          if (!items.length) return []
          const card = el('div', 'tool-form-panel min-w-0 text-foreground')
          const inner = el('div', 'space-y-4 p-5 sm:p-6')
          inner.append(el('h3', 'text-sm font-medium', heading))
          const list = el('ul', 'divide-y divide-border text-sm')
          list.append(
            ...items.map((item) => {
              const row = el('li', 'flex items-start gap-3 py-3')
              const level = LEVELS[item.level]
              const body = el('div', 'min-w-0 space-y-1')
              body.append(el('p', 'break-words leading-6 text-foreground [overflow-wrap:anywhere]', item.message))
              if (item.fix) body.append(el('p', 'break-words leading-6 text-foreground-muted', `Fix: ${item.fix}`))
              row.append(el('span', `mt-0.5 inline-flex w-12 shrink-0 justify-center rounded px-1.5 py-0.5 text-xs font-medium ${level.className}`, level.label), body)
              return row
            }),
          )
          inner.append(list)
          card.append(inner)
          return [card]
        }),
      )
      $<HTMLElement>('[data-results]').hidden = false
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      error.hidden = true
      const url = input.value.trim()
      if (!url) {
        error.textContent = 'Enter a page URL.'
        error.hidden = false
        return
      }
      button.disabled = true
      button.textContent = 'Checking…'
      try {
        const response = await fetch('/api/tools/seo-checker', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ url }),
        })
        const data = (await response.json().catch(() => ({}))) as Result & { error?: string }
        if (!response.ok) throw new Error(data.error || 'The page could not be checked.')
        result = data
        status.textContent = ''
        render()
        $<HTMLElement>('[data-results]').scrollIntoView({ behavior: 'smooth', block: 'start' })
      } catch (caught) {
        error.textContent = caught instanceof Error ? caught.message : 'The page could not be checked.'
        error.hidden = false
      } finally {
        button.disabled = false
        button.textContent = 'Check SEO'
      }
    })

    $<HTMLButtonElement>('[data-copy]').addEventListener('click', async () => {
      if (!result) return
      const lines = [
        `SEO check for ${result.finalUrl}: ${result.headline}. ${result.summary}`,
        ...result.checks
          .filter((item) => item.level !== 'pass')
          .map((item) => `${LEVELS[item.level].label}: ${item.message}${item.fix ? ` Fix: ${item.fix}` : ''}`),
      ]
      try {
        await navigator.clipboard.writeText(lines.join('\n'))
        status.textContent = 'Findings copied.'
      } catch {
        status.textContent = 'The findings could not be copied.'
      }
    })

    $<HTMLButtonElement>('[data-download]').addEventListener('click', () => {
      if (!result) return
      const link = document.createElement('a')
      link.href = URL.createObjectURL(new Blob([JSON.stringify(result, null, 2)], { type: 'application/json' }))
      link.download = 'seo-check.json'
      link.click()
      URL.revokeObjectURL(link.href)
      status.textContent = 'JSON downloaded.'
    })

    const preset = new URLSearchParams(location.search).get('url')
    if (preset) input.value = preset
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-seo-checker]')) initialise(root)
</script>
