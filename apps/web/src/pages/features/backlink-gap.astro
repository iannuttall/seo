---
import {
  Analytics01Icon,
  Key01Icon,
  Link01Icon,
  SearchList01Icon,
  UserGroupIcon,
} from '@hugeicons/core-free-icons'
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import HomeCard from '@/components/HomeCard.astro'
import LandingHero from '@/components/LandingHero.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SetupPrompts from '@/components/SetupPrompts.astro'
import SplitList from '@/components/SplitList.astro'
import { researchKeyStep } from '@/content/setup-prompts'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const title = 'Backlink gap analysis'
const setupSteps = [researchKeyStep('research')]

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Features', href: '/features' },
  { label: title },
]

const finds = [
  {
    title: 'Sites that link to two or more competitors',
    text: 'SEO Skill counts a site as part of the gap when it links to at least two of your competitors and not to you.',
  },
  {
    title: 'One link can be chance',
    text: 'One competitor’s link can be a friendship, a sponsorship or chance. Two or more is a pattern, such as a comparison post, a tools list or a community that covers the whole category.',
  },
]

const run = [
  {
    title: 'Save a DataForSEO or Ahrefs key',
    text: 'Save it under Keys on your account page, never in the chat. The provider bills you directly, and SEO Skill adds nothing on top.',
    href: '/docs/keys',
  },
  {
    title: 'The agent keeps the overlap',
    text: 'It reads each site’s referring domains, keeps the sites that link to two or more competitors and not to you, and sorts them by Domain Rating.',
  },
  {
    title: 'Each run says what it cost',
    text: 'A run with DataForSEO costs about $0.24 for a site and 3 competitors, and says so in the result. With Ahrefs it uses your API units.',
  },
]

const pick = [
  {
    title: 'Domains that share your keywords',
    text: 'Competitors lists the domains that rank for the same keywords as you.',
  },
  {
    title: 'Who holds page one',
    text: 'A SERP shows who holds page one for one search.',
  },
  {
    title: 'Sites a little stronger than yours',
    text: 'They make the best comparison. A gap against a site with 50 times your links tends to fill up with prospects that would never look at you (big publishers rarely link to the newcomer).',
  },
  {
    title: 'Finding and grouping competitors',
    text: 'The SEO competitor analysis page walks through it.',
    href: '/features/seo-competitor-analysis',
  },
]

const ends = [
  {
    title: '48 of the 90 sites have a Domain Rating under 10',
    text: 'Going by their names, many are tool directories and "alternatives to" lists. Some are worth a two-minute submission. Few are worth an outreach email.',
  },
  {
    title: 'Plausible’s gap was 13 sites',
    text: 'With Plausible as the target and Umami, Fathom and Simple Analytics as competitors, the gap was 13 sites. Most strong sites that link to two of Plausible’s rivals already link to Plausible, which is what a category leader’s link profile looks like.',
  },
]

const read = [
  {
    title: 'What each row shows',
    text: 'The linking site, its Domain Rating and which of your competitors it links to.',
  },
  {
    title: 'Domain Rating measures links',
    text: 'Domain Rating tells you how strong a site’s own links are. It does not tell you whether the site would link to you. In the Umami gap, a cookie consent company and Y Combinator sit at the top.',
  },
  {
    title: 'Open the site before you write to it',
    text: 'Whether a site is a real prospect depends on the page that carries the link.',
  },
  {
    title: 'Sites that link to everyone are left out',
    text: 'URL shorteners, link lists, and coupon or site-stats directories link to almost every site, so the gap leaves them out and names each one. The Umami run left out one, a subdomain finder.',
  },
]

const pages = [
  {
    title: 'A competitor’s referring domains',
    text: 'Backlinks lists them strongest first, with how many links each one sends and when it first linked.',
  },
  {
    title: 'The competitor pages most sites link to',
    text: 'Pages by backlinks lists them, most referring domains first.',
  },
  {
    title: 'A page like theirs gives you something to point at',
    text: 'If a competitor’s most linked page is a free tool, a pricing study or an open dataset, that is the kind of page the sites in your gap link to. A page like it on your site gives you something to point them at.',
  },
]

const limits = [
  {
    title: 'The read stops at 1,000 referring domains',
    text: 'When a site has more than that, the gap stops at the lowest authority it read and says so, and it does not guess below it. Both analytics runs stopped there, because at least one of the four sites has more than 1,000 referring domains.',
  },
  {
    title: 'Sites below the line may still link',
    text: 'A site missing from the gap may still link to a competitor below that line, and a site in the gap may link to you somewhere the provider has not crawled.',
  },
  {
    title: 'Link counts and Domain Rating are estimates',
    text: 'They come from the provider, and no outside index sees every link Google sees.',
  },
  {
    title: 'The gap names sites',
    text: 'It compares whole domains and names the linking site. To find the page that carries the link, open the site or ask your agent to search it.',
  },
]

const related = [
  { title: 'seo research', text: 'Every research action, including the link gap, with its inputs and CLI flags.', href: '/docs/research', icon: SearchList01Icon },
  { title: 'API keys', text: 'Add a DataForSEO or Ahrefs key to the hosted MCP or the CLI.', href: '/docs/keys', icon: Key01Icon },
  { title: 'Backlink checker', text: 'See who links to any domain or page in your browser, with no account.', href: '/tools/backlink-checker', icon: Link01Icon, link: 'Free tool' },
  { title: 'Domain Rating checker', text: 'Check the Domain Rating of up to 10 sites at once, for free.', href: '/tools/domain-rating-checker', icon: Analytics01Icon, link: 'Free tool' },
  { title: 'AI keyword research tool', text: 'Find the competitors that win your searches before you compare their links.', href: '/features/keyword-research', icon: UserGroupIcon, link: 'Keyword research' },
]

const faq = [
  {
    question: 'What is a backlink gap analysis?',
    answer:
      'A list of the websites that link to your competitors and not to you. Those sites already link out on your topic, so they are the warmest link building prospects you have. SEO Skill counts a site when it links to at least two of your competitors.',
  },
  {
    question: 'How many competitors can I compare?',
    answer:
      'Your site and 2 to 5 competitors. Pick sites that rank for the searches you want and are a little stronger than yours.',
  },
  {
    question: 'How much does a backlink gap cost?',
    answer:
      'About $0.24 for a site and 3 competitors with DataForSEO, and each run says what it cost. With Ahrefs it uses your API units. The provider bills you directly and SEO Skill adds nothing on top.',
  },
  {
    question: 'Why are some sites left out of the gap?',
    answer:
      'URL shorteners, link lists, and coupon or site-stats directories link to almost every site, so the gap leaves them out and names each one it dropped.',
  },
  {
    question: 'Is the link data complete?',
    answer:
      'No outside index sees every link Google sees, and link counts and Domain Rating are provider estimates. The gap reads each site’s top 1,000 referring domains and says when it stopped there.',
  },
  {
    question: 'How is this different from the Semrush Backlink Gap tool?',
    answer:
      'Both list the domains that link to your competitors and not to you. Semrush works in its own interface with daily limits set by your plan. SEO Skill runs the gap inside your agent, next to your own Search Console data, on your own DataForSEO or Ahrefs usage.',
  },
]
---

<BaseLayout
  title="Backlink gap analysis tool for AI agents"
  description="Find the sites that link to two or more of your competitors but not to you, sorted by Domain Rating, from your own DataForSEO or Ahrefs key."
  canonicalPath="/features/backlink-gap"
  {breadcrumbs}
  framed={false}
>
  <main data-agent-content>
    <LandingHero
      {title}
      lead="Ask your agent which sites link to two or more of your competitors and not to you. It compares up to 5 competitors from your own DataForSEO or Ahrefs account and lists the gap, highest Domain Rating first."
      setupId="backlink-gap-setup"
      {setupSteps}
      author
    />

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      <SplitList
        id="finds-heading"
        title="What does a backlink gap analysis find?"
        text="The websites that link to your competitors and not to you. Those sites already link out on your topic, so they are the warmest link building prospects you have."
        items={finds}
      >
        <p class="mt-4 text-base leading-7 text-foreground-muted">
          Ahrefs' own{' '}
          <a class="text-foreground underline underline-offset-4" href="https://ahrefs.com/blog/backlink-gap-analysis/" target="_blank" rel="noreferrer">backlink gap guide</a>{' '}
          draws the same line. Sites that link to every competitor are high
          priority, and sites that link to two are next.
        </p>
      </SplitList>

      <SplitList
        id="run-heading"
        title="How do I run a backlink gap in my agent?"
        text="Name your site and 2 to 5 competitors. Your agent runs the gap on your own DataForSEO or Ahrefs key."
        items={run}
      >
        <div class="mt-6">
          <CodeBlock label="Ask your agent" prompt value="Run a backlink gap for example.com against example.org, example.net and example.io" wrap />
          <CodeBlock label="Or run it in a terminal" value="seo research link_gap --target example.com --competitors example.org,example.net,example.io" wrap />
        </div>
      </SplitList>

      <SplitList
        id="competitors-heading"
        title="Which competitors should I compare?"
        text="The sites that rank for the searches you want. They are often different from the companies you meet in sales calls, and a backlink gap is only as good as the competitors you compare."
        items={pick}
      >
        <div class="mt-6">
          <CodeBlock label="Ask your agent" prompt value={`Which domains share the most keywords with example.com? Then show the top 10 for "invoice software" with each site's Domain Rating`} wrap />
        </div>
      </SplitList>

      <section class="site-frame" aria-labelledby="example-heading">
        <SectionHeading
          id="example-heading"
          title="What does a real backlink gap find?"
          text="For Umami, the open source web analytics tool, it found 90 link prospects against Plausible, Fathom and Simple Analytics. The run cost $0.24."
        />
        <p class="mb-6 max-w-2xl text-base leading-7 text-foreground-muted">
          We ran it with DataForSEO and Domain Rating by{' '}
          <a class="text-foreground underline underline-offset-4" href="https://ahrefs.com" target="_blank" rel="noreferrer">Ahrefs</a>.
          It found 90 sites that link to at least two of the three rivals and
          not to umami.is. Of those, 29 link to all three rivals, 14 have a
          Domain Rating of 50 or more, and 8 are both. Those 8 are where we
          would start, and the table shows the top of the list.
        </p>
        <div class="docs-prose max-w-4xl">
          <table>
            <thead><tr><th>Linking site</th><th>Domain Rating (links to)</th></tr></thead>
            <tbody>
              <tr><td>iubenda.com</td><td>94 (all 3)</td></tr>
              <tr><td>ycombinator.com</td><td>91 (Plausible, Simple Analytics)</td></tr>
              <tr><td>beehiiv.com</td><td>91 (all 3)</td></tr>
              <tr><td>kinsta.com</td><td>89 (Plausible, Fathom)</td></tr>
              <tr><td>discourse.org</td><td>83 (Plausible, Fathom)</td></tr>
              <tr><td>indiehackers.com</td><td>82 (Plausible, Simple Analytics)</td></tr>
              <tr><td>spreadprivacy.com</td><td>77 (all 3)</td></tr>
              <tr><td>sdf.org</td><td>77 (all 3)</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <SplitList
        id="ends-heading"
        title="What do the weak end and a short gap tell you?"
        text="The weak end is mostly quick submissions, and a short gap is still a finding. Both showed up in the analytics runs."
        items={ends}
      />

      <SplitList
        id="read-heading"
        title="How should I read a backlink gap?"
        text="By overlap first, then Domain Rating. A site that links to all your competitors covers the category on purpose, so it is the likeliest to add you."
        items={read}
      >
        <div class="mt-6">
          <CodeBlock label="Ask your agent" prompt value="From that backlink gap, list the sites that link to every competitor, then the ones with Domain Rating 50 or more, and tell me what each site is" wrap />
        </div>
      </SplitList>

      <SplitList
        id="pages-heading"
        title="Which competitor pages earn the links?"
        text="Pages by backlinks shows you. The gap names sites, and two more research actions show what earned the links."
        items={pages}
      >
        <div class="mt-6">
          <CodeBlock label="Ask your agent" prompt value="Which pages on example.org have the most referring domains, and which sites link to example.org most often?" wrap />
        </div>
      </SplitList>

      <section class="site-frame" aria-labelledby="semrush-heading">
        <SectionHeading
          id="semrush-heading"
          title="How does SEO Skill compare with the Semrush Backlink Gap tool?"
          text="Both list the domains that link to your competitors and not to you. Semrush works in its own interface, and SEO Skill runs inside your agent."
        />
        <p class="mb-6 max-w-2xl text-base leading-7 text-foreground-muted">
          The{' '}
          <a class="text-foreground underline underline-offset-4" href="https://www.semrush.com/kb/773-backlink-gap" target="_blank" rel="noreferrer">Semrush Backlink Gap tool</a>{' '}
          compares up to five domains at once, yours included, and its Best
          tab shows the domains that link to all your competitors but not to
          you. It is part of Semrush's SEO toolkit, with daily limits set by
          your plan.
        </p>
        <div class="docs-prose max-w-4xl">
          <table>
            <thead><tr><th>Question</th><th>SEO Skill</th></tr></thead>
            <tbody>
              <tr><td>How many sites?</td><td>Yours and 2 to 5 competitors.</td></tr>
              <tr><td>Which sites count?</td><td>Sites that link to two or more competitors and not to you.</td></tr>
              <tr><td>Sorted by</td><td>Domain Rating by <a href="https://ahrefs.com" target="_blank" rel="noreferrer">Ahrefs</a>, highest first.</td></tr>
              <tr><td>Where it runs</td><td>In your agent, or as a command in your terminal.</td></tr>
              <tr><td>What it costs</td><td>Your own DataForSEO or Ahrefs usage, about $0.24 a run with DataForSEO.</td></tr>
            </tbody>
          </table>
        </div>
        <p class="mt-6 max-w-2xl text-base leading-7 text-foreground-muted">
          If you already pay for Semrush and work in its interface, its tool
          does the job. SEO Skill suits you if you want the gap inside the
          agent that writes your outreach list, next to your own Search Console
          data.
        </p>
      </section>

      <SplitList
        id="limits-heading"
        title="What can't a capped backlink list prove?"
        text="It can't prove that a site never links to a competitor. The gap reads each site's top 1,000 referring domains, strongest first."
        items={limits}
      />

      <section class="site-frame" aria-labelledby="related-heading">
        <SectionHeading
          id="related-heading"
          title="Which tools and docs go with a backlink gap?"
          text="The research docs and key setup, two free link tools for any site, and the keyword research that finds your competitors."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {related.map((item) => <HomeCard {...item} link={item.link ?? `${item.title} docs`} />)}
        </div>
      </section>

      <section class="site-frame" aria-labelledby="faq-heading">
        <div class="max-w-2xl">
          <h2 id="faq-heading" class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            Backlink gap questions
          </h2>
        </div>
        <div class="mt-10">
          <FaqAccordion items={faq} id="backlink-gap-faq" />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="start-heading">
        <SectionHeading
          id="start-heading"
          title="Run your first backlink gap"
          text="Add SEO Skill to your agent, save a DataForSEO or Ahrefs key on your account page, and name your site and 2 to 5 competitors."
        />
        <SetupPrompts id="backlink-gap-setup-end" extraSteps={setupSteps} />
      </section>
    </div>
  </main>
</BaseLayout>
