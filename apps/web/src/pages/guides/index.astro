---
import { ChartIncreaseIcon, ComputerTerminal01Icon, GoogleIcon, SourceCodeIcon } from '@hugeicons/core-free-icons'
import { getCollection } from 'astro:content'
import HomeCard from '@/components/HomeCard.astro'
import LandingHero from '@/components/LandingHero.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import { statusGuides } from '@/content/status-guides'
import BaseLayout from '@/layouts/BaseLayout.astro'

const guides = (await getCollection('guides')).sort((a, b) => a.id.localeCompare(b.id))
---

<BaseLayout
  title="SEO guides: indexing reasons, frameworks and progress"
  description="What each Search Console indexing reason means and how to check every URL it covers, plus SEO setups for Astro and Next.js and how to track SEO progress."
  canonicalPath="/guides"
  schemaType="CollectionPage"
  framed={false}
>
  <main data-agent-content>
    <LandingHero
      title="SEO guides"
      lead="What Search Console's indexing reasons mean and what to do about each one, how to build a site search engines and AI agents can read, and how to measure what the work did."
      setupId="guides-setup"
      author
    />

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      <section class="site-frame" aria-labelledby="guides-indexing">
        <SectionHeading id="guides-indexing" title="Search Console indexing reasons" text="Each page in Search Console's indexing report has a reason. These guides say what each one means and how your agent checks every URL it covers." />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          <HomeCard
            title="How to get Google to index your site"
            text="The five steps that get new pages into Google, what keeps them out, and how fast 72 new pages showed up."
            icon={GoogleIcon}
            href="/guides/how-to-get-google-to-index-your-site"
            link="Read the guide"
          />
          {statusGuides.map((guide) => <HomeCard title={guide.title} text={guide.text} icon={guide.icon} href={guide.path} link="Read the guide" />)}
        </div>
      </section>

      <section class="site-frame" aria-labelledby="guides-frameworks">
        <SectionHeading id="guides-frameworks" title="Framework guides" text="The head tags, sitemaps, redirects and build checks for each framework, with the code to copy." />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {
            guides.map((guide) => (
              <HomeCard
                title={guide.data.heading}
                text={guide.data.lead}
                icon={SourceCodeIcon}
                href={`/guides/${guide.id}`}
                link={`${guide.data.heading} guide`}
              />
            ))
          }
          <HomeCard
            title="SEO for developers"
            text="Crawl local and staging builds, give your agent your Search Console, and call the same checks from TypeScript."
            icon={ComputerTerminal01Icon}
            href="/features/seo-for-developers"
            link="SEO for developers"
          />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="guides-measure">
        <SectionHeading id="guides-measure" title="Plan and measure your SEO" text="Set a baseline, plan the work in order and compare the same numbers after each change." />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          <HomeCard
            title="How to track SEO progress"
            text="Save a baseline, record the same numbers every week, and compare equal periods after each change, with the SEO KPIs to track."
            icon={ChartIncreaseIcon}
            href="/guides/how-to-track-seo-progress"
            link="Read the guide"
          />
          <HomeCard
            title="SEO case studies"
            text="A domain move and back, new pages in Google within a week and a new domain's first clicks, with the Search Console numbers."
            icon={ChartIncreaseIcon}
            href="/guides/seo-case-studies"
            link="Read the case studies"
          />
          <HomeCard
            title="SEO plan template"
            text="The headings to fill in and the four steps to work through in order."
            icon={ChartIncreaseIcon}
            href="/guides/seo-plan-template"
            link="Read the template"
          />
          <HomeCard
            title="Blog SEO"
            text="A checklist for every post, where each setting lives in eight CMSs, and how your agent picks the next post."
            icon={ChartIncreaseIcon}
            href="/guides/blog-seo"
            link="Read the guide"
          />
          <HomeCard
            title="SEO audit checklist"
            text="Access, on-page, links and Search Console, each with a free check, and a report template."
            icon={ChartIncreaseIcon}
            href="/guides/seo-audit-checklist"
            link="Read the checklist"
          />
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
