---
// "Built by Ian Nuttall" above a landing page title, with his audience on
// each network. Opens a card that links to the About page. Uses <details>,
// so it works without JavaScript.
import { ArrowDown01Icon } from '@hugeicons/core-free-icons'
import HugeIcon from './HugeIcon.astro'
import { founderSocials } from '@/lib/founder-socials'
import { founder } from '@/lib/site'
---

<details class="founder-badge group relative inline-block text-left">
  <summary class="flex cursor-pointer list-none items-center gap-3 rounded-full bg-background py-1 pr-3 pl-1 text-sm/6 text-foreground shadow-sm ring-1 ring-border-strong hover:ring-foreground/30 focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/20 [&::-webkit-details-marker]:hidden">
    <span aria-hidden="true" class="flex size-7 items-center justify-center rounded-full bg-primary text-xs font-medium text-primary-foreground">IN</span>
    <span>Built by <span class="font-medium">{founder.name}</span></span>
    <span aria-hidden="true" class="hidden h-4 w-px bg-border sm:block"></span>
    <span class="hidden items-center gap-3 text-foreground-muted sm:flex">
      {
        founderSocials.map((item) => (
          <span class="flex items-center gap-1">
            <HugeIcon icon={item.icon} class="size-4 text-foreground" />
            <span class="sr-only">{item.name}:</span>{' '}{item.value}
          </span>
        ))
      }
    </span>
    <HugeIcon icon={ArrowDown01Icon} class="size-4 text-foreground-muted transition-transform group-open:rotate-180" />
  </summary>
  <div class="absolute left-1/2 z-20 mt-2 w-80 max-w-[calc(100vw-2rem)] -translate-x-1/2 rounded-lg bg-muted p-5">
    <p class="text-base/6 font-medium text-foreground">{founder.name}</p>
    <p class="mt-1 text-sm/6 text-foreground-muted">
      More than 20 years in SEO. Founder of Practical Programmatic, a
      programmatic SEO course with over 1,000 students, and of URL Monitor,
      sold for $250,000.
    </p>
    <ul class="mt-4 divide-y divide-border rounded-md bg-background px-3">
      {
        founderSocials.map((item) => (
          <li>
            <a class="flex items-center gap-3 py-2.5 text-sm/6 no-underline hover:underline" href={item.url} target="_blank" rel="noreferrer">
              <HugeIcon icon={item.icon} class="size-5 text-foreground" />
              <span class="font-medium text-foreground">{item.value}</span>
              <span class="text-foreground-muted">{item.unit} on {item.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <a class="mt-4 inline-block text-sm/6 font-medium text-foreground underline underline-offset-4" href={`/about#${founder.anchor}`}>See my background</a>
  </div>
</details>
