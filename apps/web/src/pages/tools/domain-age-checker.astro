---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import PageHeader from '@/components/PageHeader.astro'
import SetupCommands from '@/components/SetupCommands.astro'
import DomainAgeChecker from '@/components/tools/DomainAgeChecker.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: 'Domain age checker' },
]

const faq = [
  {
    question: 'How do I check the age of a domain?',
    answer:
      'Enter the domain above. The checker asks the registry that runs its top-level domain for the registration record and works out the age from the registration date. You can check up to five domains at once and compare them on one timeline.',
  },
  {
    question: 'Is the domain age checker free?',
    answer:
      'Yes, with no account. Each visitor can check 10 domains a day.',
  },
  {
    question: 'Why does the checker say a domain has no RDAP server?',
    answer:
      'Every generic top-level domain such as .com, .org or .dev must publish RDAP, but some country registries do not. For those, use the registry’s own lookup page. The checker says so rather than guessing a date.',
  },
  {
    question: 'Is domain age the same as how long a site has existed?',
    answer:
      'Not always. The date is when the current registration began. A domain that expired and was registered again shows the newer date, and a domain can sit unused for years before any site goes live on it.',
  },
  {
    question: 'Does domain age affect SEO?',
    answer:
      'Google has said that domain age on its own does not help rankings. Older domains often rank well because they have had years to earn links and publish content, not because of the date.',
  },
  {
    question: 'Can I check when a subdomain was created?',
    answer:
      'No. Registries only record registered domains, so a subdomain such as blog.example.com shows the age of example.com.',
  },
  {
    question: 'What is the difference between WHOIS and RDAP?',
    answer:
      'Both read the same registration data. RDAP is the newer standard: structured JSON over HTTPS, served by each registry. ICANN made it the official source for generic top-level domains in 2025.',
  },
]
---

<BaseLayout
  title="Domain age checker"
  description="Check how old any domain is, for free. Get the registration date, expiry, registrar and name servers straight from the registry, and compare up to five domains on a timeline."
  canonicalPath="/tools/domain-age-checker"
  {breadcrumbs}
>
  <main data-agent-content>
    <Breadcrumbs {breadcrumbs} />
    <PageHeader
      title="Domain age checker"
      description="Enter a domain to see when it was registered and how old it is, read live from the registry's own record."
    />

    <DomainAgeChecker />

    <div class="docs-prose mt-16">
      <h2>Read the domain age result</h2>
      <p>
        The big number is the age of the current registration, in years and
        months. Under it, each domain gets its own record from the registry.
      </p>
      <table>
        <thead>
          <tr>
            <th>Field</th>
            <th>What it tells you</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Registered</td>
            <td>The day the current registration began.</td>
          </tr>
          <tr>
            <td>Paid until</td>
            <td>The date the registration runs out unless the owner renews it.</td>
          </tr>
          <tr>
            <td>Last changed</td>
            <td>The last time the record changed, such as a renewal or new name servers.</td>
          </tr>
          <tr>
            <td>Transferred</td>
            <td>The last move to a new registrar, when the registry reports one.</td>
          </tr>
          <tr>
            <td>Registrar and name servers</td>
            <td>Where the domain is registered and which DNS servers answer for it.</td>
          </tr>
        </tbody>
      </table>
      <p>
        Enter several domains and the timeline puts them side by side, so you
        can see at a glance which site has been around longest and which
        registrations run out soon.
      </p>

      <h2>Where the dates come from</h2>
      <p>
        Each top-level domain is run by one registry, and the registry keeps
        the record for every domain under it. The checker reads IANA's{' '}
        <a href="https://data.iana.org/rdap/dns.json" target="_blank" rel="noreferrer">RDAP bootstrap file</a>{' '}
        to find the registry's server, then asks it directly. No third-party
        database sits in between, so the date is the registry's own.
      </p>
      <p>
        RDAP is the standard that replaced WHOIS for generic top-level
        domains. Some country registries still do not offer it, and the
        checker says so rather than guessing. Personal details of the owner
        are usually withheld, so the result does not show who owns a domain.
      </p>

      <h2>Domain age is not the age of the website</h2>
      <p>
        The registration date is when the current owner's registration
        began. If a domain lapsed and someone registered it again, the clock
        restarts. A domain can also be bought years before a site goes live
        on it. To see when a site started getting search traffic, the{' '}
        <a href="/tools/website-traffic-checker">website traffic checker</a>{' '}
        shows a year of estimated history.
      </p>

      <h2>Does domain age matter for SEO?</h2>
      <p>
        Not by itself. Google has said that the age of a domain does not
        help it rank. Old domains often do well for other reasons: years of
        links from other sites, a large body of content and a name people
        search for. A new domain with better pages can and does outrank them.
      </p>
      <p>
        Where age is useful is due diligence. Before you buy a domain, a link
        or a business, a long registration with the same registrar and steady
        name servers is a good sign. A recent registration on a name that
        claims a long history, or a recent transfer, is worth a question.
      </p>

      <h2>Check a domain before you buy it</h2>
      <ul>
        <li>Look at the registration date and any recent transfer here.</li>
        <li>See whether it gets search traffic with the <a href="/tools/website-traffic-checker">website traffic checker</a>.</li>
        <li>Check the strength of its links with the <a href="/tools/domain-rating-checker">Domain Rating checker</a>.</li>
        <li>Look for spam patterns with the <a href="/tools/spam-score-checker">spam score checker</a>.</li>
      </ul>
      <p>
        An expired domain with a big Domain Rating, no traffic and a spam
        score in the high band was usually used for link schemes. Its old
        links are unlikely to help a new site.
      </p>

      <h2>Research a domain with your AI agent</h2>
      <p>
        SEO Skill has no domain age command, so this page is the place for
        the date. Your agent can do the rest of the check. With your own
        DataForSEO or Ahrefs key, <a href="/docs/research">seo research</a>{' '}
        lists the keywords a domain ranks for and the sites that link to it,
        each with a Domain Rating. Ask:
      </p>
      <CodeBlock value="Show the keywords example.com ranks for and its referring domains, and tell me whether its links look natural" wrap />
      <p>Add the hosted MCP server to your agent and sign in with Google:</p>
    </div>

    <SetupCommands id="domain-age-setup" class="mt-6" />

    <div class="docs-prose mt-16">
      <h2>Domain age questions</h2>
    </div>
    <div class="mt-6">
      <FaqAccordion id="domain-age-faq" items={faq} />
    </div>
  </main>
</BaseLayout>
