---
import {
  Analytics01Icon,
  ChartIncreaseIcon,
  Link01Icon,
  LinkSquare02Icon,
} from '@hugeicons/core-free-icons'
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import FounderBadge from '@/components/FounderBadge.astro'
import HomeCard from '@/components/HomeCard.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SetupPrompts from '@/components/SetupPrompts.astro'
import SplitList from '@/components/SplitList.astro'
import ProtectedMetricChecker from '@/components/tools/ProtectedMetricChecker.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: 'Spam score checker' },
]

const measures = [
  {
    title: '18 signals on every crawled page',
    text: 'DataForSEO checks each page it has crawled against 18 signals that spam sites tend to share, then averages the pages for a domain score.',
  },
  { title: 'The domain name itself', text: 'A very short or very long domain name, or a domain full of numbers.' },
  { title: 'The pages on the site', text: 'No contact information, pages served over plain HTTP, and pages with far more outgoing links than internal ones.' },
  {
    title: 'Links pointing at the site are left out',
    text: 'The score describes the site’s own pages. A good site with a few junk links aimed at it can still score low.',
  },
]

const matters = [
  {
    title: 'A quick filter for link work',
    text: 'Before you chase a link from a site, or wonder whether a link to you is a problem, it tells you which sites deserve a closer look.',
  },
  {
    title: 'A few spammy links at you',
    text: 'Google’s disavow guidance says most sites never need to disavow links, so a handful of spammy links pointing at you is usually not worth worrying about.',
    href: 'https://support.google.com/webmasters/answer/2648487',
  },
  {
    title: 'Buying a domain or placing content',
    text: 'It matters more when you are about to buy a domain, accept a guest post or place content on a site. There a high score is a good reason to stop and check.',
  },
]

const review = [
  { title: 'Real pages a person would read', text: 'Or is it mostly ads and outgoing links?' },
  { title: 'Who runs it', text: 'Can you find who runs it and how to contact them?' },
  {
    title: 'Search traffic',
    text: 'Does it rank for anything? Run it through the website traffic checker. A site with links but no search traffic is a warning sign.',
    href: '/tools/website-traffic-checker',
  },
  { title: 'The strength of its own links', text: 'The Domain Rating checker shows that side.', href: '/tools/domain-rating-checker' },
  { title: 'One checker for every site', text: 'Spam scores from different checkers use different signals, so compare sites with one checker only.' },
]

const tools = [
  { title: 'Domain Rating checker', text: 'How strong a site’s own links are, with the Domain Rating by Ahrefs.', href: '/tools/domain-rating-checker', icon: ChartIncreaseIcon, link: 'Check Domain Rating' },
  { title: 'Website traffic checker', text: 'Whether a site ranks for anything, with its estimated Google traffic.', href: '/tools/website-traffic-checker', icon: Analytics01Icon, link: 'Check traffic' },
  { title: 'Backlink checker', text: 'The referring domains, anchor text and strongest linking sites for any domain.', href: '/tools/backlink-checker', icon: Link01Icon, link: 'Check backlinks' },
  { title: 'Link building', text: 'Find sites that link to your competitors and not to you, from your agent.', href: '/features/link-building', icon: LinkSquare02Icon, link: 'See link building' },
]

const faq = [
  {
    question: 'What is a spam score?',
    answer:
      'A 0 to 100 score for how many spam patterns a website’s own pages show. This page uses DataForSEO’s spam score, which checks each page for signals such as an odd domain name, missing contact details, plain HTTP and far more outgoing links than internal ones, then averages the pages.',
  },
  {
    question: 'What is a good spam score?',
    answer:
      'DataForSEO calls 0 to 30 low, 31 to 60 medium and 61 to 100 high. Most normal business sites sit in the low band. A medium score is a reason to look at the site, not a verdict.',
  },
  {
    question: 'Does a high spam score mean Google penalised the site?',
    answer:
      'No. Google does not use this score and does not publish one. A high score means the site shares patterns that spam sites often have. Whether Google acts on a site depends on its own systems and spam policies, which this score cannot see.',
  },
  {
    question: 'How do I check the spam score of my website?',
    answer:
      'Enter your domain above. To check one page, enter its full URL instead. The score covers the pages DataForSEO has crawled, so a new site or a site it has not crawled may come back with no score.',
  },
  {
    question: 'How do I lower my spam score?',
    answer:
      'Fix the patterns behind it on your own pages: serve every page over HTTPS, add real contact details, and cut or improve thin pages that are mostly outgoing links. The score updates when DataForSEO crawls the pages again. You cannot change your domain name, so a long or number-heavy name keeps a few points.',
  },
  {
    question: 'Is this an email spam checker?',
    answer:
      'No. This checks a website for spam patterns, the way an SEO or a link builder would. To test whether an email lands in spam, you need an email deliverability tester.',
  },
]
---

<BaseLayout
  title="Free spam score checker for any domain"
  description="Check the spam score of any website or page for free. See what the 0 to 100 score measures, what counts as low or high, and when it matters for links."
  canonicalPath="/tools/spam-score-checker"
  {breadcrumbs}
  framed={false}
>
  <main data-agent-content>
    <section class="pt-4">
      <div class="site-frame flex flex-col items-center pt-14 text-center sm:pt-20">
        <FounderBadge prefix="Written by AI and" ai />
        <h1 class="mt-4 max-w-3xl text-pretty text-4xl/tight font-medium -tracking-[0.8px] xl:text-5xl/tight xl:-tracking-[1px]">
          Spam score checker
        </h1>
        <p class="mt-4 max-w-2xl text-pretty text-xl/8 font-medium -tracking-[0.2px] text-foreground-muted">
          Check the spam score of your website, a client site, a link prospect
          or one page.
        </p>
      </div>
      <div class="site-frame mt-10 sm:mt-12">
        <ProtectedMetricChecker
          kind="spam-score"
          endpoint="/api/tools/spam-score"
          action="spam-score"
          heading="Check a spam score"
          description="Enter a domain or page URL."
          buttonLabel="Check spam score"
        />
      </div>
    </section>

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      <section class="site-frame" aria-labelledby="bands-heading">
        <SectionHeading
          id="bands-heading"
          title="What is a good spam score?"
          text="Anything from 0 to 30, which DataForSEO calls low. The score runs from 0 to 100 and comes with a band, using DataForSEO's own cut-offs."
        />
        <div class="docs-prose max-w-4xl">
          <table>
            <thead>
              <tr>
                <th>Score</th>
                <th>What it means</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>0 to 30, low</td>
                <td>Normal for most real sites. Nothing to act on.</td>
              </tr>
              <tr>
                <td>31 to 60, medium</td>
                <td>Open the site and look. Often a thin or neglected site, sometimes worse.</td>
              </tr>
              <tr>
                <td>61 to 100, high</td>
                <td>Many spam patterns. Look hard before you link to it or ask it for a link.</td>
              </tr>
            </tbody>
          </table>
          <p>
            "N/A" means DataForSEO has no score for that target, usually
            because it has not crawled the site, so it says nothing about the
            site either way.
          </p>
        </div>
      </section>

      <SplitList
        id="measure-heading"
        title="What does the spam score measure?"
        text="Spam patterns on the site's own pages. DataForSEO checks each crawled page against signals spam sites tend to share and averages them."
        items={measures}
      />

      <SplitList
        id="matters-heading"
        title="When does a spam score matter?"
        text="Mostly in link work, as a quick filter for which sites deserve a closer look."
        items={matters}
      />

      <SplitList
        id="review-heading"
        title="How do you check the site behind a high score?"
        text="Open it and look at what a person would see. These questions cover what the score cannot."
        items={review}
      />

      <SplitList
        id="agent-heading"
        title="How do you review link prospects with your AI agent?"
        text="Ask it, once SEO Skill is connected. Checking one site at a time gets slow on a list of fifty prospects, so your agent pulls the domains linking to a competitor with seo research and your own DataForSEO or Ahrefs key."
        items={[
          { title: 'Domains linking to a competitor', text: 'seo research pulls them with your own DataForSEO or Ahrefs key.', href: '/docs/research' },
          { title: 'Domain Rating on each row', text: 'Ahrefs rows carry a Domain Rating already, and with DataForSEO the first 25 domains get one free.' },
          { title: 'Sites worth a human look', text: 'Your agent can then sort the list and open the sites worth a human look.' },
        ]}
      >
        <div class="mt-6">
          <CodeBlock
            label="Ask your agent"
            prompt
            value="List the referring domains for competitor.example, sort them by Domain Rating, and flag any I should check by hand"
            wrap
          />
        </div>
      </SplitList>

      <section class="site-frame" aria-labelledby="tools-heading">
        <SectionHeading
          id="tools-heading"
          title="Which tools go with a spam score check?"
          text="These, which show a site's own links, its search traffic and who links to it."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {tools.map((item) => <HomeCard {...item} />)}
        </div>
      </section>

      <section class="site-frame" aria-labelledby="faq-heading">
        <div class="max-w-2xl">
          <h2 id="faq-heading" class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            Spam score questions
          </h2>
        </div>
        <div class="mt-10">
          <FaqAccordion items={faq} id="spam-score-faq" />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="start-heading">
        <SectionHeading
          id="start-heading"
          title="Review your link prospects with your agent"
          text="Add SEO Skill to your agent and ask it to sort a competitor's referring domains by Domain Rating and flag the ones to check by hand."
        />
        <SetupPrompts id="spam-score-setup" />
      </section>
    </div>
  </main>
</BaseLayout>
