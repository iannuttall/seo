---
import { BrowserIcon, FileSearchIcon, StarIcon, WebValidationIcon } from '@hugeicons/core-free-icons'
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import FounderBadge from '@/components/FounderBadge.astro'
import HomeCard from '@/components/HomeCard.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SetupPrompts from '@/components/SetupPrompts.astro'
import SplitList from '@/components/SplitList.astro'
import OpenGraphChecker from '@/components/tools/OpenGraphChecker.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: 'Open Graph checker' },
]

const tags = `<meta property="og:title" content="How to brew pour-over coffee">
<meta property="og:description" content="A five-step method with the grind, ratio and timing that work.">
<meta property="og:image" content="https://example.com/images/pour-over-1200x630.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="A glass pour-over brewer on a kitchen scale">
<meta property="og:url" content="https://example.com/guides/pour-over">
<meta property="og:type" content="article">
<meta property="og:site_name" content="Example Coffee">
<meta name="twitter:card" content="summary_large_image">`

const previews = [
  { title: 'The crawler fetches the page and the image', text: 'When someone pastes a link, the platform’s crawler fetches the page, reads the tags in the head and fetches the image.' },
  { title: 'Most crawlers skip JavaScript', text: 'Most of these crawlers do not run JavaScript, so tags added by a script after the page loads are invisible to them.' },
  { title: 'This checker reads the page the same way', text: 'A tag missing here is missing for them too.' },
  { title: 'Platforms cache the result', text: 'Often for days. That is why a fixed page can keep an old preview.' },
  { title: 'X and chat apps lean on Open Graph', text: 'X falls back to Open Graph when its own tags are missing, and chat apps mostly use Open Graph alone.' },
]

const problems = [
  { title: 'No image', text: 'og:image is missing, relative, or points at a file that redirects to a login or returns an error.' },
  { title: 'Old image or title', text: 'The platform cached it. Refresh it in Facebook’s Sharing Debugger or LinkedIn’s Post Inspector.' },
  { title: 'Tiny thumbnail instead of a big card', text: 'The image is under 600×315, or twitter:card is summary rather than summary_large_image.' },
  { title: 'Cropped image', text: 'The image is not close to 1.91:1.' },
  { title: 'Tags present in the browser but missing here', text: 'They are added by JavaScript. Render them on the server.' },
  { title: 'Blocked crawler', text: 'A firewall or bot challenge can stop platform crawlers. If this checker could not fetch the page, they may not either.' },
]

const traffic = [
  { title: 'Shared links bring a second wave of visits', text: 'A page that ranks gets shared in Slack, WhatsApp, LinkedIn and group chats, and a link with a clear title and a sharp image gets clicked more than a bare URL. For many sites, that second wave is a real share of their visits.' },
  { title: 'Titles and descriptions do the same job in Google', text: 'Your title and meta description shape the result in Google. The title and meta description checker shows how those look.', href: '/tools/title-and-meta-description-checker' },
  { title: 'The favicon sits beside your site’s name', text: 'The small icon beside your site’s name in Google’s results and in browser tabs is the favicon. The favicon checker shows whether it is declared and loads.', href: '/tools/favicon-checker' },
]

const tools = [
  { title: 'Title and meta description checker', text: 'How a page’s title and meta description look in Google’s results.', href: '/tools/title-and-meta-description-checker', icon: FileSearchIcon, link: 'Check titles' },
  { title: 'SERP preview', text: 'See a page’s title, URL and meta description in Google on desktop and mobile, with the point where Google cuts them off.', href: '/tools/serp-preview', icon: BrowserIcon, link: 'Preview a result' },
  { title: 'Favicon checker', text: 'Every icon a site declares, with its size and response, and why a favicon is not showing in Google.', href: '/tools/favicon-checker', icon: StarIcon, link: 'Check a favicon' },
  { title: 'SEO crawler', text: 'Crawl any site on your machine, including localhost and staging, for broken links, redirects, titles, canonicals and noindex tags.', href: '/features/seo-crawler', icon: WebValidationIcon, link: 'See the crawler' },
]

const faq = [
  {
    question: 'How do I check my Open Graph tags?',
    answer:
      'Enter the page URL above. The checker reads the page’s head without running JavaScript, the way link preview crawlers do, lists every Open Graph and X tag, fetches the share image and shows how the link will look on Facebook, X and chat apps.',
  },
  {
    question: 'What size should an Open Graph image be?',
    answer:
      '1200×630 pixels, a 1.91:1 shape, as a PNG, JPEG or WebP under 5 MB. That one file works on Facebook, LinkedIn, X, Slack, Discord, WhatsApp and iMessage.',
  },
  {
    question: 'Why is my og:image not showing?',
    answer:
      'Usually one of four things: the tag is missing or added by JavaScript, the image URL returns an error or redirects to a login, the image is too small or an SVG, or the platform cached an older version. The checks above point at which one.',
  },
  {
    question: 'How do I update an old link preview?',
    answer:
      'Platforms cache what they read. Fix the tags, then ask each platform to read the page again: Facebook’s Sharing Debugger and LinkedIn’s Post Inspector both have a button for it. X and chat apps refresh on their own over time.',
  },
  {
    question: 'Do I need twitter: tags as well as Open Graph?',
    answer:
      'Only twitter:card. X reads og:title, og:description and og:image when its own tags are missing, but the card layout has no Open Graph equivalent.',
  },
  {
    question: 'Do Open Graph tags help SEO?',
    answer:
      'Not rankings. Google does not use them to rank pages. They decide how your link looks when people share it, which changes how many people click it in feeds and chats.',
  },
  {
    question: 'Can it check a page behind a login or on localhost?',
    answer:
      'No. Like the platforms themselves, it can only read public HTTPS pages. Publish to a public staging URL to test before launch.',
  },
]
---

<BaseLayout
  title="Free Open Graph checker and link preview tester"
  description="Check any page's Open Graph and X card tags for free. Preview the link on Facebook, X and chat apps, measure the og:image and find what to fix."
  canonicalPath="/tools/open-graph-checker"
  {breadcrumbs}
  framed={false}
>
  <main data-agent-content>
    <section class="pt-4">
      <div class="site-frame flex flex-col items-center pt-14 text-center sm:pt-20">
        <FounderBadge prefix="Written by AI and" ai />
        <h1 class="mt-4 max-w-3xl text-pretty text-4xl/tight font-medium -tracking-[0.8px] xl:text-5xl/tight xl:-tracking-[1px]">
          Open Graph checker
        </h1>
        <p class="mt-4 max-w-2xl text-pretty text-xl/8 font-medium -tracking-[0.2px] text-foreground-muted">
          Enter a URL to see how the link will look when someone shares it,
          and which tags or image problems to fix.
        </p>
      </div>
      <div class="site-frame mt-10 sm:mt-12">
        <OpenGraphChecker />
      </div>
    </section>

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      <section class="site-frame" aria-labelledby="labels-heading">
        <SectionHeading
          id="labels-heading"
          title="What do the Open Graph checker labels mean?"
          text="Each check gets a label that says how much it matters, from Fix down to OK. The previews above them show the link as Facebook and LinkedIn, X and chat apps draw it, from the tags the page has now."
        />
        <div class="docs-prose max-w-4xl">
          <table>
            <thead>
              <tr>
                <th>Label</th>
                <th>What it means</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Fix</td>
                <td>The preview breaks or loses its image on at least one platform.</td>
              </tr>
              <tr>
                <td>Check</td>
                <td>It works, but looks worse than it could, or depends on a fallback.</td>
              </tr>
              <tr>
                <td>Note</td>
                <td>Good to know. Often fine as it is.</td>
              </tr>
              <tr>
                <td>OK</td>
                <td>The tag or image meets the platforms' published rules.</td>
              </tr>
            </tbody>
          </table>
          <p>
            The image card gives the real size, shape and file size of the share
            image, measured from the file itself. The tag table lists every Open Graph and X tag found in the
            head, in order.
          </p>
        </div>
      </section>

      <section class="site-frame" aria-labelledby="size-heading">
        <SectionHeading
          id="size-heading"
          title="What size should an Open Graph image be?"
          text="1200×630 pixels, because one image at that size works everywhere. The limits below are from each platform's own documentation."
        />
        <div class="docs-prose max-w-4xl">
          <table>
            <thead>
              <tr>
                <th>Platform</th>
                <th>What it needs</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Facebook</td>
                <td>At least 200×200. A large card from 600×315. Use 1200×630, at up to 8 MB.</td>
              </tr>
              <tr>
                <td>LinkedIn</td>
                <td>1200×627 or larger, 1.91:1. Up to 5 MB.</td>
              </tr>
              <tr>
                <td>X</td>
                <td>For a large card, at least 300×157, about 2:1. Up to 5 MB. PNG, JPEG, WebP or GIF. SVG does not work.</td>
              </tr>
              <tr>
                <td>Chat apps</td>
                <td>The same 1.91:1 image. Keep the file small, because some apps skip large images.</td>
              </tr>
            </tbody>
          </table>
          <p>
            Keep the text and faces away from the edges. Each platform crops a
            little differently, and a square or tall image is cropped hard to
            fit a wide card.
          </p>
        </div>
      </section>

      <section class="site-frame" aria-labelledby="tags-heading">
        <SectionHeading
          id="tags-heading"
          title="Which Open Graph tags should a page have?"
          text="These, in the head of every page you expect people to share. Write each one for that page instead of one set for the whole site."
        />
        <div class="max-w-4xl">
          <CodeBlock value={tags} />
          <p class="mt-4 text-base leading-7 text-foreground-muted">
            The width, height and alt tags are optional but worth it. Facebook
            shows the image on the very first share only when it knows the size
            in advance, and the alt text is read to people using screen readers.
          </p>
        </div>
      </section>

      <SplitList
        id="previews-heading"
        title="How are link previews built?"
        text="From the tags a platform's crawler finds in the page head, then cached. That explains most previews that look wrong."
        items={previews}
      />

      <SplitList
        id="problems-heading"
        title="How do you fix a broken link preview?"
        text="Find which of these it is, fix the tag or image, then ask the platform to read the page again."
        items={problems}
      />

      <SplitList
        id="traffic-heading"
        title="Do Open Graph tags change search traffic?"
        text="They do not change where a page ranks in Google. They change what happens after, when people share the page."
        items={traffic}
      />

      <SplitList
        id="agent-heading"
        title="How do you check Open Graph tags across your site with your agent?"
        text="With seo crawl, which checks every page it reaches on your own machine. One URL here tells you about one template."
        items={[
          { title: 'Pages missing their tags', text: 'The crawl reports pages with no Open Graph title, description or image, and no X card.', href: '/docs/crawl' },
          { title: 'Fix the template, then check one page', text: 'Your agent can then add the missing tags to the right template and check one page here before it ships.' },
        ]}
      >
        <div class="mt-6">
          <CodeBlock
            label="Ask your agent"
            prompt
            value="Crawl example.com and list the pages missing og:image or twitter:card, grouped by template"
            wrap
          />
        </div>
      </SplitList>

      <section class="site-frame" aria-labelledby="tools-heading">
        <SectionHeading
          id="tools-heading"
          title="Which tools go with an Open Graph check?"
          text="These, which cover how the same page looks in Google's results and the tags across the rest of your site."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {tools.map((item) => <HomeCard {...item} />)}
        </div>
      </section>

      <section class="site-frame" aria-labelledby="faq-heading">
        <div class="max-w-2xl">
          <h2 id="faq-heading" class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            Open Graph questions
          </h2>
        </div>
        <div class="mt-10">
          <FaqAccordion items={faq} id="open-graph-faq" />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="start-heading">
        <SectionHeading
          id="start-heading"
          title="Check Open Graph tags across your whole site"
          text="The crawl runs from the CLI on your machine. Give your agent this prompt and it installs the CLI and adds the hosted MCP server."
        />
        <SetupPrompts id="open-graph-setup" />
      </section>
    </div>
  </main>
</BaseLayout>
