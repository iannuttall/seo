---
import {
  AiChat02Icon,
  Analytics01Icon,
  Key01Icon,
  SearchList01Icon,
} from '@hugeicons/core-free-icons'
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import HomeCard from '@/components/HomeCard.astro'
import LandingHero from '@/components/LandingHero.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SetupPrompts from '@/components/SetupPrompts.astro'
import SplitList from '@/components/SplitList.astro'
import { researchKeyStep } from '@/content/setup-prompts'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Features', href: '/features' },
  { label: 'AI visibility checker' },
]

const setupSteps = [researchKeyStep('dataforseo')]

const setup = [
  { title: 'Save a DataForSEO key', text: 'Save it under Keys on your account page, never in the chat.', href: '/docs/keys' },
  { title: 'DataForSEO bills you directly', text: 'You pay DataForSEO for each check, and SEO Skill adds nothing on top.' },
  { title: 'An Ahrefs key does not run it', text: 'The AI answer check needs DataForSEO.' },
]

const ownQuestions = [
  { title: 'The top 10 questions from Search Console', text: 'The checker takes the top 10 chat-style and long questions from the last 90 days of your Search Console, and shows each one\u2019s impressions beside its answers.' },
  { title: 'Weigh each answer by impressions', text: 'A "neither" on a question with 400 impressions matters more than one on a question with 3.' },
]

const competitor = [
  { title: 'Up to 10 questions you choose', text: 'The target can then be any site, and Google does not need to be connected.' },
  { title: 'Compare your site with a competitor', text: "Run the same questions for your site and a competitor's, and the difference is the list of answers where they get cited and you don't." },
]

const brands = [
  { title: 'Any domain counts as cited', text: 'When you list more than one domain, a citation to any of them counts as cited.' },
  { title: 'Placeholders and images never count', text: "Placeholder sites in an answer, such as yourdomain.com, and images in ChatGPT's answers never count as citations." },
]

const overviews = [
  { title: 'Up to 5 keywords a request', text: 'For each keyword it says whether Google showed an AI Overview, lists the sites it cited, and shows the ranking pages underneath.' },
  { title: 'Domain Rating for each ranking page', text: 'Each ranking page comes with Domain Rating by Ahrefs, free on the hosted MCP.' },
  { title: 'Small sites get cited too', text: 'When we ran that request for the US, Google showed an AI Overview for "free ai visibility checker" that cited 5 sites: ahrefs.com, amplitude.com, honeyb.ai, arobis.ai and seocrawl.ai. The small sites sit next to the big ones, which is a reason to check the AI Overview before you decide a keyword is out of reach.' },
]

const repeat = [
  { title: 'Keep the check the same', text: 'Ask your agent to run the check again on the same site, country and questions, and compare the two results.' },
  { title: 'Save each run in a terminal', text: 'In a terminal, add --json and save each run to a file.', code: '--json' },
  { title: 'Once a month is often enough', text: 'Each answer is one sample, and the same question can get a different answer the next day, so one answer that flips is noise.' },
  { title: 'What a real change looks like', text: 'A question that goes from cited on all 3 engines to none is a real change. Open the pages the answers cite now.' },
]

const visits = [
  { title: 'Visits by source and landing page', text: 'The SEO report overview counts visits from ChatGPT, Perplexity, Claude, Gemini and Copilot by source, with the pages they land on.', href: '/docs/report' },
  { title: 'Treat the number as a minimum', text: 'Only visits that pass a referrer count. An AI app that sends none shows up as Direct traffic.' },
]

const limits = [
  { title: 'Which engines it asks', text: 'The checker asks ChatGPT search, the Gemini app, Google AI Mode and Google AI Overviews. It does not ask Perplexity, Claude or Copilot, although visits from them show in the report.' },
  { title: 'One sample per answer', text: 'Each answer is one sample from one country on one day, without a chat history.' },
  { title: 'A result is no promise', text: 'A "neither" is no proof the engine will never cite you, and a "cited" is no ranking.' },
  { title: 'Finding the questions people ask', text: 'The AI search tracking page covers how SEO Skill finds the questions people ask AI in your Search Console.', href: '/features/ai-search' },
]

const related = [
  { title: 'seo research', text: 'The AI answer check, its options and how to run it from the CLI.', href: '/docs/research', icon: SearchList01Icon },
  { title: 'API keys', text: 'Add a DataForSEO key to the hosted MCP or the CLI.', href: '/docs/keys', icon: Key01Icon },
  { title: 'SEO report', text: 'The AI queries section and visits from AI assistants.', href: '/docs/report', icon: Analytics01Icon },
  { title: 'AI search tracking', text: 'Every way SEO Skill reads AI search, from questions to crawlers.', href: '/features/ai-search', icon: AiChat02Icon, link: 'AI search tracking' },
  { title: 'Free AI visibility checker', text: 'Check a few questions in your browser, with no agent set up.', href: '/tools/ai-visibility-checker', icon: AiChat02Icon, link: 'Free tool' },
  { title: 'AEO and GEO agency', text: 'The weekly work to get cited in AI answers, and how to judge an agency that does it.', href: '/services/aeo-agency', icon: Analytics01Icon, link: 'See the AEO agency page' },
]

const faq = [
  {
    question: 'What does the AI visibility checker check?',
    answer:
      'Whether AI answers cite or mention your site for up to 10 questions, and which other sites they cite. Each answer comes back as cited, mentioned, neither or no AI answer.',
  },
  {
    question: 'How much does an AI visibility check cost?',
    answer:
      'A check of 10 questions costs about 10 cents of DataForSEO credit, billed to your own DataForSEO account. SEO Skill adds nothing on top, and most answers come back in about 15 seconds.',
  },
  {
    question: 'Can I check whether AI cites a competitor?',
    answer:
      'Yes. Give up to 10 questions of your own and the target can be any site, with no Google connection needed. Run the same questions for your site and theirs to see where they get cited and you don\u2019t.',
  },
  {
    question: 'Does SEO Skill track ChatGPT visibility every day?',
    answer:
      'No. It checks AI answers when you ask and stores no history of past checks, and the weekly site audit does not ask AI answers. To follow the same questions over time, ask your agent to run the check again and compare the two results.',
  },
  {
    question: 'What is the difference between cited and mentioned?',
    answer:
      'Cited means the answer lists or links a page on your site. Mentioned means it names your site or brand in its text with no link. A mention is a text match, so when your brand is an everyday phrase, read the answer before you count it as a win.',
  },
]
---

<BaseLayout
  title="AI visibility checker for ChatGPT, Gemini and AI Overviews"
  description="Check whether ChatGPT search, Gemini, Google AI Mode and AI Overviews cite or mention your site for up to 10 questions, and which sites they cite instead."
  canonicalPath="/features/ai-visibility-checker"
  {breadcrumbs}
  framed={false}
>
  <main data-agent-content>
    <LandingHero
      title="AI visibility checker"
      lead="Ask your agent whether ChatGPT search, Gemini, Google AI Mode and Google AI Overviews cite your site for the questions people already ask, and which sites they cite instead."
      setupId="ai-visibility-checker-setup"
      author
      {setupSteps}
    />

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      <section class="site-frame" aria-labelledby="results-heading">
        <SectionHeading
          id="results-heading"
          title="What does the AI visibility checker return for each question?"
          text="One of four results for each answer. It asks up to 10 questions on ChatGPT search, the Gemini app, Google AI Mode and Google AI Overviews, so one check is up to 40 answers."
        />
        <div class="docs-prose max-w-4xl">
          <table>
            <thead><tr><th>Result</th><th>What it means</th></tr></thead>
            <tbody>
              <tr><td>Cited</td><td>The answer lists or links a page on your site.</td></tr>
              <tr><td>Mentioned</td><td>The answer names your site or brand in its text, with no link.</td></tr>
              <tr><td>Neither</td><td>The answer gave no link to your site and did not name it.</td></tr>
              <tr><td>No AI answer</td><td>The engine showed no AI answer for that question.</td></tr>
            </tbody>
          </table>
          <p>
            Every answer also lists the other sites it cites, and the result
            ranks the sites cited most across the whole check. Those are the
            pages the AI used instead of yours, so open them first to see what
            they cover.
          </p>
          <p>
            A check of 10 questions costs about 10 cents of DataForSEO credit, and
            most answers come back in about 15 seconds. It runs when you ask. SEO
            Skill does not run it on a schedule or store a history of past
            checks.
          </p>
        </div>
      </section>

      <SplitList
        id="setup-heading"
        title="How do I set up the AI visibility checker?"
        text="With one prompt. The setup box at the top of this page sets up SEO Skill and asks you to save a DataForSEO key, then you ask your agent like the prompts below."
        items={setup}
      />

      <SplitList
        id="own-questions-heading"
        title="Which questions should I check first?"
        text="The ones real people already ask. When people use Google's AI Mode, or an AI assistant searches the web for them, their questions show up in your Search Console as long, chat-style queries. Connect Google and ask your agent to check them."
        items={ownQuestions}
      >
        <div class="mt-6 space-y-4">
          <CodeBlock label="Ask your agent" prompt value="Check whether AI answers cite example.com for the questions people ask about it" wrap />
          <CodeBlock label="Or run it in a terminal" value="seo research ai_answers --target example.com --country us" wrap />
        </div>
      </SplitList>

      <SplitList
        id="competitor-heading"
        title="Can I check my own questions on a competitor's site?"
        text="Yes. Give up to 10 questions you choose, and the check runs on any site you name."
        items={competitor}
      >
        <div class="mt-6 space-y-4">
          <CodeBlock
            label="Ask your agent"
            prompt
            value={'Ask ChatGPT, AI Mode and AI Overviews "what is the best crm for a small team" and "how do I import contacts into a crm", and check whether they cite competitor.example'}
            wrap
          />
          <CodeBlock
            label="Or run it in a terminal"
            value={'seo research ai_answers --target competitor.example --keywords "what is the best crm for a small team,how do I import contacts into a crm"'}
            wrap
          />
        </div>
      </SplitList>

      <SplitList
        id="brands-heading"
        title="How do I count every domain and brand name I use?"
        text="Tell the checker about them. It counts a mention when the answer names your site, taken from the domain unless you say otherwise, so name your brand when it differs from your domain, and list each domain you run."
        items={brands}
      >
        <div class="mt-6">
          <CodeBlock
            label="Run it in a terminal"
            value={'seo research ai_answers --target example.com --also example.org --brand "Example" --keywords "what is example"'}
            wrap
          />
        </div>
      </SplitList>

      <SplitList
        id="overviews-heading"
        title="How do I check AI Overviews for my keywords?"
        text="Ask for a SERP request. Every check already asks Google AI Overviews each question, and for ordinary keywords a SERP request is a quick AI Overview checker."
        items={overviews}
      >
        <div class="mt-6 space-y-4">
          <CodeBlock label="Ask your agent" prompt value={'Show the top 10 for "free ai visibility checker" and the sites its AI Overview cites'} wrap />
          <p class="text-base leading-7 text-foreground-muted">
            Domain Rating comes from{' '}
            <a class="text-foreground underline underline-offset-4" href="https://ahrefs.com" target="_blank" rel="noreferrer">Ahrefs</a>.
          </p>
        </div>
      </SplitList>

      <section class="site-frame" aria-labelledby="real-check-heading">
        <SectionHeading
          id="real-check-heading"
          title="How often did AI answers name seoskill.dev?"
          text="In 4 of 30 answers, and not one answer cited a page on the site. We checked seoskill.dev in the US with 10 questions of our own, with SEO Skill as the brand, and the 30 answers cost $0.072."
        />
        <div class="docs-prose max-w-4xl">
          <p>
            The questions included "what is the best google search console mcp
            server" and "how can I check if chatgpt cites my website".
          </p>
          <table>
            <thead><tr><th>Result</th><th>Answers (of 30)</th></tr></thead>
            <tbody>
              <tr><td>Cited</td><td>0</td></tr>
              <tr><td>Mentioned</td><td>4</td></tr>
              <tr><td>Neither</td><td>26</td></tr>
              <tr><td>No AI answer</td><td>0</td></tr>
            </tbody>
          </table>
          <p>
            The other sites cited most were github.com (in 12 answers),
            google.com (10), youtube.com (9), reddit.com (5) and ahrefs.com (4).
          </p>
          <p>
            Three of the 4 mentions came from one question, "is there an seo skill
            for claude code", where the brand name is also the words of the
            question. A mention is a text match, so when your brand is an everyday
            phrase, read the answer before you count it as a win. The fourth
            mention came from Google AI Mode for "how do I connect google search
            console to claude code", and it is the one we would open and read
            first.
          </p>
        </div>
      </section>

      <SplitList
        id="repeat-heading"
        title="How do I follow ChatGPT visibility over time?"
        text="Run the same check again and compare the two results. SEO Skill checks AI answers on demand and stores no daily history the way a ChatGPT visibility tracker does, and the paid weekly site audit does not ask AI answers."
        items={repeat}
      >
        <div class="mt-6">
          <CodeBlock
            label="Ask your agent"
            prompt
            value="Run the AI answer check for example.com again with the same 10 questions as last month, and show which answers changed"
            wrap
          />
        </div>
      </SplitList>

      <SplitList
        id="visits-heading"
        title="Which AI assistants send me visits?"
        text="The SEO report shows them once Google Analytics is connected. Citations do not show whether anyone clicked, so the visits are the other half of the picture."
        items={visits}
      >
        <div class="mt-6">
          <CodeBlock
            label="Ask your agent"
            prompt
            value="Which AI assistants sent visits to example.com in the last 28 days, and which pages did they land on?"
            wrap
          />
        </div>
      </SplitList>

      <SplitList
        id="limits-heading"
        title="What can one AI visibility check not prove?"
        text="That an engine will or will not cite you tomorrow. Each answer is one sample, so read a check as a snapshot of the day it ran."
        items={limits}
      />

      <section class="site-frame" aria-labelledby="related-heading">
        <SectionHeading
          id="related-heading"
          title="Which tools and docs go with AI visibility?"
          text="Add a key, read the AI queries in your report, or check a few questions in your browser first."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {related.map((item) => <HomeCard {...item} link={item.link ?? `${item.title} docs`} />)}
        </div>
      </section>

      <section class="site-frame" aria-labelledby="faq-heading">
        <div class="max-w-2xl">
          <h2 id="faq-heading" class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            AI visibility checker questions
          </h2>
        </div>
        <div class="mt-10">
          <FaqAccordion items={faq} id="ai-visibility-checker-faq" />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="start-heading">
        <SectionHeading
          id="start-heading"
          title="Check your AI visibility"
          text="Add SEO Skill to your agent, save a DataForSEO key on your account page, and ask whether AI answers cite your site."
        />
        <SetupPrompts id="ai-visibility-checker-setup-end" extraSteps={setupSteps} />
      </section>
    </div>
  </main>
</BaseLayout>
