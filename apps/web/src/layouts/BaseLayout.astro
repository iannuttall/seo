---
import { ogImageUrl } from '@/lib/og-image-format'
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import { site } from '@/lib/site'
import {
  type PageSchemaType,
  type SchemaBreadcrumb,
  pageSchema,
} from '@/lib/schema'
import { canonicalUrl } from '@/lib/urls'
import '@/styles/globals.css'

type Props = {
  title: string
  titleBrandPosition?: 'prefix' | 'suffix'
  description: string
  framed?: boolean
  canonicalPath?: string
  noindex?: boolean
  // Off for the account pages the hosted MCP serves.
  analytics?: boolean
  schemaType?: PageSchemaType
  breadcrumbs?: readonly SchemaBreadcrumb[]
  dateModified?: string
  datePublished?: string
}

const {
  title,
  titleBrandPosition = 'suffix',
  description,
  framed = true,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  analytics = true,
  schemaType = 'WebPage',
  breadcrumbs,
  dateModified,
  datePublished,
} = Astro.props
const pageTitle =
  titleBrandPosition === 'prefix'
    ? `${site.name} | ${title}`
    : `${title} | ${site.name}`
const canonical = canonicalUrl(canonicalPath)
// Pages kept out of search share the home page's card.
const ogImage = ogImageUrl(noindex ? canonicalUrl('/') : canonical)
const isLocalHost = ['localhost', '127.0.0.1', '::1', '[::1]'].includes(
  Astro.url.hostname,
)
const showClicky =
  analytics && import.meta.env.PROD && !isLocalHost && site.clickySiteId
const schema = pageSchema({
  breadcrumbs,
  canonical,
  dateModified,
  datePublished,
  description,
  title: pageTitle,
  type: schemaType,
})
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#343434" media="(prefers-color-scheme: dark)" />
    {noindex ? <meta name="robots" content="noindex, follow" /> : null}
    <link rel="canonical" href={canonical} />
    {/* Start both font downloads from the HTML, before the stylesheet is parsed. */}
    <link rel="preload" href="/fonts/InterLatinVF.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/JetBrainsMonoLatinVF.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="icon" href="/favicon.svg?v=4" type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={site.name} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    {/* First visit only: the referring site's host, the landing path and any
        utm_* values, kept in a first-party cookie for 30 days. The hosted MCP
        Worker reads it once, when a new person signs up, to record where they
        came from (apps/mcp/src/signup.ts). Never overwritten by later visits. */}
    <script is:inline>
      try {
        const done = document.cookie.split('; ').some((c) => c.startsWith('seo_first='))
        const ref = document.referrer ? new URL(document.referrer).hostname : ''
        if (!done && !navigator.globalPrivacyControl && ref !== location.hostname && !location.pathname.startsWith('/oauth/')) {
          const q = new URLSearchParams(location.search)
          const v = new URLSearchParams()
          const add = (k, x, n) => x && v.set(k, x.slice(0, n))
          add('r', ref, 100)
          add('p', location.pathname, 100)
          add('s', q.get('utm_source'), 60)
          add('m', q.get('utm_medium'), 60)
          add('c', q.get('utm_campaign'), 60)
          document.cookie = `seo_first=${v.toString().slice(0, 400)}; Max-Age=2592000; Path=/; SameSite=Lax; Secure`
        }
      } catch {}
    </script>
    {
      showClicky ? (
        <>
          <script is:inline>
            window.clicky_custom = window.clicky_custom || {}
            window.clicky_custom.cookies_disable = 1
          </script>
          <script
            is:inline
            async
            data-id={site.clickySiteId}
            src="//static.getclicky.com/js"
          />
        </>
      ) : null
    }
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <div class="flex min-h-screen flex-col">
      <Header />
      <div class="flex-1">
        {
          framed ? (
            <div class="site-frame py-10">
              <slot />
            </div>
          ) : (
            <slot />
          )
        }
      </div>
      <Footer />
    </div>
    <script>
      const copyText = async (value: string) => {
        try {
          await navigator.clipboard.writeText(value)
          return true
        } catch {
          return false
        }
      }

      const showCopied = (button: HTMLElement) => {
        const copyIcon = button.querySelector('[data-copy-icon]')
        const checkIcon = button.querySelector('[data-copy-check-icon]')
        const label = button.getAttribute('aria-label') ?? 'Copy code'
        copyIcon?.classList.add('hidden')
        checkIcon?.classList.remove('hidden')
        button.setAttribute('aria-label', 'Copied')
        window.setTimeout(() => {
          copyIcon?.classList.remove('hidden')
          checkIcon?.classList.add('hidden')
          button.setAttribute('aria-label', label)
        }, 1500)
      }

      // Code blocks get their frame at build time; this binds the button.
      document.querySelectorAll('[data-code-copy]').forEach((button) => {
        if (!(button instanceof HTMLElement)) return
        const code = button.closest('.code-frame')?.querySelector('pre code')
        button.addEventListener('click', async () => {
          if (await copyText(code?.textContent ?? '')) showCopied(button)
        })
      })

      // One-click command rows carry their value on the button.
      document.querySelectorAll('[data-copy-value]').forEach((button) => {
        if (!(button instanceof HTMLElement)) return
        button.addEventListener('click', async () => {
          if (await copyText(button.dataset.copyValue ?? '')) showCopied(button)
        })
      })
    </script>
  </body>
</html>
