---
import {
  Alert02Icon,
  Analytics01Icon,
  Briefcase01Icon,
  Calendar03Icon,
  ChartLineData01Icon,
  CheckListIcon,
  FileSearchIcon,
  Key01Icon,
  PieChartIcon,
  Route01Icon,
  Search01Icon,
  SearchList01Icon,
  AiChat02Icon,
  Store01Icon,
  UserGroupIcon,
} from '@hugeicons/core-free-icons'
import FaqAccordion from '@/components/FaqAccordion.astro'
import HomeCard from '@/components/HomeCard.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SetupCommands from '@/components/SetupCommands.astro'
import { getButtonClasses } from '@/components/ui/button'
import { features } from '@/content/features'
import { toolIcon } from '@/content/tool-icons'
import { tools } from '@/content/tools/manifest.mjs'
import BaseLayout from '@/layouts/BaseLayout.astro'

// The four ways agents fail at SEO, from the README, each with the command
// that answers it.
const failures = [
  {
    title: 'It makes things up',
    icon: Analytics01Icon,
    text: 'Ask an agent why traffic dropped and you get a tidy list of possible causes, none of them from your site. The SEO report gives it your totals against the last period, the pages and queries that moved, and the Google updates in between.',
    href: '/docs/report',
  },
  {
    title: 'It trusts keyword tools',
    icon: SearchList01Icon,
    text: 'Keyword tools estimate your traffic from a sample and miss most of the long tail. Your agent starts from Search Console instead. When it needs volumes or competitors, research runs on your own key and stays apart from your real numbers.',
    href: '/docs/research',
  },
  {
    title: "It says it's fixed when it isn't",
    icon: FileSearchIcon,
    text: 'Agents trust their own edits. Then you find the page is still noindexed, still redirecting, or still not in Google. A page check loads the live URL and asks Google whether it is indexed.',
    href: '/docs/page',
  },
  {
    title: 'It drowns in reports',
    icon: CheckListIcon,
    text: 'The first version of this had about 70 reports, and almost nobody used most of them. Now there are eight commands. Each one takes a site or a URL, and every result ends with the command to run next.',
    href: '/docs',
  },
]

const sources = [
  {
    title: 'Search Console',
    icon: Analytics01Icon,
    text: 'Clicks, impressions, click-through rate and position by query and page. Then quick wins, low click-through rates, pages stuck on page two, decay and cannibalization.',
    href: '/docs/report',
  },
  {
    title: 'Google Analytics',
    icon: ChartLineData01Icon,
    text: 'Sessions for the same dates as Search Console, from Google, from every search engine and from all channels. You can tell a search drop from a drop in all traffic.',
    href: '/docs/analytics',
  },
  {
    title: 'Visits from AI assistants',
    icon: AiChat02Icon,
    text: 'Google Analytics visits from ChatGPT, Perplexity, Claude, Gemini and Copilot, by source, with the pages they land on. An AI app that sends no referrer shows up as Direct.',
    href: '/docs/report',
  },
  {
    title: 'Bing Webmaster Tools',
    icon: Search01Icon,
    text: "Bing's clicks and impressions beside Google's for the same dates, and each engine's share. The two are never added together. Runs on your machine with the CLI.",
    href: '/docs/bing',
  },
  {
    title: 'Clicky',
    icon: PieChartIcon,
    text: 'Landing pages from your Clicky sites, counted the way Clicky counts them. A Clicky visit stays a Clicky visit and never becomes a Google Analytics session.',
    href: '/docs/analytics',
  },
  {
    title: 'Google update dates',
    icon: Calendar03Icon,
    text: 'Known Google updates sit next to your traffic, so your agent can see when the timing lines up. Timing that lines up is not proof, and the result says so.',
    href: '/docs/compare',
  },
  {
    title: 'Index status',
    icon: Alert02Icon,
    text: 'Google URL Inspection for one page, or for every page that lost its clicks, with the live page checked at the same time.',
    href: '/docs/indexing',
  },
  {
    title: 'Site crawl',
    icon: Route01Icon,
    text: 'Broken pages, redirects, titles, canonicals and internal links, plus what AI bots can read: robots.txt rules, llms.txt and Markdown copies. Runs on your machine.',
    href: '/docs/crawl',
  },
  {
    title: 'Research with your key',
    icon: Key01Icon,
    text: 'Keyword volumes, search results, competitors and backlinks from your own DataForSEO or Ahrefs account, labelled as estimates and kept apart from your own data.',
    href: '/docs/research',
  },
]

const questions = [
  'Why did clicks drop last month? Was it the core update?',
  'Which pages are close to page one, and what do they rank for?',
  'Is this page indexed? If not, why not?',
  'Which searches does this page show up for that it never mentions?',
  'How many visits came from ChatGPT and Perplexity, and where did they land?',
  "Who am I up against in search, and is there demand for a 'vs' page?",
]

const teams = [
  {
    title: 'Agencies',
    icon: Briefcase01Icon,
    text: "Link each client's Google account on your account page. Every request uses the linked account that can read that site, so one agent can work across all your clients.",
    href: '/docs/mcp',
  },
  {
    title: 'In-house SEO and growth teams',
    icon: UserGroupIcon,
    text: 'Add it to the cloud agents and CI jobs you already run. One account token gives a fresh machine your Google accounts, Bing and keys with nothing else to set up.',
    href: '/docs/cloud-agents',
  },
  {
    title: 'Founders who build with agents',
    icon: Store01Icon,
    text: 'You already work in Claude Code, Codex or Cursor every day. Connect one URL and ask about your own site in the same session where you build it.',
    href: '/docs/getting-started',
  },
]

// The report truth rules from AGENTS.md, in words a buyer can check.
const rules = [
  {
    title: 'Missing data never turns into a zero',
    text: "Zero, missing, filtered, partial and capped stay separate. A capped source can't support an all-clear.",
  },
  {
    title: 'Timing is shown as timing',
    text: 'When a drop lines up with a Google update, the result shows the dates. It never claims the update caused it.',
  },
  {
    title: 'Heuristics carry a label',
    text: 'Rules of thumb, such as how brand terms are picked or one H1 per page, are marked as heuristics. None of them is presented as a Google rule.',
  },
  {
    title: 'Estimates stay apart from your data',
    text: 'DataForSEO and Ahrefs numbers are labelled as research and never blended with Search Console or analytics.',
  },
]

const surfaces = [
  {
    title: 'Hosted MCP',
    text: 'Free, with Google sign-in and nothing to install. Search Console, Google Analytics, Clicky and research.',
    code: 'seoskill.dev/mcp',
    href: '/docs/mcp',
  },
  {
    title: 'CLI',
    text: 'Open source and runs on your machine. Adds the site crawl, internal links and Bing.',
    code: 'npm i -g seo && seo start',
    href: '/docs/cli',
  },
  {
    title: 'API keys',
    text: 'Optional. Your own DataForSEO or Ahrefs account. Save the key encrypted, or send it as a header.',
    code: null,
    href: '/docs/keys',
  },
  {
    title: 'What is stored',
    text: 'Your sign-ins and saved keys, encrypted. Never your search data, your reports or a log of your requests.',
    code: null,
    href: '/docs/privacy',
  },
]

const featuredToolIds = [
  'domain-rating-checker',
  'website-traffic-checker',
  'robots-txt-validator',
  'sitemap-extractor',
  'schema-markup-generator',
  'serp-preview',
]
const featuredTools = featuredToolIds.flatMap((id) => {
  const tool = tools.find((item) => item.id === id)
  return tool ? [tool] : []
})

const faqs = [
  {
    question: 'Is it free?',
    answer:
      'Yes. The hosted MCP and the CLI are free. Research data from DataForSEO or Ahrefs uses your own account with them, so they bill you for what you use.',
  },
  {
    question: 'Does it write content or tell me what to fix?',
    answer:
      'No. It writes no pages and gives no advice. It returns facts from your data, such as which pages lost clicks or which queries sit at position 4 to 10 with a low click-through rate. Your agent shows you the facts and you decide what to change.',
  },
  {
    question: 'Can an agency use it for client sites?',
    answer:
      "Yes. Add each client's Google account on your account page. Each request uses the linked account that can read the site. If none can, the error names your linked accounts so you know which one to add.",
  },
  {
    question: 'What does the hosted MCP store?',
    answer:
      'Only your linked Google and Bing accounts, any API keys and Clicky logins you save, encrypted, and the names of machines you link. It never keeps your Search Console or analytics data, your reports or a log of your requests. You can delete everything on your account page.',
  },
  {
    question: 'Should I use the hosted MCP or the CLI?',
    answer:
      'Start with the hosted MCP if you want the quickest setup. Add the CLI when you want everything on your machine, or need the site crawl, internal links or Bing, which only run locally. Your agent tells you when it needs the CLI.',
  },
  {
    question: 'Which agents does it work with?',
    answer:
      'Any agent that supports remote MCP servers, including Claude Code, Codex, Cursor and Claude on the web. The CLI also adds a skill that teaches your agent which command to run.',
  },
  {
    question: 'Is it open source?',
    answer:
      'Yes. The CLI, both MCP servers and this site are on GitHub under the Apache-2.0 license. Read the code, run your own copy, or build a provider for another analytics tool.',
  },
]
---

<BaseLayout
  title="Open source SEO for agent-native teams"
  titleBrandPosition="prefix"
  description="Give your AI agent your real Search Console, Google Analytics, Bing and Clicky data, Google update dates and a site crawl. Free hosted MCP and open source CLI."
  canonicalPath="/"
  framed={false}
>
  <main data-agent-content>
    <section class="pt-4">
      <div class="site-frame flex flex-col items-center pt-14 text-center sm:pt-20">
        <h1 class="mt-4 max-w-3xl text-pretty text-4xl/tight font-medium -tracking-[0.8px] xl:text-5xl/tight xl:-tracking-[1px]">
          SEO for <span class="whitespace-nowrap">agent-native</span> teams
        </h1>
        <p class="mt-4 max-w-2xl text-pretty text-xl/8 font-medium -tracking-[0.2px] text-foreground-muted">
          The SEO data I give my agents every day, so they work from my real
          numbers instead of guessing.
        </p>
      </div>

      <div class="site-frame mt-10 sm:mt-12">
        <SetupCommands id="home-setup" />
        <p class="mt-6 text-center text-sm text-foreground-muted">
          It's free, and you sign in with Google. The server keeps your sign-ins and saved keys, encrypted, and never your search data.
        </p>
      </div>
    </section>

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      <section class="site-frame" aria-labelledby="why-heading">
        <SectionHeading
          id="why-heading"
          title="Why agents get SEO wrong"
          text="Most AI SEO tools hand your agent generic advice, or estimates from a keyword tool that has never seen your site. You end up with the same pages everyone else is publishing."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {
            failures.map((item) => (
              <HomeCard title={item.title} text={item.text} icon={item.icon} href={item.href} />
            ))
          }
        </div>
      </section>

      <section class="site-frame" aria-labelledby="sources-heading">
        <SectionHeading
          id="sources-heading"
          title="The data your agent works from"
          text="Your own numbers come first, from accounts you already have. Every result gives its dates and its limits, and each source keeps its own metric names."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
          {
            sources.map((item) => (
              <HomeCard title={item.title} text={item.text} icon={item.icon} href={item.href} />
            ))
          }
        </div>
        <p class="mt-6 max-w-2xl text-sm leading-6 text-foreground-muted">
          Coming next: the questions people ask AI assistants that already
          show up in your Search Console.
        </p>
      </section>

      <section class="site-frame grid gap-8 sm:grid-cols-[1fr_1.15fr] sm:items-start">
        <div class="sm:sticky sm:top-24">
          <h2 class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            Questions you can ask it
          </h2>
          <p class="mt-4 text-base leading-7 text-foreground-muted">
            Ask in plain words, the way you would ask a colleague. Your agent
            picks the commands, reads the results and shows you what it found.
          </p>
        </div>
        <ul class="divide-y divide-border rounded-lg bg-muted px-6">
          {
            questions.map((question) => (
              <li class="py-4 text-base leading-7 text-foreground">{question}</li>
            ))
          }
        </ul>
      </section>

      <section class="site-frame" aria-labelledby="teams-heading">
        <SectionHeading
          id="teams-heading"
          title="Built for teams that run agents on real sites"
          text="If search brings in your customers and your agents already ship real work, they should read the same numbers you do."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-3">
          {
            teams.map((item) => (
              <HomeCard title={item.title} text={item.text} icon={item.icon} href={item.href} />
            ))
          }
        </div>
      </section>

      <section class="site-frame grid gap-8 sm:grid-cols-[1fr_1.15fr] sm:items-start">
        <div class="sm:sticky sm:top-24">
          <h2 class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            Your agent decides and you approve
          </h2>
          <p class="mt-4 text-base leading-7 text-foreground-muted">
            SEO Skill gives no advice and writes no pages. It returns facts with
            their dates and limits. Your agent works out what matters, and you
            decide what changes. That only works if the facts are careful, so
            every result follows the same rules.
          </p>
        </div>
        <ul class="divide-y divide-border rounded-lg bg-muted px-6">
          {
            rules.map((rule) => (
              <li class="py-4">
                <h3 class="text-sm font-medium text-foreground">{rule.title}</h3>
                <p class="mt-1 text-sm leading-6 text-foreground-muted">{rule.text}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="site-frame grid gap-8 sm:grid-cols-[1fr_1.15fr] sm:items-start">
        <div class="sm:sticky sm:top-24">
          <h2 class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            Two ways in, same reports
          </h2>
          <p class="mt-4 text-base leading-7 text-foreground-muted">
            The hosted MCP and the CLI run the same code and return the same
            facts. Start with the hosted server. Add the CLI when you want a
            crawl or Bing (your agent will tell you when it needs it).
          </p>
        </div>
        <ul class="divide-y divide-border rounded-lg bg-muted px-6">
          {
            surfaces.map((item) => (
              <li>
              <a
                class="group block py-4 no-underline focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/20"
                href={item.href}
              >
                <span class="flex items-center justify-between gap-4">
                  <span class="text-sm font-medium text-foreground group-hover:underline">{item.title}</span>{' '}
                  {item.code ? (
                    <code class="truncate rounded-md bg-background px-2 py-0.5 font-mono text-xs text-foreground-muted">{item.code}</code>
                  ) : (
                    <span aria-hidden="true" class="text-foreground-soft group-hover:text-foreground">&rarr;</span>
                  )}
                </span>{' '}
                <span class="mt-1 block text-sm leading-6 text-foreground-muted">{item.text}</span>
              </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="site-frame" aria-labelledby="features-heading">
        <SectionHeading
          id="features-heading"
          title="Pick the SEO job"
          text="A Search Console MCP, keyword research, a site audit, or the MCP server that ties them together."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {
            features.map((item) => (
              <HomeCard title={item.title} text={item.text} icon={item.icon} href={item.path} />
            ))
          }
        </div>
      </section>

      <section class="site-frame" aria-labelledby="tools-heading">
        <SectionHeading
          id="tools-heading"
          title="Free SEO tools"
          text="Check a website, a technical file or a keyword list in your browser. No sign-in."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
          {
            featuredTools.map((tool) => (
              <HomeCard title={tool.title} text={tool.description} icon={toolIcon(tool.id)} href={tool.path} />
            ))
          }
        </div>
        <a class:list={[getButtonClasses('secondary', 'lg'), 'mt-6']} href="/tools">
          See all {tools.length} tools
        </a>
      </section>

      <section class="site-frame" aria-labelledby="faq-heading">
        <div class="max-w-2xl">
          <h2 id="faq-heading" class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            Questions about SEO Skill
          </h2>
        </div>
        <div class="mt-10">
          <FaqAccordion items={faqs} id="home-faq" />
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
