GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SEAL_KEY=
# Optional. Ahrefs key used only for the free Domain Rating endpoint.
AHREFS_DR_KEY=
# Bing Webmaster OAuth client, from Bing Webmaster Tools Settings > API access.
BING_CLIENT_ID=
BING_CLIENT_SECRET=
# Optional. Telegram bot and chat for the weekly sign-up, failure and cost
# reports and the cost alerts (cron).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional. Cloudflare API token with Account Analytics: Read, for the
# account's cost estimate in the cost report.
CLOUDFLARE_ANALYTICS_TOKEN=
# Optional. PostShiba API key for alert email; without it email is skipped.
POSTSHIBA_API_KEY=
# Optional. Reply-To address for alert email.
ALERT_REPLY_TO=
# Optional, local checks only: "true" composes alert email without sending.
POSTSHIBA_SANDBOX=
# Optional. Stripe for the paid weekly audit: a restricted secret key and
# the webhook signing secret. Billing stays off until both and the
# STRIPE_PRICE_ID var are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional. SEO Skill's own DataForSEO account, for the paid weekly audit's
# competitor check (src/audit/competitors.ts), and the TypeSafe key for its
# check that a keyword fits the site. The check stays off without DataForSEO.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
TYPESAFE_API_KEY=
# Optional. The secret of SEO Skill's OAuth client at Index My Site (the
# INDEXMYSITE_CLIENT_ID var), for Connect Index My Site on the account page.
# seo submit's Index My Site actions stay off on this server without it.
INDEXMYSITE_CLIENT_SECRET=
