---
import { render } from 'astro:content'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import FounderBadge from '@/components/FounderBadge.astro'
import PageHeader from '@/components/PageHeader.astro'
import SetupCommands from '@/components/SetupCommands.astro'
import { getButtonClasses } from '@/components/ui/button'
import { blogMdxComponents } from '@/components/blog/mdx'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { isPostLive } from '@/content/blog-posts.mjs'
import { type BlogPost, formatPostDate, getBlogPosts } from '@/lib/blog'
import type { SchemaBreadcrumb } from '@/lib/schema'

export async function getStaticPaths() {
  const posts = await getBlogPosts()
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

type Props = { entry: BlogPost }

const { entry } = Astro.props
const { Content } = await render(entry)
const { date, updated, draft, cover } = entry.data
const scheduled = !draft && !isPostLive(date)
const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: entry.data.heading },
]
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={`/blog/${entry.id}`}
  {breadcrumbs}
  schemaType="BlogPosting"
  datePublished={date}
  dateModified={updated ?? date}
  noindex={draft || scheduled}
>
  <main data-agent-content>
    <Breadcrumbs {breadcrumbs} />
    {
      draft ? (
        <p class="mb-6 rounded-lg bg-muted px-4 py-3 text-sm text-foreground" data-agent-markdown="exclude">
          Draft. This post shows in the dev server only and is left out of the production build.
        </p>
      ) : scheduled ? (
        <p class="mb-6 rounded-lg bg-muted px-4 py-3 text-sm text-foreground" data-agent-markdown="exclude">
          Scheduled for {formatPostDate(date)} at 9:00 UK time. Until then it shows in the dev server only.
        </p>
      ) : null
    }
    <PageHeader title={entry.data.heading} description={entry.data.lead} class="!mb-4" />
    <div class="mb-10 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-foreground-muted">
      <FounderBadge prefix="Written by AI and" align="start" ai />
      <span>
        <time datetime={date}>{formatPostDate(date)}</time>
        {updated && updated !== date ? <span>, updated <time datetime={updated}>{formatPostDate(updated)}</time></span> : null}
      </span>
    </div>
    {
      cover ? (
        <img
          src={`/blog/covers/${entry.id}.webp`}
          alt={cover.alt}
          width="1200"
          height="630"
          fetchpriority="high"
          decoding="async"
          class="mb-10 aspect-[1200/630] w-full rounded-lg bg-muted object-cover"
          data-og-cover={cover.title}
        />
      ) : null
    }
    <article class="docs-prose min-w-0">
      <Content components={blogMdxComponents} />
    </article>
    <section class="mt-20 text-center" aria-labelledby="post-cta-heading" data-agent-markdown="exclude">
      <h2 id="post-cta-heading" class="text-pretty text-2xl/tight font-medium -tracking-[0.4px]">
        Run this on your own site with SEO Skill
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-pretty text-base/7 text-foreground-muted">
        Give your AI agent your real Search Console, Google Analytics and Bing data, so its answers about search come from your own numbers instead of a guess.
      </p>
      <a class:list={[getButtonClasses('default', 'lg'), 'mt-6']} href="/account">Get started free</a>
      <SetupCommands id="post-setup" class="mt-8 text-left" />
    </section>
  </main>
</BaseLayout>

