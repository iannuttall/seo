---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'input'>

const { class: className, ...attrs } = Astro.props
---

<input
  class:list={[
    'min-h-12 w-full border border-border bg-background px-3 py-3 font-mono text-sm font-normal text-foreground outline-none transition-colors hover:border-foreground focus-visible:border-primary',
    className,
  ]}
  {...attrs}
/>
