---
import {
  Alert02Icon,
  CodeIcon,
  WebDesign01Icon,
  Share08Icon,
  SmartPhone01Icon,
  TextCheckIcon,
  ViewIcon,
  ViewOffIcon,
  WebValidationIcon,
} from '@hugeicons/core-free-icons'
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import HomeCard from '@/components/HomeCard.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SetupPrompts from '@/components/SetupPrompts.astro'
import SplitList from '@/components/SplitList.astro'
import SerpPreview from '@/components/tools/SerpPreview.astro'
import { getButtonClasses } from '@/components/ui/button'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: 'SEO title checker' },
]

// What the checker reads, in the order a reader needs it.
const checks = [
  {
    title: 'Pixel width on desktop and mobile',
    icon: SmartPhone01Icon,
    text: 'The title and the meta description measured in Google\u2019s own fonts, against the width each device shows, as you type.',
  },
  {
    title: 'The Google result',
    icon: WebDesign01Icon,
    text: 'How the title, the URL and the description look in Google on desktop and mobile, cut where Google would cut them.',
  },
  {
    title: 'Title problems',
    icon: TextCheckIcon,
    text: 'A missing or empty title, more than one title tag, a very short title, a half empty one, a word repeated, and a title that shares no words with the H1.',
  },
  {
    title: 'Meta description problems',
    icon: Alert02Icon,
    text: 'A missing or empty description, more than one, a description that repeats the title, and robots rules that hide the snippet.',
  },
  {
    title: 'Stock phrases',
    icon: CodeIcon,
    text: 'Marketing phrases, buzzwords and AI-sounding words, found with the same rules as seo lint. Each one comes with a fix.',
  },
  {
    title: 'Noindex',
    icon: ViewIcon,
    text: 'A noindex rule on the page, because a perfect title does nothing for a page Google leaves out.',
  },
]

const widths = [
  { title: 'Title on desktop', code: 'about 600px', text: 'Usually 50 to 60 characters in Arial at 20 pixels.' },
  { title: 'Title on mobile', code: 'about 560px', text: 'A little narrower, so the end of a long title goes first.' },
  { title: 'Description on desktop', code: 'about 920px', text: 'Roughly 150 to 160 characters in Arial at 14 pixels.' },
  { title: 'Description on mobile', code: 'about 680px', text: 'Shorter again. Put the useful part in the first line.' },
]

const rewrites = [
  { title: '61.6%', text: 'Of 80,959 titles on 2,370 sites showed a different title in Google, in Zyppy\u2019s study from early 2022.' },
  { title: '99.9%', text: 'Of titles over 70 characters were rewritten in the same study.' },
  { title: '62.78%', text: 'Of meta descriptions were rewritten, in Ahrefs\u2019 study from 2020.' },
  { title: '87%', text: 'Of the time Google uses the title element as it is, by Google\u2019s own count from September 2021.' },
]

const problems = [
  { title: 'Missing or empty', text: 'No title, or an empty title tag. Google builds one from the headings and links on the page.' },
  { title: 'Half empty', text: 'A title such as \u201c | Site Name\u201d, where a template field printed nothing.' },
  { title: 'Too long', text: 'Google cuts it to fit the screen, and often writes its own instead.' },
  { title: 'Keyword stuffing', text: 'The same word three times. Google says there\u2019s no reason for words to appear more than once.' },
  { title: 'Boilerplate', text: 'Hundreds of titles that differ by one word, such as a city name.' },
  { title: 'Out of date', text: '\u201cBest laptops 2024\u201d on a page you updated in 2026.' },
  { title: 'No clear main title', text: 'When the H1 names something else, Google often uses the H1. The checker flags a title and H1 that share no words.' },
]

const descriptions = [
  { title: 'No description tag', text: 'Google builds a snippet from the page text. Write one for pages that matter; thin utility pages can go without.' },
  { title: 'An empty tag', text: 'Google treats it as missing. Look at the template or SEO plugin field, because it is usually empty on every page of that type.' },
  { title: 'nosnippet or max-snippet:0', text: 'Google shows no snippet at all, and the page is left out of AI Overviews and AI Mode as a source. Remove it unless you meant it.' },
]

const writing = [
  { title: 'Lead with the words people search for', text: 'Search Console shows them for every page. Put the main one first.' },
  { title: 'Match the H1', text: 'They do different jobs, but they should name the same thing.' },
  { title: 'Give one true reason to click', text: 'Free, a number, a date or a price, when it is true.' },
  { title: 'Make every title on the site different', text: 'Twenty pages called \u201cProducts\u201d look the same in results.' },
  { title: 'Answer the main search in the description', text: 'Google picks text that matches each search, and a description that answers the main one is the one it keeps.' },
]

const tools = [
  { title: 'SERP preview', text: 'Draft a result with stars, a date or an image and see how the layout changes, then copy the HTML tags.', href: '/tools/serp-preview', icon: WebDesign01Icon, link: 'Open the preview' },
  { title: 'SEO checker', text: 'Check a whole page: access, title, headings, images, links, canonical and structured data.', href: '/tools/seo-checker', icon: WebValidationIcon, link: 'Check a page' },
  { title: 'Open Graph checker', text: 'See the title and image a page shows when it is shared on social sites and in chat apps.', href: '/tools/open-graph-checker', icon: Share08Icon, link: 'Check Open Graph' },
  { title: 'Noindex checker', text: 'Every robots rule on a page, from the meta tags, the headers and robots.txt.', href: '/tools/noindex-checker', icon: ViewOffIcon, link: 'Check noindex' },
]

const faq = [
  {
    question: 'What is an SEO title checker?',
    answer:
      'A tool that reads a page\u2019s title tag, the blue link in Google results, and checks whether it fits, says what the page is and gives Google a reason to keep it. This one checks the meta description the same way and shows both as Google would.',
  },
  {
    question: 'Is this title checker free?',
    answer:
      'Yes, with no account. Typing a title and description checks them in your browser as often as you like. Loading a live page is limited to 10 a day, because each one fetches the page.',
  },
  {
    question: 'How long should a title tag be?',
    answer:
      'Short enough to fit about 600 pixels on desktop and 560 on mobile, which is usually 50 to 60 characters. Google sets no limit. It cuts the title to fit the screen, so measure width, not characters.',
  },
  {
    question: 'How long should a meta description be?',
    answer:
      'About 920 pixels shows on desktop and about 680 on mobile, roughly 150 to 160 characters on desktop. Google sets no limit, and it rewrites most descriptions anyway, so put the useful part first.',
  },
  {
    question: 'Is a meta title the same as a title tag?',
    answer:
      'Yes. Meta title, SEO title, page title and title tag all name the title element in the page head. Google shows it as the title link in results, unless it writes its own.',
  },
  {
    question: 'Does the title tag affect rankings?',
    answer:
      'Yes, a little. John Mueller has said Google uses it for ranking but that it is not the most critical part of a page, so there is no point stuffing it with keywords.',
  },
  {
    question: 'Does the meta description affect rankings?',
    answer:
      'No. Google said so in 2009 and John Mueller repeated it in 2022: Google uses the description for the snippet only. It can still change whether people click.',
  },
  {
    question: 'Why did Google change my title?',
    answer:
      'Google writes its own title link when the title is missing, empty, too long, stuffed with keywords, the same as other pages, half empty or does not match the page. It often uses the H1 instead. Make the title a short, accurate name for the page that matches the main heading.',
    links: [{ text: 'Google writes its own title link', href: 'https://developers.google.com/search/docs/appearance/title-link' }],
  },
  {
    question: 'How do I check the titles on my whole site?',
    answer:
      'Run seo crawl from the SEO Skill CLI, or ask your agent. It lists every missing, empty, repeated and long title and description across the site, and your agent can rewrite them from your Search Console data.',
  },
]
---

<BaseLayout
  title="Free SEO title and meta description checker"
  description="Check a page's SEO title and meta description in pixels on desktop and mobile, see the Google preview, and find the problems that make Google rewrite them. Free, with no account."
  canonicalPath="/tools/title-and-meta-description-checker"
  {breadcrumbs}
  framed={false}
>
  <main data-agent-content>
    <section class="pt-4">
      <div class="site-frame flex flex-col items-center pt-14 text-center sm:pt-20">
        <h1 class="mt-4 max-w-3xl text-pretty text-4xl/tight font-medium -tracking-[0.8px] xl:text-5xl/tight xl:-tracking-[1px]">
          SEO title and meta description checker
        </h1>
        <p class="mt-4 max-w-2xl text-pretty text-xl/8 font-medium -tracking-[0.2px] text-foreground-muted">
          Enter a URL to load its meta title and description, or type your own.
          The checker measures both in pixels on desktop and mobile, shows the
          Google result, and flags what Google is likely to rewrite.
        </p>
      </div>
      <div class="site-frame mt-10 sm:mt-12">
        <SerpPreview />
      </div>
    </section>

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      <section class="site-frame" aria-labelledby="checks-heading">
        <SectionHeading
          id="checks-heading"
          title="What does the SEO title checker check?"
          text="Whether the title and description fit, what Google will show, and the problems that make Google replace them with its own words."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {checks.map((item) => <HomeCard title={item.title} text={item.text} icon={item.icon} />)}
        </div>
      </section>

      <SplitList
        id="length-heading"
        title="How long should an SEO title and meta description be?"
        text="A title fits in about 600 pixels on desktop and 560 on mobile. Google sets no character limit; it cuts the title to the screen width, so sixty narrow letters fit where sixty wide ones don't. These are the widths the checker uses, so keep the important words well inside them."
        items={widths}
      />

      <section class="site-frame" aria-labelledby="rewrite-heading">
        <SectionHeading
          id="rewrite-heading"
          title="How often does Google rewrite titles and descriptions?"
          text="About 6 times in 10, in the outside studies. Google replaces text that doesn't describe the page well enough for the search, and a character count doesn't fix that."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {
            rewrites.map((item) => (
              <div class="rounded-lg bg-muted p-6">
                <p class="text-3xl font-medium -tracking-[0.6px] text-foreground">{item.title}</p>
                <p class="mt-2 text-sm leading-6 text-foreground-muted">{item.text}</p>
              </div>
            ))
          }
        </div>
      </section>

      <SplitList
        id="problems-heading"
        title="Which title problems make Google write its own?"
        text="Google lists seven in its title link guide. The checker flags the ones it can see from one page."
        items={problems}
      >
        <a
          class:list={[getButtonClasses('secondary', 'lg'), 'mt-6']}
          href="https://developers.google.com/search/docs/appearance/title-link"
          target="_blank"
          rel="noreferrer">Read Google's title link guide</a
        >
      </SplitList>

      <SplitList
        id="descriptions-heading"
        title="Is a missing meta description the same as an empty one?"
        text="Google treats them the same, but they are different problems to fix. A missing tag needs writing. An empty tag points at a template field, and a nosnippet rule hides the description whatever it says."
        items={descriptions}
      />

      <SplitList
        id="writing-heading"
        title="How do I write a title and description Google keeps?"
        text="Name the page in the words people search for, match the main heading, and give one true reason to click. A description that answers the main search is the one Google keeps."
        items={writing}
      />

      <section class="site-frame grid gap-8 sm:grid-cols-[1fr_1.15fr] sm:items-start" aria-labelledby="site-heading">
        <div class="sm:sticky sm:top-24">
          <h2 id="site-heading" class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            How do I check every title on my site?
          </h2>
          <p class="mt-4 text-base leading-7 text-foreground-muted">
            Ask your agent. SEO Skill crawls the site for missing, empty,
            repeated and long titles and descriptions, then reads each page's
            own Search Console queries so the new title uses the words people
            already search for.
          </p>
          <a class:list={[getButtonClasses('secondary', 'lg'), 'mt-6']} href="/docs/crawl">See the site crawl</a>
        </div>
        <div class="rounded-lg bg-muted p-6 text-base leading-7 text-foreground-muted">
          <p>
            Start with the titles people already see and skip: pages ranking
            4 to 10 for searches with real impressions, which the SEO report
            lists as quick wins.
          </p>
          <CodeBlock
            prompt
            value="Find my quick wins for example.com, read the Search Console queries for each page, then write a new title and meta description for each and lint them with seo lint --preset meta"
          />
          <CodeBlock label="Or crawl the site in a terminal" value="seo crawl https://example.com" />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="tools-heading">
        <SectionHeading
          id="tools-heading"
          title="Free tools for the rest of the result"
          text="The title and description are two parts of a search result. These check the others, with no account."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {tools.map((item) => <HomeCard {...item} />)}
        </div>
      </section>

      <section class="site-frame" aria-labelledby="faq-heading">
        <div class="max-w-2xl">
          <h2 id="faq-heading" class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            SEO title checker questions
          </h2>
        </div>
        <div class="mt-10">
          <FaqAccordion items={faq} id="title-meta-faq" />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="start-heading">
        <SectionHeading
          id="start-heading"
          title="Rewrite your titles from your own search data"
          text="Add SEO Skill to your agent, sign in with the Google account that can read your Search Console, and ask it which titles to rewrite first."
        />
        <SetupPrompts id="title-meta-setup" />
      </section>
    </div>
  </main>
</BaseLayout>
