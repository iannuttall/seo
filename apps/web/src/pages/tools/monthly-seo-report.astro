---
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHeader from '@/components/PageHeader.astro'
import SetupCommands from '@/components/SetupCommands.astro'
import MonthlyReportBuilder from '@/components/tools/MonthlyReportBuilder.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: 'Monthly SEO report' },
]

const faq = [
  {
    question: "What should a monthly SEO report include?",
    answer:
      "Clicks, impressions, click-through rate and average position against the previous period, the pages and queries that moved most, and short notes on what changed on the site and what comes next.",
  },
  {
    question: "Is this monthly SEO report free?",
    answer:
      "Yes. It builds from your own Search Console export in the browser, with no account, and the export is not uploaded.",
  },
  {
    question: "Should I compare calendar months or 28 days?",
    answer:
      "Either, as long as you keep it the same every month. 28 days has the same mix of weekdays each time, which makes the numbers fairer to compare.",
  },
  {
    question: "Can I send the report to a client?",
    answer:
      "Yes. Download it and send it. Every number comes from Search Console, so the client sees what Google recorded, with your notes on top.",
  },
  {
    question: "Why are my export numbers lower than the Search Console chart?",
    answer:
      "The export’s page and query tables leave out rare and anonymised queries, so they add up to less than the totals. The totals and the chart use all the data.",
  },
]
---

<BaseLayout
  title="Free monthly SEO report from Search Console"
  description="Build a monthly SEO report from a Search Console export in your browser: clicks, impressions, CTR and position against the previous period, top movers and your notes."
  canonicalPath="/tools/monthly-seo-report"
  {breadcrumbs}
>
  <main data-agent-content>
    <Breadcrumbs {breadcrumbs} />
    <PageHeader
      title="Monthly SEO report"
      description="Turn your Search Console export into a month-on-month report you can send, then download it as HTML or Markdown."
    />

    <MonthlyReportBuilder />

    <div class="docs-prose mt-16">
      <h2>Export the right data from Search Console</h2>
      <ol>
        <li>Open <strong>Performance</strong>, then <strong>Search results</strong>.</li>
        <li>
          Open the date filter, choose <strong>Compare</strong> and pick the
          last 28 days against the previous period. For calendar months, use{' '}
          <strong>Custom</strong> and set both months.
        </li>
        <li>Choose <strong>Export</strong>, then <strong>Download CSV</strong>, and drop the zip above.</li>
      </ol>
      <p>
        An export without a comparison works too. Export the last 3 months
        and the report compares the last two complete calendar months. The
        page and query tables then cover the whole export rather than one
        month, and the report says so.
      </p>

      <h2>What goes in the report</h2>
      <ul>
        <li>Clicks, impressions, click-through rate and average position, each against the previous period.</li>
        <li>Daily clicks for both periods on one chart.</li>
        <li>Clicks by device and by country.</li>
        <li>The pages and queries that gained and lost the most clicks.</li>
        <li>Your own notes, word for word.</li>
      </ul>
      <p>
        Every number comes from your export. The report adds no score and no
        advice, so what you send is what Search Console recorded.
      </p>

      <h2>Write the part only you know</h2>
      <p>
        The numbers say what changed. They cannot say why. Use the notes for
        what you shipped this month, anything that broke, and what you will
        check next. Keep what happened apart from what you think caused it,
        and the reader can judge both.
      </p>

      <h2>Read a month-on-month change</h2>
      <p>
        A fall in clicks with flat impressions means fewer people clicked:
        check titles, a new feature on the results page, or a lower
        position. A fall in both means fewer people saw you: rankings or
        demand moved. Average position can rise while clicks fall, because
        losing a query you ranked badly for lifts the average.
      </p>
      <p>
        Many sites are seasonal. A December dip after a strong November may
        be normal. When you have a year of data, compare a month with the
        same month last year as well.
      </p>

      <h2>Have your agent write it every month</h2>
      <p>
        An export only has totals, pages and queries. The{' '}
        <a href="/docs/report">SEO report</a> your agent runs reads
        Search Console directly, so it also finds quick wins, low
        click-through rates, pages losing clicks, queries split across
        several of your pages and the day a traffic drop started, with the
        Google updates around it. It adds Google Analytics sessions for the
        same dates and Bing beside Google when Bing is connected.
      </p>
      <p>
        Ask it on the first of the month and keep the same 28-day window each time, so one
        month compares fairly with the next. Agents that run on a schedule
        can do this without you asking.
      </p>
      <CodeBlock value="Write the monthly SEO report for example.com for last month, compared with the month before" wrap />
      <p>Add the hosted MCP server to your agent and sign in with Google:</p>
    </div>

    <SetupCommands id="monthly-report-setup" class="mt-6" />

    <div class="docs-prose mt-16">
      <h2>Monthly SEO report questions</h2>
    </div>
    <div class="mt-6">
      <FaqAccordion id="monthly-seo-report-faq" items={faq} />
    </div>
  </main>
</BaseLayout>
