---
import { Link01Icon, Route01Icon, SearchList01Icon, WebValidationIcon } from '@hugeicons/core-free-icons'
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import FounderBadge from '@/components/FounderBadge.astro'
import HomeCard from '@/components/HomeCard.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SetupPrompts from '@/components/SetupPrompts.astro'
import SplitList from '@/components/SplitList.astro'
import InternalLinksExplorer from '@/components/tools/InternalLinksExplorer.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { ONLINE_LIMITS } from '@/lib/internal-links-tool'
import type { SchemaBreadcrumb } from '@/lib/schema'

const { freePages, freeRunsPerDay, auditPages, auditRunsPerDay } = ONLINE_LIMITS
const words = ['no', 'one', 'two', 'three', 'four', 'five']
const times = (count: number) => (count < words.length ? `${words[count]} times` : `${count} times`)

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: 'Internal linking tool' },
]

const does = [
  { title: 'Runs here for a site in your Search Console', text: 'On this page it runs on our servers. Sign in with Google, pick the site and wait a minute or two (longer for a big site).' },
  { title: 'Reads the HTML your server sends', text: 'It does not run JavaScript, so a site that only shows its text after JavaScript runs is better checked from your machine.' },
  { title: 'Runs on any site from your machine', text: 'seo internal-links works on any site, with no account.', href: '/docs/internal-links' },
  { title: 'Names the sentence and the link text', text: 'Each suggested link names the page to edit, the page it points to, a real sentence on that page that it fits in, and a real phrase from that sentence to use as the link text.' },
  { title: 'Counts the searches both pages share', text: 'When your Search Console account has the site, it also counts the searches both pages appear for.' },
]

const matching = [
  { title: 'On this page, Jev always judges the links', text: 'It runs on our key, so there is nothing to set up.' },
  { title: 'From your machine, Jev needs your own key', text: 'Without one, links come from text matching, which finds pages that use the same words, and sentences that name the target page.' },
  { title: 'Text matching finds good candidates', text: 'It cannot tell a helpful link from a forced one, so the result says Jev was not used.' },
]

const jev = [
  { title: 'It answers a fixed question with a choice and a probability', text: 'You ask it a question such as “would this link help a reader of this page?”, and it answers with a choice and a probability, such as yes at 82%.' },
  { title: 'It cannot invent a page, sentence or phrase', text: 'Because it only picks an answer and says how sure it is, it cannot invent anything that is not on your site.' },
  { title: 'It is fast and cheap enough for every link', text: 'It can judge every candidate link on a site, which a chat model cannot.' },
  { title: 'Add your key on the Keys tab of your account', text: 'The CLI on your machine uses it once it is linked to your account, which the setup prompt does. You can also set TYPESAFE_API_KEY on your machine to keep the key there. You pay TypeSafe for the requests directly.', href: '/account#keys' },
]

const audit = [
  { title: 'Sorts every page into a type', text: 'Guide, article, tool, product page and so on.' },
  { title: 'Judges each link', text: 'On how likely it is to help a reader, which real sentence it belongs in, which real phrase to use, and what the link does for the reader.' },
  { title: 'Counts a link at 50% and calls it strong at 75%', text: 'A link needs a probability of 50% to count as possible and 75% to count as strong. Fixed rules still apply on top.' },
  { title: 'Only picks among your own pages, sentences and phrases', text: 'It never writes text.' },
  { title: 'Reports what it cost', text: 'The result says how many requests Jev made and what they cost.' },
]

const matter = [
  { title: 'Search engines find pages by following links', text: 'They find most pages this way, and they read the links between your pages as a map of what matters.' },
  { title: 'Linked pages look central to their topic', text: 'A page that many related pages link to looks central. A page nothing links to may not be found at all, and if it is, little tells Google it is important.' },
  { title: 'Link text says what the target is about', text: 'That is why a descriptive phrase beats “click here”.' },
  { title: 'Links move readers', text: 'A link in the right sentence takes someone to the next thing they need, which is the reason to add it in the first place.' },
]

const orphans = [
  { title: 'An orphan page has no links from other pages', text: 'It often happens when a page lives only in the sitemap, or when the pages that linked to it were removed.' },
  { title: 'A weakly linked page has fewer than three content links', text: 'It counts links from other pages’ main content. Navigation and footer links repeat on every page, so they say little about any one page; links in the content are about that page.' },
  { title: 'Start with the pages that need links most', text: 'The tool lists both, so you can work down from the worst.' },
  { title: 'Check whether the crawl hit its page limit', text: 'If it did, the result says so, because pages it did not reach could link to the ones it lists.' },
]

const strategy = [
  { title: 'Link related pages to each other', text: 'Guides on one topic should point to each other where the text calls for it, and to the page that covers the topic best.' },
  { title: 'Link from inside the content', text: 'A link inside a sentence that explains why to click is worth more than one more menu item.' },
  { title: 'Use descriptive link text', text: 'Use the words that describe the target page, as they read naturally in the sentence. Avoid using the same exact phrase every time.' },
  { title: 'Fix links that go through redirects', text: 'Point them straight at the final URL so readers and crawlers skip a hop.' },
  { title: 'Check after you publish', text: 'Run the command again, or a crawl, to confirm the links are live.', href: '/docs/crawl' },
]

const tools = [
  { title: 'seo internal-links', text: 'Audit a whole site or find the pages that should link to one page, from your own machine.', href: '/docs/internal-links', icon: Link01Icon, link: 'Internal links docs' },
  { title: 'SEO crawler', text: 'Crawl the site after you publish, to confirm the new links are live.', href: '/features/seo-crawler', icon: WebValidationIcon, link: 'See the crawler' },
  { title: 'Redirect checker', text: 'Find the final URL for a link that goes through a redirect, so you can link to it directly.', href: '/tools/redirect-checker', icon: Route01Icon, link: 'Trace redirects' },
  { title: 'Keyword clustering tool', text: 'Group keywords by the pages Google ranks, to see which pages belong together.', href: '/tools/keyword-clustering-tool', icon: SearchList01Icon, link: 'Cluster keywords' },
]

const faq = [
  {
    question: 'Is the internal linking tool free?',
    answer: `Yes. On this page, sign in with Google and it crawls up to ${freePages} pages of a site in your Search Console, with Jev judging every link at no cost to you, ${times(freeRunsPerDay)} a day. A site in your weekly site audit, which is a paid plan, gets up to ${auditPages.toLocaleString('en-US')} pages, ${times(auditRunsPerDay)} a day. The command is free and open source too. There Jev needs your own TypeSafe key, and a 500-page site costs about 10 to 20 cents in requests. Without a key it uses text matching and says so.`,
  },
  {
    question: 'What is Jev, and do I need it?',
    answer:
      'Jev is an AI model from TypeSafe AI that answers fixed questions with a choice and a probability instead of writing text. The tool uses it to judge whether each suggested link would help a reader. On this page it runs on our key. From your machine you do not need it: without a TypeSafe key the command still finds links by text matching and says so.',
  },
  {
    question: 'Does it add the links for me?',
    answer:
      'No. It tells you which page to edit, which sentence the link fits in and which phrase to use as the link text. You or your agent make the edit, and a person approves it.',
  },
  {
    question: 'How many internal links should a page have?',
    answer:
      'There is no fixed number. Every important page should have links from a few related pages, in the main content. The tool flags pages with fewer than three such links, and suggests at most eight new links to any one page so no page is flooded.',
  },
  {
    question: 'How does it find orphan pages?',
    answer:
      'It crawls the site, starting from your sitemap when there is one, and records every link on every page. Crawled pages that no other crawled page links to are orphans. Pages only reachable from the sitemap are the usual cause.',
  },
  {
    question: 'Can it crawl a large site?',
    answer: `On this page it crawls up to ${freePages} pages, or up to ${auditPages.toLocaleString('en-US')} for a site in your weekly site audit. The command crawls 500 pages by default; add --max-pages with any number up to 5,000. The result always says how many pages it crawled and whether it hit the limit, because orphan and weak link counts only cover the pages it reached.`,
  },
  {
    question: 'Does it work from the hosted MCP server?',
    answer:
      'Not as an agent tool. The hosted server points your agent to the CLI, which crawls from your own machine and sends your pages nowhere but TypeSafe when you add a key. This page is the exception: sign in with the same Google account and the crawl runs on our servers for a site in your Search Console.',
  },
  {
    question: 'What happens to my site when I run it on this page?',
    answer:
      'Our crawler, SEOSkillBot, reads your pages and follows your robots.txt rules and crawl delay. Page titles, descriptions, headings, a short opening and the sentences that could hold a link go to TypeSafe so Jev can judge them. Your Search Console queries are read to count shared searches and not kept. The crawl is deleted once the result is ready, and we keep the latest result for each site for 24 hours, then delete it too. We also count your runs for the daily limit and the pages crawled.',
  },
  {
    question: 'What is the difference between internal and external links?',
    answer:
      'An internal link points to another page on the same site. An external link points to a different site. Internal links are the ones you fully control, which is why they are one of the quickest things to fix.',
  },
]
---

<BaseLayout
  title="Free internal linking tool for SEO"
  description="Find the internal links your site is missing, placed in sentences you already wrote. Run it here on a site in your Search Console, or from your own machine."
  canonicalPath="/tools/internal-linking-tool"
  {breadcrumbs}
  framed={false}
>
  <main data-agent-content>
    <section class="pt-4">
      <div class="site-frame flex flex-col items-center pt-14 text-center sm:pt-20">
        <FounderBadge prefix="Written by AI and" ai />
        <h1 class="mt-4 max-w-3xl text-pretty text-4xl/tight font-medium -tracking-[0.8px] xl:text-5xl/tight xl:-tracking-[1px]">
          Internal linking tool
        </h1>
        <p class="mt-4 max-w-2xl text-pretty text-xl/8 font-medium -tracking-[0.2px] text-foreground-muted">
          Find the internal links your site is missing, placed in sentences
          you already wrote. Run it here on a site in your Search Console, or
          from your own machine.
        </p>
      </div>
      <div class="site-frame mt-10 sm:mt-12">
        <InternalLinksExplorer />
      </div>
    </section>

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      <SplitList
        id="does-heading"
        title="What does the internal linking tool do?"
        text="It finds pages about the same things that do not link to each other yet. The tool crawls your site, honouring robots.txt and any crawl delay, and reads each page's main content."
        items={does}
      />

      <section class="site-frame" aria-labelledby="commands-heading">
        <SectionHeading
          id="commands-heading"
          title="Which internal-links command should you run?"
          text="The site audit for a whole site, or the page check for one page that needs links. Both run from your machine on any site, with no account."
        />
        <div class="docs-prose max-w-4xl">
          <table>
            <thead>
              <tr>
                <th>Command</th>
                <th>What you get</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><code>--site example.com</code></td>
                <td>Links to add across the site (at most eight to each page), orphan pages, weakly linked pages, links through redirects and links with text like "click here".</td>
              </tr>
              <tr>
                <td><code>--url https://example.com/page</code></td>
                <td>Up to eight pages that should link to that one page.</td>
              </tr>
              <tr>
                <td><code>--max-pages 2000</code></td>
                <td>Site audits only. Crawls more than the default 500 pages, up to 5,000.</td>
              </tr>
            </tbody>
          </table>
          <p>
            The <a href="/docs/internal-links">seo internal-links docs</a> cover every option.
          </p>
        </div>
      </section>

      <SplitList
        id="matching-heading"
        title="Does the tool need Jev to suggest links?"
        text="No. Without Jev it falls back to text matching and says so. Jev is what tells a helpful link from a forced one."
        items={matching}
      />

      <SplitList
        id="jev-heading"
        title="What is Jev?"
        text="An AI model from TypeSafe AI built to make decisions inside software. To use it with the command, get an API key from TypeSafe AI and add it to your account."
        items={jev}
      >
        <p class="mt-6 text-base leading-7 text-foreground-muted">
          Read about
          {' '}<a class="text-foreground underline underline-offset-4" href="https://typesafe.ai" target="_blank" rel="noreferrer">Jev at TypeSafe AI</a>.
        </p>
      </SplitList>

      <SplitList
        id="audit-heading"
        title="What does Jev do in an audit?"
        text="It judges every candidate link with a TypeSafe key, and only among your own pages, sentences and phrases."
        items={audit}
      />

      <SplitList
        id="matter-heading"
        title="Why do internal links matter for SEO?"
        text="Because search engines find pages and judge what matters by following them. Internal links also carry meaning and move readers."
        items={matter}
      />

      <SplitList
        id="orphans-heading"
        title="What are orphan pages and weakly linked pages?"
        text="Pages with no links, or fewer than three, from other pages' main content. Both are the first pages to fix."
        items={orphans}
      />

      <SplitList
        id="strategy-heading"
        title="How do you build an internal linking strategy that lasts?"
        text="Link related pages to each other from inside the content, and check the links after you publish."
        items={strategy}
      />

      <SplitList
        id="agent-heading"
        title="How do you add internal links with your AI agent?"
        text="Ask it to audit the site with seo internal-links, read each suggestion, open the source page and add the link where it helps a reader. The command is built for an agent to run."
        items={[
          { title: 'Runs from the CLI or the local MCP server', text: 'The command runs on your own machine.' },
          { title: 'Checks its own work', text: 'Your agent can then check the work with a crawl.', href: '/docs/crawl' },
          { title: 'A person approves every change', text: 'Your agent shows the edit before it saves.' },
        ]}
      >
        <div class="mt-6">
          <CodeBlock
            label="Ask your agent"
            prompt
            value="Run seo internal-links on example.com, open the strong suggestions, and add each link to the source page in the sentence it names. Show me the diff before you save."
            wrap
          />
        </div>
      </SplitList>

      <section class="site-frame" aria-labelledby="tools-heading">
        <SectionHeading
          id="tools-heading"
          title="Which tools go with an internal linking check?"
          text="These, which cover the command, the crawl that checks your work, redirects to skip and the pages that belong together."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {tools.map((item) => <HomeCard {...item} />)}
        </div>
      </section>

      <section class="site-frame" aria-labelledby="faq-heading">
        <div class="max-w-2xl">
          <h2 id="faq-heading" class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            Internal linking questions
          </h2>
        </div>
        <div class="mt-10">
          <FaqAccordion items={faq} id="internal-links-faq" />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="start-heading">
        <SectionHeading
          id="start-heading"
          title="Add internal links across your site with your agent"
          text="The command runs from the CLI or the local MCP server. Give your agent this prompt and it installs the CLI and adds the hosted MCP server."
        />
        <SetupPrompts id="internal-links-setup" />
      </section>
    </div>
  </main>
</BaseLayout>
