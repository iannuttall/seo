---
import { render } from 'astro:content'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import FounderBadge from '@/components/FounderBadge.astro'
import PageHeader from '@/components/PageHeader.astro'
import { blogMdxComponents } from '@/components/blog/mdx'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { type BlogPost, formatPostDate, getBlogPosts } from '@/lib/blog'
import type { SchemaBreadcrumb } from '@/lib/schema'

export async function getStaticPaths() {
  const posts = await getBlogPosts()
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

type Props = { entry: BlogPost }

const { entry } = Astro.props
const { Content } = await render(entry)
const { date, updated, draft, cover } = entry.data
const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: entry.data.heading },
]
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={`/blog/${entry.id}`}
  {breadcrumbs}
  schemaType="BlogPosting"
  datePublished={date}
  dateModified={updated ?? date}
  noindex={draft}
>
  <main data-agent-content>
    <Breadcrumbs {breadcrumbs} />
    {
      draft ? (
        <p class="mb-6 rounded-lg bg-muted px-4 py-3 text-sm text-foreground" data-agent-markdown="exclude">
          Draft. This post shows in the dev server only and is left out of the production build.
        </p>
      ) : null
    }
    <PageHeader title={entry.data.heading} description={entry.data.lead} class="!mb-4" />
    <div class="mb-10 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-foreground-muted">
      <FounderBadge prefix="Written by AI and" align="start" ai />
      <span>
        <time datetime={date}>{formatPostDate(date)}</time>
        {updated ? <span>, updated <time datetime={updated}>{formatPostDate(updated)}</time></span> : null}
      </span>
    </div>
    {
      cover ? (
        <img
          src={`/blog/covers/${entry.id}.webp`}
          alt={cover.alt}
          width="1200"
          height="630"
          fetchpriority="high"
          decoding="async"
          class="mb-10 aspect-[1200/630] w-full rounded-lg bg-muted object-cover"
          data-og-cover={cover.title}
        />
      ) : null
    }
    <article class="docs-prose min-w-0">
      <Content components={blogMdxComponents} />
    </article>
  </main>
</BaseLayout>

