---
// SEO Skill compared with one alternative, from its fact file, laid out as
// a landing page: the choice first, then the facts side by side.
import BeforeAfter from '@/components/blog/BeforeAfter.astro'
import PlanSteps from '@/components/blog/PlanSteps.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import HomeCard from '@/components/HomeCard.astro'
import LandingHero from '@/components/LandingHero.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SetupPrompts from '@/components/SetupPrompts.astro'
import {
  type CompetitorEntry,
  cell,
  compareRows,
  seoSkillAsTool,
  suiteRows,
  competitors,
  kindIcon,
  reasonsFor,
  searchConsoleRows,
  seoSkill,
  seoSkillBrief,
  suiteTools,
} from '@/content/alternatives'
import { toolIcon } from '@/content/tool-icons'
import { tools } from '@/content/tools/manifest.mjs'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

export function getStaticPaths() {
  return competitors.map((item) => ({ params: { slug: item.slug }, props: { item } }))
}

type Props = { item: CompetitorEntry }
const { item } = Astro.props

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Alternatives', href: '/alternatives' },
  { label: item.short },
]
// SEO suites are found by "free {name} alternative", so their pages lead
// with that phrase and the free web tools that do the same everyday jobs.
const suite = item.kind === 'seo suite'
const freeTools = (suiteTools[item.slug] ?? []).flatMap((id) => tools.filter((tool) => tool.id === id))
const description = suite
  ? `A free ${item.short} alternative with backlink, keyword and traffic tools, plus your own Search Console data in your AI agent, compared on features and price.`
  : `${item.short} alternative: compare it with the free SEO Skill MCP server on setup, tools, AI clients, price and data handling.`
// The next four of the same kind, wrapping round, so every page in a kind
// gets links from its siblings instead of the first four getting them all.
const sameKind = competitors.filter((other) => other.kind === item.kind)
const pool = sameKind.length > 1 ? sameKind : competitors
const start = pool.findIndex((other) => other.slug === item.slug)
const others = [...pool.slice(start + 1), ...pool.slice(0, start)].slice(0, 4)

// A link to the feature page closest to what this alternative does.
const featureLinks: Record<string, { anchor: string; href: string }> = {
  'claude-seo': { anchor: 'Claude SEO skill', href: '/features/claude-seo' },
  'search-console-mcp': { anchor: 'Google Search Console MCP', href: '/features/search-console' },
  'google-analytics-mcp': { anchor: 'Google Analytics MCP server', href: '/features/google-analytics' },
}
const featureLink = featureLinks[item.slug]

const glance = [
  { label: 'Free use', ours: 'Every on-demand tool, no usage cap', theirs: item.freeShort },
  { label: 'Paid', ours: 'From $10 a month, with unlimited sites', theirs: item.priceFrom },
  { label: 'Works in web chat', ours: seoSkill.webChat, theirs: item.webChat },
  { label: suite ? 'Get started' : 'Connect', ours: suite ? 'Free web tools with no account, or one URL in your AI agent' : 'One URL and a Google sign-in', theirs: item.kind === 'self-hosted' ? 'Run it on your own machine' : item.kind === 'skill' ? 'Install it in your agent' : suite ? 'Create an account' : 'Through its own account' },
]

const switchSteps = [
  { title: 'Add SEO Skill to your agent', body: 'Give your agent the setup prompt at the top of this page. It adds the server, and you sign in with Google.' },
  { title: 'Check your access', body: 'Ask "list my Search Console properties". Every Google account you link shows up.' },
  { title: 'Add your research key', body: 'Save a DataForSEO or Ahrefs key on your account page if you use keyword research.' },
  suite
    ? { title: 'Keep what you still need', body: `Projects and history you built in ${item.short} stay there. SEO Skill reads Search Console live, so you can run both while you decide.` }
    : { title: 'Carry your prompts over', body: `Prompts in plain words work as they are. Prompts that name ${item.short}'s own tools need rewording.` },
]

const fits = [
  { name: item.short, lead: `Pick ${item.short} if`, reasons: item.pickIf },
  { name: 'SEO Skill', lead: 'Pick SEO Skill if', reasons: reasonsFor(item) },
]

const faq = [
  { question: `Is SEO Skill a free alternative to ${item.short}?`, answer: `Yes. Every SEO Skill tool your agent calls on demand is free with no usage cap. ${item.short}: ${item.free}` },
  { question: `Does ${item.short} store my data?`, answer: `${item.dataStorage} SEO Skill fetches your Search Console and analytics rows on each request and does not keep them, apart from the issues list and business context your agent saves. For sites in its paid weekly audit it also keeps the crawls and index checks with each page's clicks and impressions.` },
  { question: `Can ${item.short} change anything?`, answer: `${item.writeActions} SEO Skill signs in to Google with read-only access.` },
  {
    question: `Can I use SEO Skill and ${item.short} together?`,
    answer: suite
      ? `Yes. SEO Skill reads your own Search Console and Google Analytics data, which sits fine next to ${item.short}'s index.`
      : 'Yes. Your agent can have several MCP servers connected at once and uses whichever one fits the question.',
  },
]
---

<BaseLayout title={suite ? `Free ${item.short} alternative` : `${item.short} alternative for your AI agent`} {description} canonicalPath={`/alternatives/${item.slug}`} {breadcrumbs} framed={false}>
  <main data-agent-content>
    <LandingHero
      title={suite ? `Free ${item.short} alternative` : `SEO Skill vs ${item.short}`}
      lead={
        suite
          ? `${item.summary} SEO Skill is free, with web tools for the everyday lookups and your own Search Console, Google Analytics and keyword data in your AI agent.`
          : `${item.summary} SEO Skill gives your agent your own Search Console, Google Analytics and keyword data for free, with nothing to install.`
      }
      setupId="alternative-setup"
      author
    />

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      <section class="site-frame" aria-labelledby="glance-heading">
        <SectionHeading
          id="glance-heading"
          title={`How does SEO Skill compare with ${item.short}?`}
          text={`SEO Skill is free for every tool your agent calls on demand, with no usage cap. Free use, price, web chat support and setup decide most comparisons, so they come first, from each product's own pages.`}
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {
            [
              { name: 'SEO Skill', key: 'ours' as const },
              { name: item.short, key: 'theirs' as const },
            ].map((side) => (
              <div class="rounded-lg bg-muted p-6">
                <h3 class="text-base font-medium text-foreground">{side.name}</h3>
                <dl class="mt-4 divide-y divide-border">
                  {glance.map((row) => (
                    <div class="py-3">
                      <dt class="text-sm leading-6 text-foreground-muted">{row.label}</dt>
                      <dd class="text-base leading-7 text-foreground">{row[side.key]}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            ))
          }
        </div>
      </section>

      <section class="site-frame" aria-labelledby="brief-heading">
        <SectionHeading
          id="brief-heading"
          title="What does your agent work from?"
          text={suite
            ? `Your own Search Console, next to ${item.short}'s index. SEO Skill turns your clicks and impressions into a brief with the page to change, the searches it shows for and how to check the fix.`
            : 'SEO Skill reads the Search Console API, then hands your agent a brief with the page to change, the searches it shows for and how to check the fix.'}
        />
        <div class="max-w-3xl">
          <BeforeAfter
            before={searchConsoleRows}
            after={seoSkillBrief}
            title="The same three searches, two ways"
            caption="Real rows from seoskill.dev's own Search Console, for its Google algorithm update checker."
          />
        </div>
      </section>

      {
        freeTools.length ? (
          <section class="site-frame" aria-labelledby="free-tools-heading">
            <SectionHeading
              id="free-tools-heading"
              title={`Which free tools do the jobs you use ${item.short} for?`}
              text="These four, with no account and no key. Each one opens in your browser."
            />
            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
              {freeTools.map((tool) => (
                <HomeCard title={tool.title} text={tool.description} icon={toolIcon(tool.id)} href={tool.path} link={tool.action} />
              ))}
            </div>
          </section>
        ) : null
      }

      <section class="site-frame" aria-labelledby="fit-heading">
        <SectionHeading
          id="fit-heading"
          title={`Which one fits your job, ${item.short} or SEO Skill?`}
          text={suite
            ? `${item.short} if you work from its index and projects. SEO Skill if you want free lookups in your browser and your own search data in your AI agent.`
            : `${item.short} if one of its reasons fits you. SEO Skill if you want one hosted MCP server for your own search data.`}
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {fits.map((side) => (
            <div class="rounded-lg bg-muted p-6">
              <h3 class="text-base font-medium text-foreground">{side.lead}</h3>
              <ul class="mt-4 divide-y divide-border">
                {side.reasons.map((reason) => (
                  <li class="py-3 text-base leading-7 text-foreground-muted">{reason.charAt(0).toUpperCase() + reason.slice(1)}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        {featureLink ? (
          <p class="mt-6 text-base leading-7 text-foreground-muted">
            The <a class="underline underline-offset-4" href={featureLink.href}>{featureLink.anchor}</a> page shows the setup and the prompts to try.
          </p>
        ) : null}
      </section>

      <section class="site-frame" aria-labelledby="side-heading">
        <SectionHeading
          id="side-heading"
          title="How do they compare feature by feature?"
          text={`Row by row below, with ${item.short}'s facts from its own pages.`}
        />
        <div class="rounded-lg bg-muted px-6">
          <div class="hidden gap-6 border-b border-border py-4 text-sm font-medium text-foreground sm:grid sm:grid-cols-[8rem_1fr_1fr]">
            <span></span><span>SEO Skill</span><span>{item.short}</span>
          </div>
          {
            (suite ? suiteRows : compareRows).map(([label, ours, theirs]) => (
              <div class="grid gap-2 border-b border-border py-4 last:border-b-0 sm:grid-cols-[8rem_1fr_1fr] sm:gap-6">
                <span class="text-sm leading-6 font-medium text-foreground">{label}</span>
                <div class="text-sm leading-6 text-foreground-muted">
                  <div class="font-medium text-foreground sm:hidden">SEO Skill</div>
                  <p>{(suite ? seoSkillAsTool : seoSkill)[ours]}</p>
                </div>
                <div class="text-sm leading-6 text-foreground-muted">
                  <div class="font-medium text-foreground sm:hidden">{item.short}</div>
                  <p>{cell(item[theirs])}</p>
                </div>
              </div>
            ))
          }
          {
            item.github ? (
              <div class="grid gap-2 py-4 sm:grid-cols-[8rem_1fr_1fr] sm:gap-6">
                <span class="text-sm leading-6 font-medium text-foreground">GitHub</span>
                <div class="text-sm leading-6 text-foreground-muted">
                  <div class="font-medium text-foreground sm:hidden">SEO Skill</div>
                  <p>
                  <a class="underline underline-offset-4" href="https://github.com/iannuttall/seo" target="_blank" rel="noreferrer">iannuttall/seo</a>
                  </p>
                </div>
                <div class="text-sm leading-6 text-foreground-muted">
                  <div class="font-medium text-foreground sm:hidden">{item.short}</div>
                  <p>
                  {item.github.repo},{' '}
                  {item.github.stars.toLocaleString('en-GB')} stars, last commit {item.github.lastCommit}
                  </p>
                </div>
              </div>
            ) : null
          }
        </div>
      </section>

      <section class="site-frame" aria-labelledby="switch-heading">
        <SectionHeading
          id="switch-heading"
          title={`How do you switch from ${item.short}?`}
          text={`There is nothing to migrate, because SEO Skill reads your accounts live. When you are done, remove ${item.short} from your agent and revoke its access.`}
        />
        <div class="max-w-3xl">
          <PlanSteps steps={switchSteps} />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="more-heading">
        <SectionHeading id="more-heading" title="What are the other alternatives?" text="These give your agent search data too, each compared with SEO Skill." />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {
            others.map((other) => (
              <HomeCard
                title={other.short}
                text={`${other.summary} Paid plans start at ${other.priceFrom}.`}
                icon={kindIcon(other.kind)}
                href={`/alternatives/${other.slug}`}
                link={other.kind === 'seo suite' ? `Free ${other.short} alternative` : `SEO Skill vs ${other.short}`}
              />
            ))
          }
        </div>
      </section>

      <section class="site-frame" aria-labelledby="alt-faq">
        <div class="max-w-2xl">
          <h2 id="alt-faq" class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            Questions about {item.short}
          </h2>
        </div>
        <div class="mt-10">
          <FaqAccordion items={faq} id="alt-faq-list" />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="start-heading">
        <SectionHeading
          id="start-heading"
          title="Try SEO Skill on your own site"
          text="Add SEO Skill to your agent, sign in with Google and ask for your site's quick wins. It reads your Search Console live, so you can keep both while you decide."
        />
        <SetupPrompts id="alternative-setup-end" />
      </section>
    </div>
  </main>
</BaseLayout>
