---
// The SEO Skill mark from the earlier site: two interlocking hooks that form
// an S, with the rank-delta triangles. It is drawn in one colour from
// currentColor, so it is black in light mode and white in dark mode.
type Props = { class?: string; title?: string }

const { class: className = 'size-8', title } = Astro.props
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="116 70 730 694"
  fill="currentColor"
  class={className}
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
>
  {title ? <title>{title}</title> : null}
  <path d="M350.963 300 L569.873 300 L569.873 301.646 L607.572 301.646 A223.005 222.797 0 0 1 830.577 524.443 A223.005 223.562 0 0 1 607.572 748.005 L432.5 748.005 C419.146 748.005 402.821 730.609 402.821 716.5 L402.821 525.14 L350.963 525.14 Z"></path>
  <path d="M351.663 78.757 L540 78.757 C554.614 78.757 570.373 95.892 570.373 110.5 L570.373 301.599 L351.663 301.599 L351.663 524.54 A222.919 222.919 0 0 1 128.744 301.621 A222.919 222.864 0 0 1 351.663 78.757 Z"></path>
  <path d="M615.373 78.657 L814.008 78.657 C833.382 78.657 845.678 101.744 837.508 115.896 L737.067 289.633 C727.659 305.929 702.019 306.871 691.587 288.802 L591.873 115.896 C583.703 101.744 595.999 78.657 615.373 78.657 Z"></path>
  <path d="M353.141 748.251 L154.906 748.251 C135.532 748.251 123.236 725.164 131.406 711.012 L225.797 545.373 C240.447 519.998 264.091 515.719 280.567 544.257 L376.641 711.012 C384.812 725.164 372.515 748.251 353.141 748.251 Z"></path>
</svg>
