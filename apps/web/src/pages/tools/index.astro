---
import NavCard from '@/components/NavCard.astro'
import PageHeader from '@/components/PageHeader.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools' },
]
---

<BaseLayout
  title="Free SEO tools"
  description="Use small web tools for technical SEO and agent-ready files. Each tool has strict processing limits and does not require an account."
  canonicalPath="/tools"
  {breadcrumbs}
  schemaType="CollectionPage"
>
  <main data-agent-content>
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-foreground-muted">
      <ol class="flex flex-wrap items-center gap-1.5">
        {breadcrumbs.map((crumb, index) => (
          <li class="flex items-center gap-1.5">
            {crumb.href ? (
              <a class="underline decoration-border underline-offset-4 hover:decoration-foreground" href={crumb.href}>
                {crumb.label}
              </a>
            ) : (
              <span class="text-foreground">{crumb.label}</span>
            )}
            {index < breadcrumbs.length - 1 ? <span aria-hidden="true" class="text-border">/</span> : null}
          </li>
        ))}
      </ol>
    </nav>

    <PageHeader
      title="Free SEO tools"
      description="Complete a small technical job without an account. Each tool is deliberately narrow, fast, and capped."
      align="left"
    />

    <div class="grid gap-6 sm:grid-cols-2">
      <NavCard
        title="Open the llms.txt generator"
        heading="llms.txt generator"
        description="Create a concise Markdown file for agents and services that explicitly read the llms.txt proposal. Copy it or download it as llms.txt."
        href="/tools/llms-txt-generator"
      />
      <NavCard
        title="Open the llms.txt validator"
        heading="llms.txt validator"
        description="Check a published, pasted, or local llms.txt file for format, section, link, and size problems."
        href="/tools/llms-txt-validator"
      />
      <NavCard
        title="Open the SEO log file analyzer"
        heading="SEO log file analyzer"
        description="Find search and AI crawler requests, error paths, and status codes in an access log. Download the results as CSV."
        href="/tools/server-log-analyzer"
      />
      <NavCard
        title="Open the sitemap URL extractor"
        heading="Sitemap URL extractor"
        description="Follow XML sitemaps and sitemap indexes, filter the extracted URLs, and download CSV, TXT, or JSON files."
        href="/tools/sitemap-extractor"
      />
    </div>

    <section class="docs-prose mt-14" aria-labelledby="larger-audits">
      <h2 id="larger-audits">Run larger audits on your machine</h2>
      <p>
        Browser tools are useful for one file or one decision. Use the{' '}
        <a href="/docs/reports">SEO report catalog</a> when the job needs a crawl,
        Search Console, Google Analytics, or outside keyword and result estimates.
        Reports and credentials stay on your machine.
      </p>
    </section>
  </main>
</BaseLayout>
