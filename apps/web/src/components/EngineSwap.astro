const list = engines.map((id) => ({ id, label: marks[id].label }))
---

<span class="engine-swap" data-engines={JSON.stringify(list)}>
  <span class="engine-icons" aria-hidden="true">
    {
      engines.map((id, index) => (
        <svg viewBox="0 0 24 24" data-engine={id} class:list={['engine-icon', index === 0 && 'is-on']}>
          {id === 'gemini' && (
            <defs>
              <linearGradient id="hero-engine-gemini" x1="0" y1="24" x2="24" y2="0" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#1C7DFF" />
                <stop offset="0.55" stop-color="#7B6CF6" />
                <stop offset="1" stop-color="#E86FA4" />
              </linearGradient>
            </defs>
          )}
          {marks[id].paths.map((path) => <path fill={path.fill} d={path.d} />)}
        </svg>
      ))
    }
  </span><span class="engine-box">{
    engines.map((id) => <span class="engine-sizer" aria-hidden="true" data-label={marks[id].label} />)
  }<span class="engine-label">{marks[engines[0]].label}</span></span>
</span>

<style>
  .engine-swap {
    white-space: nowrap;
  }
  /* An inline block with no text has its baseline at its bottom edge, so
     vertical-align centres the tile on the cap height. */
  .engine-icons {
    position: relative;
    display: inline-block;
    width: 0.82em;
    height: 0.82em;
    margin-right: 0.24em;
    vertical-align: calc((0.71em - 0.82em) / 2);
    border-radius: 0.2em;
    background: var(--background-raised, #fff);
  }
  .engine-icon {
    position: absolute;
    inset: 0.14em;
    width: calc(100% - 0.28em);
    height: calc(100% - 0.28em);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .engine-icon.is-on {
    opacity: 1;
  }
  /* Every name drawn invisibly in one cell sets the width; the live label
     sits on top, out of the flow, so its length never moves the line. */
  .engine-box {
    position: relative;
    display: inline-grid;
    overflow: hidden;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
    text-align: left;
  }
  .engine-sizer {
    grid-area: 1 / 1;
    visibility: hidden;
  }
  .engine-sizer::after {
    content: attr(data-label);
  }
  .engine-label {
    position: absolute;
    inset: 0 auto auto 0;
    white-space: nowrap;
    transition: opacity 0.4s ease, transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .engine-label.is-out {
    opacity: 0;
    transform: translateY(-0.6em);
  }
  .engine-label.is-below {
    opacity: 0;
    transform: translateY(0.6em);
    transition: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .engine-icon,
    .engine-label {
      transition: none;
    }
  }
</style>

<script>
  const HOLD_MS = 2800
  const MOVE_MS = 400
  for (const root of document.querySelectorAll<HTMLElement>('.engine-swap')) {
    const engines = JSON.parse(root.dataset.engines ?? '[]') as { id: string; label: string }[]
    const label = root.querySelector<HTMLElement>('.engine-label')
    const icons = [...root.querySelectorAll<SVGElement>('.engine-icon')]
    if (!label || engines.length < 2) continue
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches
    let index = 0
    const next = () => {
      index = (index + 1) % engines.length
      const engine = engines[index]
      for (const icon of icons) icon.classList.toggle('is-on', icon.dataset.engine === engine.id)
      if (still) {
        label.textContent = engine.label
      } else {
        // The old name slides up and out, the new one comes up from below.
        label.classList.add('is-out')
        setTimeout(() => {
          label.textContent = engine.label
          label.classList.remove('is-out')
          label.classList.add('is-below')
          void label.offsetWidth
          label.classList.remove('is-below')
        }, MOVE_MS)
      }
      setTimeout(next, HOLD_MS)
    }
    setTimeout(next, HOLD_MS)
  }
</script>
