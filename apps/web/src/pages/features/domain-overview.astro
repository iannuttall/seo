import FeaturePage from '@/components/FeaturePage.astro'

const related = [
  { title: 'Website traffic checker', text: 'Estimated monthly Google traffic for any domain, with twelve months of history, in your browser.', href: '/tools/website-traffic-checker', icon: ChartLineData01Icon, link: 'Free tool' },
  { title: 'Domain Rating checker', text: 'Check the Domain Rating of up to 10 sites at once, with no account.', href: '/tools/domain-rating-checker', icon: Analytics01Icon, link: 'Free tool' },
