---
import {
  Analytics01Icon,
  Key01Icon,
  Route01Icon,
  SearchList01Icon,
} from '@hugeicons/core-free-icons'
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import HomeCard from '@/components/HomeCard.astro'
import LandingHero from '@/components/LandingHero.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SetupPrompts from '@/components/SetupPrompts.astro'
import SplitList from '@/components/SplitList.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Features', href: '/features' },
  { label: 'Programmatic SEO with AI agents' },
]

const builds = [
  {
    title: 'A site about classic football shirts, say',
    text: 'Your agent finds the searches people make, collects the data, plans one page for each thing people look for, and builds the pages from that data. You judge the pages as a reader and approve the plan, and the agent does the rest.',
  },
  {
    title: 'Every page is ready for search',
    text: 'Each page has its own title and description, a canonical URL (the one address search engines should list it under), structured data (hidden labels that tell search engines what the page is about), a sharing image drawn from its heading, and a Markdown copy for AI agents.',
  },
  {
    title: 'The site lets search engines and AI answers read it',
    text: 'It also gets an llms.txt, a sitemap index and a robots.txt that lets search engines and AI answers read it.',
  },
  {
    title: 'Every fact shows where it came from',
    text: 'Each fact on a page shows its source and the date it was checked.',
  },
]

const start = [
  {
    title: 'Any coding agent that can run commands works',
    text: 'Claude Code, Codex, Cursor and Amp all do. Give it the prompt in an empty folder.',
  },
  {
    title: 'seo site new copies the starter',
    text: 'It installs the starter’s packages and prints the first step.',
  },
  {
    title: 'The starter is a small working site about parks',
    text: 'You can see every part before the agent replaces it with your data.',
  },
]

const keyData = [
  {
    title: 'Without a key',
    text: 'Your agent plans the site from the live search results, and then from your own Search Console once the site is live.',
  },
  {
    title: 'With a DataForSEO or Ahrefs key',
    text: 'seo research adds search volumes, difficulty, the pages that rank and the keywords competitors get traffic from.',
  },
  {
    title: 'Save the key on your account page',
    text: 'The provider bills you directly for what you use.',
    href: '/docs/keys',
  },
  {
    title: 'Compare what each provider returns',
    text: 'The keyword research tool page explains it.',
    href: '/features/keyword-research',
  },
]

const costs = [
  {
    title: 'The seo tools are free and open source',
    text: 'The seo CLI, the starter, the guide and the check cost nothing.',
  },
  {
    title: 'You pay for the domain',
    text: 'You pay for keyword data only if you choose a key.',
  },
  {
    title: 'Hosting starts on the free plan',
    text: 'The site runs on Cloudflare’s free plan until it outgrows it (and a static site takes a long time to do that).',
  },
]

const related = [
  { title: 'seo research', text: 'Search volumes, search result pages and competitor keywords for the market step.', href: '/docs/research', icon: SearchList01Icon },
  { title: 'API keys', text: 'Save a DataForSEO or Ahrefs key on your account page.', href: '/docs/keys', icon: Key01Icon },
  { title: 'seo crawl', text: 'Crawl the live site after launch and list technical issues.', href: '/docs/crawl', icon: Route01Icon },
  { title: 'seo report', text: 'The weekly Search Console report once the site gets impressions.', href: '/docs/report', icon: Analytics01Icon },
]

const faq = [
  {
    question: 'What is programmatic SEO with an AI agent?',
    answer:
      'Your agent finds the searches people make, collects the data, plans one page for each thing people look for, and builds the pages from that data. You judge the pages as a reader and approve the plan.',
  },
  {
    question: 'Which agents can build the site?',
    answer: 'Any coding agent that can run commands, such as Claude Code, Codex, Cursor or Amp.',
  },
  {
    question: 'How does it stop thin pages?',
    answer:
      'The starter’s build ends with seo site check. When a rule for pages, copy, design or data fails, the build fails and Cloudflare does not deploy it. Google’s spam policies describe scaled content abuse as many pages made mainly to manipulate search rankings that do little for readers.',
    links: [{ text: 'spam policies', href: 'https://developers.google.com/search/docs/essentials/spam-policies#scaled-content' }],
  },
  {
    question: 'Do I need a keyword data key?',
    answer:
      'No. Without a key your agent plans from the live search results, then from your own Search Console once the site is live. A DataForSEO or Ahrefs key adds search volumes, difficulty and competitor keywords, and the provider bills you directly.',
  },
  {
    question: 'What does a programmatic SEO site cost?',
    answer:
      'The seo CLI, the starter, the guide and the check are free and open source. A domain on Cloudflare Registrar is about $10 a year, and the site runs on Cloudflare’s free plan until it outgrows it.',
  },
]
---

<BaseLayout
  title="Programmatic SEO tool for AI agents"
  description="A free programmatic SEO tool for AI agents. Your agent builds a data-driven Astro site on Cloudflare step by step, and a build check stops thin or broken pages."
  canonicalPath="/features/programmatic-seo"
  {breadcrumbs}
  framed={false}
>
  <main data-agent-content>
    <LandingHero
      title="Programmatic SEO with AI agents"
      lead="Tell your agent what the site is about. It builds a site from real data on Astro and Cloudflare, one step at a time, and every build is checked before it can go live."
      setupId="programmatic-seo-setup"
      author
    />

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      <SplitList
        id="builds-heading"
        title="What does your agent build?"
        text="A static site on Cloudflare, built from real data with one page for each thing people search for."
        items={builds}
      />

      <SplitList
        id="start-site-heading"
        title="How do I start a programmatic SEO site?"
        text="Give your coding agent one prompt in an empty folder. It installs the CLI if needed, copies the starter and follows the guide step by step."
        items={start}
      >
        <div class="mt-6">
          <CodeBlock
            label="Ask your agent"
            prompt
            value={`If seo --version fails, install the SEO Skill CLI with npm i -g seo, and install the current LTS release of Node.js first if it is missing. Then run seo site new my-site --name "My Site", run seo site guide setup and follow it step by step. Ask me only for decisions about my site and data.`}
            wrap
          />
        </div>
      </SplitList>

      <section class="site-frame" aria-labelledby="steps-heading">
        <SectionHeading
          id="steps-heading"
          title="Which steps does your agent follow?"
          text="Ten steps, each printed by seo site guide with the step's name, so the agent reads only what it needs now. Each step ends with the next one."
        />
        <div class="docs-prose max-w-4xl">
          <table>
            <thead><tr><th>Step</th><th>What happens</th><th>What you decide</th></tr></thead>
            <tbody>
              <tr><td>setup</td><td>Signs you in to GitHub, Cloudflare and SEO Skill, one account at a time.</td><td>Free or paid keyword data</td></tr>
              <tr><td>market</td><td>Finds the main searches, who ranks for them and how strong they are.</td><td>Go or no go</td></tr>
              <tr><td>data</td><td>Collects, cleans and joins the data, with a source and date for every fact.</td><td>How often it refreshes</td></tr>
              <tr><td>plan</td><td>Maps each search to one page type and URL, with a page count.</td><td>The page list and the domain</td></tr>
              <tr><td>build</td><td>Starts the site and deploys a private preview behind Cloudflare Access.</td><td>Nothing at this step</td></tr>
              <tr><td>golden page</td><td>Builds one page with real data and shows you screenshots.</td><td>Whether it is good enough</td></tr>
              <tr><td>writing</td><td>Writes page text from the facts, so pages read differently.</td><td>The sections of a page</td></tr>
              <tr><td>scale</td><td>Turns the golden page into every page and reviews a sample.</td><td>A sample of each page type</td></tr>
              <tr><td>launch</td><td>Puts the site on your domain and sends each deploy's changed pages to IndexNow, a service that tells Bing and other search engines to crawl them again.</td><td>Adding Search Console and Bing</td></tr>
              <tr><td>grow</td><td>Reads your Search Console every week and keeps the data current.</td><td>What to act on</td></tr>
            </tbody>
          </table>
          <p>
            Your agent runs <code>seo site guide &lt;step&gt;</code> to print
            the instructions for one step.
          </p>
        </div>
      </section>

      <section class="site-frame" aria-labelledby="check-heading">
        <SectionHeading
          id="check-heading"
          title="What does seo site check stop?"
          text="It stops any build that breaks a rule for pages, copy, design or data. The starter's build ends with seo site check, and when a rule fails, the build fails and Cloudflare does not deploy it."
        />
        <div class="docs-prose max-w-4xl">
          <p>
            It runs the{' '}
            <a class="text-foreground underline underline-offset-4" href="/docs/crawl">site crawl</a>'s
            page checks on every built page, plus rules for copy, design and
            data.
          </p>
          <table>
            <thead><tr><th>Area</th><th>What fails the build</th></tr></thead>
            <tbody>
              <tr><td>Pages</td><td>A missing, duplicate or overlong title or description, more or fewer than one H1, a wrong canonical URL, broken links, a page left out of the sitemap, a noindex tag (which tells search engines to leave the page out of their results), FAQ markup (the structured data for questions and answers) that does not match the questions on the page, and a missing sharing image or Markdown copy.</td></tr>
              <tr><td>Copy</td><td>Dashes and semicolons, hype words from a list of words to cut, "it's not X, it's Y" lines, openings such as "in this guide", talk about the tools or search terms, and "coming soon".</td></tr>
              <tr><td>Design</td><td>Uppercase or letter-spaced labels, gradients, shadows, coloured left borders and card grids wider than two columns.</td></tr>
              <tr><td>Data</td><td>A fact block without a link to its source or without the date it was checked.</td></tr>
            </tbody>
          </table>
          <p>
            The point is to make thin pages hard to ship. Google's{' '}
            <a class="text-foreground underline underline-offset-4" href="https://developers.google.com/search/docs/essentials/spam-policies#scaled-content" target="_blank" rel="noreferrer">spam policies</a>{' '}
            describe scaled content abuse as many pages made mainly to
            manipulate search rankings that do little for readers. The guide
            and the check hold your agent to what makes a page worth having:
            real data, one page for each search and a source on every fact.
          </p>
        </div>
      </section>

      <section class="site-frame" aria-labelledby="accounts-heading">
        <SectionHeading
          id="accounts-heading"
          title="Which accounts do I need, and what do they cost?"
          text="GitHub, Cloudflare, a domain, Search Console, Bing Webmaster Tools and SEO Skill. Only the domain costs money, unless you add a keyword data provider."
        />
        <div class="docs-prose max-w-4xl">
          <table>
            <thead><tr><th>Account</th><th>What it is for</th><th>Cost</th></tr></thead>
            <tbody>
              <tr><td>GitHub</td><td>Holds the site's code and the data refresh job</td><td>Free</td></tr>
              <tr><td>Cloudflare</td><td>Hosts the site and runs the build</td><td>The free plan is enough for a static site</td></tr>
              <tr><td>A domain</td><td>The site's address, bought on Cloudflare Registrar</td><td>About $10 a year</td></tr>
              <tr><td>Google Search Console and Bing Webmaster Tools</td><td>Indexing and the searches that find the site</td><td>Free</td></tr>
              <tr><td>SEO Skill</td><td>Search Console reports for your agent</td><td>Free</td></tr>
              <tr><td>DataForSEO or Ahrefs</td><td>Search volumes and competitor keywords, if you want them</td><td>Optional, the provider bills you</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <SplitList
        id="keywords-heading"
        title="Do I need my own keyword data key?"
        text="No. Without a key, your agent plans the site from the live search results and then from your own Search Console. A DataForSEO or Ahrefs key adds search volumes and competitor keywords."
        items={keyData}
      />

      <SplitList
        id="cost-heading"
        title="What does programmatic SEO with SEO Skill cost?"
        text="Only the domain, unless you choose a keyword data key. The seo CLI, the starter, the guide and the check are free and open source."
        items={costs}
      />

      <section class="site-frame" aria-labelledby="related-heading">
        <SectionHeading
          id="related-heading"
          title="Which docs go with programmatic SEO?"
          text="Research for the market step, keys for keyword data, then the crawl and the report once the site is live."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {related.map((item) => <HomeCard {...item} link={`${item.title} docs`} />)}
        </div>
      </section>

      <section class="site-frame" aria-labelledby="faq-heading">
        <div class="max-w-2xl">
          <h2 id="faq-heading" class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            Programmatic SEO questions
          </h2>
        </div>
        <div class="mt-10">
          <FaqAccordion items={faq} id="programmatic-seo-faq" />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="start-heading">
        <SectionHeading
          id="start-heading"
          title="Build your first programmatic SEO site"
          text="Add SEO Skill to your agent, then give it the site prompt above in an empty folder and approve each step it shows you."
        />
        <SetupPrompts id="programmatic-seo-setup-end" />
      </section>
    </div>
  </main>
</BaseLayout>
