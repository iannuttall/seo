---
import HomeCard from '@/components/HomeCard.astro'
import PageHeader from '@/components/PageHeader.astro'
import { features } from '@/content/features'
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout
  title="Open source SEO tools for AI agents"
  description="Open source SEO tools for AI agents: a Google Search Console MCP, Google Analytics for SEO, AI search tracking, a Google update checker, keyword research and a site audit."
  canonicalPath="/features"
  schemaType="CollectionPage"
>
  <main data-agent-content>
    <PageHeader
      title="Open source SEO tools for AI agents"
      description="Give your agent your real search and analytics data, so it works from your numbers instead of guessing."
    />

    <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
      {features.map((item) => <HomeCard title={item.title} text={item.text} icon={item.icon} href={item.path} />)}
    </div>

    <section class="docs-prose mt-14" aria-labelledby="get-started">
      <h2 id="get-started">Start in a minute</h2>
      <p>
        Connect the hosted MCP and sign in with Google, or install the CLI on
        your machine. The <a href="/docs/getting-started">getting started
        guide</a> walks through both.
      </p>
    </section>
  </main>
</BaseLayout>
