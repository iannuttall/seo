---
import HomeCard from '@/components/HomeCard.astro'
import LandingHero from '@/components/LandingHero.astro'
import { toolIcon } from '@/content/tool-icons'
import { tools } from '@/content/tools/manifest.mjs'
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout
  title="Free SEO tools for any website"
  description="Use free SEO tools to check websites, technical files, search traffic, structured data and keyword lists in your browser without signing in."
  canonicalPath="/tools"
  schemaType="CollectionPage"
  framed={false}
>
  <main data-agent-content>
    <LandingHero
      title="Free SEO tools"
      lead="Check a website, a technical file or a keyword list in your browser, with no account. To check your own site with your Search Console and analytics data, set up the agent."
      setupId="tools-setup"
      author
    />

    <section class="site-frame py-24 sm:py-32">
      <h2 class="sr-only">Every free SEO tool on seoskill.dev</h2>
      <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
        {
          tools.map((tool) => (
            <HomeCard title={tool.title} text={tool.description} icon={toolIcon(tool.id)} href={tool.path} />
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
