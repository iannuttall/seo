{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.seoskill/seo",
  "title": "SEO Skill",
  "description": "Search Console, Google Analytics and keyword data for your AI agent.",
  "websiteUrl": "https://seoskill.dev",
  "icons": [
    {
      "src": "https://seoskill.dev/favicon-light.png",
      "mimeType": "image/png",
      "sizes": ["512x512"],
      "theme": "light"
    },
    {
      "src": "https://seoskill.dev/favicon-dark.png",
      "mimeType": "image/png",
      "sizes": ["512x512"],
      "theme": "dark"
    },
    {
      "src": "https://seoskill.dev/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": ["any"]
    }
  ],
  "repository": {
    "url": "https://github.com/iannuttall/seo",
    "source": "github"
  },
  "version": "0.12.1",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://seoskill.dev/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "seo",
      "version": "0.12.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "positional",
          "value": "serve"
        }
      ]
    }
  ]
}
