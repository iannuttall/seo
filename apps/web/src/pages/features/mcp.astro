---
import {
  ComputerTerminal01Icon,
  Key01Icon,
  LockKeyIcon,
  McpServerIcon,
} from '@hugeicons/core-free-icons'
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import HomeCard from '@/components/HomeCard.astro'
import LandingHero from '@/components/LandingHero.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SetupPrompts from '@/components/SetupPrompts.astro'
import SplitList from '@/components/SplitList.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Features', href: '/features' },
  { label: 'SEO MCP server' },
]

const servers = [
  {
    title: 'The hosted MCP needs nothing installed',
    code: 'https://seoskill.dev/mcp',
    text: 'The setup prompt at the top of this page adds it to your agent and waits while you sign in with Google.',
  },
  {
    title: 'The local MCP runs with the CLI',
    code: 'seo mcp install',
    text: 'It runs on your machine. Ask your agent to run seo mcp install to add it as well.',
  },
  {
    title: 'The local MCP adds three sources',
    text: 'Both serve the same tools, and the local one adds the site crawl, internal links and Bing Webmaster Tools data.',
  },
  {
    title: 'Add the Claude SEO skill in Claude Code',
    text: 'In Claude Code, add the Claude SEO skill too, so Claude knows which tool answers which question.',
    href: '/features/claude-seo',
  },
]

const stored = [
  {
    title: 'Your Google accounts and keys, encrypted',
    text: 'Only your linked Google accounts and any API keys you save are kept, encrypted, so it can fetch your own data when your agent asks.',
  },
  {
    title: 'Search data, reports and requests are never stored',
    text: 'The exceptions are the issues list and business context your agent saves, and what the paid weekly audit keeps.',
  },
  {
    title: 'You control what is kept',
    text: 'You can add Google accounts, save keys or delete everything on your account page.',
  },
]

const related = [
  { title: 'Hosted MCP', text: 'Connect seoskill.dev/mcp to Claude Code, Codex or any remote MCP client.', href: '/docs/mcp', icon: McpServerIcon },
  { title: 'CLI and local MCP', text: 'Install seo and add the local MCP server to your agents.', href: '/docs/cli', icon: ComputerTerminal01Icon },
  { title: 'API keys', text: 'Add DataForSEO or Ahrefs for keyword and competitor research.', href: '/docs/keys', icon: Key01Icon },
  { title: 'What is stored', text: 'What the hosted MCP and the CLI keep, and what they never keep.', href: '/docs/privacy', icon: LockKeyIcon },
]

const faq = [
  {
    question: 'Do I need to install anything for the hosted MCP?',
    answer:
      'No. The hosted MCP at https://seoskill.dev/mcp needs nothing installed. The setup prompt adds it to your agent and waits while you sign in with Google.',
  },
  {
    question: 'What does the local MCP add?',
    answer:
      'The local MCP runs on your machine with the CLI and serves the same tools as the hosted one. It adds the site crawl, internal links and Bing Webmaster Tools data. Ask your agent to run seo mcp install to add it.',
  },
  {
    question: 'Where does the keyword and competitor data come from?',
    answer:
      'The seo_research tool reads keyword and competitor data from our DataForSEO account with your plan\'s usage, or from your own DataForSEO or Ahrefs key if you save one. Search Console and Google Analytics data comes from the Google accounts you link.',
  },
  {
    question: 'Does the hosted MCP server store my search data?',
    answer:
      'No. It keeps only your linked Google accounts and any API keys you save, encrypted. Your search data, reports and requests are never stored, except the issues list and business context your agent saves and what the paid weekly audit keeps.',
  },
  {
    question: 'Can I delete what the hosted server keeps?',
    answer: 'Yes. You can add Google accounts, save keys or delete everything on your account page.',
    links: [{ text: 'account page', href: '/account' }],
  },
]
---

<BaseLayout
  title="SEO MCP server for AI agents"
  description="Connect a free SEO MCP server to Claude, Codex, Cursor or any agent. Read Search Console, Google Analytics and keyword data each time your agent asks."
  canonicalPath="/features/mcp"
  {breadcrumbs}
  framed={false}
>
  <main data-agent-content>
    <LandingHero
      title="SEO MCP server for AI agents"
      lead="Ask your agent what changed, what is broken and where the opportunities are. It reads your own search data before it answers."
      setupId="mcp-setup"
      author
    />

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      <SplitList
        id="servers-heading"
        title="Should I use the hosted or the local SEO MCP server?"
        text="Either one works, because both serve the same tools. The hosted one needs nothing installed, and the local one adds the site crawl, internal links and Bing Webmaster Tools data."
        items={servers}
      />

      <section class="site-frame" aria-labelledby="tools-heading">
        <SectionHeading
          id="tools-heading"
          title="Which tools does the SEO MCP server give my agent?"
          text="Your agent gets one tool per job, from listing your properties to raw Search Console rows. The site crawl and internal links run in the local MCP only."
        />
        <div class="docs-prose max-w-4xl">
          <table>
            <thead><tr><th>Tool</th><th>What it returns</th></tr></thead>
            <tbody>
              <tr><td><code>seo_sites</code></td><td>The Search Console and Google Analytics properties your linked Google accounts can read.</td></tr>
              <tr><td><code>seo_report</code></td><td>The main Search Console report: an overview, then one section.</td></tr>
              <tr><td><code>seo_page</code></td><td>One URL: live page facts, Google index status and its queries.</td></tr>
              <tr><td><code>seo_compare</code></td><td>Before and after a date, with Google updates in the window.</td></tr>
              <tr><td><code>seo_index</code></td><td>Pages that lost their clicks, checked live and with URL Inspection.</td></tr>
              <tr><td><code>seo_research</code></td><td>Keyword and competitor data from your DataForSEO or Ahrefs key.</td></tr>
              <tr><td><code>seo_data</code></td><td>Raw Search Console rows, or Google Analytics landing pages.</td></tr>
              <tr><td><code>seo_crawl</code>, <code>seo_internal_links</code></td><td>The site crawl and internal links. Local MCP only.</td></tr>
            </tbody>
          </table>
          <p>
            The <a href="/features/search-console">Google Search Console MCP</a> and{' '}
            <a href="/features/google-analytics">Google Analytics MCP server</a> pages
            show the questions these tools answer from each source.
          </p>
        </div>
        <div class="mt-6 max-w-4xl">
          <CodeBlock
            label="Ask your agent"
            prompt
            value="Which Search Console and Google Analytics properties can you see? Then run the SEO report for example.com."
            wrap
          />
        </div>
      </section>

      <SplitList
        id="stored-heading"
        title="What does the hosted SEO MCP server keep?"
        text="Only your linked Google accounts and any API keys you save, encrypted, so it can fetch your own data when your agent asks."
        items={stored}
      >
        <p class="mt-4 text-base leading-7 text-foreground-muted">
          Manage them on your{' '}
          <a class="text-foreground underline underline-offset-4" href="/account">account page</a>.{' '}
          <a class="text-foreground underline underline-offset-4" href="/docs/privacy">What is stored</a>{' '}
          has the details.
        </p>
      </SplitList>

      <section class="site-frame" aria-labelledby="related-heading">
        <SectionHeading
          id="related-heading"
          title="Which docs go with the SEO MCP server?"
          text="Set up the hosted or local server, add your research keys, and see what each one keeps."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {related.map((item) => <HomeCard {...item} link={`${item.title} docs`} />)}
        </div>
      </section>

      <section class="site-frame" aria-labelledby="faq-heading">
        <div class="max-w-2xl">
          <h2 id="faq-heading" class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            SEO MCP server questions
          </h2>
        </div>
        <div class="mt-10">
          <FaqAccordion items={faq} id="mcp-faq" />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="start-heading">
        <SectionHeading
          id="start-heading"
          title="Connect the SEO MCP server"
          text="Add the hosted server to your agent, sign in with Google, and ask what changed in search for your site."
        />
        <SetupPrompts id="mcp-setup-end" />
      </section>
    </div>
  </main>
</BaseLayout>
