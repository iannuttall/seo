---
import {
  BookOpen01Icon,
  Home01Icon,
  Wrench01Icon,
} from '@hugeicons/core-free-icons'
import HomeCard from '@/components/HomeCard.astro'
import { getButtonClasses } from '@/components/ui/button'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { site } from '@/lib/site'

const routes = [
  {
    title: 'Home',
    text: 'Connect the hosted MCP or install the CLI.',
    href: '/',
    icon: Home01Icon,
  },
  {
    title: 'Docs',
    text: 'Getting started, the eight commands and what is stored.',
    href: '/docs',
    icon: BookOpen01Icon,
  },
  {
    title: 'Free SEO tools',
    text: 'Check a website, a technical file or a keyword list.',
    href: '/tools',
    icon: Wrench01Icon,
  },
]
---

<BaseLayout
  title="Page not found"
  description="The requested seoskill.dev page could not be found."
  canonicalPath="/404"
  noindex
>
  <main>
    <section class="flex flex-col items-center pt-8 text-center sm:pt-14" aria-labelledby="not-found-title">
      <p class="font-mono text-sm text-foreground-muted">404</p>
      <h1 id="not-found-title" class="mt-3 max-w-3xl text-pretty text-4xl/tight font-medium -tracking-[0.8px]">
        That page is not here
      </h1>
      <p class="mt-4 max-w-2xl text-pretty text-xl/8 font-medium -tracking-[0.2px] text-foreground-muted">
        The URL may be old or mistyped. Many older report pages now live on
        a command page in the docs.
      </p>
    </section>

    <section class="mt-14" aria-labelledby="not-found-routes">
      <h2 id="not-found-routes" class="text-2xl/8 font-medium tracking-normal">Get back to something useful</h2>
      <div class="mt-6 grid grid-cols-1 gap-2 sm:grid-cols-3">
        {routes.map((route) => <HomeCard {...route} />)}
      </div>
    </section>

    <section class="mt-14 flex flex-col gap-5 rounded-lg bg-muted p-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="max-w-xl">
        <h2 class="text-base font-medium text-foreground">Did one of our links send you here?</h2>
        <p class="mt-1 text-sm leading-6 text-foreground-muted">
          That is a bug. Include the broken URL in a GitHub issue so it can be
          fixed.
        </p>
      </div>
      <a
        class={getButtonClasses('outline', 'default')}
        href={`${site.repository}/issues/new`}
        target="_blank"
        rel="noreferrer"
      >
        Report the broken link
      </a>
    </section>
  </main>
</BaseLayout>
