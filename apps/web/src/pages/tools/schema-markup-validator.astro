---
import { CodeIcon, FileSearchIcon, Image01Icon, WebValidationIcon } from '@hugeicons/core-free-icons'
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import HomeCard from '@/components/HomeCard.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SetupPrompts from '@/components/SetupPrompts.astro'
import SplitList from '@/components/SplitList.astro'
import SchemaMarkupValidator from '@/components/tools/SchemaMarkupValidator.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: 'Schema markup validator' },
]

const passes = [
  {
    title: 'First, the JSON and its type',
    text: 'The first pass parses the JSON and checks each object for an @context of Schema.org and an @type.',
  },
  {
    title: 'Then the properties for fifteen common types',
    text: 'The second pass compares each typed object with the required and recommended properties for fifteen common types, including Article, Product, Event, Recipe, LocalBusiness, JobPosting, VideoObject and BreadcrumbList.',
  },
  {
    title: 'Nothing leaves this browser tab',
    text: 'Everything runs in this browser tab. The markup is not uploaded, and no URL inside it is requested.',
  },
]

const reasons = [
  {
    title: 'Google reads what the page is',
    text: 'A page says what it is in words. Structured data says it again in a form a machine cannot misread: this is a recipe, it takes 40 minutes, it has 212 reviews averaging 4.6.',
  },
  {
    title: 'Extras can change how a result looks',
    text: 'Google uses it to decide whether it can show extras such as review stars, prices, event dates or a video thumbnail. Those extras change how a result looks, which can change how many people click it. They do not move the page up the results.',
  },
  {
    title: 'The markup has to match the page',
    text: 'Google expects the markup to describe what a visitor can see on the page. Markup for content that is hidden or untrue can cost the page its rich results.',
  },
]

const errors = [
  {
    title: 'Invalid JSON',
    text: 'A trailing comma, a missing brace or curly quotes pasted from a word processor. The error gives the line.',
  },
  {
    title: 'No context or type',
    code: '@context',
    text: 'Each top-level object needs "@context": "https://schema.org" and an @type, or nothing else in it can be read.',
  },
  {
    title: 'Missing required property',
    text: 'An article with no image or a product with no offer, review or rating. Add the property if the page shows it. If it does not, leave the type out.',
  },
  {
    title: 'Wrong value shape',
    code: '2026-10-21',
    text: 'An author given as a plain string where a Person object with a name works better, or a date that is not in ISO 8601 form such as 2026-10-21.',
  },
  {
    title: 'Template values left empty',
    code: '"price": ""',
    text: 'A CMS that prints "price": "" when a field is blank. Fix the template instead of one page.',
  },
]

const official = [
  {
    title: "Google's Rich Results Test",
    text: 'Reads a live URL after rendering it and shows which Google features it is eligible for.',
    href: 'https://search.google.com/test/rich-results',
  },
  {
    title: "Schema.org's validator",
    text: 'Checks the whole vocabulary, including Microdata and RDFa.',
    href: 'https://validator.schema.org/',
  },
  {
    title: 'Schema markup generator',
    text: 'Need a fresh block? It builds one from a form.',
    href: '/tools/schema-markup-generator',
  },
]

const tools = [
  {
    title: 'Schema markup generator',
    text: 'Generate JSON-LD for articles, products, local businesses, events, recipes and more, using only the fields the page shows.',
    href: '/tools/schema-markup-generator',
    icon: CodeIcon,
    link: 'Generate schema',
  },
  {
    title: 'SEO checker',
    text: 'A free audit of one page, from whether Google can index it to its structured data and Open Graph tags.',
    href: '/tools/seo-checker',
    icon: FileSearchIcon,
    link: 'Check a page',
  },
  {
    title: 'Open Graph checker',
    text: "A page's Open Graph and X card tags, with a preview of the link on Facebook, X and chat apps.",
    href: '/tools/open-graph-checker',
    icon: Image01Icon,
    link: 'Check Open Graph',
  },
  {
    title: 'Technical SEO site crawl',
    text: 'Crawl your site on your own machine with seo crawl and find the pages with missing or broken JSON-LD.',
    href: '/docs/crawl',
    icon: WebValidationIcon,
    link: 'Site crawl docs',
  },
]

const faq = [
  {
    question: 'What does a schema validator check?',
    answer:
      'It reads your structured data the way a parser would. First it checks that the JSON is valid and that each object says which Schema.org type it is. Then it checks the properties that type needs before a search feature can use it, such as a headline, image and date for an article.',
  },
  {
    question: 'Does valid schema markup guarantee a rich result?',
    answer:
      'No. Valid markup makes a page eligible. Google still decides whether to show a rich result, and it can leave one out because of the page content, its policies or the search itself. Use the Rich Results Test on the live URL to see what Google can read.',
  },
  {
    question: 'Can I validate a URL instead of pasted code?',
    answer:
      'This page checks code you paste or a file you drop, without fetching anything. To check a live page, open its source and paste it in, or use Google’s Rich Results Test. To check every page on your site, run seo crawl.',
  },
  {
    question: 'Does it read Microdata or RDFa?',
    answer:
      'No. It reads JSON-LD, either as plain JSON or inside application/ld+json script tags in pasted HTML. JSON-LD is the format Google recommends. For Microdata and RDFa, use the Schema.org validator.',
  },
  {
    question: 'Is structured data a ranking factor?',
    answer:
      'Google does not treat it as one. Structured data helps Google understand a page and can make it eligible for rich results, which can change how the result looks. Do not expect a ranking change from adding it.',
  },
  {
    question: 'Why does Google show an error this validator does not?',
    answer:
      'Google reads the live page after rendering it, and it applies its own rules for each search feature. This validator checks the code you gave it against a reviewed set of fifteen common types. Fix what Google reports first, because that is what decides eligibility.',
  },
]
---

<BaseLayout
  title="Free schema markup validator for JSON-LD"
  description="Validate JSON-LD in your browser. Find syntax errors, missing types and the required properties Google needs for articles, products, events and recipes."
  canonicalPath="/tools/schema-markup-validator"
  {breadcrumbs}
  framed={false}
>
  <main data-agent-content>
    <section class="pt-4">
      <div class="site-frame flex flex-col items-center pt-14 text-center sm:pt-20">
        <h1 class="mt-4 max-w-3xl text-pretty text-4xl/tight font-medium -tracking-[0.8px] xl:text-5xl/tight xl:-tracking-[1px]">
          Schema markup validator
        </h1>
        <p class="mt-4 max-w-2xl text-pretty text-xl/8 font-medium -tracking-[0.2px] text-foreground-muted">
          Paste JSON-LD or a page's HTML and check its syntax, types and
          required properties for common search features.
        </p>
      </div>
      <div class="site-frame mt-10 sm:mt-12">
        <SchemaMarkupValidator />
      </div>
    </section>

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      <section class="site-frame" aria-labelledby="result-heading">
        <SectionHeading
          id="result-heading"
          title="How do you read the schema validation result?"
          text="Fix the issues in order: errors, then warnings, then advice. The result lists every typed object it found, then the issues in those three levels."
        />
        <div class="docs-prose max-w-4xl">
          <table>
            <thead>
              <tr>
                <th>Level</th>
                <th>What it means</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Error</td>
                <td>The markup cannot be read, or a type is missing a property it needs. A search feature will not use it.</td>
              </tr>
              <tr>
                <td>Warning</td>
                <td>A recommended property is missing. The markup works, but it gives less detail.</td>
              </tr>
              <tr>
                <td>Advice</td>
                <td>A rule Google applies to that type, such as who can get FAQ or review stars.</td>
              </tr>
            </tbody>
          </table>
          <p>
            A type the validator does not have a profile for is listed on its
            own. Its JSON is still checked, but the validator does not claim to
            know every property in the full Schema.org vocabulary.
          </p>
        </div>
      </section>

      <SplitList
        id="method-heading"
        title="How does the schema validator check markup?"
        text="In two passes, one for the JSON and one for the properties each type needs, and both run in your browser."
        items={passes}
      />

      <SplitList
        id="why-heading"
        title="Why does structured data matter for search?"
        text="Because Google uses it to understand a page and to decide which extras its result can show. It changes how a result looks, and Google expects it to match the page."
        items={reasons}
      />

      <SplitList
        id="errors-heading"
        title="What are the most common schema markup errors?"
        text="These five. Each one stops a parser or a search feature from using the markup, and most come from a template."
        items={errors}
      />

      <SplitList
        id="official-heading"
        title="Which official schema tests should you use as well?"
        text="Google's Rich Results Test for a live URL and Schema.org's validator for the whole vocabulary. This page is quicker for pasted code and drafts, and it never sends them anywhere."
        items={official}
      />

      <SplitList
        id="agent-heading"
        title="How do you check structured data across your site with your agent?"
        text="With seo crawl, which fetches your pages on your own machine. One page at a time is fine for a draft."
        items={[
          { title: 'Pages with no structured data', text: 'The crawl reports the pages with no structured data at all.', href: '/docs/crawl' },
          { title: 'JSON-LD that does not parse', text: 'It also reports the pages with JSON-LD that does not parse.' },
          { title: 'The template that prints it', text: 'Your agent can then open the template that prints it and fix the cause.' },
        ]}
      >
        <div class="mt-6">
          <CodeBlock
            label="Ask your agent"
            prompt
            value="Crawl example.com and list the pages with broken JSON-LD, grouped by template"
            wrap
          />
        </div>
      </SplitList>

      <section class="site-frame" aria-labelledby="tools-heading">
        <SectionHeading
          id="tools-heading"
          title="Which tools go with a schema markup check?"
          text="These, which build the markup, check the rest of the page and find broken JSON-LD across a whole site."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {tools.map((item) => <HomeCard {...item} />)}
        </div>
      </section>

      <section class="site-frame" aria-labelledby="faq-heading">
        <div class="max-w-2xl">
          <h2 id="faq-heading" class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            Schema validator questions
          </h2>
        </div>
        <div class="mt-10">
          <FaqAccordion id="schema-validator-faq" items={faq} />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="start-heading">
        <SectionHeading
          id="start-heading"
          title="Check structured data across your whole site"
          text="The crawl runs from the CLI on your machine. Give your agent this prompt and it installs the CLI and adds the hosted MCP server."
        />
        <SetupPrompts id="schema-validator-setup" />
      </section>
    </div>
  </main>
</BaseLayout>
