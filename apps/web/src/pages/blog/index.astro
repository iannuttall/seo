---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import NavCard from '@/components/NavCard.astro'
import PageHeader from '@/components/PageHeader.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

// New posts go at the top of this list.
const posts = [
  {
    title: 'SEO MCP servers for AI agents',
    description:
      'Compare local audits, Search Console, keyword research, rank tracking, content workflows, and provider data before you connect a server.',
    href: '/blog/seo-mcp-servers',
    date: '2026-08-13',
    dateLabel: '13 August 2026',
  },
  {
    title: 'How an SEO agent works',
    description:
      'An interactive guide. Six small models you can play with, from the evidence an agent can see to the measurement that closes the loop.',
    href: '/blog/seo-agent',
    date: '2026-08-12',
    dateLabel: '12 August 2026',
  },
]

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Blog' },
]
---

<BaseLayout
  title="Blog"
  description="Interactive guides and real case studies about doing SEO with agents, written from audits of live sites and measured with final search data."
  canonicalPath="/blog"
  schemaType="CollectionPage"
  {breadcrumbs}
>
  <main data-agent-content>
    <Breadcrumbs {breadcrumbs} />
    <PageHeader
      title="Blog"
      description="Interactive guides and real case studies about doing SEO with agents. Case studies report the measured result either way, including flat or negative."
      align="left"
    />

    <div class="grid gap-6 sm:grid-cols-2">
      {
        posts.map((post) => (
          <NavCard title={post.dateLabel} heading={post.title} description={post.description} href={post.href} />
        ))
      }
    </div>
  </main>
</BaseLayout>
