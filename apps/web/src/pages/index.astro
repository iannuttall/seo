---
import {
  Analytics01Icon,
  Calendar03Icon,
  Key01Icon,
} from '@hugeicons/core-free-icons'
import FaqAccordion from '@/components/FaqAccordion.astro'
import HomeCard from '@/components/HomeCard.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SetupCommands from '@/components/SetupCommands.astro'
import { getButtonClasses } from '@/components/ui/button'
import { commands } from '@/content/commands'
import { toolIcon } from '@/content/tool-icons'
import { tools } from '@/content/tools/manifest.mjs'
import BaseLayout from '@/layouts/BaseLayout.astro'

const sources = [
  {
    title: 'Your own search data',
    icon: Analytics01Icon,
    text: 'Search Console and Google Analytics through your Google sign-in, plus Clicky, Fathom, Simple Analytics or Plausible with your key.',
  },
  {
    title: 'Google update dates',
    icon: Calendar03Icon,
    text: 'Known Google algorithm updates sit next to your traffic, so you can see when the timing lines up.',
  },
  {
    title: 'Research with your key',
    icon: Key01Icon,
    text: 'Keyword, SERP, competitor and backlink data from your own DataForSEO or Ahrefs account.',
  },
]

const surfaces = [
  {
    title: 'Hosted MCP',
    text: 'Free, with Google sign-in and nothing to install. Nothing is stored.',
    code: 'seoskill.dev/mcp',
    href: '/docs/mcp',
  },
  {
    title: 'CLI',
    text: 'Open source and local. Adds a site crawl and internal links.',
    code: 'npm i -g seo && seo start',
    href: '/docs/cli',
  },
  {
    title: 'API keys',
    text: 'Optional. Your own research and analytics accounts, never stored.',
    code: null,
    href: '/docs/keys',
  },
  {
    title: 'What is stored',
    text: 'Nothing on the hosted server. Only anonymous usage counts.',
    code: null,
    href: '/docs/privacy',
  },
]

const featuredToolIds = [
  'domain-rating-checker',
  'website-traffic-checker',
  'robots-txt-validator',
  'sitemap-extractor',
  'schema-markup-generator',
  'serp-preview',
]
const featuredTools = featuredToolIds.flatMap((id) => {
  const tool = tools.find((item) => item.id === id)
  return tool ? [tool] : []
})

const faqs = [
  {
    question: 'Is it free?',
    answer:
      'Yes. The hosted MCP and the CLI are free. Research data from DataForSEO or Ahrefs uses your own account with them, so they bill you for what you use.',
  },
  {
    question: 'What does the hosted MCP store?',
    answer:
      'Nothing. Your Google sign-in and any keys are sealed into the tokens your agent keeps, and the server uses them for one request at a time. The only thing kept is an anonymous count of what ran.',
  },
  {
    question: 'Does it tell me what to fix?',
    answer:
      'No. It returns facts from your data, such as which pages lost clicks or which queries sit at position 4 to 10 with a low click-through rate. Your agent shows you the facts and you decide what to change.',
  },
  {
    question: 'Should I use the hosted MCP or the CLI?',
    answer:
      'Start with the hosted MCP if you want the quickest setup. Use the CLI if you want everything on your machine, or need the site crawl and internal links, which only run locally.',
  },
  {
    question: 'Which agents does it work with?',
    answer:
      'Any agent that supports remote MCP servers, including Claude Code, Codex, Cursor and Claude on the web. The CLI also adds a skill that teaches your agent which command to run.',
  },
]
---

<BaseLayout
  title="Free SEO data for AI agents"
  titleBrandPosition="prefix"
  description="Give your AI agent facts from your own Search Console, Google Analytics and keyword data. Connect the free hosted MCP in one command or install the open source CLI."
  canonicalPath="/"
  framed={false}
>
  <main data-agent-content>
    <section class="pt-4">
      <div class="site-frame flex flex-col items-center pt-14 text-center sm:pt-20">
        <h1 class="max-w-3xl text-pretty text-4xl/tight font-medium -tracking-[0.8px] xl:text-5xl/tight xl:-tracking-[1px]">
          Give your AI agent your real SEO data
        </h1>
        <p class="mt-4 max-w-2xl text-pretty text-xl/8 font-medium -tracking-[0.2px] text-foreground-muted">
          Facts from your Search Console, analytics and keyword data, ready
          for Claude, Codex or any agent. No advice, no guesswork. You decide
          what to change.
        </p>
      </div>

      <div class="site-frame mt-10 sm:mt-12">
        <SetupCommands id="home-setup" />
        <p class="mt-6 text-center text-sm text-foreground-muted">
          Free. Google sign-in, no account. Nothing stored.
        </p>
      </div>
    </section>

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      <section class="site-frame" aria-labelledby="commands-heading">
        <SectionHeading
          id="commands-heading"
          title="What your agent can do"
          text="Eight commands. Start with the report, then ask about one page, one date or one keyword."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {
            commands.map((item) => (
              <HomeCard
                title={item.command}
                code={item.command}
                text={item.text}
                icon={item.icon}
                href={item.path}
              />
            ))
          }
        </div>
      </section>

      <section class="site-frame" aria-labelledby="sources-heading">
        <SectionHeading
          id="sources-heading"
          title="Facts from data you own"
          text="Every row says where it came from, and outside estimates never mix with your own numbers."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-3">
          {sources.map((item) => <HomeCard title={item.title} text={item.text} icon={item.icon} />)}
        </div>
      </section>

      <section class="site-frame grid gap-8 sm:grid-cols-[1fr_1.15fr] sm:items-start">
        <div class="sm:sticky sm:top-24">
          <h2 class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            Two ways in, same reports
          </h2>
          <p class="mt-4 text-base leading-7 text-foreground-muted">
            The hosted MCP and the CLI run the same code and return the same
            facts. Pick the one that suits how you work (you can switch later).
          </p>
        </div>
        <div class="divide-y divide-border rounded-lg bg-muted px-6">
          {
            surfaces.map((item) => (
              <a
                class="group block py-4 no-underline focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/20"
                href={item.href}
              >
                <span class="flex items-center justify-between gap-4">
                  <span class="text-sm font-medium text-foreground group-hover:underline">{item.title}</span>
                  {item.code ? (
                    <code class="truncate rounded-md bg-background px-2 py-0.5 font-mono text-xs text-foreground-muted">{item.code}</code>
                  ) : (
                    <span aria-hidden="true" class="text-foreground-soft group-hover:text-foreground">&rarr;</span>
                  )}
                </span>
                <span class="mt-1 block text-sm leading-6 text-foreground-muted">{item.text}</span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="site-frame" aria-labelledby="tools-heading">
        <SectionHeading
          id="tools-heading"
          title="Free SEO tools"
          text="Check a website, a technical file or a keyword list in your browser. No sign-in."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
          {
            featuredTools.map((tool) => (
              <HomeCard title={tool.title} text={tool.description} icon={toolIcon(tool.id)} href={tool.path} />
            ))
          }
        </div>
        <a class:list={[getButtonClasses('secondary', 'lg'), 'mt-6']} href="/tools">
          See all {tools.length} tools
        </a>
      </section>

      <section class="site-frame" aria-labelledby="faq-heading">
        <div class="max-w-2xl">
          <h2 id="faq-heading" class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            Questions about SEO Skill
          </h2>
        </div>
        <div class="mt-10">
          <FaqAccordion items={faqs} id="home-faq" />
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
