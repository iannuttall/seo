---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import PageHeader from '@/components/PageHeader.astro'
import SetupCommands from '@/components/SetupCommands.astro'
import RobotsTxtValidator from '@/components/tools/RobotsTxtValidator.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: 'robots.txt checker and tester' },
]

const faq = [
  {
    question: 'How do I test my robots.txt file?',
    answer:
      'Enter your domain above to fetch the live file, or paste a draft. Add the URLs you care about and pick a crawler. Each URL comes back allowed or blocked, with the group and the exact line that decided it.',
  },
  {
    question: 'Does noindex work in robots.txt?',
    answer:
      'No. Google stopped supporting noindex lines in robots.txt in 2019 and ignores them. To keep a page out of search, let Google crawl it and put a noindex meta tag or X-Robots-Tag header on the page itself.',
  },
  {
    question: 'Does blocking a page in robots.txt remove it from Google?',
    answer:
      'No. It stops Google crawling the page, not indexing it. A blocked URL that other pages link to can still show in results, usually without a description. It also means Google can never see a noindex tag on that page.',
  },
  {
    question: 'Where does the robots.txt file go?',
    answer:
      'At the root of each host, such as https://example.com/robots.txt. A file in a folder is ignored, and each subdomain and each protocol needs its own file.',
  },
  {
    question: 'Should I add my sitemap to robots.txt?',
    answer:
      'Yes, it is a cheap way to tell every crawler where the sitemap is. Add a line such as Sitemap: https://example.com/sitemap.xml with the full URL. It can go anywhere in the file and does not belong to a user-agent group.',
  },
  {
    question: 'How do I block AI crawlers but stay in AI search?',
    answer:
      'Block the training crawlers by name and leave the search crawlers allowed. For OpenAI that means a group for GPTBot with Disallow: / and no block for OAI-SearchBot. Use the presets above to test both tokens against the same file.',
  },
  {
    question: 'Does Google still have a robots.txt tester?',
    answer:
      'Not one you can paste rules into. Google retired the old tester in 2023. The robots.txt report in Search Console shows the files Google found for your site and when it last read them, and URL Inspection checks one URL at a time. Paste a draft here to test it before it goes live.',
  },
  {
    question: 'Does robots.txt cover my subdomains?',
    answer:
      'No. A robots.txt file applies only to the protocol, host and port it is served from. blog.example.com needs its own file at blog.example.com/robots.txt, even when example.com has one.',
  },
  {
    question: 'How long does Google take to see a robots.txt change?',
    answer:
      'Google usually caches robots.txt for up to 24 hours, sometimes longer if the file cannot be fetched. Search Console has a robots.txt report where you can ask Google to fetch it again.',
  },
]
---

<BaseLayout
  title="Free robots.txt checker for Google and AI crawlers"
  description="Free robots.txt checker. Load a site's file or paste a draft, and see which search, AI and training crawlers can read each URL, and the line that decides."
  canonicalPath="/tools/robots-txt-validator"
  {breadcrumbs}
>
  <main data-agent-content>
    <Breadcrumbs {breadcrumbs} />

    <PageHeader
      title="robots.txt checker and tester"
      description="Load a site's robots.txt or test a draft. See which search, AI and training crawlers can read each URL, and the line that allows or blocks them."
    />

    <RobotsTxtValidator />

    <div class="docs-prose mt-16">
      <h2>Test live rules or a draft file</h2>
      <p>
        Live mode requests the robots.txt file at the site's root. Custom mode
        checks pasted rules inside your browser, which is useful before a
        change reaches production. Both modes use the same parser and URL
        matching rules.
      </p>
      <p>
        The result keeps parseable rules even when another line is ignored.
        That matters because crawlers do not normally discard a whole file over
        one bad line.
      </p>

      <h2>How the winning rule is selected</h2>
      <p>
        The tester follows the{' '}
        <a href="https://www.rfc-editor.org/rfc/rfc9309.html" target="_blank" rel="noreferrer">Robots Exclusion Protocol</a>.
        {' '}It selects the most specific user-agent group, matches paths with
        case sensitivity, supports <code>*</code> and terminal <code>$</code>,
        and uses the rule that matches the most URL octets. An Allow rule wins
        when equally specific Allow and Disallow rules conflict.
      </p>
      <p>
        Repeated groups for the same specific crawler are combined. A specific
        group is not combined with the global <code>User-agent: *</code> group.
        Google's{' '}
        <a href="https://developers.google.com/crawling/docs/robots-txt/robots-txt-spec" target="_blank" rel="noreferrer">robots.txt parser documentation</a>
        {' '}shows the same grouping and matching behavior.
      </p>

      <h2>Allowed does not prove a crawler can fetch the page</h2>
      <p>
        An allowed result means no matching robots.txt rule blocks the URL. A
        firewall, login, bot challenge, network failure, or page response can
        still stop a request. The tool does not impersonate a crawler or verify
        its source IP address.
      </p>
      <p>
        robots.txt is also a crawl control, not access control. Google may show
        a blocked URL without a snippet when it discovers that address
        elsewhere. Use authentication for private content and a crawlable
        {' '}<code>noindex</code> directive when the goal is to keep a public page
        out of Google Search.
      </p>

      <h2>Missing files and server errors mean different things</h2>
      <p>
        Google generally treats a missing robots.txt file and most other 4xx
        responses as no crawl restrictions. A 429 response, server error, DNS
        failure, or timeout is different because a cached copy may continue to
        apply. The checker reports that state as uncertain rather than guessing
        which rules a crawler currently holds.
      </p>

      <h2>Which crawlers to let in</h2>
      <p>
        The crawler access table splits crawlers into three groups, because
        blocking each group does something different.
      </p>
      <ul>
        <li>
          <strong>Search and AI answers.</strong> Googlebot, Bingbot,
          OAI-SearchBot, Claude-SearchBot, PerplexityBot and Applebot find the
          pages these engines show and cite. Let them all in. If Googlebot is
          blocked, the page is out of Google Search, which includes AI
          Overviews and AI Mode. OpenAI says sites that block OAI-SearchBot
          will not be shown in ChatGPT search answers.
        </li>
        <li>
          <strong>Opens a page when a person asks.</strong> ChatGPT-User,
          Claude-User and Perplexity-User fetch a page because someone asked
          about it. OpenAI says robots.txt rules may not apply to ChatGPT-User,
          and Perplexity says Perplexity-User generally ignores them, so a
          block there is a request rather than a guarantee.
        </li>
        <li>
          <strong>Model training.</strong> GPTBot, ClaudeBot, Applebot-Extended,
          CCBot and Bytespider are your call. OpenAI, Anthropic and Apple run
          search and training on separate tokens, so blocking GPTBot, ClaudeBot
          or Applebot-Extended does not take you out of their search answers.
          Google-Extended works differently: it does not
          affect Google Search, but it decides whether Gemini can use your
          pages for training and to ground its answers.
        </li>
      </ul>
      <p>
        Applebot has one quirk. Apple says that when no group names Applebot
        but one names Googlebot, Applebot follows the Googlebot rules. The
        checker does the same and says so in the result.
      </p>
      <p>
        Crawler names and uses change, so read the current guidance from{' '}
        <a href="https://developers.openai.com/api/docs/bots" target="_blank" rel="noreferrer">OpenAI</a>,{' '}
        <a href="https://support.anthropic.com/en/articles/8896518-does-anthropic-crawl-data-from-the-web-and-how-can-site-owners-block-the-crawler" target="_blank" rel="noreferrer">Anthropic</a>,{' '}
        <a href="https://docs.perplexity.ai/docs/resources/perplexity-crawlers" target="_blank" rel="noreferrer">Perplexity</a>,{' '}
        <a href="https://support.apple.com/en-us/119829" target="_blank" rel="noreferrer">Apple</a> and{' '}
        <a href="https://developers.google.com/crawling/docs/crawlers-fetchers/google-common-crawlers" target="_blank" rel="noreferrer">Google</a>
        {' '}before you change your policy.
      </p>

      <h2>Fix common robots.txt mistakes</h2>
      <ul>
        <li>
          <strong>A leftover <code>Disallow: /</code>.</strong> A staging
          file copied to production blocks the whole site. Test the home page
          for Googlebot after every launch.
        </li>
        <li>
          <strong>Blocked CSS and JavaScript.</strong> Google renders pages
          like a browser. If it cannot fetch the files a page needs, it may
          see a broken page.
        </li>
        <li>
          <strong>Noindex in robots.txt.</strong> Google ignores it. Put the
          noindex on the page and leave the page crawlable.
        </li>
        <li>
          <strong>Blocking a page you want removed.</strong> The block hides
          the noindex tag, so the URL can stay in results. Allow the crawl
          until the page drops out.
        </li>
        <li>
          <strong>Wrong case or a missing slash.</strong> Paths are case
          sensitive, so <code>/Admin</code> does not block{' '}
          <code>/admin</code>. Test the exact URLs.
        </li>
      </ul>

      <h2>Check robots.txt across your site with your agent</h2>
      <p>
        The <a href="/docs/crawl">seo crawl</a> command reads your
        robots.txt while it crawls your site on your own machine. It lists
        which AI search crawlers and which AI training crawlers your file
        allows, apart from each other, and reports the pages your rules
        stop its own crawler from fetching. Your agent can then change the file in your codebase
        and test the new rules here before you ship. Ask:
      </p>
      <CodeBlock value="Crawl example.com and tell me which AI search and training crawlers my robots.txt blocks, and which linked pages robots.txt stops the crawl from fetching" wrap />
      <p>The crawl runs from the CLI. Install it and run setup:</p>
      <CodeBlock value="npm i -g seo && seo start" wrap />
      <p>Or add the hosted MCP server for Search Console work in your agent:</p>
    </div>

    <SetupCommands id="robots-setup" class="mt-6" />

    <div class="docs-prose mt-16">
      <h2>robots.txt questions</h2>
    </div>
    <div class="mt-6">
      <FaqAccordion id="robots-faq" items={faq} />
    </div>
  </main>
</BaseLayout>
