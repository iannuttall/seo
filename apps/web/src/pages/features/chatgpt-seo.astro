---
import {
  AiChat02Icon,
  Analytics01Icon,
  McpServerIcon,
  SearchList01Icon,
} from '@hugeicons/core-free-icons'
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import HomeCard from '@/components/HomeCard.astro'
import LandingHero from '@/components/LandingHero.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SetupPrompts from '@/components/SetupPrompts.astro'
import SplitList from '@/components/SplitList.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Features', href: '/features' },
  { label: 'ChatGPT SEO with your own search data' },
]

const unseen = [
  { title: 'Which queries you rank on page two for' },
  { title: 'Which pages lost their clicks' },
  { title: 'Whether Google still has a page in its index' },
]

const steps = [
  { title: 'Open Plugins', text: 'Open Plugins, choose +, then Add custom MCP server.' },
  {
    title: 'Name it and add the address',
    code: 'https://seoskill.dev/mcp',
    text: 'Name it seoskill and enter https://seoskill.dev/mcp under Connection.',
  },
  {
    title: 'Choose OAuth and sign in',
    text: 'Choose OAuth for authentication, confirm, and choose Create as a plugin. Sign in with Google when ChatGPT asks. Access is read only.',
  },
  { title: 'Pick seoskill in a chat', text: 'In a chat, type @ and pick seoskill.' },
]

const costs = [
  { title: 'Every tool ChatGPT calls is free', text: 'There is no usage cap.' },
  {
    title: 'Research uses a plan or your own key',
    text: 'Keyword research and the AI answer check use your plan\'s usage or your free credit, or your own DataForSEO or Ahrefs key if you save one.',
  },
    { title: 'Plans start at $10 a month', text: 'Every plan has unlimited sites and the weekly site audit.' },
]

const related = [
  { title: 'ChatGPT', text: 'Add SEO Skill to ChatGPT as a custom MCP server.', href: '/integrations/chatgpt', icon: McpServerIcon },
  { title: 'seo report', text: 'The Search Console report ChatGPT reads first.', href: '/docs/report', icon: Analytics01Icon },
  { title: 'seo research', text: 'Keyword data, and whether ChatGPT search cites your site.', href: '/docs/research', icon: SearchList01Icon },
  { title: 'AI search tracking', text: 'The questions people ask AI that show in your Search Console.', href: '/features/ai-search', icon: AiChat02Icon },
]

const faq = [
  {
    question: 'Can ChatGPT do SEO without my data?',
    answer:
      "ChatGPT can write a decent SEO plan from memory. It can't see which queries you rank on page two for, which pages lost their clicks, or whether Google still has a page in its index until you connect your Search Console.",
  },
  {
    question: 'Which ChatGPT plans can add SEO Skill?',
    answer:
      'Custom MCP servers depend on your ChatGPT plan. OpenAI lists Business, Enterprise and Edu workspaces, where an admin may need to create the plugin, and Pro accounts for read-only servers like this one.',
  },
  {
    question: 'Can ChatGPT change my Search Console?',
    answer: 'No. You sign in with Google when ChatGPT asks, and access is read only.',
  },
  {
    question: 'Does it check whether ChatGPT search cites my site?',
    answer:
      'Yes. Your top AI-style questions from Search Console are asked on ChatGPT search, using your plan\'s usage or your own DataForSEO key.',
  },
  {
    question: 'How much does ChatGPT SEO with SEO Skill cost?',
    answer:
      'Every tool ChatGPT calls is free with no usage cap. Keyword research and the AI answer check use a plan\'s usage or your own DataForSEO or Ahrefs key. Plans start at $10 a month, with unlimited sites, the weekly site audit and included research usage.',
  },
]
---

<BaseLayout
  title="ChatGPT SEO with your own search data"
  description="Use ChatGPT for SEO with your real Search Console, Google Analytics and keyword data through a free MCP server. Setup steps, prompts and what it can check."
  canonicalPath="/features/chatgpt-seo"
  {breadcrumbs}
  framed={false}
>
  <main data-agent-content>
    <LandingHero
      title="ChatGPT SEO with your own search data"
      lead="ChatGPT can write a decent SEO plan from memory. Connect your Search Console and it writes one for your site, from your own clicks, queries and pages."
      setupId="chatgpt-seo-setup"
      author
    />

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      <SplitList
        id="why-heading"
        title="Why does ChatGPT need your data for SEO?"
        text="Prompt lists for ChatGPT SEO work on the text you paste in, so they can't see these three things. SEO Skill gives ChatGPT those facts from your own Search Console, Google Analytics and URL Inspection, so its answer starts from your numbers."
        items={unseen}
      />

      <SplitList
        id="add-heading"
        title="How do I add SEO Skill to ChatGPT?"
        text="Add it as a custom MCP server in four steps. Custom MCP servers depend on your ChatGPT plan. OpenAI lists Business, Enterprise and Edu workspaces, where an admin may need to create the plugin, and Pro accounts for read-only servers like this one."
        items={steps}
      >
        <p class="mt-4 text-base leading-7 text-foreground-muted">
          The{' '}
          <a class="text-foreground underline underline-offset-4" href="/integrations/chatgpt">ChatGPT setup page</a>{' '}
          has the current steps.
        </p>
      </SplitList>

      <section class="site-frame" aria-labelledby="prompts-heading">
        <SectionHeading
          id="prompts-heading"
          title="Which prompts should I try in ChatGPT?"
          text="Start with quick wins, lost traffic and index checks. Each prompt below shows what ChatGPT reads to answer it."
        />
        <div class="docs-prose max-w-4xl">
          <table>
            <thead><tr><th>Ask</th><th>What ChatGPT reads</th></tr></thead>
            <tbody>
              <tr><td>Give me three quick wins for my site.</td><td>Queries close to page one (<a href="/features/striking-distance-keywords">striking distance keywords</a>) and pages with a low click-through rate for their position.</td></tr>
              <tr><td>Which pages are losing traffic?</td><td>Content decay and traffic drops from Search Console, page by page.</td></tr>
              <tr><td>Is this page indexed?</td><td>Google's URL Inspection result and the live page facts.</td></tr>
              <tr><td>How much traffic do AI assistants send us?</td><td>Visits from ChatGPT, Perplexity and others in Google Analytics or Clicky.</td></tr>
              <tr><td>Does ChatGPT search cite us for our top questions?</td><td>Your top AI-style questions from Search Console, asked on ChatGPT search with your DataForSEO key.</td></tr>
            </tbody>
          </table>
        </div>
        <div class="mt-6 max-w-4xl">
          <CodeBlock label="Ask your agent" prompt value="@seoskill Give me three quick wins for example.com." wrap />
        </div>
      </section>

      <SplitList
        id="cost-heading"
        title="What does ChatGPT SEO with SEO Skill cost?"
        text="Every tool ChatGPT calls is free without a plan. Keyword data uses a plan's usage or your own research key."
        items={costs}
      />

      <section class="site-frame" aria-labelledby="related-heading">
        <SectionHeading
          id="related-heading"
          title="Which docs go with ChatGPT SEO?"
          text="The ChatGPT setup, the reports ChatGPT reads and the questions people ask AI about your site."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {related.map((item) => <HomeCard {...item} link={`${item.title} docs`} />)}
        </div>
      </section>

      <section class="site-frame" aria-labelledby="faq-heading">
        <div class="max-w-2xl">
          <h2 id="faq-heading" class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            ChatGPT SEO questions
          </h2>
        </div>
        <div class="mt-10">
          <FaqAccordion items={faq} id="chatgpt-seo-faq" />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="start-heading">
        <SectionHeading
          id="start-heading"
          title="Use ChatGPT with your own search data"
          text="Add SEO Skill to ChatGPT with the four steps above, or copy the prompt for an agent that runs commands. Then ask for three quick wins for your site."
        />
        <SetupPrompts id="chatgpt-seo-setup-end" />
      </section>
    </div>
  </main>
</BaseLayout>
