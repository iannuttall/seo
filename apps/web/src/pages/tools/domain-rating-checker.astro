---
import {
  Analytics01Icon,
  Calendar03Icon,
  Link01Icon,
  SearchList01Icon,
} from '@hugeicons/core-free-icons'
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import FounderBadge from '@/components/FounderBadge.astro'
import HomeCard from '@/components/HomeCard.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SetupPrompts from '@/components/SetupPrompts.astro'
import SplitList from '@/components/SplitList.astro'
import ProtectedMetricChecker from '@/components/tools/ProtectedMetricChecker.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: 'Domain Rating checker' },
]

const reading = [
  { title: 'From 0 to 100', text: 'Higher means a stronger backlink profile: more unique websites link to the domain, and those websites have strong links of their own.' },
  { title: 'A logarithmic scale', text: 'Each step up is harder than the one before it, so climbing from 10 to 20 is far easier than climbing from 70 to 80.' },
  { title: 'Gaps near the top are bigger', text: 'Read a gap of 10 points near the top as a much bigger difference than the same gap near the bottom.' },
  { title: 'Domain Rating by Ahrefs', text: 'The number comes from the Ahrefs link index.', href: 'https://ahrefs.com' },
]

const method = [
  { title: 'Ahrefs records who links to whom', text: 'It crawls the web and records which sites link to which.' },
  { title: 'Unique linking websites', text: 'For a domain, it counts the unique websites that send it at least one followed link. Many links from one site count as one, and nofollow links do not count.' },
  { title: 'Strength passes on', text: 'Each linking site passes on part of its own strength, shared out between all the sites it links to.' },
  { title: 'Only links', text: 'DR knows nothing about the content, the traffic or the topic of a site, and it does not look at the links to any single page.' },
]

const rows = [
  { label: 'Made by', dr: 'Ahrefs', da: 'Moz' },
  { label: 'Scale', dr: '0 to 100, logarithmic', da: '1 to 100, logarithmic' },
  { label: 'Built from', dr: "Ahrefs' link index: unique linking domains and their strength", da: "Moz's link index, with a model trained to predict how well a site ranks" },
  { label: 'Shown here', dr: 'Yes', da: 'No' },
  { label: 'Used by Google', dr: 'No', da: 'No' },
]

const market = [
  { title: 'The same score means different things', text: 'A DR of 30 can be strong for a local plumber and weak for a national news site.' },
  { title: 'Check who ranks for your keyword', text: 'The domains on the first page for your main keyword show the range you are competing in.', href: '/tools/serp-checker' },
  { title: 'See how long each domain has been registered', text: 'The domain age checker gives each site’s registration date.', href: '/tools/domain-age-checker' },
]

const limits = [
  { title: 'Google does not use DR', text: 'It is a summary of links, which Google does look at, but Google ranks pages for searches, not domains by a score.' },
  { title: 'The better page often wins', text: 'A lower-DR site with the better page for a search can and often does outrank a higher-DR site.' },
  { title: 'What DR is good for', text: 'Judging a backlink profile, or deciding which link prospects deserve a look.' },
  { title: 'What it cannot do', text: 'Predict one page’s position.' },
]

const tools = [
  { title: 'SERP checker', text: 'The live Google results for a keyword, with the Domain Rating of the first 25 sites.', href: '/tools/serp-checker', icon: SearchList01Icon, link: 'Check a search' },
  { title: 'Backlink checker', text: 'The sites that link to a domain, to see what is behind its Domain Rating.', href: '/tools/backlink-checker', icon: Link01Icon, link: 'Check backlinks' },
  { title: 'Domain age checker', text: 'How long each competing domain has been registered.', href: '/tools/domain-age-checker', icon: Calendar03Icon, link: 'Check a domain’s age' },
  { title: 'Domain overview', text: 'A site’s Domain Rating next to its estimated traffic and top pages, in one answer from your agent.', href: '/features/domain-overview', icon: Analytics01Icon, link: 'See the domain overview' },
]

const faq = [
  {
    question: 'What is Domain Rating?',
    answer:
      'Domain Rating, or DR, is a 0 to 100 score from Ahrefs for the strength of a website’s backlink profile. It looks at how many unique websites link to it with followed links, and how strong those websites are themselves. It is one score for the whole domain, covering every page on it.',
  },
  {
    question: 'What is a good Domain Rating?',
    answer:
      'There is no fixed good number. The scale is logarithmic, so going from 20 to 30 is far easier than going from 70 to 80, and what counts as strong depends on the market. Check the sites that rank for the searches you want and see where you sit among them.',
  },
  {
    question: 'Is Domain Rating the same as Domain Authority?',
    answer:
      'No. This page shows Domain Rating by Ahrefs. Domain Authority is a different score from Moz, built from a different link index with a different formula. A site can have very different numbers on the two, so never compare a DR with a DA.',
  },
  {
    question: 'Can this page check Moz DA?',
    answer:
      'No. It shows Ahrefs Domain Rating only. If you need Domain Authority, it comes from Moz. For comparing link strength between sites, either score works as long as you use the same one for every site.',
  },
  {
    question: 'Does Google use Domain Rating?',
    answer:
      'No. Domain Rating and Domain Authority are third-party scores. Google does not use either of them. They are useful because they summarise links, which Google does look at, but a higher score does not by itself move a page in Google.',
  },
  {
    question: 'How do I increase my Domain Rating?',
    answer:
      'Get followed links from more websites that have strong links of their own. Many links from one site count as one. Links from pages people actually read and share tend to come with the authority that moves the score. Buying links breaks Google’s spam policies, whatever it does to a third-party score.',
  },
  {
    question: 'Why did my Domain Rating drop?',
    answer:
      'Either you lost linking domains, or the domains that link to you lost strength, or other sites grew faster. DR is relative to the whole web, so it can fall a little while nothing about your own links changed.',
  },
]
---

<BaseLayout
  title="Free Domain Rating (DR) checker for any website"
  description="Check any website's Domain Rating by Ahrefs for free. Learn what DR measures, what a good score is, and how Domain Rating differs from Moz Domain Authority."
  canonicalPath="/tools/domain-rating-checker"
  {breadcrumbs}
  framed={false}
>
  <main data-agent-content>
    <section class="pt-4">
      <div class="site-frame flex flex-col items-center pt-14 text-center sm:pt-20">
        <FounderBadge prefix="Written by AI and" ai />
        <h1 class="mt-4 max-w-3xl text-pretty text-4xl/tight font-medium -tracking-[0.8px] xl:text-5xl/tight xl:-tracking-[1px]">
          Domain Rating checker
        </h1>
        <p class="mt-4 max-w-2xl text-pretty text-xl/8 font-medium -tracking-[0.2px] text-foreground-muted">
          Get the Domain Rating by Ahrefs for your website, a client site or a
          competitor.
        </p>
      </div>
      <div class="site-frame mt-10 sm:mt-12">
        <ProtectedMetricChecker
          kind="domain-rating"
          endpoint="/api/tools/domain-rating"
          action="domain-rating"
          heading="Check Domain Rating"
          description="Enter a domain."
          buttonLabel="Check Domain Rating"
        />
      </div>
    </section>

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      <SplitList
        id="read-heading"
        title="How do you read a Domain Rating?"
        text="As a 0 to 100 score for the strength of a domain's backlinks, where every step up is harder than the last."
        items={reading}
      />

      <SplitList
        id="method-heading"
        title="How is Domain Rating worked out?"
        text="From links alone. That makes DR a measure of links, and only links."
        items={method}
      />

      <section class="site-frame" aria-labelledby="da-heading">
        <SectionHeading
          id="da-heading"
          title="Is Domain Rating the same as Domain Authority?"
          text="No. This page shows Ahrefs Domain Rating. Moz Domain Authority comes from a different index, so the same site can score 45 on one and 30 on the other. Pick one score and use it for every site you compare."
        />
        <div class="docs-prose max-w-4xl">
          <table>
            <thead>
              <tr><th></th><th>Domain Rating (DR)</th><th>Domain Authority (DA)</th></tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr><th scope="row">{row.label}</th><td>{row.dr}</td><td>{row.da}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <SplitList
        id="market-heading"
        title="What is a good Domain Rating?"
        text="One that holds up against the sites ranking for the searches you want. There is no fixed good number, so compare sites in the same market."
        items={market}
      />

      <SplitList
        id="limits-heading"
        title="What can Domain Rating not tell you?"
        text="How one page will rank. Use DR to judge links and leave ranking predictions out of it."
        items={limits}
      />

      <SplitList
        id="agent-heading"
        title="How do you check Domain Rating with your AI agent?"
        text="Run seo research, and Domain Rating comes free next to the results."
        items={[
          { title: 'With your DataForSEO key', text: 'For competitors or backlinks through the hosted MCP server, the first 25 domains in the result get a Domain Rating, with no Ahrefs key needed for that part.', href: '/docs/research' },
          { title: 'With an Ahrefs key', text: 'Every row carries its own.' },
          { title: 'In a domain overview', text: 'A site’s Domain Rating sits next to its estimated traffic and top pages.', href: '/features/domain-overview' },
        ]}
      >
        <div class="mt-6">
          <CodeBlock
            label="Ask your agent"
            prompt
            value="Find the sites that compete with example.com in Google and sort them by Domain Rating"
            wrap
          />
        </div>
      </SplitList>

      <section class="site-frame" aria-labelledby="tools-heading">
        <SectionHeading
          id="tools-heading"
          title="Which tools go with a Domain Rating check?"
          text="These, which show who ranks, who links and how long each site has been around."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {tools.map((item) => <HomeCard {...item} />)}
        </div>
      </section>

      <section class="site-frame" aria-labelledby="faq-heading">
        <div class="max-w-2xl">
          <h2 id="faq-heading" class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            Domain Rating questions
          </h2>
        </div>
        <div class="mt-10">
          <FaqAccordion id="domain-rating-faq" items={faq} />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="start-heading">
        <SectionHeading
          id="start-heading"
          title="Rank your competitors by Domain Rating"
          text="Add SEO Skill to your agent and ask which sites compete with yours in Google, sorted by Domain Rating."
        />
        <SetupPrompts id="domain-rating-setup" />
      </section>
    </div>
  </main>
</BaseLayout>
