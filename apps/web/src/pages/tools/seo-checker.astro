---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import PageHeader from '@/components/PageHeader.astro'
import SetupPrompts from '@/components/SetupPrompts.astro'
import SeoChecker from '@/components/tools/SeoChecker.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: 'SEO checker' },
]

const faq = [
  {
    question: 'What is an SEO audit?',
    answer:
      'A check of what stops a site doing well in search. It covers whether search engines can reach and index the pages, what each page tells them in its title, headings, canonical and structured data, and how the site actually performs in Search Console. This page does the first two for one URL.',
  },
  {
    question: 'Is this SEO checker really free?',
    answer:
      'Yes. It needs no account and no email address. You get 10 checks a day, because each one fetches a live page and its robots.txt.',
  },
  {
    question: 'Why is there no SEO score?',
    answer:
      'A single score adds up things that matter very differently. A missing Open Graph image and a noindex tag would each lose a few points, but only one of them takes the page out of Google. The checker counts what to fix and what to look at instead, and puts the fixes first.',
  },
  {
    question: 'Does a page that passes every check rank?',
    answer:
      'No. Passing means nothing on the page stops Google indexing it or reading it. Rankings depend on whether the page answers the search better than the other results, and on links from other sites. The Search Console report shows the searches a page already shows up for.',
  },
  {
    question: 'Does it check pages built with JavaScript?',
    answer:
      'It reads the HTML the server sends, before any JavaScript runs. That is what Google sees first and what most AI crawlers see at all. If the word count is low on a page that looks full in the browser, the text arrives through JavaScript.',
  },
  {
    question: 'How do I audit my whole site for free?',
    answer:
      'Run seo crawl from the SEO Skill CLI. It crawls any site, including staging and localhost, with no sign-in, and lists broken links, redirect chains, missing and repeated titles, canonicals and noindex pages across every page it finds.',
  },
  {
    question: 'Can my AI agent run an SEO audit?',
    answer:
      'Yes. Add SEO Skill to Claude Code, Codex, Cursor or another agent and ask it to audit a site. It runs the crawl, checks pages one by one, reads Search Console and Google Analytics, and can fix what it finds in your code.',
  },
]
---

<BaseLayout
  title="Free SEO checker for any page"
  description="Run a free SEO audit of any page. Check whether Google can index it, then its title, meta description, headings, images, links, canonical, structured data and Open Graph tags."
  canonicalPath="/tools/seo-checker"
  {breadcrumbs}
>
  <main data-agent-content>
    <Breadcrumbs {breadcrumbs} />
    <PageHeader
      title="SEO checker"
      description="Enter a URL for a free SEO audit of that page. The checker says whether Google can reach and index it, then reads the title, description, headings, images, links, canonical, structured data and share tags, with a fix for each problem."
    />

    <SeoChecker />

    <div class="docs-prose mt-16">
      <h2>What the SEO checker looks at</h2>
      <p>
        The checks run in the order that matters. A page Google cannot
        index gains nothing from a better title, so access comes first.
      </p>
      <table>
        <thead>
          <tr>
            <th>Part</th>
            <th>What it checks</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Access</td>
            <td>The status code, every redirect on the way, whether robots.txt lets Googlebot in, and noindex in the robots meta tag, googlebot tag or X-Robots-Tag header.</td>
          </tr>
          <tr>
            <td>Title and description</td>
            <td>Missing, empty and long titles and meta descriptions, and pages with more than one title tag.</td>
          </tr>
          <tr>
            <td>Content</td>
            <td>The H1, how many words are in the HTML, images without alt text, and how many links go to other pages on the site.</td>
          </tr>
          <tr>
            <td>Markup</td>
            <td>The canonical link, the page language, the viewport tag for phones, JSON-LD structured data and whether it parses, hreflang alternates and Open Graph tags.</td>
          </tr>
        </tbody>
      </table>

      <h2>Read the result</h2>
      <p>
        Each line has one of four labels. <strong>Fix</strong> means
        something is wrong, such as a noindex, a 404 or structured data
        that is not valid JSON. <strong>Check</strong> means it is probably
        a problem but depends on what you meant, such as a missing meta
        description. <strong>Note</strong> is context, and{' '}
        <strong>OK</strong> passed.
      </p>
      <p>
        A noindex or a canonical pointing somewhere else is not always a
        mistake (thank you pages and filtered listings are often meant to
        stay out of Google). The checker says what each rule does, and you
        decide whether it should be there.
      </p>
      <p>
        For a closer look at one part, the{' '}
        <a href="/tools/title-and-meta-description-checker">title and meta description checker</a>{' '}
        measures both in pixels, the{' '}
        <a href="/tools/noindex-checker">noindex checker</a> shows every
        robots rule, the{' '}
        <a href="/tools/schema-markup-validator">schema markup validator</a>{' '}
        reads the structured data field by field and the{' '}
        <a href="/tools/open-graph-checker">Open Graph checker</a> shows the
        share preview.
      </p>

      <h2>What one page check cannot tell you</h2>
      <p>
        It cannot say whether Google has indexed the page, only whether it
        is allowed to. The <a href="/tools/google-index-checker">Google index checker</a>{' '}
        searches Google for the page itself. It also cannot see how the page
        does in search. That lives in Search Console: the searches it shows
        for, its position and its clicks.
      </p>

      <h2>Audit the whole site with your agent</h2>
      <p>
        One page is a spot check. Most problems live in templates, so they
        show up on hundreds of pages at once, and the fix belongs in the
        code. SEO Skill gives your AI agent the full{' '}
        <a href="/features/seo-audit">SEO audit</a>: a crawl of the site,
        Google's own index status for each page from URL Inspection, and the
        Search Console report. Ask:
      </p>
      <CodeBlock prompt value="Run an SEO audit of example.com: crawl the site, check the top pages one by one, then list what to fix first from the Search Console report" wrap />
      <p>
        To crawl a site, including staging and localhost, your agent needs
        the CLI. Give it this prompt and it installs the CLI and adds the
        hosted MCP server:
      </p>
    </div>

    <SetupPrompts id="seo-checker-setup" class="mt-6" />

    <div class="docs-prose mt-16">
      <h2>SEO checker questions</h2>
    </div>
    <div class="mt-6">
      <FaqAccordion id="seo-checker-faq" items={faq} />
    </div>
  </main>
</BaseLayout>
