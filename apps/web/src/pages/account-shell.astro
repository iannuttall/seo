---
// The account and connect pages of the hosted MCP, in the site design. The
// MCP Worker (apps/mcp) serves this page at /account and /oauth/authorize
// and adds a JSON state block; the script below shows the matching view.
// Opened directly, it sends the visitor to /account.
import CodeBlock from '@/components/CodeBlock.astro'
import FormInput from '@/components/FormInput.astro'
import PageHeader from '@/components/PageHeader.astro'
import { getButtonClasses } from '@/components/ui/button'
import BaseLayout from '@/layouts/BaseLayout.astro'

const primary = getButtonClasses('default')
const outline = getButtonClasses('outline')
const danger = getButtonClasses('destructive')
const quiet = getButtonClasses('link-muted', 'xs')
const panel = 'rounded-lg bg-muted p-6'
const heading = 'text-base font-medium text-foreground'
const note = 'mt-1 text-sm/6 text-foreground-muted'
// A small toggle group, in the tab bar's style.
const toggles =
  'inline-flex h-9 shrink-0 items-center gap-1 rounded-lg bg-muted p-0.5 text-foreground-muted'
const toggle =
  'inline-flex h-8 items-center rounded-md px-3 text-sm font-medium outline-none transition-colors hover:text-foreground focus-visible:ring-[3px] focus-visible:ring-ring/20 aria-pressed:bg-card aria-pressed:text-foreground aria-pressed:shadow-xs'
const description =
  'The Google accounts, Bing, API keys and Clicky sites your agents use, through the hosted MCP server or the seo CLI.'
const tabs = [
  { id: 'accounts', label: 'Accounts' },
  { id: 'keys', label: 'Keys' },
  { id: 'machines', label: 'Machines' },
  // Only for accounts in the weekly-audit beta; removed otherwise.
  { id: 'sites', label: 'Sites' },
  // Only for accounts granted a beta feature; removed otherwise.
  { id: 'beta', label: 'Beta' },
]
const keys: { name: string; label: string; type: 'text' | 'password' }[] = [
  { name: 'x-dataforseo-login', label: 'DataForSEO API login', type: 'text' },
  {
    name: 'x-dataforseo-password',
    label: 'DataForSEO API password',
    type: 'password',
  },
  { name: 'x-ahrefs-key', label: 'Ahrefs API key', type: 'password' },
  { name: 'x-typesafe-key', label: 'TypeSafe API key', type: 'password' },
]
---

<BaseLayout
  title="Your account"
  description="Manage the Google accounts and API keys your agents use through the hosted SEO Skill MCP server."
  canonicalPath="/account"
  noindex
  analytics={false}
>
  <main class="max-w-2xl" data-account-app>
    <div data-header>
      <PageHeader title="Your account" description={description} />
    </div>
    <p data-message class="mb-6 rounded-lg bg-muted px-4 py-3 text-sm/6 text-foreground" hidden></p>

    <section data-view="loading">
      <p class="text-sm text-foreground-muted">Loading.</p>
    </section>

    <section data-view="connect" hidden>
      <div class={panel}>
        <p class="text-sm/6 text-foreground">
          <strong class="font-medium" data-client></strong> wants to read your
          Search Console and Google Analytics data through SEO Skill. After you
          sign in, Google sends you back to <strong class="font-medium" data-host></strong>.
        </p>
        <p class={note}>
          SEO Skill keeps your Google sign-in, encrypted, so every agent you
          connect can use it. It never keeps your data or reports. You can add
          more Google accounts and API keys on your account page, and
          delete everything there.
        </p>
        <form method="post" data-action="/oauth/google" class="mt-6">
          <input type="hidden" name="flow" data-flow />
          <button type="submit" class={primary}>Continue with Google</button>
        </form>
        <p class="mt-4 text-xs text-foreground-muted">
          Only continue if you started this from your own agent.
        </p>
      </div>
    </section>

    <section data-view="signin" hidden>
      <div class={panel}>
        <p class="text-sm/6 text-foreground">
          Sign in with any Google account you connected to SEO Skill.
        </p>
        <p class={note}>
          A Google account that is not connected yet gets its own new account.
        </p>
        <p class={note} data-signin-link hidden>
          After you sign in, you can link the <code>seo</code> CLI that asked.
        </p>
        <form method="post" data-action="/account/signin" class="mt-6">
          <input type="hidden" name="link" data-link-code />
          <button type="submit" class={primary}>Sign in with Google</button>
        </form>
      </div>
    </section>

    <section data-view="notice" hidden>
      <div class={panel}>
        <p class="text-sm/6 text-foreground" data-notice-text></p>
        <a href="/account" data-href="/account" class:list={[outline, 'mt-6']}>Go to your account</a>
      </div>
    </section>

    <section data-view="account" hidden>
      <div class:list={[panel, 'mb-6']} data-login hidden>
        <h2 class={heading}>Link the seo CLI</h2>
        <p class="mt-1 text-sm/6 text-foreground">
          <strong class="font-medium" data-login-label></strong> asked to
          link with code <strong class="font-mono font-medium" data-login-code></strong>.
        </p>
        <p class={note}>
          Only link it if you just ran <code>seo login</code> yourself. That
          machine can then use your Google accounts, Bing and keys.
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <form method="post" data-action="/account/link">
            <input type="hidden" name="form" />
            <input type="hidden" name="code" data-login-input />
            <button type="submit" class={primary}>Link this machine</button>
          </form>
          <a href="/account" data-href="/account" class={outline}>Cancel</a>
        </div>
      </div>

      {/* The ilo toggle group from SetupCommands, on one row. On a narrow
          screen it scrolls sideways with no scrollbar, and a fade shows on
          each edge that has more tabs past it. Each tab has a hash, and
          the #google, #bing, #clicky and #machines links open the tab that
          holds them. */}
      <div class="relative w-fit max-w-full">
        <div
          role="tablist"
          aria-label="Account sections"
          class="relative flex h-9 max-w-full items-center gap-1 overflow-x-auto rounded-lg bg-muted p-0.5 text-foreground-muted [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          data-tab-strip
        >
          {
            tabs.map((tab, index) => (
              <button
                type="button"
                role="tab"
                id={`account-tab-${tab.id}`}
                aria-controls={`account-panel-${tab.id}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? undefined : -1}
                data-account-tab={tab.id}
                class="inline-flex h-8 min-w-7 shrink-0 items-center justify-center rounded-md border border-transparent px-3 text-sm font-medium outline-none transition-colors hover:text-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/20 aria-selected:bg-card aria-selected:text-foreground aria-selected:shadow-xs"
              >
                {tab.label}
              </button>
            ))
          }
        </div>
        <span
          aria-hidden="true"
          class="pointer-events-none absolute inset-y-0 left-0 w-10 rounded-l-lg bg-linear-to-r from-muted to-transparent opacity-0 transition-opacity"
          data-tab-fade="left"
        ></span>
        <span
          aria-hidden="true"
          class="pointer-events-none absolute inset-y-0 right-0 w-10 rounded-r-lg bg-linear-to-l from-muted to-transparent opacity-0 transition-opacity"
          data-tab-fade="right"
        ></span>
      </div>

      <div
        role="tabpanel"
        id="account-panel-accounts"
        aria-labelledby="account-tab-accounts"
        data-account-panel="accounts"
        class="mt-4 flex flex-col gap-4"
      >
        <div class={panel} id="google">
          <h2 class={heading}>Google accounts</h2>
          <p class={note}>Each report uses the account that can read the site.</p>
          <ul class="mt-4 divide-y divide-border text-sm" data-google-list></ul>
          <form method="post" data-action="/account/google" class="mt-4">
            <input type="hidden" name="form" />
            <button type="submit" class={outline}>Add a Google account</button>
          </form>
        </div>

        <div class={panel} id="bing" data-bing-panel>
          <h2 class={heading}>Bing Webmaster Tools</h2>
          <p class={note}>
            Adds Bing clicks, impressions, queries and pages beside Search
            Console. Bing blocks this server, so Bing data comes through
            the <code>seo</code> CLI on your own machine after <code>seo login</code>.
          </p>
          <ul class="mt-4 divide-y divide-border text-sm" data-bing-list></ul>
          <form method="post" data-action="/account/bing" class="mt-4" data-bing-add>
            <input type="hidden" name="form" />
            <button type="submit" class={outline} data-bing-button>Connect Bing</button>
          </form>
        </div>
      </div>

      <div
        role="tabpanel"
        id="account-panel-keys"
        aria-labelledby="account-tab-keys"
        data-account-panel="keys"
        class="mt-4 flex flex-col gap-4"
        hidden
      >
        <div class={panel} id="keys">
          <h2 class={heading}>DataForSEO, Ahrefs and TypeSafe</h2>
          <p class={note}>
            DataForSEO and Ahrefs add keyword, SERP, competitor and backlink
            data from your own account. A TypeSafe key lets internal link
            audits use Jev to sort your pages and judge each link (about 10 to
            20 cents for a 500-page site). Each request uses your credits there.
            Saved keys are encrypted and never shown again.
          </p>
          <form method="post" data-action="/account/keys" class="mt-4 flex flex-col gap-4">
            <input type="hidden" name="form" />
            {
              keys.map((key) => (
                <label class="flex flex-col gap-1.5 text-sm font-medium text-foreground">
                  <span>
                    {key.label}{' '}
                    <span class="font-normal text-primary" data-saved={key.name} hidden>
                      saved
                    </span>
                  </span>
                  <FormInput
                    name={key.name}
                    type={key.type}
                    autocomplete="off"
                    spellcheck="false"
                    data-key-input={key.name}
                  />
                </label>
              ))
            }
            <div class="flex flex-wrap gap-3">
              <button type="submit" class={primary}>Save keys</button>
            </div>
          </form>
          <form method="post" data-action="/account/keys/remove" class="mt-3" data-keys-remove hidden>
            <input type="hidden" name="form" />
            <button type="submit" class={quiet}>Remove these keys</button>
          </form>
        </div>

        <div class={panel} id="clicky">
          <h2 class={heading}>Clicky</h2>
          <p class={note}>
            Adds Clicky visits by landing page, traffic sources and search
            engines. Add your whole Clicky account, or one site at a time.
          </p>
          <ul class="mt-4 divide-y divide-border text-sm" data-clicky-list></ul>

          <h3 class="mt-6 text-sm font-medium text-foreground">Your Clicky account</h3>
          <p class={note}>
            Adds every site in your Clicky account. Sites you add to Clicky
            later appear when an agent asks for them. Your Clicky password is
            encrypted and kept for this, so use one you use nowhere else. To
            stop, remove the account here and change your password at Clicky.
            It does not work if your Clicky account uses two-factor sign-in or
            Sign in with Google; add each site below instead.
          </p>
          <div class="mt-3 flex items-center justify-between gap-4 text-sm" data-clicky-account-row hidden>
            <span class="min-w-0 break-all text-foreground">
              <span data-clicky-account></span>
              <span class="text-primary">saved</span>
            </span>
            <form method="post" data-action="/account/clicky/account/remove">
              <input type="hidden" name="form" />
              <button type="submit" class={quiet}>Remove account and its sites</button>
            </form>
          </div>
          <form method="post" data-action="/account/clicky/account" class="mt-4 flex flex-col gap-4">
            <input type="hidden" name="form" />
            <div class="grid gap-4 sm:grid-cols-2">
              <label class="flex flex-col gap-1.5 text-sm font-medium text-foreground">
                <span>Clicky username or email</span>
                <FormInput name="clicky-username" type="text" autocomplete="off" spellcheck="false" />
              </label>
              <label class="flex flex-col gap-1.5 text-sm font-medium text-foreground">
                <span>Clicky password</span>
                <FormInput name="clicky-password" type="password" autocomplete="off" spellcheck="false" />
              </label>
            </div>
            <div class="flex flex-wrap gap-3">
              <button type="submit" class={outline}>Save Clicky account</button>
            </div>
          </form>

          <h3 class="mt-6 text-sm font-medium text-foreground">One site</h3>
          <p class={note}>
            Use the site ID and sitekey from Clicky (Preferences, Info). The
            sitekey is encrypted and never shown again.
          </p>
          <form method="post" data-action="/account/clicky" class="mt-4 flex flex-col gap-4">
            <input type="hidden" name="form" />
            <div class="grid gap-4 sm:grid-cols-2">
              <label class="flex flex-col gap-1.5 text-sm font-medium text-foreground">
                <span>Site ID</span>
                <FormInput name="clicky-site" type="text" inputmode="numeric" autocomplete="off" spellcheck="false" />
              </label>
              <label class="flex flex-col gap-1.5 text-sm font-medium text-foreground">
                <span>Sitekey</span>
                <FormInput name="clicky-sitekey" type="password" autocomplete="off" spellcheck="false" />
              </label>
            </div>
            <div class="flex flex-wrap gap-3">
              <button type="submit" class={outline}>Add Clicky site</button>
            </div>
          </form>
        </div>
      </div>

      <div
        role="tabpanel"
        id="account-panel-machines"
        aria-labelledby="account-tab-machines"
        data-account-panel="machines"
        class="mt-4 flex flex-col gap-4"
        hidden
      >
        <div class={panel} id="machines">
          <h2 class={heading}>Linked machines</h2>
          <p class={note}>
            The <code>seo</code> CLI on these machines uses your Google
            accounts, Bing and keys. Run <code>seo login</code> on a machine to
            add it.
          </p>
          <ul class="mt-4 divide-y divide-border text-sm" data-machine-list></ul>
          <div class="mt-4" data-token hidden>
            <p class="text-sm/6 text-foreground">
              Save this as <code>SEO_TOKEN</code> in your cloud agent's
              secrets. It is shown once.
            </p>
            <CodeBlock value="" wrap class="!mt-2 [--muted:var(--background)]" />
          </div>
          <form method="post" data-action="/account/cli/new" class="mt-4">
            <input type="hidden" name="form" />
            <button type="submit" class={outline}>Make a token for a cloud agent</button>
          </form>
        </div>
      </div>

      <div
        role="tabpanel"
        id="account-panel-sites"
        aria-labelledby="account-tab-sites"
        data-account-panel="sites"
        class="mt-4 flex flex-col gap-4"
        hidden
      >
        <div class="flex flex-col gap-4" data-sites-overview>
          <div class="flex items-center gap-3 rounded-lg bg-info-soft px-4 py-2.5 text-sm/6 text-foreground" data-sites-notice hidden>
            <p class="min-w-0 flex-1">
              <span data-sites-notice-text></span><a class="underline" data-sites-notice-link>Review</a>
            </p>
            <button
              type="button"
              aria-label="Dismiss"
              class="-mr-1 inline-flex size-7 shrink-0 items-center justify-center rounded-md text-foreground-muted hover:text-foreground"
              data-sites-notice-close
            >
              <svg viewBox="0 0 16 16" class="size-3.5" aria-hidden="true"><path d="M3.5 3.5l9 9m0-9l-9 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
            </button>
          </div>

          <div class={panel} id="sites">
            <h2 class={heading}>Sites</h2>
            <p class={note}>
              Each site is crawled once a week and Google checks its pages
              every day. Ask your agent for the report.
            </p>
            <form method="post" data-action="/account/audit" class="mt-4" data-audit-add>
              <input type="hidden" name="form" />
              <input type="hidden" name="property" data-picker-value />
              <label for="site-picker" class="text-sm font-medium text-foreground">Add a site</label>
              <div class="relative mt-1.5">
                <FormInput
                  id="site-picker"
                  type="text"
                  role="combobox"
                  aria-expanded="false"
                  aria-controls="site-picker-list"
                  aria-autocomplete="list"
                  autocomplete="off"
                  spellcheck="false"
                  placeholder="Search your Search Console properties"
                  data-picker
                />
                <ul
                  id="site-picker-list"
                  role="listbox"
                  aria-label="Search Console properties"
                  class="absolute inset-x-0 z-10 mt-1 max-h-80 overflow-y-auto rounded-lg bg-card p-1 text-sm shadow-lg"
                  data-picker-list
                  hidden
                ></ul>
              </div>
              <p class={note} data-picker-status aria-live="polite"></p>
            </form>
            <p class={note} data-audit-full hidden></p>
          </div>

          <div class="flex flex-wrap items-center gap-2" data-sites-tools hidden>
            <label for="site-filter" class="sr-only">Filter sites by name</label>
            <FormInput
              id="site-filter"
              type="search"
              autocomplete="off"
              spellcheck="false"
              placeholder="Filter sites"
              class="h-9 basis-full sm:basis-0 sm:flex-1"
              data-site-filter
            />
            <div role="group" aria-label="Show" class={toggles}>
              <button type="button" class={toggle} aria-pressed="true" data-health="all">All</button>
              <button type="button" class={toggle} aria-pressed="false" data-health="issues">Issues</button>
              <button type="button" class={toggle} aria-pressed="false" data-health="healthy">Healthy</button>
            </div>
            <div role="group" aria-label="Layout" class:list={[toggles, 'ml-auto sm:ml-0']}>
              <button type="button" class={toggle} aria-pressed="true" data-layout="cards">Cards</button>
              <button type="button" class={toggle} aria-pressed="false" data-layout="list">List</button>
            </div>
          </div>

          <ul class="grid gap-4 sm:grid-cols-2" aria-label="Audited sites" data-site-cards></ul>
          <div class="overflow-hidden rounded-lg bg-muted" data-site-table hidden>
            <table class="w-full text-left text-sm">
              <caption class="sr-only">Audited sites</caption>
              <thead class="text-foreground-muted">
                <tr>
                  <th scope="col" class="px-4 py-2.5 font-normal">Site</th>
                  <th scope="col" class="hidden px-2 py-2.5 font-normal sm:table-cell">Health</th>
                  <th scope="col" class="hidden px-2 py-2.5 text-right font-normal sm:table-cell">Crawled</th>
                  <th scope="col" class="whitespace-nowrap px-2 py-2.5 text-right font-normal">In index</th>
                  <th scope="col" class="px-2 py-2.5 text-right font-normal">New issues</th>
                  <th scope="col" class="hidden px-4 py-2.5 font-normal sm:table-cell">Alerts</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border" data-site-rows></tbody>
            </table>
          </div>
          <p class="text-sm text-foreground-muted" data-sites-empty hidden>No site matches.</p>
        </div>

        <div data-site-page hidden>
          <a href="/account#sites" data-href="/account#sites" class="inline-flex items-center gap-1 text-sm text-foreground-muted hover:text-foreground">
            <span aria-hidden="true">←</span> All sites
          </a>
          <h2 class="mt-3 break-all text-xl font-semibold text-foreground" data-page-name></h2>
          <p class={note} data-page-owner></p>
          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            {
              [
                { id: 'crawl', label: 'Weekly crawl' },
                { id: 'checks', label: 'Index checks' },
                { id: 'coverage', label: 'Coverage' },
                { id: 'alerts', label: 'Alerts' },
              ].map((tile) => (
                <section class="flex flex-col rounded-lg bg-muted p-5" data-tile={tile.id}>
                  <h3 class="flex items-center gap-2 text-sm font-medium text-foreground">
                    <span class="size-2 shrink-0 rounded-full bg-foreground-soft" data-tile-dot></span>
                    <span>{tile.label}</span>
                  </h3>
                  <p class="mt-3 text-3xl font-semibold tabular-nums text-foreground" data-tile-value></p>
                  <p class="mt-1 text-sm/6 text-foreground-muted" data-tile-line></p>
                  {tile.id === 'coverage' && (
                    <button type="button" class:list={[outline, 'mt-4 self-start']} data-coverage-open hidden>
                      Improve coverage
                    </button>
                  )}
                  {tile.id === 'alerts' && (
                    <a href="/account#alerts" data-href="/account#alerts" class="mt-4 self-start text-sm text-foreground underline">
                      Change alerts
                    </a>
                  )}
                </section>
              ))
            }
          </div>
          <form method="post" data-action="/account/audit/remove" class="mt-8">
            <input type="hidden" name="form" />
            <input type="hidden" name="property" data-page-input />
            <button type="submit" class={quiet}>Remove from audit</button>
          </form>
        </div>

        <dialog
          id="coverage"
          aria-labelledby="coverage-title"
          class="m-auto w-[min(30rem,calc(100%-2rem))] rounded-xl border-0 bg-card shadow-xl outline-none p-6 text-foreground backdrop:bg-overlay-scrim"
          data-coverage-dialog
        >
          <h2 id="coverage-title" class={heading}>Improve coverage</h2>
          <p class={note}>
            Google checks up to 2,000 pages a day for each property, so each
            folder you add checks more.
          </p>
          <ul class="mt-4 divide-y divide-border text-sm" data-coverage-list></ul>
          <form method="post" data-action="/account/audit/properties" class="mt-5" data-coverage-create>
            <input type="hidden" name="form" />
            <input type="hidden" name="property" data-coverage-input />
            <button type="submit" class={primary}>Create these in Search Console</button>
            <p class="mt-2 text-xs/5 text-foreground-muted">
              Google asks once for permission to add properties, and SEO Skill does not keep it.
            </p>
          </form>
          <form method="dialog" class="mt-4">
            <button type="submit" class={outline}>Close</button>
          </form>
        </dialog>
      </div>

      <div
        role="tabpanel"
        id="account-panel-beta"
        aria-labelledby="account-tab-beta"
        data-account-panel="beta"
        class="mt-4 flex flex-col gap-4"
        hidden
      >
        <div class={panel} id="beta">
          <h2 class={heading}>Beta</h2>
          <p class={note}>
            Features your account can try before everyone else. They may
            change, and we may turn them off.
          </p>
          <ul class="mt-4 divide-y divide-border text-sm" data-beta-list></ul>
        </div>

        <div class={panel} id="alerts" data-alerts-panel hidden>
          <h2 class={heading}>Alerts</h2>
          <p class={note} data-alerts-to></p>
          <form method="post" data-action="/account/alerts" class="mt-4 flex flex-col gap-4">
            <input type="hidden" name="form" />
            <ul class="divide-y divide-border text-sm" data-alerts-list></ul>
            <label class="flex flex-col gap-1.5 text-sm font-medium text-foreground">
              <span>Webhook URL</span>
              <FormInput name="webhook_url" type="url" autocomplete="off" spellcheck="false" placeholder="https://example.com/hooks/seo" data-alerts-url />
            </label>
            <p class="-mt-2 text-sm/6 text-foreground-muted">
              Optional. Each alert is sent as signed JSON, the same alert as
              the email. <a class="text-foreground underline" href="https://github.com/iannuttall/seo/blob/main/apps/mcp/README.md#alert-webhooks" target="_blank" rel="noopener">How to read it</a>
            </p>
            <div class="flex flex-wrap gap-3">
              <button type="submit" class={outline}>Save alerts</button>
            </div>
          </form>
          <div class="mt-6" data-alerts-secret hidden>
            <p class="text-sm/6 text-foreground">
              Signing secret: check each call's <code>webhook-signature</code> header with it.
            </p>
            <CodeBlock value="" wrap class="!mt-2 [--muted:var(--background)]" />
            <p class={note} data-alerts-last hidden></p>
            <form method="post" data-action="/account/alerts/secret" class="mt-2">
              <input type="hidden" name="form" />
              <button type="submit" class={quiet}>Make a new secret</button>
            </form>
          </div>
          <p class={note} data-alerts-held hidden></p>
        </div>
      </div>

      <div class="mt-10 border-t border-border pt-6" id="delete">
        <p class="text-sm/6 text-foreground-muted">
          Delete everything removes your Google and Bing sign-ins, keys,
          Clicky sites, linked machines and any audited sites with their
          crawl data from SEO Skill and revokes the
          Google sign-ins. Your agents will ask you to sign in again.
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <form method="post" data-action="/account/signout">
            <input type="hidden" name="form" />
            <button type="submit" class={outline}>Sign out</button>
          </form>
          <form method="post" data-action="/account/delete">
            <input type="hidden" name="form" />
            <button type="submit" class={danger}>Delete everything</button>
          </form>
        </div>
      </div>
    </section>

    <template data-account-row>
      <li class="flex items-center justify-between gap-4 py-2.5">
        <span class="min-w-0 break-all text-foreground" data-email></span>
        <form method="post" data-action="/account/remove" data-remove>
          <input type="hidden" name="form" />
          <input type="hidden" name="provider" data-provider />
          <input type="hidden" name="subject" data-subject />
          <button type="submit" class={quiet}>Remove</button>
        </form>
      </li>
    </template>
    <template data-clicky-row>
      <li class="flex items-center justify-between gap-4 py-2.5">
        <span class="min-w-0 break-all text-foreground">
          <span data-clicky-domain></span>
          <span class="text-foreground-muted" data-clicky-id></span>
        </span>
        <form method="post" data-action="/account/clicky/remove">
          <input type="hidden" name="form" />
          <input type="hidden" name="id" data-clicky-input />
          <button type="submit" class={quiet}>Remove</button>
        </form>
      </li>
    </template>
    <template data-beta-row>
      <li class="py-2.5" data-beta-feature>
        <p class="font-medium text-foreground" data-beta-title></p>
        <p class="mt-0.5 text-foreground-muted" data-beta-text></p>
      </li>
    </template>
    <template data-site-card>
      <li class="flex flex-col rounded-lg bg-muted p-5" data-site>
        <a class="flex items-center justify-between gap-3 text-sm font-medium text-foreground hover:underline" data-site-link>
          <span class="min-w-0 [overflow-wrap:anywhere]" data-site-name></span>
          <span aria-hidden="true" class="text-foreground-muted">›</span>
        </a>
        {/* The right side of this row is kept free for a small trend chart. */}
        <div class="mt-2 flex items-center justify-between gap-4">
          <p class="flex items-center gap-2 text-xl font-semibold text-foreground">
            <span class="size-2.5 shrink-0 rounded-full" data-site-dot></span>
            <span data-site-health></span>
          </p>
        </div>
        <dl class="mt-4 grid grid-cols-3 gap-3 text-sm">
          <div class="flex flex-col-reverse">
            <dt class="text-xs text-foreground-muted">crawled</dt>
            <dd class="font-medium tabular-nums text-foreground" data-site-crawled></dd>
          </div>
          <div class="flex flex-col-reverse">
            <dt class="text-xs text-foreground-muted">in index</dt>
            <dd class="font-medium tabular-nums text-foreground" data-site-indexed></dd>
          </div>
          <div class="flex flex-col-reverse">
            <dt class="text-xs text-foreground-muted">new issues</dt>
            <dd class="font-medium tabular-nums text-foreground" data-site-new></dd>
          </div>
        </dl>
        <div class="mt-5 flex items-center justify-between gap-3 text-sm">
          <span class="text-foreground-muted" data-site-alerts></span>
          <a class="font-medium text-primary hover:underline" data-site-view>View site <span aria-hidden="true">→</span></a>
        </div>
      </li>
    </template>
    <template data-site-row>
      <tr data-site>
        <td class="px-4 py-3">
          <a class="font-medium text-foreground [overflow-wrap:anywhere] hover:underline" data-site-link data-site-name></a>
          <span class="mt-0.5 flex items-center gap-1.5 text-foreground-muted sm:hidden">
            <span class="size-2 shrink-0 rounded-full" data-site-dot></span>
            <span data-site-health></span>
          </span>
        </td>
        <td class="hidden px-2 py-3 sm:table-cell">
          <span class="inline-flex items-center gap-1.5 whitespace-nowrap text-foreground">
            <span class="size-2 shrink-0 rounded-full" data-site-dot></span>
            <span data-site-health></span>
          </span>
        </td>
        <td class="hidden px-2 py-3 text-right tabular-nums text-foreground sm:table-cell" data-site-crawled></td>
        <td class="px-2 py-3 text-right tabular-nums text-foreground" data-site-indexed></td>
        <td class="px-2 py-3 text-right tabular-nums text-foreground" data-site-new></td>
        <td class="hidden whitespace-nowrap px-4 py-3 text-foreground-muted sm:table-cell" data-site-alerts></td>
      </tr>
    </template>
    <template data-alert-row>
      <li class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2 py-2.5">
        <span class="min-w-0">
          <span class="block text-foreground" data-alert-title></span>
          <span class="block text-foreground-muted" data-alert-text></span>
        </span>
        <span class="flex shrink-0 gap-4">
          <label class="flex items-center gap-1.5 text-foreground">
            <input type="checkbox" class="size-4 accent-primary" data-alert-email /> Email
          </label>
          <label class="flex items-center gap-1.5 text-foreground">
            <input type="checkbox" class="size-4 accent-primary" data-alert-webhook /> Webhook
          </label>
        </span>
      </li>
    </template>
    <template data-machine-row>
      <li class="flex items-center justify-between gap-4 py-2.5">
        <span class="min-w-0 text-foreground">
          <span data-machine-label></span>
          <span class="text-foreground-muted" data-machine-used></span>
        </span>
        <form method="post" data-action="/account/cli/remove">
          <input type="hidden" name="form" />
          <input type="hidden" name="id" data-machine-id />
          <button type="submit" class={quiet}>Remove</button>
        </form>
      </li>
    </template>
  </main>
</BaseLayout>

<script>
  type State = {
    view: 'connect' | 'signin' | 'account' | 'notice'
    base?: string
    message?: string
    error?: boolean
    connect?: { client: string; host: string; flow: string }
    notice?: { title: string; text: string }
    account?: {
      form: string
      google: { email: string; subject: string }[]
      bing: { label: string; subject: string }[]
      bingReady: boolean
      keys: string[]
      clicky: { siteId: string; domain: string | null; account?: boolean }[]
      clickyAccount?: string | null
      machines: { id: string; label: string; usedAt: number | null }[]
      login?: { code: string; label: string }
      beta?: { id: string; title: string; text: string }[]
      audit?: {
        max: number
        sites: {
          id: string
          property: string
          lastFinishedAt: number | null
          lastStatus: string | null
          pages: number | null
          open: number | null
          new: number | null
          error: string | null
          nextRunAt: number
          monitor: {
            at: number
            used: number
            perDay: number
            known: number
            covered: number
            indexed?: number
            queued: number
            lastCheckedAt: number | null
            oldestCheckedAt: number | null
            dropped: number
            returned: number
          } | null
          coverage: {
            perDay: number
            properties: { property: string; urls: number }[]
            suggestions: {
              property: string
              urls: number
              gain: number
              added?: 'verified' | 'unverified'
            }[]
          } | null
        }[]
      }
      alerts?: {
        email: string | null
        types: { id: string; title: string; text: string; email: boolean; webhook: boolean }[]
        webhookUrl: string | null
        webhookSecret: string | null
        webhookLast: { at: number; result: string } | null
        held: number
      }
      token?: string
      tab?: string
      site?: string
    }
    link?: string
  }

  const root = document.querySelector<HTMLElement>('[data-account-app]')
  const raw = document.getElementById('seo-state')?.textContent
  if (!raw) {
    window.location.replace('/account')
  } else if (root) {
    const state = JSON.parse(raw) as State
    const base = state.base ?? ''
    const all = <T extends Element>(selector: string) =>
      Array.from(root.querySelectorAll<T>(selector))
    const show = (element: Element | null, visible = true) =>
      element?.toggleAttribute('hidden', !visible)

    type Audit = NonNullable<NonNullable<State['account']>['audit']>
    type Site = Audit['sites'][number]
    // A property as people say it: example.com, or shop.example.org/blog.
    const siteName = (site: Site) => site.property.replace(/^sc-domain:|^https?:\/\//, '').replace(/\/$/, '')
    type Alerts = NonNullable<State['account']>['alerts']
    type Choice = { property: string; email: string; audited: boolean }
    const day = (ms: number) =>
      new Date(ms).toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' })
    const time = (ms: number) =>
      new Date(ms).toLocaleString(undefined, { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' })
    const count = (n: number) => n.toLocaleString()
    const pages = (n: number) => `${count(n)} ${n === 1 ? 'page' : 'pages'}`
    const line = (parent: Element | null, text: string, muted = false) => {
      const item = document.createElement('span')
      item.className = muted ? 'block text-foreground-muted' : 'block'
      item.textContent = text
      parent?.append(item)
      return item
    }
    // The property list for the picker and the "read with" lines, fetched
    // once, when the Sites tab or the picker is first used.
    let choices: Promise<{ choices: Choice[]; failed: string[] } | null> | undefined
    const loadChoices = () => {
      choices ??= fetch(`${base}/account/audit/choices`, { credentials: 'same-origin' })
        .then((response) => (response.ok ? response.json() : null))
        .catch(() => null)
      return choices
    }

    // One site's page: four short tiles, and the step to add folders.
    let sitePageShown = () => {}
    const renderSitePage = (
      site: Site,
      alerts: Alerts,
      alertsOn: boolean,
      number: (value: number | null | undefined) => string,
    ) => {
      show(root.querySelector('[data-sites-overview]'), false)
      show(root.querySelector('[data-site-page]'))
      const name = root.querySelector('[data-page-name]')
      if (name) name.textContent = siteName(site)
      const input = root.querySelector<HTMLInputElement>('[data-page-input]')
      if (input) input.value = site.property
      document.title = `${name?.textContent} · Your account`
      const tile = (id: string, value: string, text: string, dot: string) => {
        const element = root.querySelector(`[data-tile="${id}"]`)
        const valueCell = element?.querySelector('[data-tile-value]')
        if (valueCell) valueCell.textContent = value
        const lineCell = element?.querySelector('[data-tile-line]')
        if (lineCell) lineCell.textContent = text
        element?.querySelector('[data-tile-dot]')?.classList.replace('bg-foreground-soft', dot)
      }
      const next = site.nextRunAt > Date.now() ? `next ${day(site.nextRunAt)}` : 'next within the hour'
      if (site.lastFinishedAt) {
        const failed = site.lastStatus === 'failed'
        tile(
          'crawl',
          count(site.pages ?? 0),
          `${failed ? 'stopped early' : `pages · ${count(site.new ?? 0)} new ${site.new === 1 ? 'issue' : 'issues'}`} · ${next}`,
          failed ? 'bg-destructive' : 'bg-success',
        )
      } else {
        tile('crawl', '–', site.error ? `Could not start: ${site.error}` : 'First crawl running', site.error ? 'bg-destructive' : 'bg-foreground-soft')
      }
      const monitor = site.monitor
      if (monitor) {
        const changes =
          monitor.dropped || monitor.returned
            ? `${count(monitor.dropped)} dropped, ${count(monitor.returned)} back this week`
            : 'no drops this week'
        tile(
          'checks',
          number(monitor.indexed),
          `of ${count(monitor.known)} in index · ${changes}`,
          monitor.dropped ? 'bg-warning' : 'bg-success',
        )
      } else {
        tile('checks', '–', 'Starts after the first crawl', 'bg-foreground-soft')
      }
      const coverage = site.coverage
      const folders = coverage?.suggestions ?? []
      const open = folders.filter((folder) => !folder.added)
      if (coverage) {
        const perDay = coverage.perDay * coverage.properties.length
        tile(
          'coverage',
          count(perDay),
          open.length
            ? `pages a day · add ${open.length === 1 ? 'one folder' : `${open.length} folders`} for ${count(perDay + open.length * coverage.perDay)}`
            : 'pages a day',
          open.length ? 'bg-warning' : 'bg-success',
        )
      } else {
        tile('coverage', '–', 'Worked out after the first checks', 'bg-foreground-soft')
      }
      const channels = [
        alerts?.types.some((type) => type.email) && 'email',
        alerts?.webhookUrl && alerts.types.some((type) => type.webhook) && 'webhook',
      ].filter(Boolean)
      tile(
        'alerts',
        alertsOn ? 'On' : 'Off',
        alertsOn ? `By ${channels.join(' and ')}` : 'No alerts for your sites',
        alertsOn ? 'bg-success' : 'bg-foreground-soft',
      )

      // Improve coverage: the suggested folders as a short checklist.
      const dialog = root.querySelector<HTMLDialogElement>('[data-coverage-dialog]')
      const opener = root.querySelector('[data-coverage-open]')
      if (dialog && folders.length) {
        show(opener)
        opener?.addEventListener('click', () => dialog.showModal())
        const list = dialog.querySelector('[data-coverage-list]')
        for (const folder of folders) {
          const item = document.createElement('li')
          item.className = 'flex items-start gap-3 py-2.5'
          const mark = document.createElement('span')
          mark.setAttribute('aria-hidden', 'true')
          mark.className = `mt-0.5 inline-flex size-4 shrink-0 items-center justify-center rounded text-[10px] ${
            folder.added === 'verified'
              ? 'bg-success text-background'
              : folder.added
                ? 'bg-warning text-background'
                : 'border border-border-strong'
          }`
          mark.textContent = folder.added === 'verified' ? '✓' : folder.added ? '!' : ''
          const text = document.createElement('span')
          text.className = 'min-w-0 flex-1'
          line(text, folder.property).classList.add('break-all', 'text-foreground')
          const status = line(
            text,
            `${pages(folder.urls)} · ${
              folder.added === 'verified' ? 'verified' : folder.added ? 'added, not verified' : 'suggested'
            }`,
            true,
          )
          if (!folder.added) {
            status.append(' · ')
            const link = document.createElement('a')
            link.href = 'https://search.google.com/search-console/welcome'
            link.target = '_blank'
            link.rel = 'noopener'
            link.className = 'text-foreground underline'
            link.textContent = 'add it yourself'
            status.append(link)
          }
          item.append(mark, text)
          list?.append(item)
        }
        const create = dialog.querySelector<HTMLInputElement>('[data-coverage-input]')
        if (create) create.value = site.property
        show(dialog.querySelector('[data-coverage-create]'), open.length > 0)
        if (window.location.hash === '#coverage') dialog.showModal()
      }

      sitePageShown = () => {
        const owner = root.querySelector('[data-page-owner]')
        if (owner) owner.textContent = 'Finding the Google account that reads it…'
        loadChoices().then((found) => {
          const match = found?.choices.find((item) => item.property === site.property)
          if (!owner) return
          owner.textContent = !found
            ? 'Could not check which Google account reads it.'
            : match
              ? `${site.property.startsWith('sc-domain:') ? 'Domain property' : 'URL-prefix property'} · read with ${match.email}`
              : 'None of your linked Google accounts can read it now. Link one on the Accounts tab.'
        })
      }
    }

    const renderSites = (audit: Audit, alerts: Alerts, pageId?: string) => {
      const alertsOn = (alerts?.types ?? []).filter((type) => type.email || (type.webhook && alerts?.webhookUrl))
      const alertsWord = alertsOn.length ? 'Alerts on' : 'Alerts off'
      const siteLink = (site: Site) => `${base}/account/sites/${site.id}`
      // One health line per site: drops first, then crawl trouble.
      const health = (site: Site) => {
        const dropped = site.monitor?.dropped ?? 0
        if (dropped) return { kind: 'issues', text: `${pages(dropped)} dropped`, dot: 'bg-warning' }
        if (site.lastStatus === 'failed' || (site.error && !site.lastFinishedAt)) {
          return { kind: 'issues', text: 'Crawl issues', dot: 'bg-destructive' }
        }
        if (!site.lastFinishedAt) return { kind: 'pending', text: 'First crawl running', dot: 'bg-foreground-soft' }
        return { kind: 'healthy', text: 'Healthy', dot: 'bg-success' }
      }
      const number = (value: number | null | undefined) => (value == null ? '–' : count(value))
      const fillSite = (copy: DocumentFragment, site: Site) => {
        const state = health(site)
        for (const link of copy.querySelectorAll<HTMLAnchorElement>('[data-site-link], [data-site-view]')) {
          link.href = siteLink(site)
        }
        const set = (name: string, text: string) => {
          for (const element of copy.querySelectorAll(`[data-site-${name}]`)) element.textContent = text
        }
        set('name', siteName(site))
        set('health', state.text)
        set('crawled', number(site.pages))
        set('indexed', number(site.monitor?.indexed))
        set('new', number(site.new))
        set('alerts', alertsWord)
        for (const dot of copy.querySelectorAll('[data-site-dot]')) dot.classList.add(state.dot)
        const item = copy.querySelector<HTMLElement>('[data-site]')
        if (item) {
          item.dataset.health = state.kind
          item.dataset.name = site.property.toLowerCase()
        }
        return copy
      }

      // Every site's open folder suggestions, for the notice and the step.
      const openFolders = (site: Site) => site.coverage?.suggestions.filter((folder) => !folder.added) ?? []
      const page = audit.sites.find((site) => site.id === pageId)
      if (page) {
        renderSitePage(page, alerts, alertsOn.length > 0, number)
      } else {
        show(root.querySelector('[data-site-page]'), false)
        const cards = root.querySelector('[data-site-cards]')
        const rows = root.querySelector('[data-site-rows]')
        const cardTemplate = root.querySelector<HTMLTemplateElement>('[data-site-card]')
        const rowTemplate = root.querySelector<HTMLTemplateElement>('[data-site-row]')
        // By name as shown, so a domain property and its URL-prefix sit together.
        const sorted = [...audit.sites].sort(
          (a, b) => siteName(a).localeCompare(siteName(b)) || a.property.localeCompare(b.property),
        )
        for (const site of sorted) {
          if (cardTemplate) cards?.append(fillSite(cardTemplate.content.cloneNode(true) as DocumentFragment, site))
          if (rowTemplate) rows?.append(fillSite(rowTemplate.content.cloneNode(true) as DocumentFragment, site))
        }

        // Filters and the card or list layout, kept in this browser.
        const table = root.querySelector('[data-site-table]')
        const empty = root.querySelector('[data-sites-empty]')
        const filter = root.querySelector<HTMLInputElement>('[data-site-filter]')
        const healthButtons = all<HTMLButtonElement>('[data-health]')
        const layoutButtons = all<HTMLButtonElement>('[data-layout]')
        let wanted = 'all'
        let layout = localStorage.getItem('seo-sites-layout') === 'list' ? 'list' : 'cards'
        const apply = () => {
          const words = (filter?.value ?? '').toLowerCase().split(/\s+/).filter(Boolean)
          let shown = 0
          for (const item of all<HTMLElement>('[data-site-cards] [data-site], [data-site-rows] [data-site]')) {
            const match =
              words.every((word) => item.dataset.name?.includes(word)) &&
              (wanted === 'all' || item.dataset.health === wanted)
            item.hidden = !match
            if (match && item.tagName === 'LI') shown += 1
          }
          for (const button of healthButtons) button.setAttribute('aria-pressed', String(button.dataset.health === wanted))
          for (const button of layoutButtons) button.setAttribute('aria-pressed', String(button.dataset.layout === layout))
          show(cards, layout === 'cards' && shown > 0)
          show(table, layout === 'list' && shown > 0)
          show(empty, audit.sites.length > 0 && shown === 0)
        }
        filter?.addEventListener('input', apply)
        for (const button of healthButtons) {
          button.addEventListener('click', () => {
            wanted = button.dataset.health ?? 'all'
            apply()
          })
        }
        for (const button of layoutButtons) {
          button.addEventListener('click', () => {
            layout = button.dataset.layout ?? 'cards'
            localStorage.setItem('seo-sites-layout', layout)
            apply()
          })
        }
        show(root.querySelector('[data-sites-tools]'), audit.sites.length > 0)
        apply()

        // A slim notice while any site has folders to add, until dismissed;
        // new suggestions bring it back.
        const suggested = audit.sites.flatMap((site) => openFolders(site).map((folder) => ({ site, folder })))
        const notice = root.querySelector('[data-sites-notice]')
        const seen = suggested.map((item) => item.folder.property).sort().join(' ')
        if (suggested.length && localStorage.getItem('seo-sites-notice') !== seen) {
          const gain = suggested.reduce((sum, item) => sum + item.folder.gain, 0)
          const text = root.querySelector('[data-sites-notice-text]')
          if (text) {
            text.textContent = `${suggested.length === 1 ? 'One suggested folder' : `${suggested.length} suggested folders`} could check ${count(gain)} more pages a day · `
          }
          const review = root.querySelector<HTMLAnchorElement>('[data-sites-notice-link]')
          const first = suggested[0]
          if (review && first) review.href = `${siteLink(first.site)}#coverage`
          root.querySelector('[data-sites-notice-close]')?.addEventListener('click', () => {
            localStorage.setItem('seo-sites-notice', seen)
            show(notice, false)
          })
          show(notice)
        }
      }

      const form = root.querySelector<HTMLFormElement>('[data-audit-add]')
      if (audit.sites.length >= audit.max) {
        form?.remove()
        const full = root.querySelector('[data-audit-full]')
        if (full) full.textContent = `The beta audits up to ${audit.max} sites. Remove one to add another.`
        show(full)
      }

      // The picker: the linked accounts' properties, filtered as you type.
      const picker = root.querySelector<HTMLInputElement>('[data-picker]')
      const listbox = root.querySelector<HTMLElement>('[data-picker-list]')
      const value = root.querySelector<HTMLInputElement>('[data-picker-value]')
      const status = root.querySelector('[data-picker-status]')
      if (!form || !picker || !listbox || !value) return
      let options: HTMLElement[] = []
      let matchesNow: Choice[] = []
      let active = -1
      const close = () => {
        show(listbox, false)
        picker.setAttribute('aria-expanded', 'false')
        picker.removeAttribute('aria-activedescendant')
        active = -1
      }
      const highlight = (index: number) => {
        options.forEach((option, at) => {
          const on = at === index
          option.setAttribute('aria-selected', String(on))
          option.classList.toggle('bg-muted', on)
        })
        active = index
        const option = options[index]
        if (option) {
          picker.setAttribute('aria-activedescendant', option.id)
          option.scrollIntoView({ block: 'nearest' })
        }
      }
      const choose = (choice: Choice) => {
        if (choice.audited) return
        value.value = choice.property
        picker.value = choice.property
        close()
        if (status) status.textContent = `Adding ${choice.property}…`
        form.requestSubmit()
      }
      const render = async () => {
        if (status && !choices) status.textContent = 'Loading your Search Console properties…'
        const found = await loadChoices()
        if (!found) {
          if (status) status.textContent = 'Could not read your Search Console properties. Reload the page to try again.'
          close()
          return
        }
        if (status) {
          status.textContent = found.failed.length
            ? `Could not read the properties of ${found.failed.join(', ')}.`
            : found.choices.length
              ? ''
              : 'None of your linked Google accounts has a verified Search Console property.'
        }
        const words = picker.value.toLowerCase().split(/\s+/).filter(Boolean)
        const matches = found.choices.filter((choice) =>
          words.every((word) => `${choice.property} ${choice.email}`.toLowerCase().includes(word)),
        )
        listbox.replaceChildren()
        options = []
        for (const [index, choice] of matches.slice(0, 50).entries()) {
          const option = document.createElement('li')
          option.id = `site-picker-option-${index}`
          option.setAttribute('role', 'option')
          option.setAttribute('aria-selected', 'false')
          if (choice.audited) option.setAttribute('aria-disabled', 'true')
          option.className = `rounded-md px-3 py-2 ${choice.audited ? 'cursor-default opacity-60' : 'cursor-pointer hover:bg-muted'}`
          line(option, choice.property).classList.add('break-all', 'text-foreground')
          line(
            option,
            `${choice.property.startsWith('sc-domain:') ? 'Domain property' : 'URL-prefix property'} · ${choice.email}${choice.audited ? ' · already audited' : ''}`,
            true,
          )
          // mousedown, so the pick happens before the input loses focus.
          option.addEventListener('mousedown', (event) => {
            event.preventDefault()
            choose(choice)
          })
          listbox.append(option)
          options.push(option)
        }
        if (!matches.length && found.choices.length) {
          const empty = document.createElement('li')
          empty.className = 'px-3 py-2 text-foreground-muted'
          empty.textContent = `No property matches “${picker.value.trim()}”.`
          listbox.append(empty)
        }
        if (matches.length > 50) {
          line(listbox, `${count(matches.length - 50)} more. Keep typing to narrow the list.`, true).classList.add('px-3', 'py-2')
        }
        show(listbox, listbox.childElementCount > 0)
        picker.setAttribute('aria-expanded', String(listbox.childElementCount > 0))
        highlight(options.findIndex((option) => option.getAttribute('aria-disabled') !== 'true'))
        matchesNow = matches
      }
      picker.addEventListener('focus', render)
      picker.addEventListener('input', render)
      picker.addEventListener('blur', close)
      picker.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') return close()
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault()
          if (listbox.hidden) return void render()
          const step = event.key === 'ArrowDown' ? 1 : -1
          let next = active
          for (let tries = 0; tries < options.length; tries += 1) {
            next = (next + step + options.length) % options.length
            if (options[next]?.getAttribute('aria-disabled') !== 'true') break
          }
          highlight(next)
        }
        if (event.key === 'Enter') {
          event.preventDefault()
          const choice = matchesNow[active]
          if (!listbox.hidden && choice) choose(choice)
        }
      })
      form.addEventListener('submit', (event) => {
        if (!value.value) event.preventDefault()
      })
    }

    // The account rows come first so their forms get actions below.
    const account = state.account
    if (account) {
      const row = root.querySelector<HTMLTemplateElement>('[data-account-row]')
      const fill = (
        list: Element | null,
        provider: 'google' | 'bing',
        items: { label: string; subject: string }[],
        removable: boolean,
      ) => {
        for (const item of items) {
          const copy = row?.content.cloneNode(true) as DocumentFragment
          const label = copy.querySelector('[data-email]')
          if (label) label.textContent = item.label
          const kind = copy.querySelector<HTMLInputElement>('[data-provider]')
          if (kind) kind.value = provider
          const subject = copy.querySelector<HTMLInputElement>('[data-subject]')
          if (subject) subject.value = item.subject
          if (!removable) copy.querySelector('[data-remove]')?.remove()
          list?.append(copy)
        }
      }
      fill(
        root.querySelector('[data-google-list]'),
        'google',
        account.google.map((item) => ({ label: item.email, subject: item.subject })),
        account.google.length > 1,
      )
      fill(root.querySelector('[data-bing-list]'), 'bing', account.bing, true)
      const bingButton = root.querySelector('[data-bing-button]')
      if (bingButton && account.bing.length) bingButton.textContent = 'Add a Bing account'
      show(root.querySelector('[data-bing-add]'), account.bingReady)
      // Hidden while the hosted server has no Bing.
      show(
        root.querySelector('[data-bing-panel]'),
        account.bingReady || account.bing.length > 0,
      )
      for (const name of account.keys) {
        show(root.querySelector(`[data-saved="${name}"]`))
        const input = root.querySelector<HTMLInputElement>(`[data-key-input="${name}"]`)
        if (input) input.placeholder = 'Leave empty to keep the saved key'
      }
      show(root.querySelector('[data-keys-remove]'), account.keys.length > 0)
      const clickyRow = root.querySelector<HTMLTemplateElement>('[data-clicky-row]')
      const clickyList = root.querySelector('[data-clicky-list]')
      for (const site of account.clicky ?? []) {
        const copy = clickyRow?.content.cloneNode(true) as DocumentFragment
        const domain = copy.querySelector('[data-clicky-domain]')
        if (domain) domain.textContent = site.domain ?? `Site ${site.siteId}`
        const id = copy.querySelector('[data-clicky-id]')
        if (id) {
          id.textContent = [site.domain ? ` · site ${site.siteId}` : '', site.account ? ' · from account' : ''].join('')
        }
        const input = copy.querySelector<HTMLInputElement>('[data-clicky-input]')
        if (input) input.value = site.siteId
        clickyList?.append(copy)
      }
      const clickyAccount = root.querySelector('[data-clicky-account]')
      if (clickyAccount) clickyAccount.textContent = account.clickyAccount ?? ''
      show(root.querySelector('[data-clicky-account-row]'), Boolean(account.clickyAccount))
      const machineRow = root.querySelector<HTMLTemplateElement>('[data-machine-row]')
      const machineList = root.querySelector('[data-machine-list]')
      for (const machine of account.machines) {
        const copy = machineRow?.content.cloneNode(true) as DocumentFragment
        const label = copy.querySelector('[data-machine-label]')
        if (label) label.textContent = machine.label
        const used = copy.querySelector('[data-machine-used]')
        if (used && machine.usedAt) {
          used.textContent = ` · used ${new Date(machine.usedAt).toLocaleDateString()}`
        }
        const id = copy.querySelector<HTMLInputElement>('[data-machine-id]')
        if (id) id.value = machine.id
        machineList?.append(copy)
      }
      // The Beta tab exists only for an account with a beta feature.
      if (account.beta?.length) {
        const betaRow = root.querySelector<HTMLTemplateElement>('[data-beta-row]')
        const betaList = root.querySelector('[data-beta-list]')
        for (const feature of account.beta) {
          const copy = betaRow?.content.cloneNode(true) as DocumentFragment
          const item = copy.querySelector<HTMLElement>('[data-beta-feature]')
          if (item) item.id = `beta-${feature.id}`
          const title = copy.querySelector('[data-beta-title]')
          if (title) title.textContent = feature.title
          const text = copy.querySelector('[data-beta-text]')
          if (text) text.textContent = feature.text
          betaList?.append(copy)
        }
        const audit = account.audit
        if (audit) {
          renderSites(audit, account.alerts, account.site)
        } else {
          root.querySelector('[data-account-tab="sites"]')?.remove()
          root.querySelector('[data-account-panel="sites"]')?.remove()
        }
        const alerts = account.alerts
        if (alerts) {
          show(root.querySelector('[data-alerts-panel]'))
          const to = root.querySelector('[data-alerts-to]')
          if (to) {
            to.textContent = alerts.email
              ? `Alert emails go to ${alerts.email}, one per site each time something changes.`
              : 'Link a Google account to get alert emails.'
          }
          const alertRow = root.querySelector<HTMLTemplateElement>('[data-alert-row]')
          const alertList = root.querySelector('[data-alerts-list]')
          for (const type of alerts.types) {
            const copy = alertRow?.content.cloneNode(true) as DocumentFragment
            const title = copy.querySelector('[data-alert-title]')
            if (title) title.textContent = type.title
            const text = copy.querySelector('[data-alert-text]')
            if (text) text.textContent = type.text
            const email = copy.querySelector<HTMLInputElement>('[data-alert-email]')
            if (email) {
              email.name = `email:${type.id}`
              email.checked = type.email
            }
            const webhook = copy.querySelector<HTMLInputElement>('[data-alert-webhook]')
            if (webhook) {
              webhook.name = `webhook:${type.id}`
              webhook.checked = type.webhook
            }
            alertList?.append(copy)
          }
          const url = root.querySelector<HTMLInputElement>('[data-alerts-url]')
          if (url) url.value = alerts.webhookUrl ?? ''
          if (alerts.webhookUrl && alerts.webhookSecret) {
            show(root.querySelector('[data-alerts-secret]'))
            const value = root.querySelector('[data-alerts-secret] pre code')
            if (value) value.textContent = alerts.webhookSecret
            const last = root.querySelector('[data-alerts-last]')
            if (last && alerts.webhookLast) {
              const when = new Date(alerts.webhookLast.at).toLocaleString()
              last.textContent =
                alerts.webhookLast.result === 'ok'
                  ? `Last webhook call ${when}: delivered.`
                  : `Last webhook call ${when}: failed (${alerts.webhookLast.result}).`
              show(last)
            }
          }
          const held = root.querySelector('[data-alerts-held]')
          if (held && alerts.held) {
            held.textContent = `${alerts.held === 1 ? 'One alert email is' : `${alerts.held} alert emails are`} waiting for tomorrow: SEO Skill sends a limited number of emails a day.`
            show(held)
          }
        }
      } else {
        root.querySelector('[data-account-tab="beta"]')?.remove()
        root.querySelector('[data-account-panel="beta"]')?.remove()
        root.querySelector('[data-account-tab="sites"]')?.remove()
        root.querySelector('[data-account-panel="sites"]')?.remove()
      }
      if (account.login) {
        show(root.querySelector('[data-login]'))
        const label = root.querySelector('[data-login-label]')
        if (label) label.textContent = account.login.label
        const code = root.querySelector('[data-login-code]')
        if (code) code.textContent = account.login.code
        const input = root.querySelector<HTMLInputElement>('[data-login-input]')
        if (input) input.value = account.login.code
      }
      if (account.token) {
        show(root.querySelector('[data-token]'))
        const value = root.querySelector('[data-token] pre code')
        if (value) value.textContent = account.token
      }
      for (const input of all<HTMLInputElement>('input[name="form"]')) {
        input.value = account.form
      }
    }

    if (state.view === 'signin' && state.link) {
      show(root.querySelector('[data-signin-link]'))
      const code = root.querySelector<HTMLInputElement>('[data-link-code]')
      if (code) code.value = state.link
    }

    const connect = state.connect
    if (connect) {
      const client = root.querySelector('[data-client]')
      if (client) client.textContent = connect.client
      const host = root.querySelector('[data-host]')
      if (host) host.textContent = connect.host
      const flow = root.querySelector<HTMLInputElement>('[data-flow]')
      if (flow) flow.value = connect.flow
    }

    // One page header: its title and description follow the view.
    const title = root.querySelector('[data-header] h1')
    const lead = root.querySelector('[data-header] p')
    if (state.view === 'connect' && title) title.textContent = 'Connect SEO Skill'
    if (state.notice) {
      if (title) title.textContent = state.notice.title
      const text = root.querySelector('[data-notice-text]')
      if (text) text.textContent = state.notice.text
    }
    show(lead, state.view === 'signin' || state.view === 'account')

    for (const form of all<HTMLFormElement>('form[data-action]')) {
      form.action = `${base}${form.dataset.action}`
    }
    for (const link of all<HTMLAnchorElement>('a[data-href]')) {
      link.href = `${base}${link.dataset.href}`
    }

    // Tabs: the hash names a tab, or a panel inside one, so links such as
    // /account#google and the redirects after a change open the right tab.
    const tabs = all<HTMLButtonElement>('[data-account-tab]')
    // On a narrow screen the tab row scrolls: a fade marks each edge with
    // more tabs past it, and the selected tab is scrolled into view.
    const strip = root.querySelector<HTMLElement>('[data-tab-strip]')
    const fades = () => {
      if (!strip) return
      const left = strip.scrollLeft > 1
      const right = strip.scrollLeft + strip.clientWidth < strip.scrollWidth - 1
      root.querySelector('[data-tab-fade="left"]')?.classList.toggle('opacity-0', !left)
      root.querySelector('[data-tab-fade="right"]')?.classList.toggle('opacity-0', !right)
    }
    strip?.addEventListener('scroll', fades, { passive: true })
    window.addEventListener('resize', fades)
    const reveal = (tab: HTMLElement, smooth: boolean) => {
      if (!strip) return
      const edge = 32
      let to = strip.scrollLeft
      if (tab.offsetLeft - edge < strip.scrollLeft) to = tab.offsetLeft - edge
      else if (tab.offsetLeft + tab.offsetWidth + edge > strip.scrollLeft + strip.clientWidth) {
        to = tab.offsetLeft + tab.offsetWidth + edge - strip.clientWidth
      }
      strip.scrollTo({ left: Math.max(0, to), behavior: smooth ? 'smooth' : 'auto' })
      fades()
    }
    let shown = false
    const select = (id: string, focus = false) => {
      for (const tab of tabs) {
        const selected = tab.dataset.accountTab === id
        if (selected) reveal(tab, shown)
        tab.setAttribute('aria-selected', String(selected))
        if (selected) tab.removeAttribute('tabindex')
        else tab.tabIndex = -1
        if (selected && focus) tab.focus()
        show(
          root.querySelector(`[data-account-panel="${tab.dataset.accountTab}"]`),
          selected,
        )
      }
      if (id === 'sites') sitePageShown()
      shown = true
    }
    const tabFor = (hash: string) => {
      const id = hash.replace(/^#/, '')
      if (!id) return null
      if (tabs.some((tab) => tab.dataset.accountTab === id)) return id
      const target = root.querySelector(`[id="${CSS.escape(id)}"]`)
      return (
        target?.closest<HTMLElement>('[data-account-panel]')?.dataset
          .accountPanel ?? null
      )
    }
    if (account) {
      select(
        account.token
          ? 'machines'
          : (account.tab ?? tabFor(window.location.hash) ?? 'accounts'),
      )
    }
    // In-page links such as "Change alerts" open their tab.
    window.addEventListener('hashchange', () => {
      const id = tabFor(window.location.hash)
      if (id) {
        select(id)
        root.querySelector(`[id="${CSS.escape(window.location.hash.slice(1))}"]`)?.scrollIntoView()
      }
    })
    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        const id = tab.dataset.accountTab ?? 'accounts'
        // From a site's page, the Sites tab goes back to every site.
        if (id === 'sites' && account?.site) {
          window.location.href = `${base}/account#sites`
          return
        }
        select(id)
        history.replaceState(null, '', `#${id}`)
      })
      tab.addEventListener('keydown', (event) => {
        const index = tabs.indexOf(tab)
        let next = -1
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length
        else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length
        const target = tabs[next]
        if (!target) return
        event.preventDefault()
        select(target.dataset.accountTab ?? 'accounts', true)
        history.replaceState(null, '', `#${target.dataset.accountTab}`)
      })
    }

    const message = root.querySelector('[data-message]')
    if (message && state.message) {
      message.textContent = state.message
      if (state.error) {
        message.classList.replace('bg-muted', 'bg-destructive-soft')
        message.setAttribute('role', 'alert')
      }
      show(message)
    }
    for (const view of all('[data-view]')) {
      show(view, view.getAttribute('data-view') === state.view)
    }
    // Measured only now that the account view shows.
    const current = tabs.find((tab) => tab.getAttribute('aria-selected') === 'true')
    if (current) reveal(current, false)
  }
</script>
