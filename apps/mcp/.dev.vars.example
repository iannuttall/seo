GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SEAL_KEY=
# Optional. Ahrefs key used only for the free Domain Rating endpoint.
AHREFS_DR_KEY=
# Bing Webmaster OAuth client, from Bing Webmaster Tools Settings > API access.
BING_CLIENT_ID=
BING_CLIENT_SECRET=
# Optional. Telegram bot and chat for the weekly sign-up count (cron).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional. PostShiba API key for alert email; without it email is skipped.
POSTSHIBA_API_KEY=
# Optional, local checks only: "true" composes alert email without sending.
POSTSHIBA_SANDBOX=
