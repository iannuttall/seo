{
  "name": "seo",
  "version": "0.18.0",
  "mcpName": "dev.seoskill/seo",
  "description": "The SEO command for AI agents: a free Google Search Console MCP server and CLI. Reads your real Search Console, Google Analytics and Bing data for traffic drops, quick wins, content decay, cannibalization and indexing, plus DataForSEO and Ahrefs keyword research.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Ian Nuttall",
  "homepage": "https://seoskill.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iannuttall/seo.git"
  },
  "bugs": {
    "url": "https://github.com/iannuttall/seo/issues"
  },
  "funding": "https://github.com/iannuttall/seo",
  "keywords": [
    "seo",
    "google-search-console",
    "search-console-mcp",
    "seo-mcp",
    "mcp-server",
    "bing-webmaster-tools",
    "dataforseo",
    "ahrefs",
    "agent-skills",
    "search-console",
    "google-analytics",
    "keyword-research",
    "competitor-analysis",
    "crawler",
    "cli",
    "mcp"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./provider-sdk": {
      "types": "./dist/provider-sdk.d.ts",
      "import": "./dist/provider-sdk.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "seo": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "site-kit",
    "evals",
    "PRIVACY.md",
    "SECURITY.md",
    "TERMS.md",
    "TRADEMARKS.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "auth:inject-shared-client": "node scripts/inject-shared-oauth-client.mjs",
    "build": "turbo run build && pnpm run build:package",
    "build:package": "tsdown --config tsdown.config.ts",
    "build:mcp": "pnpm --filter \"@seo/hosted-mcp^...\" build",
    "build:web": "pnpm --filter @seo/web... build",
    "clean": "turbo run clean && rm -rf dist",
    "dev": "turbo run dev",
    "deploy:mcp": "pnpm --filter @seo/hosted-mcp exec wrangler d1 migrations apply seo-mcp --remote && pnpm --filter @seo/hosted-mcp exec wrangler deploy",
    "deploy:web": "pnpm --filter @seo/web secrets:check && pnpm --filter @seo/web exec wrangler d1 migrations apply seo-telemetry --remote && pnpm --filter @seo/web exec wrangler deploy",
    "deploy:web:dry-run": "pnpm --filter @seo/web exec wrangler deploy --dry-run",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "lint": "biome check . && node scripts/check-emdashes.mjs && node scripts/check-report-parity.mjs && pnpm run skills:validate",
    "lint:static": "biome check . && node scripts/check-emdashes.mjs && node scripts/check-report-parity.mjs && pnpm run skills:validate",
    "lint:fix": "biome check . --write",
    "loc:audit": "node scripts/loc-audit.mjs",
    "pack:check": "pnpm pack --dry-run",
    "prepack": "pnpm run skills:validate && pnpm run build:package && node --test scripts/package.test.mjs",
    "security:audit": "pnpm audit --audit-level low",
    "security:check": "pnpm run security:audit && pnpm run security:secrets",
    "security:secrets": "node scripts/security-secrets.mjs",
    "secrets:web:check": "pnpm --filter @seo/web secrets:check",
    "secrets:web:check-local": "pnpm --filter @seo/web secrets:check-local",
    "secrets:web:publish": "pnpm --filter @seo/web secrets:publish",
    "skills:validate": "node scripts/validate-skills.mjs",
    "test": "turbo run test && pnpm run test:contracts:built",
    "test:built": "turbo run test && pnpm run test:contracts:built",
    "test:contracts:built": "node --test scripts/package.test.mjs",
    "test:resources": "pnpm run build:package && pnpm run test:resources:built",
    "test:resources:built": "node scripts/resource-harness.mjs && node scripts/provider-resource-harness.mjs && node scripts/provider-extension-resource-harness.mjs",
    "test:package-install": "pnpm --filter @seo/core build && pnpm --filter @seo/mcp build && pnpm run build:package && node --test scripts/installed-package.test.mjs",
    "test:package-install:built": "node --test scripts/installed-package.test.mjs",
    "typecheck": "turbo run typecheck"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/keyring": "^1.3.0",
    "@types/node": "^22.20.5",
    "citty": "^0.2.2",
    "cli-table3": "^0.6.5",
    "defuddle": "^0.19.6",
    "htmlparser2": "10.1.0",
    "jsonc-parser": "^3.3.1",
    "libsql": "^0.5.29",
    "lighthouse": "13.6.0",
    "linkedom": "^0.18.14",
    "open": "^11.0.4",
    "p-queue": "^9.3.5",
    "p-retry": "^8.0.1",
    "picocolors": "^1.1.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "playwright-core": "1.64.1",
    "proper-lockfile": "^4.1.2",
    "robots-parser": "^3.0.1",
    "string-width": "^8.3.0",
    "turndown": "^7.2.4",
    "undici": "^8.12.2",
    "update-notifier": "^7.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "tsdown": "^0.23.2",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.1.6",
      "@sentry/node": "10.60.0",
      "@xmldom/xmldom": "0.9.12",
      "devalue": "5.9.3",
      "esbuild": "0.28.1",
      "fast-uri": "3.1.9",
      "hono@<4.13.16": "4.13.17",
      "body-parser@<2.4.0": "2.4.0",
      "fast-copy@<4.1.0": "4.1.0",
      "http-cache-semantics@<4.2.1": "4.3.0",
      "ip-address@<10.5.1": "10.7.4",
      "js-yaml@3.15.0": "3.15.2",
      "js-yaml@4.3.0": "4.3.2",
      "nanoid@<3.3.18": "3.3.18",
      "postcss": "8.5.23",
      "proxy-addr@<2.0.8": "2.0.8",
      "qs@<6.16.1": "6.16.1",
      "sharp": "0.35.5",
      "smol-toml": "1.9.1",
      "source-map-js": "1.2.2",
      "svgo": "4.1.0",
      "undici@7": "7.30.1",
      "vite@>=8.0.0 <8.1.6": "8.1.6",
      "undici@>=8 <8.12.2": "8.12.3"
    }
  }
}
