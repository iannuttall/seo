---
import Logo from './Logo.astro'
import { site } from '@/lib/site'

const links = [
  { label: 'Features', href: '/features' },
  { label: 'Docs', href: '/docs' },
  { label: 'Tools', href: '/tools' },
  { label: 'Stats', href: '/stats' },
  { label: 'Privacy', href: '/privacy' },
  { label: 'Terms', href: '/terms' },
  { label: 'GitHub', href: site.repository },
]

const linkClass =
  'text-sm/6 text-foreground-muted underline-offset-4 transition-colors hover:text-foreground hover:underline'
const year = new Date().getFullYear()

// The byline picks one of these at random on each load. Every entry has to
// read naturally in "an Ian Nuttall ___".
const projectThings = [
  'joint',
  'jam',
  'thing',
  'production',
  'contraption',
  'experiment',
  'side quest',
  'passion project',
  'labor of love',
  'rabbit hole',
  'weekend build',
  'deep cut',
  'banger',
  'shenanigan',
  'special',
]
---

<footer class="mt-20 py-14">
  <div class="site-frame flex flex-col items-center gap-8 text-center">
    <a href="/" class="text-foreground no-underline" aria-label={`${site.name} home`}>
      <Logo class="size-9" />
    </a>

    <nav aria-label="Footer">
      <ul class="flex flex-wrap items-center justify-center gap-x-7 gap-y-3">
        {
          links.map((link) => (
            <li>
              <a
                class={linkClass}
                href={link.href}
                target={link.href.startsWith('http') ? '_blank' : undefined}
                rel={link.href.startsWith('http') ? 'noreferrer' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="text-sm/6 text-foreground-soft">
      &copy; {year} {site.name}, an{' '}
      <a class="underline-offset-4 hover:text-foreground hover:underline" href="https://ian.is" target="_blank" rel="noreferrer">Ian Nuttall</a>{' '}
      <span data-project-thing>joint</span>
    </p>
  </div>
  <script is:inline define:vars={{ projectThings }}>
    const thing = document.querySelector('[data-project-thing]')
    if (thing) {
      thing.textContent = projectThings[Math.floor(Math.random() * projectThings.length)]
    }
  </script>
</footer>
