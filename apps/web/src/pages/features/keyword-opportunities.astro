---
import {
  Analytics01Icon,
  GitCompareIcon,
  SearchList01Icon,
  Target02Icon,
  UserGroupIcon,
} from '@hugeicons/core-free-icons'
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import HomeCard from '@/components/HomeCard.astro'
import LandingHero from '@/components/LandingHero.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SetupPrompts from '@/components/SetupPrompts.astro'
import SplitList from '@/components/SplitList.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Features', href: '/features' },
  { label: 'Keyword opportunities' },
]

const potential = [
  {
    title: 'SEO potential is the clicks a keyword could bring',
    text: 'It is the number of clicks a keyword could bring if your page ranked for it.',
  },
  {
    title: 'Without a Search Console row it is an estimate',
    text: "For a search with no Search Console row, any such number is the provider's volume times an assumed click-through rate. Ask your agent to label it as an estimate.",
  },
  {
    title: 'Check the results page first',
    text: 'An AI Overview, ads or a video block above the organic results takes some of the clicks the arithmetic assumes.',
  },
  {
    title: 'A blank volume means no data',
    text: 'A blank volume means the provider has no data, which is different from zero.',
  },
  {
    title: 'Search Console can show demand the provider misses',
    text: 'DataForSEO had no US volume for "algorithm update checker", while Search Console showed one seoskill.dev page 267 impressions for it in the 28 days to 7 November 2026.',
  },
]

const seed = [
  {
    title: 'You need a DataForSEO or Ahrefs key',
    text: 'Save it on your account page. The provider bills you, and every DataForSEO result says what the request cost.',
    href: '/docs/keys',
  },
  {
    title: 'Keyword ideas take up to 5 seeds',
    code: 'keyword_ideas',
    text: 'They return the searches that contain each seed keyword, highest volume first.',
  },
  { title: 'Keyword metrics take up to 100 keywords', code: 'keyword_metrics' },
  {
    title: 'The whole research workflow',
    text: 'The AI keyword research tool page walks through the whole research workflow.',
    href: '/features/keyword-research',
  },
]

const serp = [
  { title: 'Difficulty is a model', text: "A low difficulty score is a provider's model. The results page is the evidence." },
  {
    title: 'Authority for every ranking page',
    text: "Each ranking page comes with its domain's authority and a free column of Domain Rating by Ahrefs.",
  },
  {
    title: 'AI Overviews and their citations',
    text: 'With DataForSEO, the SERP also shows whether Google showed an AI Overview and which sites it cites.',
  },
  { title: 'Weaker sites on page one', text: 'A page one with several sites weaker than yours is a real opening.' },
  {
    title: 'One page or several',
    code: 'serp_overlap',
    text: 'To decide whether a group of keywords needs one page or several, ask for a serp_overlap, which counts the top 10 pages each pair of searches shares.',
  },
]

const competitors = [
  { title: 'Find the domains that share your keywords', text: 'Your agent finds your search competitors first.' },
  { title: "Read each one's ranked keywords", text: 'Then it compares them with your Search Console queries.' },
  {
    title: 'The comparison step by step',
    text: 'The keyword gap analysis page covers that comparison step by step.',
    href: '/features/keyword-gap',
  },
  {
    title: 'Check any domain with no account',
    text: 'The free competitor keyword research tool shows what any domain ranks for with no account.',
    href: '/tools/competitor-keyword-research',
  },
]

const example = [
  {
    title: 'Striking distance ranked it first',
    text: 'The striking distance section for 11 October to 7 November 2026 ranked "algorithm update checker" first: 267 impressions, 8 clicks (a 3% click-through rate) and an average position of 11.08, on /tools/google-algorithm-update-checker. The live check found the page returning 200, with the search in its title and H1.',
  },
  {
    title: 'Its score is about 265',
    text: 'Closeness (21 − 11.08) ÷ 10 = 0.992, times 267 impressions, is about 265. The report shows 264.81 because it uses the unrounded position.',
  },
  {
    title: 'The page scores 576 on page two',
    text: "The second-page section scores the same page as a whole: 809 impressions across 12 queries at an impression-weighted position of 13.88. Closeness is (21 − 13.88) ÷ 10 = 0.712, and 809 × 0.712 is about 576, the report's 576.14. It was the second-highest page in that section, behind the SERP checker.",
  },
  {
    title: 'Search Console beat the provider on demand',
    text: 'Keyword metrics from DataForSEO for the US had no volume for the exact search. Two near variants had some: "google algorithm checker" 40 a month (KD 0) and "algorithm checker" 40 (KD 0).',
  },
  {
    title: 'Page one had weaker sites',
    text: 'The SERP for "algorithm update checker" on desktop in the US had an AI Overview, and 5 of the top 8 results were articles about updates instead of checkers. The ranking sites included peoplefirstcontent.com (Domain Rating 16) and aysa.ai (23), and virtina.com (48) held first place.',
  },
]

const report = [
  {
    title: 'Monthly is a sensible cadence',
    text: 'Keep the same 28 days of Search Console data each time so the scores compare.',
  },
  {
    title: 'Mark each fix in the issues list',
    text: "When you fix a page from the list, your agent can mark it fixed in the report's issues list, which later shows that page's clicks for the 28 and 56 days after the change.",
  },
  {
    title: 'How fixes are measured',
    text: 'The striking distance keywords page explains how each fix is measured.',
    href: '/features/striking-distance-keywords',
  },
]

const related = [
  { title: 'Striking distance keywords', text: 'Queries just off page one, quick wins, low CTR and content decay, and each fix measured 28 and 56 days later.', href: '/features/striking-distance-keywords', icon: Target02Icon, link: 'Striking distance keywords' },
  { title: 'AI keyword research tool', text: 'Keyword ideas, search volume, SERPs and SERP overlap in your agent, from your own key.', href: '/features/keyword-research', icon: SearchList01Icon, link: 'AI keyword research' },
  { title: 'Keyword gap analysis', text: 'The searches your competitors rank for and you don’t, against your own Search Console queries.', href: '/features/keyword-gap', icon: GitCompareIcon, link: 'Keyword gap analysis' },
  { title: 'Competitor keyword research', text: 'See what any domain ranks for in your browser, with no account.', href: '/tools/competitor-keyword-research', icon: UserGroupIcon, link: 'Free tool' },
  { title: 'SEO report', text: 'Every section of the Search Console report, with its dates and how to ask for it.', href: '/docs/report', icon: Analytics01Icon, link: 'SEO report docs' },
]

const faq = [
  {
    question: 'What is a keyword opportunity?',
    answer:
      'A search with real demand where your site has a fair chance of earning more clicks than it gets today. Some of those searches already show your pages in Google, and others don’t show your site at all yet.',
  },
  {
    question: 'Where should I look for keyword opportunities first?',
    answer:
      'In your own Search Console. It shows what people actually typed and where Google already places you, so an opportunity there has evidence behind it. Provider numbers are estimates, kept in their own columns and never added to your clicks.',
  },
  {
    question: 'How is the keyword opportunity score worked out?',
    answer:
      'Page two rows score impressions times closeness to page one. Page one rows score impressions times the gap between your curve’s click-through rate for that position and the row’s own rate. Both are heuristics for sorting the list, and the report labels them that way.',
  },
  {
    question: 'Do I need a DataForSEO or Ahrefs key?',
    answer:
      'Only for searches your site doesn’t appear for yet. The Search Console opportunities need just a Google sign-in. Keyword ideas, metrics and SERPs use your own DataForSEO or Ahrefs key, and the provider bills you.',
  },
  {
    question: 'What does a blank search volume mean?',
    answer:
      'The provider has no data, which is different from zero. Search Console can still show impressions for a search with no provider volume.',
  },
  {
    question: 'How often should I make a keyword opportunity report?',
    answer:
      'Monthly is a sensible cadence. Keep the same 28 days of Search Console data each time so the scores compare.',
  },
]
---

<BaseLayout
  title="Find keyword opportunities in your own search data"
  description="Find keyword opportunities from your own Search Console, score them by the clicks they could win, and size new keywords with your DataForSEO or Ahrefs key."
  canonicalPath="/features/keyword-opportunities"
  {breadcrumbs}
  framed={false}
>
  <main data-agent-content>
    <LandingHero
      title="Keyword opportunities"
      lead="A keyword opportunity is a search where one change to your site could win clicks it is not getting yet. Ask your agent for them and it starts from your own Search Console, then sizes new keywords with your DataForSEO or Ahrefs key."
      setupId="keyword-opportunities-setup"
      author
    />

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      <section class="site-frame" aria-labelledby="kinds-heading">
        <SectionHeading
          id="kinds-heading"
          title="What kinds of keyword opportunity are there?"
          text="There are two: searches you already appear for, and searches you don't appear for yet. A keyword opportunity is a search with real demand where your site has a fair chance of earning more clicks than it gets today, and the evidence for each kind comes from a different place."
        />
        <div class="docs-prose max-w-4xl">
          <table>
            <thead><tr><th>Kind</th><th>Evidence and where it comes from</th></tr></thead>
            <tbody>
              <tr><td>Searches you already appear for</td><td>Impressions, clicks, click-through rate and average position, from your own Search Console through the SEO report.</td></tr>
              <tr><td>Searches you don't appear for yet</td><td>Search volume, keyword difficulty, cost per click and who ranks, from your DataForSEO or Ahrefs key through keyword research.</td></tr>
            </tbody>
          </table>
          <p>
            Start with the first kind. Search Console shows what people
            actually typed and where Google already places you, so an
            opportunity there has evidence behind it. Provider numbers are
            estimates. Your agent keeps them in their own columns and never
            adds them to your clicks.
          </p>
        </div>
      </section>

      <section class="site-frame" aria-labelledby="ranks-heading">
        <SectionHeading
          id="ranks-heading"
          title="How do I find keyword opportunities my site already ranks for?"
          text="Ask your agent for them after you sign in with Google (access is read only). The report overview counts the rows in each section and shows its top rows, so you can pick where to look first."
        />
        <div class="max-w-4xl space-y-4">
          <CodeBlock
            label="Ask your agent"
            prompt
            value={`Find the keyword opportunities for example.com in my Search Console. Show the top 10 with the page that ranks for each.`}
            wrap
          />
          <CodeBlock label="Or run it in a terminal" value={`seo report --site example.com`} wrap />
        </div>
        <div class="docs-prose mt-10 max-w-4xl">
          <p>Six sections hold keyword opportunities:</p>
          <table>
            <thead><tr><th>Section</th><th>What it lists</th></tr></thead>
            <tbody>
              <tr><td><code>second-page</code></td><td>Pages at an average position above 10 and up to 20, each with the queries that put it there.</td></tr>
              <tr><td><code>striking-distance</code></td><td>Query and page pairs in the same range, with impressions.</td></tr>
              <tr><td><code>quick-wins</code></td><td>Pairs at positions 4 to 10 that get fewer clicks than your site's own curve says they should.</td></tr>
              <tr><td><code>low-ctr</code></td><td>Pairs at positions 1 to 4 below the same curve. Titles and snippets to review.</td></tr>
              <tr><td><code>ai-queries</code></td><td>Searches shaped like AI prompts and follow-up questions, grouped by question, with the page Google showed.</td></tr>
              <tr><td><code>cannibalization</code></td><td>Queries where two or more of your pages share the impressions.</td></tr>
            </tbody>
          </table>
          <p>
            Open one section by name, such as{' '}
            <code>seo report --site example.com --section second-page</code>. Brand
            searches are left out, and the top 20 pages in every section except{' '}
            <code>ai-queries</code> are fetched live, so a page that now redirects or returns an error shows before
            you spend time on it. The <a href="/features/striking-distance-keywords">striking
            distance keywords</a> page covers the page-two, quick wins and low CTR
            lists in depth, including the hand method in Search Console.
          </p>
        </div>
      </section>

      <section class="site-frame" aria-labelledby="score-heading">
        <SectionHeading
          id="score-heading"
          title="How is a keyword opportunity score worked out?"
          text="From your own clicks and impressions, with one of two formulas. Both are heuristics for sorting the list, and the report labels them that way."
        />
        <div class="docs-prose max-w-4xl">
          <table>
            <thead><tr><th>Rows</th><th>Score</th></tr></thead>
            <tbody>
              <tr>
                <td>Page two (above 10, up to 20)</td>
                <td>Impressions × closeness to page one. Closeness is 1 up to position 11 and drops by 0.1 for each position after it, to 0.1 at position 20. So 400 impressions at position 11 score 400, and the same 400 at position 16 score 200.</td>
              </tr>
              <tr>
                <td>Page one (positions 1 to 10)</td>
                <td>Impressions × the gap between your curve's click-through rate for that position and the row's own rate. So 2,000 impressions at position 6 with a 1% rate, where your curve says 4%, score 60 clicks missed in 28 days.</td>
              </tr>
            </tbody>
          </table>
          <p>
            The curve is built from your own site: for each position on page
            one, the click-through rate that one page in four beats. A site with
            too little data falls back to a built-in curve, and the report says
            which one it used. Brand searches, ads and AI Overviews all change
            click rates, so treat a high score as a page to open first.
          </p>
          <p>
            Most published keyword opportunity scores are built from provider
            estimates instead. Moz's{' '}
            <a href="https://moz.com/help/keyword-explorer/keyword-metrics/priority" target="_blank" rel="noreferrer">Priority</a>{' '}
            weighs volume, difficulty and organic click-through rate, and
            SEOmonitor's opportunity score divides the clicks a top three
            position would add by difficulty. For keywords you don't rank for
            yet, your agent can build a score like that from keyword metrics and
            show its formula:
          </p>
        </div>
        <div class="mt-6 max-w-4xl">
          <CodeBlock
            label="Ask your agent"
            prompt
            value={`Score these 30 keywords by search volume, keyword difficulty and whether example.com already ranks for them. Show the formula you used.`}
            wrap
          />
        </div>
      </section>

      <SplitList
        id="potential-heading"
        title="How do I estimate the SEO potential of a keyword I don't rank for?"
        text="Multiply the provider's volume by an assumed click-through rate, label the result as an estimate, and check the results page first."
        items={potential}
      />

      <SplitList
        id="seed-heading"
        title="How do I find new keyword opportunities from a seed keyword?"
        text="Ask for keyword ideas and metrics together, with a DataForSEO or Ahrefs key saved on your account page."
        items={seed}
      >
        <div class="mt-6 space-y-4">
          <CodeBlock
            label="Ask your agent"
            prompt
            value={`Give me keyword ideas for "invoice template" in the US, then get volume and difficulty for the 30 best fits for example.com`}
            wrap
          />
          <CodeBlock
            label="Or run it in a terminal"
            value={`seo research keyword_ideas --keywords "invoice template" --country us
seo research keyword_metrics --keywords "invoice template for contractors,free invoice template word" --country us`}
            wrap
          />
        </div>
      </SplitList>

      <SplitList
        id="serp-heading"
        title="How do I check who ranks before I call it an opportunity?"
        text="Ask for the SERP. A low difficulty score is a provider's model, and the results page is the evidence."
        items={serp}
      >
        <div class="mt-6">
          <CodeBlock
            label="Or run it in a terminal"
            value={`seo research serp --keywords "invoice template for contractors" --country us`}
            wrap
          />
        </div>
        <p class="mt-4 text-base leading-7 text-foreground-muted">
          The Domain Rating column comes from{' '}
          <a class="text-foreground underline underline-offset-4" href="https://ahrefs.com" target="_blank" rel="noreferrer">Ahrefs</a>.
        </p>
      </SplitList>

      <SplitList
        id="competitors-heading"
        title="How do I find keyword opportunities my competitors already win?"
        text="Ask your agent for the searches a competitor ranks for and you don't. They are opportunities with proof that the topic can rank."
        items={competitors}
      >
        <div class="mt-6">
          <CodeBlock
            label="Ask your agent"
            prompt
            value={`Who are example.com's search competitors? For the top 3, list the keywords they rank for in the top 10 that example.com doesn't.`}
            wrap
          />
        </div>
      </SplitList>

      <SplitList
        id="example-heading"
        title="What does one real keyword opportunity look like?"
        text="We ran the steps above on seoskill.dev's own Search Console. These are the real numbers for one page, the Google algorithm update checker."
        items={example}
      >
        <p class="mt-4 text-base leading-7 text-foreground-muted">
          Read together, the page already matches the search, Google already
          shows it at the top of page two, and page one includes sites with a
          Domain Rating by{' '}
          <a class="text-foreground underline underline-offset-4" href="https://ahrefs.com" target="_blank" rel="noreferrer">Ahrefs</a>{' '}
          of 16 and 23. That makes it a better bet than a new page.
        </p>
        <p class="mt-4 text-base leading-7 text-foreground-muted">
          The next step is{' '}
          <a class="text-foreground underline underline-offset-4" href="/docs/page">seo page</a>{' '}
          on the URL to see its other queries and what the articles above it
          cover. Mark the change fixed in the issues list on the day it ships,
          so its clicks can be compared 28 and 56 days later. See the{' '}
          <a class="text-foreground underline underline-offset-4" href="/tools/google-algorithm-update-checker">Google algorithm update checker</a>.
        </p>
      </SplitList>

      <section class="site-frame" aria-labelledby="targets-heading">
        <SectionHeading
          id="targets-heading"
          title="Which keywords does this page target?"
          text="We sized this page's own keywords the same way. These are keyword metrics from DataForSEO for the US, in searches a month with keyword difficulty from 0 to 100."
        />
        <div class="docs-prose max-w-4xl">
          <table>
            <thead><tr><th>Keyword</th><th>Searches (KD)</th></tr></thead>
            <tbody>
              <tr><td>keyword opportunity</td><td>140 (KD 24)</td></tr>
              <tr><td>keyword opportunities</td><td>140 (KD 14)</td></tr>
              <tr><td>seo opportunities</td><td>70 (KD 32)</td></tr>
              <tr><td>seo potential</td><td>40 (KD 0)</td></tr>
              <tr><td>opportunity keywords</td><td>20 (KD 0)</td></tr>
              <tr><td>keyword opportunity score</td><td>10 (no KD)</td></tr>
              <tr><td>keyword opportunity report</td><td>No data</td></tr>
            </tbody>
          </table>
          <p>
            The SERP for "seo opportunities" ruled that one out. All 9 organic
            results were about Sponsors for Educational Opportunity, a nonprofit
            that is also called SEO (a fair reminder to read the results before
            trusting a volume).
          </p>
        </div>
      </section>

      <SplitList
        id="report-heading"
        title="How do I turn the list into a keyword opportunity report?"
        text="Ask for one in a single prompt. A keyword opportunity report is the list in a form you can act on and share."
        items={report}
      >
        <div class="mt-6">
          <CodeBlock
            label="Ask your agent"
            prompt
            value={`Write a keyword opportunity report for example.com. First the top 10 Search Console opportunities with their score and the page for each. Then 10 new keywords with volume, difficulty and who ranks, in a separate table. Say which numbers are estimates.`}
            wrap
          />
        </div>
      </SplitList>

      <section class="site-frame" aria-labelledby="related-heading">
        <SectionHeading
          id="related-heading"
          title="Which tools and docs go with keyword opportunities?"
          text="Go deeper on page-two keywords, keyword research and competitor gaps, or read every section of the SEO report."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {related.map((item) => <HomeCard {...item} />)}
        </div>
      </section>

      <section class="site-frame" aria-labelledby="faq-heading">
        <div class="max-w-2xl">
          <h2 id="faq-heading" class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            Keyword opportunity questions
          </h2>
        </div>
        <div class="mt-10">
          <FaqAccordion items={faq} id="keyword-opportunities-faq" />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="start-heading">
        <SectionHeading
          id="start-heading"
          title="Find your first keyword opportunities"
          text="Add SEO Skill to your agent, sign in with the Google account that can read your Search Console, and ask for the keyword opportunities for your site."
        />
        <SetupPrompts id="keyword-opportunities-setup-end" />
      </section>
    </div>
  </main>
</BaseLayout>
