---
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import SetupCommands from '@/components/SetupCommands.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHeader from '@/components/PageHeader.astro'
import WordCombiner from '@/components/tools/WordCombiner.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: 'Word combiner' },
]

const faq = [
  {
    question: "What is a word combiner?",
    answer:
      "A tool that joins words from two or more lists into every combination, in order. Two lists of three words each make nine phrases.",
  },
  {
    question: "How do I combine two lists of words?",
    answer:
      "Put one word or phrase per line in list A and list B, choose how to join them, and generate. Add more lists for more parts.",
  },
  {
    question: "Is the word combiner free?",
    answer:
      "Yes, with no account. It runs in your browser and nothing is uploaded.",
  },
  {
    question: "Can I combine words in every order?",
    answer:
      "This tool keeps the list order, which gives cleaner phrases. To get the reverse order, swap the lists and generate again.",
  },
  {
    question: "How many combinations can it make?",
    answer:
      "Up to 100,000 at a time. A larger result is marked as partial, so narrow the lists to get the full set.",
  },
]
---

<BaseLayout
  title="Word combiner"
  description="Combine words from several lists into every phrase, in order, with filters and CSV export. Use it for keyword lists, product names, ad groups and name ideas."
  canonicalPath="/tools/word-combiner"
  {breadcrumbs}
>
  <main data-agent-content>
    <Breadcrumbs {breadcrumbs} />

    <PageHeader
      title="Word combiner"
      description="Mix up to five lists into ordered word and keyword combinations, then filter, copy, or download the result."
    />

    <WordCombiner />

    <div class="docs-prose mt-16">
      <h2>Combine keyword lists in a fixed order</h2>
      <p>
        Each list works like a column. Add "best" and "local" to list A,
        "SEO tools" and "rank tracker" to list B, and the tool creates four
        combinations. Add another list when every output needs a location,
        audience, product attribute, or other qualifier.
      </p>
      <p>
        You can combine every populated list, build progressively from list A,
        or generate adjacent pairs alongside the full combination. Individual
        list items can be included too. Fixed order usually produces cleaner
        phrases than generating every possible word order.
      </p>

      <h2>Filters keep large combinations manageable</h2>
      <p>
        Include and exclude filters are applied while the list is generated.
        Use one phrase per line. An include filter keeps a combination when any
        phrase matches, while an exclude filter removes it when any phrase
        matches.
      </p>
      <p>
        The projected count appears before you run the tool. Generation stops
        after the first 100,000 candidate combinations, and a capped result is
        labelled as partial. Narrow the source lists when you need the complete
        set.
      </p>

      <h2>Generated phrases still need keyword research</h2>
      <p>
        A combination is a candidate, not proof that people search for it. Check
        relevance, intent, and demand before using a phrase in a page plan or
        paid search campaign. For an existing site,{' '}
        <a href="/docs/data">seo data</a>
        {' '}returns the queries people already use to find you in Search Console.
      </p>
      <p>
        Do not turn every row into a landing page. The useful rows are the ones
        that match a real product, service, audience, or location and deserve a
        distinct answer.
      </p>

      <h2>Keep your word lists private</h2>
      <p>
        Your lists stay in this browser tab while you combine, filter, copy, and
        export them. Closing or refreshing the tab clears the current result.
      </p>
      <p>
        Copy and TXT use your chosen output separator, which can be a new line,
        comma, space, pipe, dash, or custom value. CSV keeps one combination
        per row and adds a heading for spreadsheet imports. All three actions
        use the active result search, so you can export a smaller subset without
        generating it again.
      </p>

      <h2>Ways to use a word combiner</h2>
      <ul>
        <li><strong>Keyword lists.</strong> Combine services with locations, such as “plumber” and “emergency plumber” with a list of towns.</li>
        <li><strong>Product names.</strong> Pair attributes with products: sizes, colours and materials.</li>
        <li><strong>Ad groups.</strong> Build exact phrase lists for a paid search campaign.</li>
        <li><strong>Names and ideas.</strong> Join two lists of words to find a domain or brand name.</li>
      </ul>

      <h2>Check which combinations people search for</h2>
      <p>
        Most generated phrases get no searches at all. Before you plan pages
        around them, check the demand. Pick the combinations that read like
        something a person would type, then look up their search volume.
        Keep the ones with demand and fold close variants into one page
        rather than one page each.
      </p>

      <h2>Check search volume with your agent</h2>
      <p>
        With SEO Skill, your agent can take the list straight from here.{' '}
        <a href="/docs/research">seo research</a> looks up search volume,
        keyword difficulty and cost per click for up to 100 keywords at a
        time with your own DataForSEO or Ahrefs key. Your agent can check
        which ones you already get impressions for with{' '}
        <a href="/docs/data">seo data</a>. Ask:
      </p>
      <CodeBlock value="Get the search volume for these phrases in the US, drop the ones with none, and group the rest by intent" wrap />
      <p>Add the hosted MCP server to your agent and sign in with Google:</p>
    </div>

    <SetupCommands id="word-combiner-setup" class="mt-6" />

    <div class="docs-prose mt-16">
      <h2>Word combiner questions</h2>
    </div>
    <div class="mt-6">
      <FaqAccordion id="word-combiner-faq" items={faq} />
    </div>
  </main>
</BaseLayout>
