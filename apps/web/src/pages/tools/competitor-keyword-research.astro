---
import { Analytics01Icon, BrowserIcon, Link01Icon, SearchList01Icon } from '@hugeicons/core-free-icons'
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import FounderBadge from '@/components/FounderBadge.astro'
import HomeCard from '@/components/HomeCard.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SetupPrompts from '@/components/SetupPrompts.astro'
import SplitList from '@/components/SplitList.astro'
import ResearchLookup from '@/components/tools/ResearchLookup.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: 'Competitor keyword research' },
]

const keywords = [
  { title: 'Keep Keywords it ranks for selected', text: 'Enter a competitor’s domain. You get its 50 keywords with the most estimated traffic, the position it holds for each one, how many people search for it a month and the page that ranks.' },
  { title: 'Read the page column first', text: 'It shows which of their pages pull in that traffic, which tells you more about what is working for them than the keyword list alone.' },
  { title: 'Count the pages that earn the traffic', text: 'Three pages earning most of a site’s traffic is a very different competitor from three hundred pages earning a little each.' },
]

const rivals = [
  { title: 'Choose Sites it competes with', text: 'Enter your own domain. You get the domains that rank for the most of the same keywords, with a Domain Rating for the first 25.' },
  { title: 'Expect publishers and forums', text: 'These are often not the businesses you think of as competitors (a publisher or a forum can share more keywords with you than a rival shop does).' },
  { title: 'Large platforms are left out', text: 'Platforms that share keywords with nearly every site are left out so the list stays useful, and the result says which ones.' },
  { title: 'Look up any row next', text: 'Choose Its keywords on any row to look up that domain next.' },
]

const gap = [
  { title: 'Find three to five search competitors', text: 'Use Sites it competes with. Pick sites near your size and leave the giants out.' },
  { title: 'Note the keywords that match what you do', text: 'Look up each one’s keywords and note the ones that match what you sell or write about.' },
  { title: 'Check each keyword against your Search Console', text: 'No impressions at all means you have no page Google shows for it. Impressions at position 20 or below means you have a page that is not good enough yet.' },
  { title: 'Group the gaps by topic', text: 'One strong page usually ranks for a whole cluster of related searches, so group the gaps by topic.' },
  { title: 'Trust your own data in step three', text: 'Step three is where most gap analyses go wrong. Comparing two estimates hides the keywords you already rank for but the index missed. Your own Search Console data is the side to trust.' },
]

const winnable = [
  { title: 'A competitor’s keyword may not suit you', text: 'A competitor ranking for a keyword does not mean you should chase it.' },
  { title: 'Look at who holds the top five', text: 'Run the keyword through the SERP checker. If they are much stronger sites than yours, a lower volume keyword where the results are thinner is often the better bet.', href: '/tools/serp-checker' },
  { title: 'Positions and searches are estimates', text: 'The keywords, positions and search volumes come from DataForSEO’s own index for the country you pick. They are good for comparing sites in the same market.' },
  { title: 'Positions count every block', text: 'Positions count every block on the results page, including the ones that are not organic results.' },
]

const tools = [
  { title: 'Keyword gap analysis', text: 'The searches your competitors rank for and you don’t, from their ranked keywords and your Search Console queries.', href: '/features/keyword-gap', icon: SearchList01Icon, link: 'See the keyword gap' },
  { title: 'SEO competitor analysis', text: 'Your real SEO competitors, the pages that earn their traffic and the sites that link to them and not you.', href: '/features/seo-competitor-analysis', icon: Analytics01Icon, link: 'Analyse competitors' },
  { title: 'SERP checker', text: 'The live Google results for any keyword, with who ranks and where your domain ranks.', href: '/tools/serp-checker', icon: BrowserIcon, link: 'Check a SERP' },
  { title: 'Backlink checker', text: 'Which websites link to a competitor’s site or page, and how strong those sites are. Free, with no account.', href: '/tools/backlink-checker', icon: Link01Icon, link: 'Check backlinks' },
]

const faq = [
  {
    question: 'How do I find the keywords a competitor ranks for?',
    answer:
      'Enter their domain above with Keywords it ranks for selected. You get the 50 keywords that bring them the most estimated traffic, with their position, monthly searches and the page that ranks. For a longer list, your agent can page through up to 1,000 rows with seo research.',
  },
  {
    question: 'Can I see a competitor’s keywords for free?',
    answer:
      'Yes, 3 lookups a day on this page without an account. The data comes from DataForSEO’s index of Google results. With your own DataForSEO or Ahrefs key, your agent can run as many as you need.',
  },
  {
    question: 'What is a keyword gap analysis?',
    answer:
      'Comparing the keywords your competitors rank for with the ones you rank for, to find searches you are missing. The useful version uses your real Search Console queries for your side, not an estimate, which is what your agent does with seo data and seo research together. The keyword gap analysis guide shows a worked example.',
    links: [{ text: 'keyword gap analysis guide', href: '/features/keyword-gap' }],
  },
  {
    question: 'How do I find my real competitors in search?',
    answer:
      'Choose Sites it competes with and enter your own domain. You get the domains that rank for the most of the same keywords. They are often publishers, forums or tools rather than the businesses you sell against. An SEO competitor analysis then shows the pages that earn their traffic.',
    links: [{ text: 'SEO competitor analysis', href: '/features/seo-competitor-analysis' }],
  },
  {
    question: 'How accurate are competitor keyword numbers?',
    answer:
      'They are estimates for the country you pick. Positions are close to what the index last saw, and search volumes are monthly averages. They are good for comparing sites and spotting which pages earn traffic. For your own site, Search Console has the real numbers.',
  },
  {
    question: 'Can I see a competitor’s paid keywords?',
    answer: 'No. This page shows organic rankings only. Ads change by the hour and depend on bids, so they are not in the results.',
  },
]
---

<BaseLayout
  title="Free competitor keyword research tool"
  description="Find the keywords a competitor ranks for in Google, with positions, searches and the ranking page, and the sites you really compete with."
  canonicalPath="/tools/competitor-keyword-research"
  {breadcrumbs}
  framed={false}
>
  <main data-agent-content>
    <section class="pt-4">
      <div class="site-frame flex flex-col items-center pt-14 text-center sm:pt-20">
        <FounderBadge prefix="Written by AI and" ai />
        <h1 class="mt-4 max-w-3xl text-pretty text-4xl/tight font-medium -tracking-[0.8px] xl:text-5xl/tight xl:-tracking-[1px]">
          Competitor keyword research
        </h1>
        <p class="mt-4 max-w-2xl text-pretty text-xl/8 font-medium -tracking-[0.2px] text-foreground-muted">
          Enter a competitor's domain to see the keywords it ranks for in
          Google, or find the sites that compete with any domain.
        </p>
      </div>
      <div class="site-frame mt-10 sm:mt-12">
        <ResearchLookup
          kind="competitors"
          heading="Look up a competitor"
          description="Choose what to look up, enter a domain and pick the country you care about."
        />
      </div>
    </section>

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      <SplitList
        id="keywords-heading"
        title="How do you see the keywords a competitor ranks for?"
        text="Enter its domain with Keywords it ranks for selected. You get the 50 keywords that bring it the most estimated traffic, and the pages behind them."
        items={keywords}
      />

      <SplitList
        id="rivals-heading"
        title="Which sites do you actually compete with in search?"
        text="The ones that rank for the most of the same keywords as you. Choose Sites it competes with and enter your own domain to find them."
        items={rivals}
      />

      <SplitList
        id="gap-heading"
        title="How do you run a keyword gap analysis?"
        text="Compare your competitors' keywords with your own Search Console queries, then group the gaps by topic. Four steps do it."
        items={gap}
      />

      <SplitList
        id="winnable-heading"
        title="How do you pick competitor keywords you can win?"
        text="Look at who ranks before you chase a keyword, and treat the numbers as estimates."
        items={winnable}
      />

      <SplitList
        id="agent-heading"
        title="How do you compare their keywords with yours using your agent?"
        text="Ask it, once SEO Skill is connected. A competitor list only becomes a plan when you hold it up against your own site."
        items={[
          { title: 'Their ranked keywords', text: 'Your agent pulls them with seo research.', href: '/docs/research' },
          { title: 'Your own queries', text: 'It reads your Search Console queries with seo data, then does step three for every keyword at once.', href: '/docs/data' },
          { title: 'Research kept apart', text: 'Research data stays labelled as research and is never mixed into your own numbers.' },
        ]}
      >
        <div class="mt-6">
          <CodeBlock
            label="Ask your agent"
            prompt
            value="Which keywords does competitor.example rank for in the top 10 that example.com gets no Search Console impressions for? Group them by topic."
            wrap
          />
        </div>
      </SplitList>

      <section class="site-frame" aria-labelledby="tools-heading">
        <SectionHeading
          id="tools-heading"
          title="Which tools go with competitor keyword research?"
          text="These, which cover the gaps against your own site, the results page for a keyword and the links behind a competitor."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {tools.map((item) => <HomeCard {...item} />)}
        </div>
      </section>

      <section class="site-frame" aria-labelledby="faq-heading">
        <div class="max-w-2xl">
          <h2 id="faq-heading" class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            Competitor keyword questions
          </h2>
        </div>
        <div class="mt-10">
          <FaqAccordion items={faq} id="competitor-faq" />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="start-heading">
        <SectionHeading
          id="start-heading"
          title="Find the keywords you're missing"
          text="Add SEO Skill to your agent, sign in with Google and connect your own DataForSEO or Ahrefs key, then ask which competitor keywords you have no page for."
        />
        <SetupPrompts id="competitor-setup" />
      </section>
    </div>
  </main>
</BaseLayout>
