---
import type { CollectionEntry } from 'astro:content'
import { getCollection, render } from 'astro:content'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHeader from '@/components/PageHeader.astro'
import PagerNav from '@/components/PagerNav.astro'
import { docsMdxComponents } from '@/components/docs/mdx'
import { docsNavFor } from '@/content/docs-nav.mjs'
import BaseLayout from '@/layouts/BaseLayout.astro'

export async function getStaticPaths() {
  const docs = await getCollection('docs')

  return docs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

type Props = { entry: CollectionEntry<'docs'> }

const { entry } = Astro.props
const { Content } = await render(entry)
const path = `/docs/${entry.id}`
const nav = docsNavFor(path)
if (!nav) throw new Error(`${path} is missing from src/content/docs-nav.mjs`)
const schemaType = entry.id === 'commands' ? 'CollectionPage' : 'TechArticle'
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={path}
  breadcrumbs={nav.breadcrumbs}
  {schemaType}
>
  <main data-agent-content>
    <Breadcrumbs breadcrumbs={nav.breadcrumbs} />

    <PageHeader
      title={entry.data.heading ?? entry.data.title}
      description={entry.data.lead ?? entry.data.description}
    />

    <article class="docs-prose min-w-0">
      <Content components={docsMdxComponents} />
    </article>

    <PagerNav
      ariaLabel="Docs pages"
      previous={nav.prev ? { label: nav.prev.label, href: nav.prev.path } : undefined}
      next={nav.next ? { label: nav.next.label, href: nav.next.path } : undefined}
    />
  </main>
</BaseLayout>
