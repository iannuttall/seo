---
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import SetupCommands from '@/components/SetupCommands.astro'
import PageHeader from '@/components/PageHeader.astro'
import LlmsTxtValidator from '@/components/tools/LlmsTxtValidator.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: 'llms.txt validator' },
]

const faq = [
  {
    question: "How do I check my llms.txt file?",
    answer:
      "Enter the URL of the file, or paste its Markdown. The validator checks the structure and lists errors and suggestions with line numbers.",
  },
  {
    question: "What makes an llms.txt file valid?",
    answer:
      "One H1 with the project name, an optional blockquote summary, and H2 sections whose list items are Markdown links with full URLs.",
  },
  {
    question: "Does a valid llms.txt get me cited in AI answers?",
    answer:
      "No. It only means the file follows the proposal. Whether an AI tool reads it, and whether it cites you, is up to that tool.",
  },
  {
    question: "Why does the validator say the file is not Markdown?",
    answer:
      "The server probably returned an HTML page instead, such as a 404 template. Open the URL in a browser and check what comes back.",
  },
]
---

<BaseLayout
  title="Free llms.txt validator and checker"
  description="Validate an llms.txt file by URL or pasted Markdown. Find structure errors, bad and duplicate links and thin sections, with the line for each problem."
  canonicalPath="/tools/llms-txt-validator"
  {breadcrumbs}
>
  <main data-agent-content>
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-foreground-muted">
      <ol class="flex flex-wrap items-center gap-1.5">
        {breadcrumbs.map((crumb, index) => (
          <li class="flex items-center gap-1.5">
            {crumb.href ? (
              <a class="underline decoration-border underline-offset-4 hover:decoration-foreground" href={crumb.href}>
                {crumb.label}
              </a>
            ) : (
              <span class="text-foreground">{crumb.label}</span>
            )}
            {index < breadcrumbs.length - 1 ? <span aria-hidden="true" class="text-border">/</span> : null}
          </li>
        ))}
      </ol>
    </nav>

    <PageHeader
      title="llms.txt validator"
      description="Enter a public llms.txt URL, paste the content, or open a local file. Get line-specific format and link-list checks."
    />

    <LlmsTxtValidator />

    <div class="docs-prose mt-16">
      <h2>What the validator checks</h2>
      <p>
        The checker follows the current{' '}
        <a href="https://llmstxt.org/" target="_blank" rel="noreferrer">llms.txt proposal</a>.
        {' '}It looks for one H1 project name, the optional blockquote summary,
        H2 file-list sections, complete HTTP or HTTPS links, duplicate links,
        and the special Optional section.
      </p>
      <p>
        Errors include a line number when the problem belongs to one line.
        Suggestions cover valid but thin files, such as a title with no summary
        or useful links.
      </p>

      <h2>A valid file does not prove the links work</h2>
      <p>
        When you enter a URL, this tool downloads that llms.txt file. It does
        not request the pages listed inside it, inspect their response headers,
        or confirm that an agent uses the file.
      </p>

      <h2>llms.txt is optional for AI search</h2>
      <p>
        The proposal gives systems that choose to read it a curated page list.
        Google says AI Overviews and AI Mode need no new machine-readable file
        or special AI markup. Pages still need the normal technical and content
        foundations used by Google Search.
      </p>
      <p>
        Google's{' '}
        <a href="https://developers.google.com/search/docs/appearance/ai-features" target="_blank" rel="noreferrer">AI features guidance</a>
        {' '}covers the current requirements and controls. A clean validation
        result does not predict crawling, indexing, rankings, citations, or
        traffic.
      </p>

      <h2>Create a cleaner draft</h2>
      <p>
        Fix a small file with the{' '}
        <a href="/tools/llms-txt-generator">llms.txt generator</a>. It creates
        the same basic shape from links you choose and can import page URLs from
        a sitemap.
      </p>

      <h2>Read the validation result</h2>
      <p>
        Errors break the format: no H1, more than one H1, links that are not
        full HTTP or HTTPS URLs, or list items that are not links. Fix those
        first. Suggestions point at a file that is valid but thin, such as a
        title with no summary or a section with no links. Each finding gives
        the line where it applies.
      </p>

      <h2>Fix common llms.txt problems</h2>
      <ul>
        <li><strong>Served as HTML.</strong> Some servers return an error page or a site template for <code>/llms.txt</code>. The validator shows what it actually received.</li>
        <li><strong>Relative links.</strong> Write each link as a full URL.</li>
        <li><strong>The whole sitemap pasted in.</strong> A long list defeats the point. Keep the pages an agent should read first.</li>
        <li><strong>Links to pages that moved.</strong> Valid Markdown, broken result. Check the links when you change your site.</li>
      </ul>

      <h2>Check the links in your llms.txt with your agent</h2>
      <p>
        This page checks the file, not the pages it lists. The{' '}
        <a href="/docs/crawl">seo crawl</a> command does both: it finds{' '}
        <code>/llms.txt</code> and checks that its links load. Ask:
      </p>
      <CodeBlock value="Check whether example.com has an llms.txt with working links, and list the pages that are missing from it" wrap />
      <p>The crawl runs from the CLI on your machine. Install it and run setup:</p>
      <CodeBlock value="npm i -g seo && seo start" wrap />
      <p>Or add the hosted MCP server to your agent and sign in with Google:</p>
    </div>

    <SetupCommands id="llms-txt-validator-setup" class="mt-6" />

    <div class="docs-prose mt-16">
      <h2>llms.txt validator questions</h2>
    </div>
    <div class="mt-6">
      <FaqAccordion id="llms-txt-validator-faq" items={faq} />
    </div>
  </main>
</BaseLayout>
