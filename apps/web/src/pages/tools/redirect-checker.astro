---
import {
  Alert02Icon,
  ArrowLeftRightIcon,
  CsvIcon,
  FileSearchIcon,
  RepeatIcon,
  Route01Icon,
  TextCheckIcon,
  Timer02Icon,
  ViewOffIcon,
  WebValidationIcon,
} from '@hugeicons/core-free-icons'
import CodeBlock from '@/components/CodeBlock.astro'
import FaqAccordion from '@/components/FaqAccordion.astro'
import FounderBadge from '@/components/FounderBadge.astro'
import HomeCard from '@/components/HomeCard.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SetupPrompts from '@/components/SetupPrompts.astro'
import SplitList from '@/components/SplitList.astro'
import RedirectChecker from '@/components/tools/RedirectChecker.astro'
import { getButtonClasses } from '@/components/ui/button'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SchemaBreadcrumb } from '@/lib/schema'

const breadcrumbs: SchemaBreadcrumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: 'Redirect checker' },
]

// What one trace shows, in the order a reader looks for it.
const checks = [
  {
    title: 'Every hop',
    icon: Route01Icon,
    text: 'Each request and response from the URL you enter to the page it ends on, with the Location the server sent at each step.',
  },
  {
    title: 'The status code of each hop',
    icon: ArrowLeftRightIcon,
    text: 'Whether each redirect is a 301, 302, 303, 307 or 308, so a temporary hop hiding in the middle of a chain stands out.',
  },
  {
    title: 'Time per hop',
    icon: Timer02Icon,
    text: 'How long each server took to answer, in milliseconds. A slow first hop on an old domain shows up here.',
  },
  {
    title: 'Loops and long chains',
    icon: RepeatIcon,
    text: 'A URL that comes back round, and a chain still redirecting after 10 hops, the point where Google stops following.',
  },
  {
    title: 'The page it ends on',
    icon: FileSearchIcon,
    text: 'Its status, a noindex rule, a canonical that points somewhere else and any meta refresh, because a redirect to a page Google drops does no good.',
  },
  {
    title: 'Up to 200 URLs at once',
    icon: CsvIcon,
    text: 'Paste old URLs with the page each should reach, get a verdict for every line and download the full trace as CSV.',
  },
]

const codes = [
  { title: 'Moved for good', code: '301', text: 'The default for a page that moved. Google shows the new URL. Browsers may turn a form POST into a GET.' },
  { title: 'Moved for good, method kept', code: '308', text: 'Google treats it like a 301. Browsers must repeat the same request, so a POST stays a POST.' },
  { title: 'Moved for now', code: '302', text: 'Google usually keeps showing the old URL. Use it when the old page will come back.' },
  { title: 'Moved for now, method kept', code: '307', text: 'Google treats it like a 302. Chrome also shows it for an HSTS upgrade that never left the browser.' },
  { title: 'See another page', code: '303', text: 'Sends the browser to a different page with a GET, usually after a form. Temporary to Google.' },
  { title: 'Meta refresh', code: 'meta', text: 'A redirect in the page HTML. Google reads an instant one as permanent and a delayed one as temporary.' },
]

const limits = [
  { title: '10', text: 'Redirect hops Google\u2019s crawlers follow before they give up, by Google\u2019s HTTP status code guide. This checker stops at 10 too.' },
  { title: 'Fewer than 5', text: 'Hops Google advises for a chain you can\u2019t avoid, and ideally no more than 3, in its site move guide.' },
  { title: '0', text: 'PageRank lost to a permanent redirect. Google says 301 and other permanent redirects don\u2019t cause a loss.' },
  { title: '1 year', text: 'The least time Google advises keeping redirects after a move. Old links and bookmarks keep using them long after.' },
]

const working = [
  { title: 'Enter the old URL', text: 'Not the new one. The trace starts where a visitor or crawler would start.' },
  { title: 'Look for one permanent hop', text: 'A working redirect shows a single 301 or 308, then a 200 on the new URL.' },
  { title: 'Check the page it ends on', text: 'It should return 200, allow indexing and have a canonical that points to itself.' },
  { title: 'Trace the other versions too', text: 'http and https, www and non-www, with and without the trailing slash. Each should reach the same page in one hop.' },
]

const fixes = [
  { title: 'Find the final URL', text: 'The page the trace ends on is the target every older URL should point at.' },
  { title: 'Point each old rule straight at it', text: 'A chain usually builds up over several moves, such as http to https, then www, then a new slug. Edit the oldest rule so it skips the rest.' },
  { title: 'Break a loop at the rule that disagrees', text: 'A loop is two rules that undo each other, such as one adding a trailing slash and one removing it. Search the server config, CMS and CDN for the path that came back.' },
  { title: 'Trace it again', text: 'Repeat until the first URL shows one permanent redirect and a 200.' },
]

const hidden = [
  { title: 'Cached 301s', text: 'Browsers can remember a 301 with no end date and skip the request. This checker asks the server fresh every time.' },
  { title: 'HSTS', text: 'A browser that knows a site is https only upgrades the URL itself, and Chrome shows it as \u201c307 Internal Redirect\u201d.' },
  { title: 'Redirects by user agent, country or cookie', text: 'The server can answer Googlebot or a visitor differently. Use URL Inspection in Search Console on the final URL for Google\u2019s view.' },
  { title: 'JavaScript redirects', text: 'They don\u2019t show here, because the checker doesn\u2019t run scripts. If a URL looks fine here but visitors still move, a script is doing it.' },
]

const tools = [
  { title: 'SEO migration checklist', text: 'Plan a site move and check your redirect map for duplicates and home page targets before launch.', href: '/tools/seo-migration-checklist', icon: TextCheckIcon, link: 'Plan a migration' },
  { title: 'Page with redirect in Search Console', text: 'What the status means, when it\u2019s fine and when a redirect is costing you a page in Google.', href: '/guides/page-with-redirect', icon: Alert02Icon, link: 'Read the guide' },
  { title: 'Canonical tag checker', text: 'See where a page\u2019s canonical points, and whether it agrees with your redirects.', href: '/tools/canonical-checker', icon: WebValidationIcon, link: 'Check canonicals' },
  { title: 'Noindex checker', text: 'Every robots rule on the page a redirect ends on, from the meta tags, headers and robots.txt.', href: '/tools/noindex-checker', icon: ViewOffIcon, link: 'Check noindex' },
]

const faq = [
  {
    question: 'How do I check if a 301 redirect is working?',
    answer:
      'Enter the old URL above. A working 301 shows one response with status 301 and a Location header, then a 200 on the new URL. If you see 302 or 307 instead, the redirect works for visitors but tells Google the move is temporary.',
  },
  {
    question: 'How do I check if a redirect is a 301 or a 302?',
    answer:
      'Trace the URL here and read the status column. Each hop shows its own code, so a chain that starts with a 301 and passes through a 302 shows both. Your browser can hide the difference, because it caches 301s.',
  },
  {
    question: 'Should I use a 301 or a 302 redirect?',
    answer:
      'Use a 301 when the page has moved for good, which covers most site changes, migrations and merged pages. Use a 302 only when the old page will come back, such as during maintenance or a short campaign.',
  },
  {
    question: 'Should I use a 301 or a 308?',
    answer:
      'Google treats them the same. The difference is for browsers: a 308 must keep the request method, so a form POST stays a POST. For ordinary pages, either works.',
  },
  {
    question: 'Do redirects hurt SEO?',
    answer:
      'Permanent redirects don\u2019t lose PageRank, by Google\u2019s own guide. What costs you is a temporary redirect used for a permanent move, a redirect to an unrelated page, and a long chain that slows every visit and breaks during the next move.',
  },
  {
    question: 'How many redirects does Google follow?',
    answer:
      'Up to 10 in a row. Google advises redirecting to the final page directly and, when that isn\u2019t possible, keeping a chain to fewer than 5. This checker stops at 10 too, so a chain it can\u2019t finish is one Google can\u2019t finish either.',
  },
  {
    question: 'Why does my browser show a different redirect from this checker?',
    answer:
      'Browsers remember 301s and HSTS rules, so a browser can skip a redirect the server still sends. Chrome shows an HSTS upgrade as \u201c307 Internal Redirect\u201d, which never leaves the browser. This checker asks the server fresh every time, so it shows what a crawler gets.',
  },
  {
    question: 'Does the checker follow meta refresh or JavaScript redirects?',
    answer:
      'It reports a meta refresh on the page where the trace ends, with its delay and target, but doesn\u2019t follow it. It doesn\u2019t run JavaScript, so a script redirect won\u2019t show. Google prefers server redirects for both reasons.',
  },
  {
    question: 'How long should I keep redirects after a site move?',
    answer:
      'Google says as long as possible, and generally at least a year. Old links and bookmarks keep sending people to the old URLs long after Google has moved on.',
  },
  {
    question: 'Is the redirect checker free?',
    answer:
      'Yes, with no account. You get 10 checks a day, and a bulk check of up to 200 URLs counts as one.',
  },
  {
    question: 'Can I check redirects on localhost or a staging site?',
    answer:
      'Not with this page. It fetches from a public server, so the URL has to be public, with no password or custom port. The SEO Skill CLI runs the same trace from your own machine, so it reaches anything your machine can.',
  },
]
---

<BaseLayout
  title="Free redirect checker for 301, 302 and redirect chains"
  description="Trace every redirect a URL takes, with each hop's status code and time, find chains and loops, or check up to 200 old URLs after a migration."
  canonicalPath="/tools/redirect-checker"
  {breadcrumbs}
  framed={false}
>
  <main data-agent-content>
    <section class="pt-4">
      <div class="site-frame flex flex-col items-center pt-14 text-center sm:pt-20">
        <FounderBadge prefix="Written by AI and" ai />
        <h1 class="mt-4 max-w-3xl text-pretty text-4xl/tight font-medium -tracking-[0.8px] xl:text-5xl/tight xl:-tracking-[1px]">
          Redirect checker
        </h1>
        <p class="mt-4 max-w-2xl text-pretty text-xl/8 font-medium -tracking-[0.2px] text-foreground-muted">
          Enter a URL to see every redirect it takes, whether each one is a
          301, 302 or something else, and whether the page it ends on can be
          indexed. Switch to bulk to check up to 200 old URLs after a
          migration.
        </p>
      </div>
      <div class="site-frame mt-10 max-w-3xl sm:mt-12">
        <RedirectChecker />
      </div>
    </section>

    <div class="space-y-24 py-24 sm:space-y-32 sm:py-32">
      <section class="site-frame" aria-labelledby="checks-heading">
        <SectionHeading
          id="checks-heading"
          title="What does the redirect checker show?"
          text="Every hop from the URL you enter to the page it ends on, and whether that page is one Google will keep. It asks the server fresh each time, so you see what a crawler gets."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {checks.map((item) => <HomeCard title={item.title} text={item.text} icon={item.icon} />)}
        </div>
      </section>

      <SplitList
        id="codes-heading"
        title="Should I use a 301 or a 302 redirect?"
        text="Use a 301 when the page has moved for good and a 302 only when it will come back. Google cares whether a move is permanent; browsers also care whether the request method is kept, which is all that separates a 308 from a 301 and a 307 from a 302."
        items={codes}
      >
        <a
          class:list={[getButtonClasses('secondary', 'lg'), 'mt-6']}
          href="https://developers.google.com/search/docs/crawling-indexing/301-redirects"
          target="_blank"
          rel="noreferrer">Read Google's redirects guide</a
        >
      </SplitList>

      <section class="site-frame" aria-labelledby="limits-heading">
        <SectionHeading
          id="limits-heading"
          title="How many redirects will Google follow?"
          text="Ten in a row, but one is the target. A chain costs a request per hop and breaks easily in the next move, even though a permanent redirect loses no ranking value."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {
            limits.map((item) => (
              <div class="rounded-lg bg-muted p-6">
                <p class="text-3xl font-medium -tracking-[0.6px] text-foreground">{item.title}</p>
                <p class="mt-2 text-sm leading-6 text-foreground-muted">{item.text}</p>
              </div>
            ))
          }
        </div>
      </section>

      <SplitList
        id="working-heading"
        title="How do I check that a 301 redirect is working?"
        text="Trace the old URL and look for one permanent redirect followed by a 200. Anything more, such as a 302 in the middle or a page that ends on a noindex, works for visitors but not for Google."
        items={working}
      />

      <SplitList
        id="fixes-heading"
        title="How do I fix a redirect chain or loop?"
        text="Point every old URL straight at the final page. Each rule in a chain is usually right on its own; together they make three requests where one would do."
        items={fixes}
      />

      <section class="site-frame grid gap-8 sm:grid-cols-[1fr_1.15fr] sm:items-start" aria-labelledby="bulk-heading">
        <div class="sm:sticky sm:top-24">
          <h2 id="bulk-heading" class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            How do I check redirects after a site migration?
          </h2>
          <p class="mt-4 text-base leading-7 text-foreground-muted">
            Switch the checker to bulk and put the planned target after each
            old URL. Every line gets a verdict: it reaches the right page,
            reaches it through a chain, lands on the wrong page, doesn't
            redirect, loops, or is still redirecting after 10.
          </p>
        </div>
        <div class="min-w-0 rounded-lg bg-muted p-6 text-base leading-7 text-foreground-muted">
          <p>One URL per line, with the page it should reach after a comma:</p>
          <CodeBlock value={'https://old.example.com/about-us, https://example.com/about\nhttps://old.example.com/blog/2019/post, https://example.com/blog/post\nhttp://old.example.com/services'} />
          <p class="mt-4">
            A line with one URL just shows where it ends. Download CSV writes
            one line per response, so you can filter to every 302 at once. For
            more than 200 rows, your agent runs up to 1,000 from your own
            machine.
          </p>
        </div>
      </section>

      <SplitList
        id="hidden-heading"
        title="Why does my browser show a different redirect?"
        text="Because browsers remember redirects and the server never sees the request. This checker sends every request fresh from a server, with no cache, so it shows what a crawler gets."
        items={hidden}
      />

      <div>
        <SplitList
          id="site-heading"
          title="How do I check every redirect on my site?"
          text="Ask your agent. SEO Skill crawls the site for internal links that still point at redirects and for redirect chains, and traces a whole redirect map from your own machine, including staging and anything behind your VPN."
          items={[
            { title: 'Links that point at redirects', text: 'The crawl lists every internal link that still goes through a redirect, so you can link to the final URL instead.' },
            { title: 'Redirect maps of up to 1,000 rows', text: 'One old and new URL per line in a CSV file, traced with the same 10 hop limit as this page.' },
            { title: 'Old URLs that still get searches', text: 'With the hosted MCP server, the page report puts a URL\u2019s live redirect next to Google\u2019s URL Inspection result and its Search Console queries.' },
          ]}
        />
        <div class="site-frame mt-8 grid gap-2 sm:grid-cols-2">
          <CodeBlock
            label="Ask your agent"
            prompt
            value="Trace every row of redirects.csv with seo redirect-trace and list each chain, loop, error and temporary redirect, with the rule to fix it"
          />
          <CodeBlock
            label="Or check one old URL"
            prompt
            value="Check https://example.com/old-pricing with SEO Skill. Where does it redirect, is every hop permanent, and is the old URL still getting impressions in Search Console?"
          />
        </div>
      </div>

      <section class="site-frame" aria-labelledby="tools-heading">
        <SectionHeading
          id="tools-heading"
          title="Free tools and guides for a redirect"
          text="A redirect is one part of a move. These cover the plan, the page it ends on and what Search Console says about it."
        />
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {tools.map((item) => <HomeCard {...item} />)}
        </div>
      </section>

      <section class="site-frame" aria-labelledby="faq-heading">
        <div class="max-w-2xl">
          <h2 id="faq-heading" class="text-pretty text-2xl font-medium -tracking-[0.4px] text-foreground xl:text-3xl xl:-tracking-[0.6px]">
            Redirect checker questions
          </h2>
        </div>
        <div class="mt-10">
          <FaqAccordion items={faq} id="redirect-checker-faq" />
        </div>
      </section>

      <section class="site-frame" aria-labelledby="start-heading">
        <SectionHeading
          id="start-heading"
          title="Check every redirect on your site with your agent"
          text="Add SEO Skill to your agent, sign in with the Google account that can read your Search Console, and ask it which redirects to fix first."
        />
        <SetupPrompts id="redirect-checker-setup" />
      </section>
    </div>
  </main>
</BaseLayout>
