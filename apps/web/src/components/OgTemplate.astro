---
import Logo from '@/components/Logo.astro'

type Props = {
  title: string
  description?: string
}

const { title } = Astro.props
---

<div
  class="og-card relative flex h-[630px] w-[1200px] flex-col justify-between overflow-hidden bg-background px-20 py-16 text-foreground"
  style="color-scheme: light; --background: oklch(98.5% 0 0); --foreground: oklch(20.5% 0 0); --foreground-muted: oklch(45% 0 0); --muted: oklch(96% 0 0); --primary: oklch(60.9% 0.126 221.723);"
>
  <header class="flex items-center justify-between">
    <span class="flex items-center gap-4">
      <Logo class="size-12" />
      <span class="text-[34px] font-medium">SEO Skill</span>
    </span>
    <span class="text-[24px] text-foreground-muted">The SEO command for AI agents</span>
  </header>

  <h1 class="og-title max-w-[1000px] text-[68px] font-medium leading-[1.1] -tracking-[1.5px]">
    {title}
  </h1>

  <footer class="flex items-center justify-between">
    <span class="flex items-center gap-4">
      <span class="rounded-[14px] bg-muted px-6 py-4 font-mono text-[26px]">npm i -g seo</span>
      <span class="rounded-[14px] bg-muted px-6 py-4 font-mono text-[26px]">seoskill.dev/mcp</span>
    </span>
    <span class="text-[26px] font-medium text-primary">seoskill.dev</span>
  </footer>
</div>

<style>
  .og-title {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
</style>
